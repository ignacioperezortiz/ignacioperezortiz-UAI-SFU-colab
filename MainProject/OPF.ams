			Body: {
				SCT_Trafo := "TR4";  SCT_H4Periods := "2,3,4,5,6,7,8,9,33,34,35,36,37,38,39,40";
				SCT_H4SC1Run( 0, 1, 1000, 0, "_TR4W_h4_ref", "" );
				SCT_Trafo := "";
			}
			Comment: "TR4 closed loop, no service (reference day).";
		}

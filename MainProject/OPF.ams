			Body: {
				SCT_Trafo := "TR4";  RollOfferLog := 1;  SCT_PlanDump := 1;  SCT_PlanSteps := "2,24,38";
				SCT_SC1Run( 0, 1, 0, "_TR4W_fix", "" );
				SCT_Trafo := "";  RollOfferLog := 0;  SCT_PlanDump := 0;
			}
			Comment: "TR4 walk-through, recommended setup (SCFirst = 1, SCAlpha = 0): same logging.";
		}

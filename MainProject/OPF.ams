		Procedure SCT_Micro_Hard {
			Body: {
				FOR_SCWeight    := 0;
				SCT_Hard        := 1;
				SCT_nShrink     := 1;
				SCT_Shrink('1') := 0.99;
				SCT_RunBed( "_SCT_micro_hard", "_two" );
				SCT_Hard        := 0;
			}
			Comment: "H2c on the micro bed: P1 as a hard constraint of the sweep (no extra import in any later slot, per prosumer), production baseline.";
		}
		Procedure SCT_TR9_Hard {
			Body: {
				FOR_SCWeight    := 0;
				SCT_Hard        := 1;
				SCT_nShrink     := 1;

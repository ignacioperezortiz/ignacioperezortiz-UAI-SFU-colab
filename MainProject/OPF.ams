		}
		Procedure SCT_H4Run {
			Arguments: (Kappa,ExpShare,Hard,Svc,Tag,Pattern);
			Body: {
				! H4 closed loop: the TSO takes (almost) the 180 deg vertex at every period of SCT_H4Periods; the
				! commitment is executed at the next step and the day rolls on from the SOC it leaves. Svc = 0 is the
				! no-service reference with the same logging.
				FOR_SCWeight      := Kappa;
				FOR_SCExpWeight   := ExpShare;
				SCT_Hard          := Hard;
				SCT_Regret        := 0;
				SCT_nShrink       := 1;
				SCT_Shrink('1')   := 0.99;
				RollSvcMode       := Svc;
				RollSvcAngle      := 180;
				RollSvcRho        := 0.99;
				RollSvcPeriodsCSV := SCT_H4Periods;
				SCT_RunBed( Tag, Pattern );
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				SCT_Regret        := 1;
				SCT_Hard          := 0;
				FOR_SCWeight      := 0;
				FOR_SCExpWeight   := 1;
			}
			Parameter Kappa {
				Property: Input;
			}
			Parameter ExpShare {
				Property: Input;
			}
			Parameter Hard {
				Property: Input;
			}
			Parameter Svc {
				Property: Input;
			}
			StringParameter Tag {
				Property: Input;
			}
			StringParameter Pattern {
				Property: Input;
			}
		}
		Procedure SCT_Micro_H4_Ref {
			Body: {
				SCT_H4Periods := "2,3,4,5,6,7,8,9,33,34,35,36,37,38,39,40";
				SCT_H4Run( 0, 1, 0, 0, "_SCT_micro_h4_ref", "_two" );
			}
			Comment: "H4 on the micro bed, no service (reference): TSO takes the 180 deg vertex (rho 0.99) at 00:30-04:30 and 16:00-20:00.";
		}
		Procedure SCT_Micro_H4_K0 {
			Body: {
				SCT_H4Periods := "2,3,4,5,6,7,8,9,33,34,35,36,37,38,39,40";
				SCT_H4Run( 0, 1, 0, 1, "_SCT_micro_h4_k000", "_two" );
			}
			Comment: "H4 on the micro bed, production FOR: TSO takes the 180 deg vertex (rho 0.99) at 00:30-04:30 and 16:00-20:00.";
		}
		Procedure SCT_Micro_H4_KI100 {
			Body: {
				SCT_H4Periods := "2,3,4,5,6,7,8,9,33,34,35,36,37,38,39,40";
				SCT_H4Run( 1, 0, 0, 1, "_SCT_micro_h4_ki100", "_two" );
			}
			Comment: "H4 on the micro bed, imports-only weights, kappa 1: TSO takes the 180 deg vertex (rho 0.99) at 00:30-04:30 and 16:00-20:00.";
		}

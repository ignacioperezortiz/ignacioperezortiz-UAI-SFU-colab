		Procedure RunTR4_ExpW {
			Body: {
				MainInitialization;
				UseBattComp       := 0;
				FOR_ThruPenSlot   := 0.2;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				FairMode          := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				ExpWRelief        := 0;
				BaselineOnly      := 1;
				RollUseSOCSeed    := 0;
				RollFileSuffix    := "_TR4_ewwarm";
				run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed    := 1;
				IrrRef            := max(t, Irrraw(t));
				if IrrRef <= 0 then
					halt with "IrrRef vazio: Irrraw so e preenchido DENTRO de RunFOR_Rolling. ExpWeight ficaria 1 e o teste nao mediria nada - falhar alto e melhor que um resultado nulo silencioso.";
				endif;
				BaselineOnly      := 0;
				ExpWRelief        := 0;
				RollFileSuffix    := "_TR4_ew0";
				run RunFOR_Rolling;
				ExpWRelief        := 0.75;
				RollFileSuffix    := "_TR4_ew75";
				run RunFOR_Rolling;
				ExpWRelief        := 0;
				IrrRef            := 1;
				FOR_ThruPenSlot   := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				SCAlpha           := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "TIME-VARYING EXPORT WEIGHT, about 1 h 45. Two sweeps from the SAME seed, no service, differing only in ExpWRelief: _TR4_ew0 is the control at 0 and must reproduce the untouched objective, _TR4_ew75 relieves the export penalty in proportion to sunlight, down to 0.25 at the peak. Tests whether the 824 kWh of largely unavoidable daily export - the PV surplus is 4.2 times the fleet capacity - is distorting the dispatch by competing with the terms the batteries can actually control.";
		}
		Procedure RunTR4_RevFlow {
			Body: {
				MainInitialization;
				UseBattComp       := 0;
				FOR_ThruPenSlot   := 0.2;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				FairMode          := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				RevFlowOn         := 0;
				RevFlowMax        := 99;
				PVcutPen          := 0;
				BaselineOnly      := 1;
				RollUseSOCSeed    := 0;
				RollFileSuffix    := "_TR4_rfwarm";
				run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed    := 1;
				BaselineOnly      := 0;
				RevFlowOn         := 0;
				RollFileSuffix    := "_TR4_rf0";
				run RunFOR_Rolling;
				RevFlowOn         := 1;
				RevFlowMax        := 1.5;
				PVcutPen          := 5;
				RollFileSuffix    := "_TR4_rfcap";
				run RunFOR_Rolling;
				RevFlowOn         := 0;
				RevFlowMax        := 99;
				PVcutPen          := 0;
				FOR_ThruPenSlot   := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				SCAlpha           := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "REVERSE-FLOW LIMIT AND PV CURTAILMENT, about 1 h 45. Two sweeps from the SAME seed: _TR4_rf0 is the control with everything off and must reproduce the untouched model, _TR4_rfcap caps PCC export at 1.5 p.u. and prices curtailment at 5. PVcut(t) is how much PV would have to be cut in that half-hour to respect the cap, so the run measures how much the fleet saves from the cut by charging instead. Not nodal curtailment: P0minGenP is a parameter and the PV enters the linearised injection through its own terms, so reducing generation per node would mean touching the validated physics.";
		}
		Procedure RunTR4_CapSvc {
			Body: {
				MainInitialization;
				UseBattComp       := 0;
				FOR_ThruPenSlot   := 0.2;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				FairMode          := 0;
				RollSvcPeriodsCSV := "17,19,21,23,25,27,29,31,33,35,37";
				RollSvcAngle      := 0;
				RollSvcRho        := 0.5;
				RevFlowOn         := 0;
				RevFlowMax        := 99;
				PVcutPen          := 0;
				RollSvcMode       := 0;
				BaselineOnly      := 1;
				RollUseSOCSeed    := 0;
				RollFileSuffix    := "_TR4_cxwarm";
				run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed    := 1;
				BaselineOnly      := 0;
				RevFlowOn         := 1;
				RevFlowMax        := 1.5;
				PVcutPen          := 5;
				RollSvcMode       := 1;
				RollFileSuffix    := "_TR4_capsvc";
				run RunFOR_Rolling;
				RevFlowOn         := 0;
				RevFlowMax        := 99;
				PVcutPen          := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				RollSvcAngle      := 180;
				FOR_ThruPenSlot   := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				SCAlpha           := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "REVERSE-FLOW CAP AND SUNLIT ABSORPTION SERVICE TOGETHER, about 1 h 10. One sweep, seeded from the same warm-up as _TR4_rf0 and _TR4_rfcap, with the export cap at 1.5 p.u., curtailment priced at 5, and 11 requests at RollSvcAngle 0 - the least-export corner, which makes the fleet absorb - in periods 17 to 37, all in strong sun. Tests whether a service and curtailment avoidance are the same physical action: asking the fleet to absorb during sun should deliver flexibility, save PV from the cut, and cost almost nothing in self-consumption. Compare against _TR4_rfcap, which is the same cap with no service.";
		}

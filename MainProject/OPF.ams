## ams_version=1.0

Model Main_OPF_VI_LG {
	Section ModelOverview {
		Comment: "Read-me. Start here: what the model is, where each part lives, and how to reproduce the thesis results.";
		DeclarationSection ReadMe {
			Comment: {
				"OPF + Feasible Operation Region (FOR) at the PCC - rolling horizon.
				.
				WHAT THIS MODEL IS
				A three-phase linearized OPF of an LV distribution feeder with
				household PV + batteries. Two coupled products, both convex QCP:
				1) a self-consumption battery dispatch (MinImports), and
				2) the FOR offered at the PCC for the next half-hour, computed by a
				   12-direction sweep around the committed dispatch (RunFOR_Rolling).
				.
				STRUCTURE (top-level sections, in reading order)
				- Configuration      : every run switch; defaults = production values.
				- InputData          : sets, database tables, time series, unit conversion.
				- NetworkModel       : the network physics (linearized current-injection
				                       power flow, transformers, voltage/thermal limits).
				                       Inherited from the OPF model of Prof. Luis (physics
				                       unchanged). The IncludeNetworkConstraints toggle
				                       acts on THIS section.
				- BatteryModel       : SOC dynamics, power limits, cyclic-SOC band,
				                       inverter capability, throughput penalty.
				- SelfConsumptionOPF : objectives + solve wrappers + the paper case runners.
				- FOR_Computation    : PCC power, directional objective, sweep containers.
				- NetworkReduction   : per-transformer detail + lumped MV loads.
				- RollingHorizonFOR  : the production rolling FOR (RunFOR_Rolling and
				                       the per-transformer runners RunTR1..RunTR9).
				- Validation         : MIQCP complementarity cross-check (BattComp),
				                       exact-AC / SLP boundary validation, loss-balance
				                       and coverage audits, paper comparison.
				- ResultsOutput      : Excel results writer.
				.
				TO REPRODUCE
				- one transformer   : run RunTR1 .. RunTR9 (writes FOR_rolling_TR<k>.csv
				                      + FOR_rolling_soc_TR<k>.csv)
				- all transformers  : run RunFOR_Rolling_PerTrafo
				- all-idle baseline : run RunFOR_Rolling_Baseline
				- micro test bed    : run RunReducedTest_RollingMicro (TR9_two sub-branch)
				- dispatch study    : set DOE_Now + DOE_TargetP/Q, then RunDOE_Dispatch or
				                      RunDOE_Envelope (DOE_Dispatch section, two-level fair DOEs)
				A fresh session reproduces production results with no manual parameter
				assignments: all defaults ARE the production values.
				.
				KEY MODELING CHOICES (defended in the thesis)
				- BattThroughputPen = 0.2 > w2/19 ~ 0.105: linear battery throughput
				  penalty above the closed-form phantom-dump threshold, so simultaneous
				  charge/discharge never pays while the problem stays a convex QCP
				  (no binary). Derivation in the parameter comment (Configuration).
				- FOR_PolyS = 0 and FOR_LinearizeVmax = 0 in production: EXACT quadratic
				  inverter S-circle + exact quadratic Vmax cap, solved as a convex QCP
				  (CPLEX barrier). Tractable because production runs per transformer on
				  the reduced network (RunTrafoFOR). The linearized forms (both = 1)
				  remain available as fidelity toggles and were used for the historical
				  whole-feeder runs; ex-post columns VmaxTrue/OVviol/LinErr quantify them.
				- The service slot (PeriodMaxP = 2, i.e. now+1) carries no self-consumption
				  weight in the committed baseline: its exchange is the service offered.
				  See the w2 parameter comment."
			}
		}
	}
	Section Configuration {
		Comment: "Every run switch and scenario parameter. Principle: DEFAULTS = PRODUCTION VALUES, so a fresh session reproduces the thesis results without manual assignments. Validation-only toggles (UseBattComp, FOR_ScaleInv, FOR_WarmFromLin) default off.";
		DeclarationSection RunSettings {
			Parameter IncludeQforMaxP {
				Comment: "1 = battery reactive power is a decision variable at PeriodMaxP (the service slot) only; it stays fixed at 0 in every other period. Production: 1.";
			}
			Parameter BattThroughputPen {
				Default: 0.2;
				Comment: {
					"Linear penalty on total battery throughput sum(BattP_Chg+BattP_Dis) in the cost-min objectives.
					PRODUCTION VALUE 0.2. Must exceed w2max/((1+eta^2)/(1-eta^2)) = 2.0/19 ~ 0.105:
					with eta = etaChg = etaDis ~ 0.9487 (eta^2 ~ 0.9), dissipating a surplus P through
					simultaneous charge/discharge at pinned SOC needs gross throughput P*(1+eta^2)/(1-eta^2) ~ 19P,
					so any penalty above w2/19 makes the phantom dump uneconomic and the battery
					dispatch becomes physically meaningful - WITHOUT a complementarity binary
					(the problem stays a convex QCP). 0.2 adds margin to close marginal SOC<1
					dissipate-vs-store ties. Validated on the full feeder: 0 simultaneous-cycling
					rows vs ~50% at the historical 0.1. Cross-check vs the MIQCP binary
					formulation: Section Validation (UseBattComp)."
				}
			}
			Parameter UseBattComp {
				Default: 0;
				Comment: "0 = production (pure convex QCP; the throughput penalty alone prevents simultaneous charge/discharge). 1 = enforce charge/discharge complementarity via binary BattOn (constraints ChgMode/DisMode) - makes the program a MIQCP. Kept as the VALIDATION alternative: RunMicro_BattComp / RunFullTR9_BattComp reproduce the same dispatch as the penalty formulation.";
			}
			Parameter maxtanphi;
			Parameter MaxExports;
			Parameter PeriodMaxP {
				Comment: "The evaluated/service period. Paper cases: 25 (12:00-12:30). Rolling FOR: 2 (the slot right after the committed one; the day is rotated so slot 1 = now). w2(PeriodMaxP) = 0 by construction: the service slot carries no self-consumption weight.";
			}
			StringParameter ResultsFile {
				Definition: ResultsFileRoot+PeriodMaxP+".xls";
			}
			StringParameter ResultsFileRoot;
			Parameter IncludeNetworkConstraints {
				Comment: "1 = include the NetworkModel section (voltage, thermal, power-flow constraints). 0 = battery/energy model only. Implemented via NotTobeExcluded_constraints/variables (intersection of AllConstraints/AllVariables with the NetworkModel section). Production: 1.";
			}
			Parameter VmultLV;
			Parameter maxtapchanges;
			Parameter DeltaT {
				Definition: 24/nPeriods;
				Comment: "Time step between periods in hours (0.5 h at nPeriods=48). Used by the SOC dynamics.";
			}
			Parameter nPeriods;
			Parameter w1 {
				Definition: 1;
			}
			Parameter w2 {
				IndexDomain: t;
				Definition: {
					if PeriodMaxP=0 or t<PeriodMaxP then
						2.01-0.01*t
					elseif t>PeriodMaxP then
						2.01-0.01*(t-1)
					endif
				}
				Comment: {
					"Self-consumption weight per period: 2.00 at t=1, decreasing by 0.01 per period
					(earlier self-consumption is worth slightly more, which breaks temporal degeneracy).
					DELIBERATE HOLE: w2(PeriodMaxP) = 0 (no else-branch). In the rolling FOR
					(PeriodMaxP=2) the committed baseline therefore puts NO self-consumption weight
					on the service slot: its exchange is exactly the flexibility offered to the
					aggregator, so the baseline must not pre-commit value there. In the paper cases
					(PeriodMaxP=25) the w1 max-reverse-flow term takes over at that period instead."
				}
			}
		}
		DeclarationSection FidelityToggles {
			Comment: {
				"Reversible model-fidelity switches. AllowChargeAtPmax (article vs relaxed); FOR_PolyS with FOR_PolySides/FOR_PolyAng (exact inverter S-circle vs 16-gon); FOR_LinearizeVmax (exact vs linearized Vmax). All 0 reproduces the exact reference model. FOR_PolyS/PolyAng are read by MaxBattS_poly in NetworkModel."
			}
			Parameter AllowChargeAtPmax {
				Comment: "0 = article assumption (batteries discharge-only at PeriodMaxP). 1 = relaxed: batteries may also CHARGE at PeriodMaxP (lets the feeder import).";
			}
			Parameter FOR_PolyS {
				Comment: "0 = exact battery S-circle BattP^2+Qinv^2<=BattMaxP^2 (Prof. Luis\'s model, DEFAULT). 1 = piecewise-linear polygon inverter capability curve (well-conditioned, fixes the high-Q arc).";
			}
			Set FOR_PolySides {
				SubsetOf: Integers;
				Index: ks;
				Property: ElementsAreNumerical;
				Definition: ElementRange(1, 16);
				Comment: {
					"Sides of the polygonal inverter capability curve (16-gon ~ 2% outer tolerance; raise to tighten)."
				}
			}
			Parameter FOR_PolyAng {
				IndexDomain: ks;
				Definition: (ord(ks)-1) * 2 * (4*arctan(1)) / Card(FOR_PolySides);
				Comment: "Tangent-line angle of polygon side ks (radians, 0..2pi).";
			}
			Parameter FOR_ScaleInv {
				Comment: "0 = inverter S-cone in natural p.u. (DEFAULT, all existing runs unchanged). 1 = per-unit-normalized cone (MaxBattS_norm on BattInvPn/BattInvQn, link constraints active, exact MaxBattS_def disabled) to test whether rescaling cures the exact-QCP status-13 numerical breakdown. Only RunFOR_TR9_Exact sets it.";
			}
			Parameter FOR_WarmFromLin {
				Comment: "0 = warm-start the exact solve from the cost-min OPF (DEFAULT). 1 = per direction, first solve the linearized model, set Vre0/Vim0 to that boundary solution (re-linearize loads there) and warm-start the exact solve from it. Only RunFOR_TR9_Exact sets it.";
			}
			Parameter FOR_LinearizeVmax {
				Comment: "0 = original exact Vmax (Vre^2+Vim^2<=MaxV^2, Prof. Luis\'s model, DEFAULT). 1 = linearized Vmax (Vmag2approx<=MaxV^2) for the conditioning experiment.";
			}
		}
	}
	Section InputData {
		Comment: "Sets and indices, database table mappings (Database.dsn), the Excel time series (OpData.xls), per-customer load/PV parameters, and the master loader Load_data_dsn (DB + Excel + kW->p.u. conversion at Sb=1 MW + flat-start voltages = the linearization point).";
		DeclarationSection sets {
			Set Batteries {
				Index: bat;
			}
			Set Aggregators {
				Index: a;
			}
			Set SlackGens {
				Index: sg;
			}
			Set RefBus {
				SubsetOf: Buses;
				Index: ref;
				Definition: {
					{n|Slack(n)=1}
				}
			}
			Set Trafos {
				Index: tr;
			}
			Set LoadsAndPV {
				Index: d;
			}
			Set Phases {
				SubsetOf: Integers;
				Index: f, h;
				Definition: ElementRange( 1, 3);
			}
			Set Time {
				SubsetOf: Integers;
				Index: t;
				Property: ElementsAreNumerical;
				Definition: ElementRange( 1, nPeriods);
			}
			Set SubTime {
				SubsetOf: Integers;
				Index: tt;
				Property: ElementsAreNumerical;
				Definition: ElementRange( 1, nPeriods);
				Comment: "tt ranges from 1 to t";
			}
			Set Lines {
				Index: l;
			}
			Set Buses {
				Index: n;
			}
			Set NotTobeExcluded_constraints {
				SubsetOf: AllConstraints;
				Property: NoSave;
				OrderBy: IndexConstraints;
				Definition: {
					if IncludeNetworkConstraints=0 then
						AllConstraints - AllConstraints*NetworkModel
					else
						AllConstraints
					endif
				}
			}
			Set NotTobeExcluded_variables {
				SubsetOf: AllVariables;
				Property: NoSave;
				Definition: {
					if IncludeNetworkConstraints=0 then
						AllVariables - AllVariables*NetworkModel
					else
						AllVariables
					endif
				}
			}
		}
		DeclarationSection Databases {
			DatabaseTable BatteriesData {
				DataSource: "Database.dsn";
				TableName: "Batteries";
				Mapping: {
					"BattName"  	--> Batteries,
					"BattBus"  	--> BattBus(bat),
					"BattPhase"  	--> BattPhase(bat),
					"BattSOCini"	--> BattSOCini(bat),
					"BattSOCmin"	--> BattSOCmin(bat),
					"BattSOCmax"	--> BattSOCmax(bat),
					"BattMaxP"  	--> BattMaxP(bat),
					"BattEcap"  	--> BattEcap(bat),
					"etaChg"	--> etaChg(bat),
					"etaDis"	--> etaDis(bat),

					"BattAgg" --> BattAgg(bat),
					"BattTr" --> BattTr(bat),

					"BattAgg" --> Aggregators
				}
			}
			DatabaseTable SlackGenData {
				DataSource: "Database.dsn";
				TableName: "SlackGen";
				Mapping: {
					"SlackGenName" 	--> SlackGens,
					"SlackGenBus"  	--> SlackGenBus(sg),
					"SlackGenPhase"	--> SlackGenPhase(sg)
				}
			}
			DatabaseTable LoadsAndPVData {
				DataSource: "Database.dsn";
				TableName: "LoadsAndPV";
				Mapping: {
					"LoadName"  	--> LoadsAndPV,                
					"LoadBus"  	--> LoadBus(d),
					"LoadPhase"  	--> LoadPhase(d),
					"PVsize"	--> PVsize(d)
				}
			}
			DatabaseTable BusesData {
				DataSource: "Database.dsn";
				TableName: "Buses";
				Mapping: {
					"BusName"  	--> Buses,
					"MinV"  	--> MinV(n),
					"MaxV"  	--> MaxV(n),
					"SlackBus"	--> Slack(n),
					"Vbase"		--> Vbase(n)
				}
			}
			DatabaseTable LinesData {
				DataSource: "Database.dsn";
				TableName: "Lines";
				Mapping: {
					"LineName"  --> Lines,
					"StartBus" -->StartBus(l),
					"EndBus" -->EndBus(l),
					"Rs" -->Rs(l),
					"Xs" -->Xs(l),
					"Rm" -->Rm(l),
					"Xm" -->Xm(l),
					"MaxCurrent" -->MaxCurrent(l),
					"MinimiseFlow" -->MinimiseFlow(l)
				}
			}
			DatabaseTable TrafosData {
				DataSource: "Database.dsn";
				TableName: "Trafos";
				Mapping: {
					"TrafoName"  --> Trafos,
					"StartBusTr" -->StartBusTr(tr),
					"EndBusTr" -->EndBusTr(tr),
					"Is_OLTC" -->Is_OLTC(tr),
					"FixedTapPos" -->FixedTapPos(tr),
					"MaxAmps" -->MaxAmps(tr),
					"MinTap" -->MinTap(tr),
					"MaxTap" -->MaxTap(tr),
					"R" -->R(tr),
					"X" -->X(tr),
					"nomratio" -->nomratio(tr)
				}
			}
		}
		DeclarationSection LoadAndPVParameters {
			Parameter P0 {
				IndexDomain: (d,t);
			}
			Parameter Q0 {
				IndexDomain: (d,t);
			}
			Parameter Irradiance {
				IndexDomain: t;
			}
			Parameter GenP0 {
				IndexDomain: (d,t);
			}
			ElementParameter LoadBus {
				IndexDomain: d;
				Range: Buses;
			}
			ElementParameter LoadPhase {
				IndexDomain: d;
				Range: Phases;
			}
			Parameter P0minGenP {
				IndexDomain: (d,t);
				Definition: P0(d,t)-GenP0(d,t);
			}
			Parameter Q0minGenQ {
				IndexDomain: (d,t);
				Definition: Q0(d,t);
			}
			Parameter PVsize {
				IndexDomain: d;
			}
		}
		Procedure ReadExcelFile {
			Body: {
				axll::CloseAllWorkBooks;
				axll::OpenWorkBook("OpData.xls");

				axll::SelectSheet(SheetName:"Irradiance(t)");	!read Irradiance data
				axll::ReadList(
					IdentifierReference:Irradiance(t),
					RowHeaderRange:"A2:A49",
					DataRange:"B2:B49",
					ModeForUnknownElements:1,
					MergeWithExistingData:0);

				axll::SelectSheet(SheetName:"P0(d,t)");	!read P0 data
				axll::ReadTable(
					IdentifierReference:P0(d,t),
					RowHeaderRange:"A3:A2432",
					ColumnHeaderRange:"B2:AW2",
					DataRange:"B3:AW2432",
					ModeForUnknownElements:1,
					MergeWithExistingData:0);

				axll::SelectSheet(SheetName:"Q0(d,t)");	!read G0 data
				axll::ReadTable(
					IdentifierReference:Q0(d,t),
					RowHeaderRange:"A3:A2432",
					ColumnHeaderRange:"B2:AW2",
					DataRange:"B3:AW2432",
					ModeForUnknownElements:1,
					MergeWithExistingData:0);


				!axll::SelectSheet(SheetName:"EnergyExpPrices(t)");	!read EnergyPrices
				!axll::ReadList(
				!	IdentifierReference:PayExport(t),
				!	RowHeaderRange:"A2:A49",
				!	DataRange:"B2:B49",
				!	ModeForUnknownElements:1,
				!	MergeWithExistingData:0);
				!
				!axll::SelectSheet(SheetName:"EnergyImpPrices(t)");	!read EnergyPrices
				!axll::ReadList(
				!	IdentifierReference:CostImport(t),
				!	RowHeaderRange:"A2:A49",
				!	DataRange:"B2:B49",
				!	ModeForUnknownElements:1,
				!	MergeWithExistingData:0);


				axll::CloseAllWorkBooks;
			}
		}
		Procedure Load_data_static {
			Body: {
				            read from table BusesData;
				            read from table SlackGenData;
				            read from table TrafosData;
				            read from table LoadsAndPVData;
				            read from table LinesData;
				            !read from table GenData;
				            !read from table CapacitorsData;
				            read from table BatteriesData;

				            run ReadExcelFile;	!reads OpData in time for GenP, P0 and Q0 

				            !data input in kW, needd to be taken to pu (Sb=1MW)
				            P0(d,t):=P0(d,t)/1000; !Active load demand at load/customer d and time t
				            Q0(d,t):=Q0(d,t)/1000; !Reactive load demand at load/customer d and time t
					    GenP0(d,t):=PVsize(d)*Irradiance(t)/1000; !PV/generation active power

				            !Cost in time
				!            CostImport(t):=12;
				!            PayExport(t):=4;
				            !read from file "Costs.dat";

				            VmultLV:=1.037; !433/(230*sqrt(3)) (1.087) - 5% (choosing tap ratio 1.05) = 1.037 / Defines a voltage multiplier for LV buses.
						            !for low-voltage nodes, the initial voltage magnitude is approximately 1.037 p.u.


				            !Transformer tap linearization coefficients
				            !This block defines a linear relationship between transformer tap position and tap ratio.
				            !Tapratio(tr,t) := mlin(tr)*TapPosUnits(tr,t) + nlin(tr);
				            for (tr) do
				            	if MaxTap(tr)=19 then
				            		mlin(tr):=-0.0167;
				            		nlin(tr):=1.1169;

				            	elseif MaxTap(tr)=17 then	!Prim subst OLTC
				            		mlin(tr):=-0.0143;
				            		nlin(tr):=1.0715;

				            	elseif MaxTap(tr)=9 then !now case MaxTap(tr)=9 for LV-OLTCs (base in 230V)
				            		mlin(tr):=-0.02;
				            		nlin(tr):=1.16;

				            	else	!OffLTC secondary trafo
				            		mlin(tr):=-0.025;
				            		nlin(tr):=1.075;
				            	endif;
				            endfor;
			}
			Comment: {
				"Static half of the loader: the Access tables, OpData.xls and everything derived from them
				(kW->p.u. conversion, VmultLV, the tap linearization coefficients mlin/nlin). This data does not
				change between solves, so it only has to run once per study case. Split out of Load_data_dsn so
				that RunFOR_Rolling can load it once per run instead of once per direction (it was doing 13 full
				DB+Excel reloads per period, ~624 per 48-period run). Every other caller still goes through
				Load_data_dsn, which runs this and Load_data_reset back to back, in the original order."
			}
		}
		Procedure Load_data_reset {
			Body: {
				!            Imax(bat):=0.00368;	!16A limited inverters

				            Qinv(bat,t):=0;	!without Q capabilities  
				            Qinv(bat,t).nonvar:=1; !This variable is not allowed to change during optimization.

				            if IncludeQforMaxP=1 then
				            	Qinv(bat,PeriodMaxP).nonvar:=0; !By default, battery reactive power is disabled. But if IncludeQforMaxP = 1, then battery reactive power is allowed only during the period used to maximize/evaluate PCC active power.
				            endif;

				            !for trafos with fixed taps
				            for (tr) do
				            	if Is_OLTC(tr)=0 then	!for the HV/MV trafo - then this transformer does not change taps during optimization.
				            		TapPosUnits(tr,t):=FixedTapPos(tr);
				            		Tapratio(tr,t) := mlin(tr)*TapPosUnits(tr,t) + nlin(tr);
				!            		TapPosUnits(tr,t).nonvar:=1; !If want to make it change
				!            		Tapratio(tr,t).nonvar:=1;    !If want to make it change
				            	endif;
				            endfor;

				            !!warm start of variables
				            !VmultLV:=1.03265;

				            for (n) do
				            	if Vbase(n)>=6.6 then	!source bus and all MV nodes, no primary modelled - Source bus and MV buses
				            		Vre(n,1,t):=1;
				            		Vim(n,1,t):=0;
				            		Vre(n,2,t):= -0.5;
				            		Vim(n,2,t):= -0.866;
				            		Vre(n,3,t):= -0.5;
				            		Vim(n,3,t):= 0.866;
				            	else	!LV nodes - Vbase(n)<6.6 - LV buses
				            		!this reflects the 30deg rotation of a Dy1 connection
				            		Vre(n,1,t):= 0.866*VmultLV;
				            		Vim(n,1,t):= -0.5*VmultLV;
				            		Vre(n,2,t):= -0.866*VmultLV;
				            		Vim(n,2,t):= -0.5*VmultLV;
				            		Vre(n,3,t):= 0*VmultLV;
				            		Vim(n,3,t):= 1*VmultLV;
				!            	else
				!            		!this reflects a second 30deg rotation of a Dy1 connection
				!            		Vre(n,1,t):= 0.5*VmultLV;
				!            		Vim(n,1,t):= -0.866*VmultLV;
				!            		Vre(n,2,t):= -1*VmultLV;
				!            		Vim(n,2,t):= 0*VmultLV;
				!            		Vre(n,3,t):= 0.5*VmultLV;
				!            		Vim(n,3,t):= 0.866*VmultLV;		
				            	endif;
				            endfor;


				           !For linearization
				           !copies the initial voltage values into:
				            Vre0(n,f,t):=Vre(n,f,t);
				            Vim0(n,f,t):=Vim(n,f,t);
			}
			Comment: {
				"Per-solve half of the loader. Three of its targets are Variables, which empty allvariables wipes and
				which therefore MUST be re-established before every solve: the Qinv fix (value + nonvar) and the
				flat-start voltage seed Vre/Vim. The rest - the fixed transformer taps TapPosUnits/Tapratio and the
				linearization point Vre0/Vim0 - are Parameters that survive empty allvariables; they are recomputed
				anyway because it costs nothing and keeps this procedure a self-contained reset.
				Reads no data and touches no set, and writes nothing indexed by d, so it is safe to call on the
				reduced network: after ApplyNetworkReduction the loops simply range over the reduced sets, and the
				elements outside them are no longer referenced by the model. Cheap - this is what RunFOR_Rolling
				calls per direction instead of a full DB+Excel reload."
			}
		}
		Procedure Load_data_dsn {
			Body: {
				run Load_data_static;   ! DB tables + OpData.xls + kW->p.u. + tap linearization coefficients
				run Load_data_reset;    ! Qinv fix, fixed taps, flat-start voltages, Vre0/Vim0

				! 1. Read network data
				!   ↓
				! 2. Read load/PV/battery data
				!   ↓
				! 3. Disable battery reactive power by default
				!   ↓
				! 4. Optionally allow battery Q at the target FOR period
				!   ↓
				! 5. Convert kW/kVAr data to p.u.
				!   ↓
				! 6. Define transformer tap-ratio linear models
				!   ↓
				! 7. Initialize fixed transformer taps
				!   ↓
				! 8. Initialize balanced three-phase voltages
				!      - MV side: 1∠0°, 1∠−120°, 1∠120°
				!      - LV side: shifted by 30° because of Dy1 transformers
				!   ↓
				! 9. Copy initial voltages into Vre0 and Vim0
				!   ↓
				! 10. Use Vre0 and Vim0 as the linearization point

				! reduce to DetailedTrafos (lump the other transformers as MV loads) when requested; no-op otherwise
				if ReduceNetwork = 1 then
					run ApplyNetworkReduction;
				endif;
			}
			Comment: {
				"loads as constant power (for now). Thin wrapper since 2026-07-29: it runs Load_data_static then
				Load_data_reset then the optional network reduction, which is the original statement order, so
				every existing caller behaves exactly as before. Only the Qinv fix moved - from before the Excel
				read to after the tap coefficients - and nothing in between touches Qinv, so that is a no-op."
			}
		}
	}
	Section NetworkModel {
		Comment: "The network physics, inherited unchanged from the OPF model of Prof. Luis: linearized current-injection power flow (loads/PV linearized around the flat-start voltages Vre0/Vim0), transformer Dy1 voltage/current equations, thermal limits, voltage limits, slack bus, and the inverter capability constraints. The IncludeNetworkConstraints toggle excludes exactly this section (AllConstraints*NetworkModel), so constraint membership here is semantically meaningful - do not move constraints in or out casually.";
		DeclarationSection Inverters {
			Constraint MaxBattS_def {
				IndexDomain: (bat) | FOR_PolyS = 0 and FOR_ScaleInv = 0;
				Definition: BattP_Balance(bat,PeriodMaxP)^2 + Qinv(bat,PeriodMaxP)^2 <= BattMaxP(bat)^2;
				Comment: "Exact S-circle. Disabled (no rows) when FOR_PolyS=1 (replaced by MaxBattS_poly) or when FOR_ScaleInv=1 (replaced by the unit-scaled MaxBattS_norm).";
			}
			Variable BattInvPn {
				IndexDomain: (bat);
				Range: free;
				Comment: "Per-unit-normalized inverter active power at PeriodMaxP (BattP_Balance/BattMaxP). O(1) cone variable, used only when FOR_ScaleInv=1 to improve exact-QCP conditioning. No rows when FOR_ScaleInv=0.";
			}
			Variable BattInvQn {
				IndexDomain: (bat);
				Range: free;
				Comment: "Per-unit-normalized inverter reactive power at PeriodMaxP (Qinv/BattMaxP). Pairs with BattInvPn for the unit S-cone when FOR_ScaleInv=1.";
			}
			Constraint LinkBattInvPn {
				IndexDomain: (bat) | FOR_ScaleInv = 1;
				Definition: BattMaxP(bat)*BattInvPn(bat) = BattP_Balance(bat,PeriodMaxP);
			}
			Constraint LinkBattInvQn {
				IndexDomain: (bat) | FOR_ScaleInv = 1;
				Definition: BattMaxP(bat)*BattInvQn(bat) = Qinv(bat,PeriodMaxP);
			}
			Constraint MaxBattS_norm {
				IndexDomain: (bat) | FOR_ScaleInv = 1;
				Definition: BattInvPn(bat)^2 + BattInvQn(bat)^2 <= 1;
				Comment: "Unit S-cone on normalized variables (well-conditioned). Replaces the exact MaxBattS_def when FOR_ScaleInv=1.";
			}
			Constraint MaxBattS_poly {
				IndexDomain: (bat,ks) | FOR_PolyS = 1;
				Definition: {
					cos(FOR_PolyAng(ks))*BattP_Balance(bat,PeriodMaxP)
					+ sin(FOR_PolyAng(ks))*Qinv(bat,PeriodMaxP)
					<= BattMaxP(bat)
				}
				Comment: "Piecewise-linear (16-gon) inverter capability curve replacing the exact S-circle when FOR_PolyS=1. Tangent lines => circumscribed polygon, ~2% outer tolerance at K=16.";
			}
		}
		DeclarationSection SlackGenVars {
			Variable Iim_SlackGen {
				IndexDomain: (sg,t);
				Range: free;
			}
			Variable Ire_SlackGen {
				IndexDomain: (sg,t);
				Range: free;
			}
		}
		DeclarationSection LineVars {
			Variable Ire_Line {
				IndexDomain: (l,f,t);
				Range: free;
			}
			Variable Iim_Line {
				IndexDomain: (l,f,t);
				Range: free;
			}
		}
		DeclarationSection TrafosVars {
			Parameter Tapratio {
				IndexDomain: (tr,t);
				Range: nonnegative;
			}
			Parameter TapPosUnits {
				IndexDomain: (tr,t);
				Range: [MinTap(tr), MaxTap(tr)];
			}
			Variable Iim_Trafo {
				IndexDomain: (tr,f,n,t);
				Range: free;
			}
			Variable Ire_Trafo {
				IndexDomain: (tr,f,n,t);
				Range: free;
			}
		}
		DeclarationSection BusVars {
			Variable Vmag2approx {
				IndexDomain: (n,f,t);
				Range: free;
				Definition: Vre0(n,f,t)^2 + Vim0(n,f,t)^2 + 2*Vre0(n,f,t)*(Vre(n,f,t)-Vre0(n,f,t)) + 2*Vim0(n,f,t)*(Vim(n,f,t)-Vim0(n,f,t));
			}
			Variable Vre {
				IndexDomain: (n,f,t);
				Range: free;
			}
			Variable Vim {
				IndexDomain: (n,f,t);
				Range: free;
			}
		}
		DeclarationSection SlackGenParameters {
			ElementParameter SlackGenBus {
				IndexDomain: sg;
				Range: Buses;
			}
			ElementParameter SlackGenPhase {
				IndexDomain: sg;
				Range: Phases;
			}
		}
		DeclarationSection BusParameters {
			Parameter Slack {
				IndexDomain: n;
			}
			Parameter MinV {
				IndexDomain: n;
			}
			Parameter MaxV {
				IndexDomain: n;
			}
			Parameter Vbase {
				IndexDomain: n;
				Comment: "in kV";
			}
		}
		DeclarationSection LineParameters {
			Parameter MinimiseFlow {
				IndexDomain: l;
			}
			ElementParameter StartBus {
				IndexDomain: l;
				Range: Buses;
			}
			ElementParameter EndBus {
				IndexDomain: l;
				Range: Buses;
			}
			Parameter Rs {
				IndexDomain: l;
			}
			Parameter xs {
				IndexDomain: l;
			}
			Parameter Rm {
				IndexDomain: l;
			}
			Parameter Xm {
				IndexDomain: l;
			}
			Parameter MaxCurrent {
				IndexDomain: l;
			}
		}
		DeclarationSection TrafosParameters {
			ElementParameter StartBusTr {
				IndexDomain: tr;
				Range: Buses;
			}
			ElementParameter EndBusTr {
				IndexDomain: tr;
				Range: Buses;
			}
			Parameter Is_OLTC {
				IndexDomain: tr;
			}
			Parameter FixedTapPos {
				IndexDomain: tr;
			}
			Parameter MaxAmps {
				IndexDomain: tr;
			}
			Parameter MinTap {
				IndexDomain: tr;
			}
			Parameter MaxTap {
				IndexDomain: tr;
			}
			Parameter R {
				IndexDomain: tr;
			}
			Parameter X {
				IndexDomain: tr;
			}
			Parameter nomratio {
				IndexDomain: tr;
			}
			Parameter mlin {
				IndexDomain: tr;
			}
			Parameter nlin {
				IndexDomain: tr;
			}
		}
		DeclarationSection NonLinearConstraints {
			Constraint Vre_calc_Trafo {
				IndexDomain: (tr,f,t);
				Definition: {
					if f=1 then
					Vre(StartBusTr(tr),f,t) = -(nomratio(tr)*Tapratio(tr,t)/3)*(2*Vre(EndBusTr(tr),2,t)+Vre(EndBusTr(tr),3,t)
								+ R(tr)*(2*Ire_Trafo(tr,2,EndBusTr(tr),t) + Ire_Trafo(tr,3,EndBusTr(tr),t))
								- X(tr)*(2*Iim_Trafo(tr,2,EndBusTr(tr),t) + Iim_Trafo(tr,3,EndBusTr(tr),t)))
					elseif f=2 then
					Vre(StartBusTr(tr),f,t) = -(nomratio(tr)*Tapratio(tr,t)/3)*(2*Vre(EndBusTr(tr),3,t)+Vre(EndBusTr(tr),1,t)
								+ R(tr)*(2*Ire_Trafo(tr,3,EndBusTr(tr),t) + Ire_Trafo(tr,1,EndBusTr(tr),t))
								- X(tr)*(2*Iim_Trafo(tr,3,EndBusTr(tr),t) + Iim_Trafo(tr,1,EndBusTr(tr),t)))
					else
					Vre(StartBusTr(tr),f,t) = -(nomratio(tr)*Tapratio(tr,t)/3)*(2*Vre(EndBusTr(tr),1,t)+Vre(EndBusTr(tr),2,t)
								+ R(tr)*(2*Ire_Trafo(tr,1,EndBusTr(tr),t) + Ire_Trafo(tr,2,EndBusTr(tr),t))
								- X(tr)*(2*Iim_Trafo(tr,1,EndBusTr(tr),t) + Iim_Trafo(tr,2,EndBusTr(tr),t)))
					endif
				}
			}
			Constraint Vim_calc_Trafo {
				IndexDomain: (tr,f,t);
				Definition: {
					if f=1 then
					Vim(StartBusTr(tr),f,t) = -(nomratio(tr)*Tapratio(tr,t)/3)*(2*Vim(EndBusTr(tr),2,t)+Vim(EndBusTr(tr),3,t)
								+ R(tr)*(2*Iim_Trafo(tr,2,EndBusTr(tr),t) + Iim_Trafo(tr,3,EndBusTr(tr),t))
								+ X(tr)*(2*Ire_Trafo(tr,2,EndBusTr(tr),t) + Ire_Trafo(tr,3,EndBusTr(tr),t)))
					elseif f=2 then
					Vim(StartBusTr(tr),f,t) = -(nomratio(tr)*Tapratio(tr,t)/3)*(2*Vim(EndBusTr(tr),3,t)+Vim(EndBusTr(tr),1,t)
								+ R(tr)*(2*Iim_Trafo(tr,3,EndBusTr(tr),t) + Iim_Trafo(tr,1,EndBusTr(tr),t))
								+ X(tr)*(2*Ire_Trafo(tr,3,EndBusTr(tr),t) + Ire_Trafo(tr,1,EndBusTr(tr),t)))
					else
					Vim(StartBusTr(tr),f,t) = -(nomratio(tr)*Tapratio(tr,t)/3)*(2*Vim(EndBusTr(tr),1,t)+Vim(EndBusTr(tr),2,t)
								+ R(tr)*(2*Iim_Trafo(tr,1,EndBusTr(tr),t) + Iim_Trafo(tr,2,EndBusTr(tr),t))
								+ X(tr)*(2*Ire_Trafo(tr,1,EndBusTr(tr),t) + Ire_Trafo(tr,2,EndBusTr(tr),t)))
					endif

					!if f<3 then
					!Vim(StartBusTr(tr),f) = -(nomratio(tr)/3)*(2*Vim(EndBusTr(tr),f+1)+Vim(EndBusTr(tr),f+2)
					!			+ R(tr)*(2*Iim_Trafo(tr,f+1,EndBusTr(tr)) + Iim_Trafo(tr,f+2,EndBusTr(tr)))
					!			+ X(tr)*(2*Ire_Trafo(tr,f+1,EndBusTr(tr)) + Ire_Trafo(tr,f+2,EndBusTr(tr))))
					!else
					!Vim(StartBusTr(tr),f) = -(nomratio(tr)/3)*(2*Vim(EndBusTr(tr),1)+Vim(EndBusTr(tr),2)
					!			+ R(tr)*(2*Iim_Trafo(tr,1,EndBusTr(tr)) + Iim_Trafo(tr,2,EndBusTr(tr)))
					!			+ X(tr)*(2*Ire_Trafo(tr,1,EndBusTr(tr)) + Ire_Trafo(tr,2,EndBusTr(tr))))
					!endif
					!
				}
			}
			Constraint Ire_calc_Trafo {
				IndexDomain: (tr,f,t);
				Definition: {
					if f<3 then
						Ire_Trafo(tr,f,StartBusTr(tr),t)*nomratio(tr)*Tapratio(tr,t) = Ire_Trafo(tr,f,EndBusTr(tr),t) - Ire_Trafo(tr,f+1,EndBusTr(tr),t)
					else
						Ire_Trafo(tr,f,StartBusTr(tr),t)*nomratio(tr)*Tapratio(tr,t) = Ire_Trafo(tr,3,EndBusTr(tr),t) - Ire_Trafo(tr,1,EndBusTr(tr),t)
					endif
				}
			}
			Constraint Iim_calc_Trafo {
				IndexDomain: (tr,f,t);
				Definition: {
					if f<3 then
						Iim_Trafo(tr,f,StartBusTr(tr),t)*nomratio(tr)*Tapratio(tr,t) = Iim_Trafo(tr,f,EndBusTr(tr),t) - Iim_Trafo(tr,f+1,EndBusTr(tr),t)
					else
						Iim_Trafo(tr,f,StartBusTr(tr),t)*nomratio(tr)*Tapratio(tr,t) = Iim_Trafo(tr,3,EndBusTr(tr),t) - Iim_Trafo(tr,1,EndBusTr(tr),t)
					endif
				}
			}
			Constraint I2maxTrafos {
				IndexDomain: (tr,f,t);
				Definition: {
					!constraining the primary side current per phase
					Ire_Trafo(tr,f,StartBusTr(tr),t)^2+Iim_Trafo(tr,f,StartBusTr(tr),t)^2 <= MaxAmps(tr)^2

					!to not consider it
					!Ire_Trafo(tr,f,n)^2+Iim_Trafo(tr,f,n)^2 <= MaxAmps(tr)^2*10000000000000000000000000000
				}
			}
			Constraint I2maxLines {
				IndexDomain: (l,f,t);
				Definition: {
					Ire_Line(l,f,t)^2+Iim_Line(l,f,t)^2 <= MaxCurrent(l)^2

					!to not consider it
					!Ire_Line(l,f,t)^2+Iim_Line(l,f,t)^2 <= MaxCurrent(l)^2*10000000000000000000000000000000000000
				}
			}
			Constraint Vmax {
				IndexDomain: (n,f,t);
				Definition: (1-FOR_LinearizeVmax)*( Vre(n,f,t)^2 + Vim(n,f,t)^2 ) + FOR_LinearizeVmax * Vmag2approx(n,f,t) <= MaxV(n)^2;
			}
		}
		DeclarationSection OtherLinearConstraints {
			Constraint Vmin {
				IndexDomain: (n,f,t);
				Definition: {
					Vmag2approx(n,f,t) >= MinV(n)^2

					!Vre(n,f,t)^2 + Vim(n,f,t)^2 >= MinV(n)^2
				}
			}
			Constraint SlackVim {
				IndexDomain: (ref,f,t);
				Definition: {
					if f=1 then
						Vim(ref,f,t)=0
					elseif f=2 then
						Vim(ref,f,t)=-0.866025404
					else
						Vim(ref,f,t)=0.866025404
					endif
				}
			}
			Constraint SlackVre {
				IndexDomain: (ref,f,t);
				Definition: {
					if f=1 then
						Vre(ref,f,t)=1
					else
						Vre(ref,f,t)=-0.5
					endif
				}
			}
			Constraint Ire_balance {
				IndexDomain: (n,f,t);
				Definition: {
					sum(sg|SlackGenBus(sg)=n and SlackGenPhase(sg)=f,Ire_SlackGen(sg,t))
					+ sum(l|EndBus(l)=n, Ire_Line(l,f,t))
					+ sum(tr|EndBusTr(tr)=n, Ire_Trafo(tr,f,n,t))
					- sum(l|StartBus(l)=n, Ire_Line(l,f,t))
					- sum(tr|StartBusTr(tr)=n, Ire_Trafo(tr,f,n,t))
					= sum(d|LoadBus(d)=n and LoadPhase(d)=f,Ire_Load(d,t)-Ire_Gen(d,t))
					+ sum(bat|BattBus(bat)=n and BattPhase(bat)=f,Ire_Batt(bat,t))
				}
			}
			Constraint Iim_balance {
				IndexDomain: (n,f,t);
				Definition: {
					sum(sg|SlackGenBus(sg)=n and SlackGenPhase(sg)=f,Iim_SlackGen(sg,t))
					+ sum(l|EndBus(l)=n, Iim_Line(l,f,t))
					+ sum(tr|EndBusTr(tr)=n, Iim_Trafo(tr,f,n,t))
					- sum(l|StartBus(l)=n, Iim_Line(l,f,t))
					- sum(tr|StartBusTr(tr)=n, Iim_Trafo(tr,f,n,t))
					= sum(d|LoadBus(d)=n and LoadPhase(d)=f,Iim_Load(d,t)-Iim_Gen(d,t))
					+ sum(bat|BattBus(bat)=n and BattPhase(bat)=f,Iim_Batt(bat,t))
				}
			}
			Constraint VdropLines_re {
				IndexDomain: (l,f,t);
				Definition: Vre(StartBus(l),f,t)-Vre(EndBus(l),f,t) = sum(h|h<>f,Rm(l)*Ire_Line(l,h,t) - Xm(l)*Iim_Line(l,h,t)) + Rs(l)*Ire_Line(l,f,t) - Xs(l)*Iim_Line(l,f,t);
			}
			Constraint VdropLines_im {
				IndexDomain: (l,f,t);
				Definition: Vim(StartBus(l),f,t)-Vim(EndBus(l),f,t) = sum(h|h<>f,Xm(l)*Ire_Line(l,h,t) + Rm(l)*Iim_Line(l,h,t)) + Xs(l)*Ire_Line(l,f,t) + Rs(l)*Iim_Line(l,f,t);
			}
			Constraint FixedTaps {
				IndexDomain: (tr,t)|Is_OLTC(tr)=0;
				Definition: TapPosUnits(tr,t)=FixedTapPos(tr);
			}
		}
		DeclarationSection Linearization {
			Parameter Vre0 {
				IndexDomain: (n,f,t);
			}
			Parameter Vim0 {
				IndexDomain: (n,f,t);
			}
			Parameter dIredVre_Gen {
				IndexDomain: (d,t);
				Definition: {
					(GenP0(d,t)*(-Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2))/
					(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)^2
				}
			}
			Parameter dIredVre_Load {
				IndexDomain: (d,t);
				Definition: {
					(P0(d,t)*(-Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2) - 2*Q0(d,t)*Vim0(LoadBus(d),LoadPhase(d),t)*Vre0(LoadBus(d),LoadPhase(d),t))/
					(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)^2
				}
			}
			Parameter dIimdVre_Gen {
				IndexDomain: (d,t);
				Definition: {
					(- 2*GenP0(d,t)*Vre0(LoadBus(d),LoadPhase(d),t)*Vim0(LoadBus(d),LoadPhase(d),t))/
					(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)^2
				}
			}
			Parameter dIimdVre_Load {
				IndexDomain: (d,t);
				Definition: {
					(Q0(d,t)*(Vre0(LoadBus(d),LoadPhase(d),t)^2-Vim0(LoadBus(d),LoadPhase(d),t)^2) - 2*P0(d,t)*Vre0(LoadBus(d),LoadPhase(d),t)*Vim0(LoadBus(d),LoadPhase(d),t))/
					(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)^2
				}
			}
			Parameter dIimdVim_Gen {
				IndexDomain: (d,t);
				Definition: {
					GenP0(d,t)*(Vre0(LoadBus(d),LoadPhase(d),t)^2 - Vim0(LoadBus(d),LoadPhase(d),t)^2)/
					(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)^2
				}
			}
			Parameter dIimdVim_Load {
				IndexDomain: (d,t);
				Definition: {
					P0(d,t)*(Vre0(LoadBus(d),LoadPhase(d),t)^2 - Vim0(LoadBus(d),LoadPhase(d),t)^2 + 2*Q0(d,t)*Vre0(LoadBus(d),LoadPhase(d),t)*Vim0(LoadBus(d),LoadPhase(d),t))/
					(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)^2
				}
			}
			Parameter dIredVim_Gen {
				IndexDomain: (d,t);
				Definition: {
					(- 2*P0minGenP(d,t)*Vre0(LoadBus(d),LoadPhase(d),t)*Vim0(LoadBus(d),LoadPhase(d),t))/
					(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)^2
				}
			}
			Parameter dIredVim_Load {
				IndexDomain: (d,t);
				Definition: {
					(Q0(d,t)*(-Vim0(LoadBus(d),LoadPhase(d),t)^2+Vre0(LoadBus(d),LoadPhase(d),t)^2) - 2*P0(d,t)*Vre0(LoadBus(d),LoadPhase(d),t)*Vim0(LoadBus(d),LoadPhase(d),t))/
					(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)^2
				}
			}
		}
		DeclarationSection LoadAndGenVars {
			Variable Ire_Gen {
				IndexDomain: (d,t);
				Range: free;
				Definition: {
					(GenP0(d,t)*Vre0(LoadBus(d),LoadPhase(d),t))/(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)
						      + dIredVre_Gen(d,t)*(Vre(LoadBus(d),LoadPhase(d),t)-Vre0(LoadBus(d),LoadPhase(d),t))
						      + dIredVim_Gen(d,t)*(Vim(LoadBus(d),LoadPhase(d),t)-Vim0(LoadBus(d),LoadPhase(d),t))
				}
			}
			Variable Ire_Load {
				IndexDomain: (d,t);
				Range: free;
				Definition: {
					(P0(d,t)*Vre0(LoadBus(d),LoadPhase(d),t) + Q0(d,t)*Vim0(LoadBus(d),LoadPhase(d),t))/(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)
						      + dIredVre_Load(d,t)*(Vre(LoadBus(d),LoadPhase(d),t)-Vre0(LoadBus(d),LoadPhase(d),t))
						      + dIredVim_Load(d,t)*(Vim(LoadBus(d),LoadPhase(d),t)-Vim0(LoadBus(d),LoadPhase(d),t))
				}
			}
			Variable Iim_Load {
				IndexDomain: (d,t);
				Range: free;
				Definition: {
					(P0(d,t)*Vim0(LoadBus(d),LoadPhase(d),t) - Q0(d,t)*Vre0(LoadBus(d),LoadPhase(d),t))/(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)
						      + dIimdVre_Load(d,t)*(Vre(LoadBus(d),LoadPhase(d),t)-Vre0(LoadBus(d),LoadPhase(d),t))
						      + dIimdVim_Load(d,t)*(Vim(LoadBus(d),LoadPhase(d),t)-Vim0(LoadBus(d),LoadPhase(d),t))
				}
			}
			Variable Iim_Gen {
				IndexDomain: (d,t);
				Range: free;
				Definition: {
					(GenP0(d,t)*Vim0(LoadBus(d),LoadPhase(d),t))/(Vre0(LoadBus(d),LoadPhase(d),t)^2+Vim0(LoadBus(d),LoadPhase(d),t)^2)
						      + dIimdVre_Gen(d,t)*(Vre(LoadBus(d),LoadPhase(d),t)-Vre0(LoadBus(d),LoadPhase(d),t))
						      + dIimdVim_Gen(d,t)*(Vim(LoadBus(d),LoadPhase(d),t)-Vim0(LoadBus(d),LoadPhase(d),t))
				}
			}
		}
	}
	Section BatteryModel {
		Comment: "Battery energy-storage model, active in every case (NOT part of the network toggle set): charge/discharge/SOC variables, the P/Q current coupling (Pbat/Qbat), SOC limits, the cyclic-SOC band for the rolling horizon, and per-battery parameters from the database. Qinv is inverter reactive power, freed only at PeriodMaxP when IncludeQforMaxP=1. The complementarity binary BattOn exists only when UseBattComp=1 (Validation).";
		DeclarationSection BattVars {
			Variable Ire_Batt {
				IndexDomain: (bat,t);
				Range: free;
			}
			Variable Iim_Batt {
				IndexDomain: (bat,t);
				Range: free;
			}
			Variable BattP_Chg {
				IndexDomain: (bat,t);
				Range: nonnegative;
			}
			Variable BattP_Dis {
				IndexDomain: (bat,t);
				Range: nonnegative;
			}
			Variable BattP_Balance {
				IndexDomain: (bat,t);
				Range: free;
				Definition: BattP_Chg(bat,t)-BattP_Dis(bat,t);
			}
			Variable BattOn {
				IndexDomain: (bat,t) | UseBattComp;
				Range: binary;
				Comment: "Charge/discharge mode binary (1 = may charge, 0 = may discharge); exists only when UseBattComp=1. With ChgMode/DisMode it forbids charging and discharging in the same period (no non-physical simultaneous cycling).";
			}
			Constraint ChgMode {
				IndexDomain: (bat,t) | UseBattComp;
				Definition: BattP_Chg(bat,t) <= BattOn(bat,t)*BattMaxP(bat);
			}
			Constraint DisMode {
				IndexDomain: (bat,t) | UseBattComp;
				Definition: BattP_Dis(bat,t) <= (1-BattOn(bat,t))*BattMaxP(bat);
			}
			Variable BattSOC {
				IndexDomain: (bat,t);
				Range: nonnegative;
				Definition: BattSOCini(bat) + sum(tt|tt<=t,BattP_Chg(bat,tt)*etaChg(bat) - BattP_Dis(bat,tt)/etaDis(bat))*DeltaT/BattEcap(bat);
			}
			Variable Qinv {
				IndexDomain: (bat,t);
				Range: free;
			}
			Constraint OnlyDischatT {
				IndexDomain: bat;
				Definition: BattP_Balance(bat,PeriodMaxP) <= AllowChargeAtPmax*BattMaxP(bat);
			}
			Constraint MaxBattP_Chg_def {
				IndexDomain: (bat,t);
				Definition: BattP_Chg(bat,t)<=BattMaxP(bat);
			}
			Constraint MaxBattP_Dis_def {
				IndexDomain: (bat,t);
				Definition: BattP_Dis(bat,t)<=BattMaxP(bat);
				Comment: "Seen as injected (grid side)";
			}
			Constraint MinSOC_def {
				IndexDomain: (bat,t);
				Definition: BattSOC(bat,t)>=BattSOCmin(bat);
			}
			Constraint MaxSOC_def {
				IndexDomain: (bat,t);
				Definition: BattSOC(bat,t)<=BattSOCmax(bat);
			}
			Constraint Pbat {
				IndexDomain: (bat,t);
				Definition: BattP_Balance(bat,t)=Vre0(BattBus(bat),BattPhase(bat),t)*Ire_Batt(bat,t) + Vim0(BattBus(bat),BattPhase(bat),t)*Iim_Batt(bat,t);
			}
			Constraint Qbat {
				IndexDomain: (bat,t);
				Definition: Qinv(bat,t)=-Vre0(BattBus(bat),BattPhase(bat),t)*Iim_Batt(bat,t) + Vim0(BattBus(bat),BattPhase(bat),t)*Ire_Batt(bat,t);
			}
			Constraint CyclicSOC {
				IndexDomain: bat | RollCyclicSOC = 1 and CyclicSOCBand = 0;
				Definition: sum(t, BattP_Chg(bat,t)*etaChg(bat) - BattP_Dis(bat,t)/etaDis(bat)) = 0;
				Comment: {
					"Rolling horizon, strict equality: net battery energy over the wrapped day is zero, so SOC returns to its window start. Active when RollCyclicSOC=1 AND CyclicSOCBand=0 (default; identical to the original pre-band formulation, no LP-presolve regression). When CyclicSOCBand>0 this row is dropped and the CyclicSOC_ub/CyclicSOC_lb band pair takes over."
				}
			}
			Constraint CyclicSOC_ub {
				IndexDomain: bat | RollCyclicSOC = 1 and CyclicSOCBand > 0;
				Definition: sum(t, BattP_Chg(bat,t)*etaChg(bat) - BattP_Dis(bat,t)/etaDis(bat)) <= CyclicSOCBand * BattEcap(bat) / DeltaT;
				Comment: {
					"Rolling horizon, band upper bound. Active only when CyclicSOCBand>0 (diagnostic / future relaxed runs); pairs with CyclicSOC_lb. Together: |SOC_end - SOC_start| <= CyclicSOCBand."
				}
			}
			Constraint CyclicSOC_lb {
				IndexDomain: bat | RollCyclicSOC = 1 and CyclicSOCBand > 0;
				Definition: sum(t, BattP_Chg(bat,t)*etaChg(bat) - BattP_Dis(bat,t)/etaDis(bat)) >= -CyclicSOCBand * BattEcap(bat) / DeltaT;
				Comment: {
					"Rolling horizon, band lower bound. Active only when CyclicSOCBand>0; pairs with CyclicSOC_ub."
				}
			}
		}
		DeclarationSection BatteryParameters {
			ElementParameter BattBus {
				IndexDomain: bat;
				Range: Buses;
			}
			ElementParameter BattAgg {
				IndexDomain: bat;
				Range: Aggregators;
			}
			ElementParameter BattTr {
				IndexDomain: bat;
				Range: Trafos;
			}
			ElementParameter BattPhase {
				IndexDomain: bat;
				Range: Phases;
			}
			Parameter BattSOCini {
				IndexDomain: bat;
			}
			Parameter BattSOCmin {
				IndexDomain: bat;
			}
			Parameter BattSOCmax {
				IndexDomain: bat;
			}
			Parameter BattMaxP {
				IndexDomain: bat;
			}
			Parameter BattEcap {
				IndexDomain: bat;
			}
			Parameter etaChg {
				IndexDomain: bat;
			}
			Parameter etaDis {
				IndexDomain: bat;
			}
		}
		DeclarationSection Fairness {
			Comment: {
				"Stage 0 fairness: criterion C1, proportional to installed capacity, applied to the ACTIVE-POWER
				scalar at the service slot. FairMode picks the level, FairActive gates it to the directional
				sweep, FairCap is the capacity s_i. Declared here (BatteryModel) and NOT inside NetworkModel so
				it survives IncludeNetworkConstraints=0: fairness is an allocation rule, not a network law.
				With FairMode=0 both constraints have an empty IndexDomain -> zero rows, and Zeta is a free
				column with no coefficients that presolve removes. That is the mechanism by which case A must
				reproduce the pre-fairness baseline bit-identically."
			}
			Parameter FairMode {
				Default: 0;
				Comment: {
					"Fairness level. Mutually exclusive, NOT cumulative - level 2 does not imply level 1.
					0 = off (production, case A).
					1 = proportional between PROSUMERS:   x_i = Zeta*FairCap(i) for every battery.
					2 = proportional between AGGREGATORS: sum_{i in a} x_i = Zeta*sum_{i in a} FairCap(i),
					    with the split among an aggregator\'s own prosumers left free."
				}
			}
			Parameter FairActive {
				Default: 0;
				Comment: {
					"Runtime gate, set by RunFOR_Rolling: 0 around the committed self-consumption baseline,
					1 around the 12 directional solves.

					WHY THE GATE EXISTS. PeriodMaxP=2 in BOTH solves and MinImports uses the same constraint
					set (AllConstraints), so an ungated fairness row would also bind in the committed baseline,
					shift the slot-1 dispatch that is actually executed, and make the realised SOC trajectory of
					case B diverge from case A. The A/B difference would then mix \'fairness contracts the offered
					region\' (what the deliverable measures) with \'fairness moved the batteries somewhere else\',
					and per-period comparison would stop being legitimate because the starting SOCs no longer
					match. It would also violate the w2(PeriodMaxP)=0 design rule - the baseline must not
					pre-commit value at the service slot, because that exchange IS the flexibility being offered.

					Modelling reading: the committed baseline is a pure self-consumption agent (OFminImports has
					no w1 service term at all), i.e. a prosumer who prioritises self-consumption and provides
					what it happens to have available when service is called - not one who spends every half hour
					positioning for a market it might be asked to serve. See FairBaseline for the alternative."
				}
			}
			Parameter FairBaseline {
				Default: 0;
				Comment: {
					"EXPERIMENT toggle: 1 = impose fairness in the committed baseline solve as well (the
					\'prosumers anticipate a fair market\' variant). 0 = production.

					Read this before using it. The baseline objective OFminImports carries NO service term (w1
					appears only in OFminImportsmaxReverseP, which the rolling baseline does not use) and
					w2(PeriodMaxP)=0, so switching this on constrains an agent that derives no value whatsoever
					from market participation. Only slot 1 is carried forward (RollChgExec/RollDisExec/
					RollSOCnext all read BattP_Balance(bat,\'1\')), so the baseline\'s slot-2 decision is discarded
					and the effect on the executed dispatch is indirect, via the SOC coupling. Modelling genuine
					anticipation would additionally need a service-value term in the baseline objective and a
					model of WHICH direction the aggregator will call - both out of scope for Stage 0.

					Kept because the size of the divergence is worth measuring on the micro bed (~10 min per
					run), not because it is the modelled default."
				}
			}
			Parameter FairCap {
				IndexDomain: bat;
				Definition: BattMaxP(bat);
				Comment: {
					"s_i - the capacity each prosumer\'s contribution is made proportional to, in p.u. Deliberate
					indirection: the source of s_i changes in ONE line here, and every run should record which.

					WHY BattMaxP. It is the battery rating and simultaneously the inverter S-circle radius
					(MaxBattS_def / MaxBattS_poly), so \'kW of battery\' and \'kVA of inverter\' are the same number
					in this model. NOT PVsize: PV is a parameter driven by irradiance
					(GenP0 := PVsize*Irradiance/1000), not a decision variable and not curtailable, so rationing
					battery dispatch by PV size would allocate on an attribute that is not the resource shared.

					NOTE for the paper: this fleet is homogeneous (BattMaxP = 0.0036 p.u. = 3.6 kW on all 1216
					batteries), so here \'proportional to capacity\' coincides numerically with \'equal absolute\'.
					That does NOT make the constraint slack: the network is radial, so two prosumers with equal
					batteries at different feeder positions cannot inject equally without different voltage rise.
					Measured on the TR9 case-A run, dispatch spread across the 90 identical batteries averages
					46% of BattMaxP (peak 85%), and the fleet reaches only 33% of its nameplate aggregate. The
					heterogeneity that makes C1 bind is LOCATIONAL, not equipment."
				}
			}
			Variable Zeta {
				Range: free;
				Comment: {
					"The SINGLE free scalar of criterion C1 - the fleet utilisation factor, dimensionless.
					One Zeta per solve: each of the 12 directions gets its own, which is what makes C1 a
					one-pass criterion (max-min would instead need one Zeta* per time step, held fixed across
					the 12 angles).

					It removes exactly ONE degree of freedom. Deliberately NOT written as n-1 pairwise
					equalities, which would remove n-1 and overstate the cost of fairness by a factor near 2.
					With FairCap=BattMaxP the implied bound is |Zeta|<=1. Zeta=0 (everyone idle) is always
					feasible, so C1 contracts the FOR and can never render it infeasible."
				}
			}
			Constraint FairProportional_Prosumer {
				IndexDomain: bat | FairMode = 1 and (FairActive or FairBaseline);
				Definition: BattP_Balance(bat,PeriodMaxP) = Zeta*FairCap(bat);
				Comment: {
					"C1 at PROSUMER level: every prosumer runs at the same utilisation Zeta of its own capacity.
					Since BattP_Balance = BattP_Chg - BattP_Dis (>0 charge, <0 discharge), a single Zeta also
					forbids one battery charging while another discharges - it removes all internal arbitrage
					between prosumers. That is the strictest reading of the criterion and is precisely why C1
					delivers the UPPER bound on the cost of fairness. It is not hypothetical: in the case-A run
					the batteries do split signs (period 16: some charging at -0.99 kW while others discharge at
					+1.91 kW), so this row binds hard."
				}
			}
			Constraint FairProportional_Aggregator {
				IndexDomain: a | FairMode = 2 and (FairActive or FairBaseline);
				Definition: {
					sum(bat | BattAgg(bat) = a, BattP_Balance(bat,PeriodMaxP))
					= Zeta*sum(bat | BattAgg(bat) = a, FairCap(bat))
				}
				Comment: {
					"C1 at AGGREGATOR level: each aggregator\'s total tracks the same utilisation Zeta of its own
					installed capacity, while the split among its prosumers stays free. Uses BattAgg, the
					database column, as the single source of truth for the aggregator index (the synthetic
					DOE_AggOf mapping stays confined to the frozen DOE_Dispatch section).

					An aggregator left with no batteries after ApplyNetworkReduction yields 0 = Zeta*0, which is
					trivially satisfied - there is no division here, so no epsilon guard is needed."
				}
			}
		}
	}
	Section SelfConsumptionOPF {
		Comment: "The self-consumption OPF: node import/export decomposition at battery nodes, the two cost-min objectives (OFminImports = pure self-consumption, used by the rolling baseline; OFminImportsmaxReverseP = paper objective with the w1 max-reverse-flow term at PeriodMaxP), their mathematical programs and solve wrappers, and the paper case runners.";
		DeclarationSection ObjectFunction {
			MathematicalProgram MinImportsMaxReverseP {
				Objective: OFminImportsmaxReverseP;
				Direction: minimize;
				Constraints: NotTobeExcluded_constraints;
				Variables: NotTobeExcluded_variables;
				Type: Automatic;
				Comment: {
					"Use this to be more generic (may take more time)
					Constraints: NotTobeExcluded_constraints
					Variables: NotTobeExcluded_variables"
				}
			}
			MathematicalProgram MinImports {
				Objective: OFminImports;
				Direction: minimize;
				Constraints: NotTobeExcluded_constraints;
				Variables: NotTobeExcluded_variables;
				Type: Automatic;
				Comment: {
					"Use this to be more generic (may take more time)
					Constraints: NotTobeExcluded_constraints
					Variables: NotTobeExcluded_variables"
				}
			}
			Variable TotPcust {
				IndexDomain: (n,f,t);
				Range: free;
				Definition: {
					sum(d|LoadBus(d)=n and LoadPhase(d)=f,P0minGenP(d,t))
					+ sum(bat|BattBus(bat)=n and BattPhase(bat)=f,BattP_Balance(bat,t))

				}
			}
			Variable ImportedPnode {
				IndexDomain: (n,f,t);
				Range: nonnegative;
			}
			Constraint TotPbalance {
				IndexDomain: (n,f,t);
				Definition: TotPcust(n,f,t) = ImportedPnode(n,f,t) - ExportedPnode(n,f,t);
			}
			Parameter ChgDis {
				IndexDomain: (bat,t);
			}
			Variable OFminImportsmaxReverseP {
				Range: free;
				Definition: {
					w1*sum(bat,TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP))
					+ sum((bat,t)|t<>PeriodMaxP,w2(t)*(ImportedPnode(BattBus(bat),BattPhase(bat),t)+ExportedPnode(BattBus(bat),BattPhase(bat),t)))
					+ BattThroughputPen*sum((bat,t),BattP_Chg(bat,t)+BattP_Dis(bat,t))
				}
			}
			Variable OFminImports {
				Range: free;
				Definition: {
					sum((bat,t),w2(t)*(ImportedPnode(BattBus(bat),BattPhase(bat),t)+ExportedPnode(BattBus(bat),BattPhase(bat),t)))
					+ BattThroughputPen*sum((bat,t),BattP_Chg(bat,t)+BattP_Dis(bat,t))
				}
			}
			Variable ExportedPnode {
				IndexDomain: (n,f,t);
				Range: nonnegative;
			}
			Parameter CostImport {
				IndexDomain: t;
			}
			Parameter PayExport {
				IndexDomain: t;
			}
			Parameter AllCustWithBatPtot {
				IndexDomain: t;
			}
			Parameter AllCustWithBatPtot_AggTr {
				IndexDomain: (tr,t);
			}
			Parameter VmagExPost {
				IndexDomain: (n,f,t);
			}
			Parameter VmagExPost_PeriodMaxP {
				IndexDomain: (n,f);
			}
			Parameter LineUsage_PeriodMaxP {
				IndexDomain: (l,f);
			}
			Parameter TrafoUsage_PeriodMaxP {
				IndexDomain: (tr,f);
			}
		}
		DeclarationSection Convergence {
			StringParameter ConvFlag;
			Parameter ConvTime;
		}
		Procedure MinOFminImportsmaxReverseP {
			Body: {
				!CapStage(c|Is_FixedStage(c)=1):=FixedStage(c);
				!CapStage(c|Is_FixedStage(c)=1).nonvar:=1;

				!TapPosUnits(tr|Is_OLTC(tr)=0):=FixedTapPos(tr);
				!TapPosUnits(tr|Is_OLTC(tr)=0).nonvar:=1;

				!MinLineP.CallbackAOA := 'OuterApprox::BasicAlgorithm';

				option Bound_Tolerance:=1e-006;
				solve MinImportsMaxReverseP where MIP_Relative_Optimality_Tolerance := 0.01, time_limit := 3000;

				ConvFlag:=MinImportsMaxReverseP.ProgramStatus;

				ConvTime:=MinImportsMaxReverseP.SolutionTime;

				!VmagExPost(n,f,t):=sqrt(Vre(n,f,t)^2+Vim(n,f,t)^2);
			}
		}
		Procedure MinOFminImports {
			Body: {
				!CapStage(c|Is_FixedStage(c)=1):=FixedStage(c);
				!CapStage(c|Is_FixedStage(c)=1).nonvar:=1;

				!TapPosUnits(tr|Is_OLTC(tr)=0):=FixedTapPos(tr);
				!TapPosUnits(tr|Is_OLTC(tr)=0).nonvar:=1;

				!MinLineP.CallbackAOA := 'OuterApprox::BasicAlgorithm';

				option Bound_Tolerance:=1e-006;
				solve MinImports where MIP_Relative_Optimality_Tolerance := 0.01, method := 'deterministic concurrent', time_limit := 3000;

				ConvFlag:=MinImports.ProgramStatus;

				ConvTime:=MinImports.SolutionTime;

				!VmagExPost(n,f,t):=sqrt(Vre(n,f,t)^2+Vim(n,f,t)^2);
			}
		}
		Procedure ComputeMetrics {
			Body: {
				VmagExPost(n,f,t):=sqrt(Vre(n,f,t)^2+Vim(n,f,t)^2);
				VmagExPost_PeriodMaxP(n,f):=VmagExPost(n,f,PeriodMaxP);

				LineUsage_PeriodMaxP(l,f):=sqrt(Ire_Line(l,f,PeriodMaxP)^2+Iim_Line(l,f,PeriodMaxP)^2)*100/MaxCurrent(l);
				TrafoUsage_PeriodMaxP(tr,f):=sqrt(Ire_Trafo(tr,f,StartBusTr(tr),PeriodMaxP)^2+Iim_Trafo(tr,f,StartBusTr(tr),PeriodMaxP)^2)*100/MaxAmps(tr);


				ChgDis(bat,t):=BattP_Chg(bat,t)*BattP_Dis(bat,t);

				AllCustWithBatPtot(t):=sum(bat,TotPcust(BattBus(bat),BattPhase(bat),t));


				!AllCustWithBatPtot_AggTr(a,tr,t):=sum(bat|BattAgg(bat)=a and BattTr(bat)=tr ,TotPcust(BattBus(bat),BattPhase(bat),t));
			}
		}
		Procedure MainExecution {
			Body: {
				run MinOFminImportsmaxReverseP;
			}
		}
		Procedure MainInitialization;
		Procedure RunOneCase {
			Body: {
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries; !,Generators
				showprogresswindow;
				option disable_new_mathprog_generator:=1;

				!settings
				IncludeNetworkConstraints:=0; !flag to include network constraints
				IncludeQforMaxP:=0;	!flag to indicate if using Q-capabilities

				nPeriods:=48;
				!nPeriods:=1;

				PeriodMaxP := 25;

				!!!!!!!!!!!

				if IncludeNetworkConstraints=1 then
					if IncludeQforMaxP=0 then
						ResultsFileRoot:="NC_noQ_";
					else
						ResultsFileRoot:="NC_Q_";
					endif;
				else
					ResultsFileRoot:="noNC_";
				endif;



				empty allvariables;

				run Load_data_dsn;

				run MainExecution;

				!run ComputeMetrics;

				!run WriteResultstoExcel;
			}
		}
		Procedure RunAllCases {
			Body: {
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries; !,Generators

				!settings
				IncludeNetworkConstraints:=0; !flag to include network constraints


				IncludeQforMaxP:=0;	!flag to indicate if using Q-capabilities

					ResultsFileRoot:="noNC_";

					nPeriods:=48;

					PeriodMaxP := 1;
					while (PeriodMaxP <= 48) do
						empty allvariables;

						run Load_data_dsn;

						run MainExecution;

						run ComputeMetrics;

						run WriteResultstoExcel;

						PeriodMaxP:=PeriodMaxP+1;
					endwhile;


				!settings
				IncludeNetworkConstraints:=1; !flag to include network constraints

				IncludeQforMaxP:=0;	!flag to indicate if using Q-capabilities

				while IncludeQforMaxP<=1 do

					if IncludeNetworkConstraints=1 then
						if IncludeQforMaxP=0 then
							ResultsFileRoot:="NC_noQ_";
						else
							ResultsFileRoot:="NC_Q_";
						endif;
					else
						ResultsFileRoot:="noNC_";
					endif;

					nPeriods:=48;

					PeriodMaxP := 1;
					while (PeriodMaxP <= 48) do
						empty allvariables;

						run Load_data_dsn;

						run MainExecution;

						run ComputeMetrics;

						run WriteResultstoExcel;

						PeriodMaxP:=PeriodMaxP+1;
					endwhile;
					IncludeQforMaxP:=IncludeQforMaxP+1;
				endwhile;
			}
		}
		Procedure RunBAU {
			Body: {
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries; !,Generators

				!settings
				IncludeNetworkConstraints:=0; !flag to include network constraints
				IncludeQforMaxP:=0;	!flag to indicate if using Q-capabilities
				PeriodMaxP:=0; !out of range
				!!!!!!!!!!!

				if IncludeNetworkConstraints=1 then
					ResultsFileRoot:="NC_BAU";
				else
					ResultsFileRoot:="noNC_BAU";
				endif;

				nPeriods:=48;

				empty allvariables;

				run Load_data_dsn;

				run MinOFminImports;

				run ComputeMetrics;

				run WriteResultstoExcel;
			}
		}
	}
	Section FOR_Computation {
		Comment: "The FOR at the PCC: P_PCC/Q_PCC (grid->feeder positive), the directional objective OF_FOR = -(cos.P + sin.Q) minimized once per sweep angle, the homotopy/tiebreaker variant OF_FOR_cont, the 12-angle sweep set, and the per-vertex result containers incl. the ex-post accuracy columns (VminTrue/VmaxTrue/UVviol/OVviol/LinErr).";
		DeclarationSection PCC_Power {
			Comment: "PCC power being mapped: fixed slack voltage (Vre_PCC/Vim_PCC mirror SlackVre/SlackVim) and the resulting active/reactive power P_PCC/Q_PCC at the slack bus (grid->feeder positive). These are the (P,Q) coordinates of the FOR.";
			Parameter Vre_PCC {
				IndexDomain: f;
				Definition: {
					if f=1 then 1
					else -0.5
					endif
				}
				Comment: "Real part of fixed slack-bus voltage (balanced 3-phase, p.u.). Mirrors SlackVre.";
			}
			Parameter Vim_PCC {
				IndexDomain: f;
				Definition: {
					if f=1 then 0
					elseif f=2 then -0.866025404
					else 0.866025404
					endif
				}
				Comment: "Imag part of fixed slack-bus voltage (balanced 3-phase, p.u.). Mirrors SlackVim.";
			}
			Variable P_PCC {
				IndexDomain: t;
				Range: free;
				Definition: {
					sum(sg, Vre_PCC(SlackGenPhase(sg)) * Ire_SlackGen(sg,t)
					      + Vim_PCC(SlackGenPhase(sg)) * Iim_SlackGen(sg,t))
				}
				Comment: "Active power at PCC (p.u.). Grid->feeder positive.";
			}
			Variable Q_PCC {
				IndexDomain: t;
				Range: free;
				Definition: {
					sum(sg, Vim_PCC(SlackGenPhase(sg)) * Ire_SlackGen(sg,t)
					      - Vre_PCC(SlackGenPhase(sg)) * Iim_SlackGen(sg,t))
				}
				Comment: "Reactive power at PCC (p.u.). Grid->feeder positive.";
			}
		}
		DeclarationSection ScanObjective {
			Comment: {
				"Directional FOR objective. FOR_Angle/FOR_AngleRad set the scan direction; OF_FOR = -(cos.P + sin.Q) so minimizing it pushes the PCC point outward along the angle. OF_FOR_cont adds the cost-min homotopy (FOR_Lambda) and tiebreaker (FOR_TieEps); FOR_nSteps/FOR_DampAlpha tune the rescue continuation."
			}
			Parameter FOR_Angle {
				Comment: "Sweep direction in DEGREES. 0=maxP, 90=maxQ, 180=minP, 270=minQ.";
			}
			Parameter FOR_AngleRad {
				Comment: "FOR_Angle converted to radians (set in the procedure before each solve).";
			}
			Variable OF_FOR {
				Range: free;
				Definition: {
					-( cos(FOR_AngleRad)*P_PCC(PeriodMaxP)
					+ sin(FOR_AngleRad)*Q_PCC(PeriodMaxP) )
				}
				Comment: {
					"Directional FOR objective: minimizing -(cos.P + sin.Q) maximizes the
					projection of (P_PCC,Q_PCC) onto direction FOR_Angle. Rotating FOR_Angle
					0..360 traces the FOR boundary (radial/directional scan)."
				}
			}
			Variable OF_FOR_cont {
				Range: free;
				Definition: (1-FOR_Lambda)*OFminImportsmaxReverseP + FOR_Lambda*OF_FOR + FOR_TieEps*OFminImportsmaxReverseP;
				Comment: {
					"Homotopy objective + cost-min tiebreaker. (1-FOR_Lambda).cost-min + FOR_Lambda.OF_FOR is the original homotopy (FOR_Lambda=1 -> pure direction). FOR_TieEps.OFminImportsmaxReverseP is an additional small weight on the cost-min objective; with FOR_TieEps=0 (default) behaviour is identical to before, with FOR_TieEps small positive (~1e-5) the period-25 vertex stays optimal for the FOR direction but off-period dispatch is pulled to the cost-min solution as a tiebreaker."
				}
			}
			Parameter FOR_Lambda {
				Comment: "Continuation parameter. 0 = pure cost-min objective, 1 = pure FOR direction.";
			}
			Parameter FOR_TieEps {
				Comment: {
					"Cost-min tiebreaker weight added to OF_FOR_cont. 0 = original behaviour (off-period dispatch is a degenerate optimum and may look arbitrary in vertex .xls files). Small positive value (~1e-5) keeps the period-25 vertex optimal for the FOR direction but pulls off-period dispatch to the base cost-min solution as a tiebreaker, so AllCustWithBatPtot at periods != PeriodMaxP becomes physically meaningful. Used by RunFOR_4Vertices."
				}
			}
			Parameter FOR_nSteps {
				Comment: "Number of continuation steps to walk from cost-min to a FOR direction.";
			}
			Parameter FOR_DampAlpha {
				Comment: "Re-linearization damping: fraction Vre0/Vim0 moves toward the latest solution each step (0..1).";
			}
		}
		DeclarationSection FOR_Programs {
			MathematicalProgram FOR_Vertex {
				Objective: OF_FOR;
				Direction: minimize;
				Constraints: NotTobeExcluded_constraints;
				Variables: NotTobeExcluded_variables;
				Type: Automatic;
				Comment: "Solves for one vertex of the FOR at the PCC. Set FOR_Angle/FOR_AngleRad before each solve.";
			}
			MathematicalProgram FOR_VertexCont {
				Objective: OF_FOR_cont;
				Direction: minimize;
				Constraints: NotTobeExcluded_constraints;
				Variables: NotTobeExcluded_variables;
				Type: Automatic;
				Comment: {
					"Continuation version. FOR_Lambda=1 is identical to FOR_Vertex; FOR_Lambda<1 blends in cost-min."
				}
			}
		}
		DeclarationSection AngleSweep {
			Comment: {
				"Angular sweep bookkeeping: FOR_Axes (P,Q); FOR_nAngles with FOR_AngleSet/FOR_AngleDeg enumerate the scan directions."
			}
			Set FOR_Axes {
				Index: ax;
				Definition: data { P, Q };
				Comment: "Axes of the FOR plane (P and Q).";
			}
			Parameter FOR_nAngles {
				Comment: "Number of directions in the boundary sweep (set in the procedure).";
			}
			Set FOR_AngleSet {
				SubsetOf: Integers;
				Index: ia;
				Property: ElementsAreNumerical;
				Definition: ElementRange(1, FOR_nAngles);
				Comment: "Index set for the angular sweep, 1..FOR_nAngles.";
			}
			Parameter FOR_AngleDeg {
				IndexDomain: ia;
				Definition: (ord(ia)-1) * 360 / FOR_nAngles;
				Comment: "Direction of sweep point ia, in degrees (0,30,60,...).";
			}
		}
		DeclarationSection LastSolveScalars {
			Comment: "Generic single-solve working scalars reused by several procedures to hold the latest solve P/Q/Vmax/LinErr/status (RunFOR_Rolling and the audit procedures).";
			Parameter FOR_Pcur {
				Comment: "Working: P_PCC of the latest probe pass (for the diag_dir190 trace).";
			}
			Parameter FOR_Qcur {
				Comment: "Working: Q_PCC of the latest probe pass (for the diag_dir190 trace).";
			}
			Parameter FOR_VmaxCur {
				Comment: "Working: true max |V| of the latest probe pass (for the diag_dir190 trace).";
			}
			Parameter FOR_LinCur {
				Comment: "Working: max linearization error of the latest probe pass (for the diag_dir190 trace).";
			}
			StringParameter FOR_StatCur {
				Comment: "Working: solver status string of the latest probe solve (for the diag_dir190 trace).";
			}
		}
		DeclarationSection BoundaryResults {
			Comment: "RunFOR_4Vertices outputs: boundary point FOR_Boundary(ia,P/Q) per direction, solver status/time/projection, Tier-2 AC checks (true Vmin/Vmax, under/overvoltage, linearization error), the CustPtot/Ploss reconciliation, FixUsed, the FOR_boundary.csv file, and the validation-export switches.";
			Parameter FOR_Boundary {
				IndexDomain: (ia, ax);
				Comment: "Boundary point (P,Q) at the PCC for each sweep direction (per-unit).";
			}
			StringParameter FOR_BndStatus {
				IndexDomain: ia;
				Comment: "Solver status string for each sweep direction.";
			}
			Parameter FOR_BndTime {
				IndexDomain: ia;
				Comment: "Wall-clock solve time per sweep direction (seconds).";
			}
			Parameter FOR_BndProj {
				IndexDomain: ia;
				Comment: "Optimal projection cos(th).P+sin(th).Q. Outer-approx line: cos.P+sin.Q <= FOR_BndProj.";
			}
			Parameter FOR_VminTrue {
				IndexDomain: ia;
				Comment: "Tier-2 check: minimum TRUE |V|=sqrt(Vre^2+Vim^2) over all buses at this vertex (p.u.).";
			}
			Parameter FOR_VmaxTrue {
				IndexDomain: ia;
				Comment: "Tier-2 check: maximum TRUE |V| over all buses at this vertex (p.u.).";
			}
			Parameter FOR_UndervoltViol {
				IndexDomain: ia;
				Comment: "Tier-2 check: worst undervoltage MinV(n)-|V| over all buses (p.u.). 0 = no true voltage violation (point physically valid).";
			}
			Parameter FOR_OvervoltViol {
				IndexDomain: ia;
				Comment: "Tier-2 check: worst overvoltage |V|-MaxV(n) (p.u.). Should be ~0 since Vmax is an exact constraint.";
			}
			Parameter FOR_LinErrMax {
				IndexDomain: ia;
				Comment: "Tier-2 check: max |Vmag2approx - (Vre^2+Vim^2)| over all buses. Small = linearization trustworthy at this vertex.";
			}
			Parameter FOR_CustPtot {
				IndexDomain: ia;
				Comment: "Customer-side total P = AllCustWithBatPtot(PeriodMaxP). Directly comparable to the article NC_Q xls (measured at customer terminals, NOT the PCC).";
			}
			Parameter FOR_Ploss {
				IndexDomain: ia;
				Comment: "Feeder losses at this vertex = P_PCC - FOR_CustPtot. Identity: P_PCC = customer total + network losses.";
			}
			StringParameter FOR_FixUsed {
				IndexDomain: ia;
				Comment: "Which attempt produced this point: direct / numeric / reseed / FAILED. Lets you see what fixed each direction.";
			}
			File FOR_CSV {
				Name: "FOR_boundary.csv";
			}
			File FOR_CSV_Exact {
				Name: "FOR_boundary_TR9_exact.csv";
			}
			File FOR_CSV_Lin {
				Name: "FOR_boundary_TR9_lin.csv";
			}
			Parameter FOR_WriteVertexXls {
				Comment: "Validation export switch. 1 = also write one full NC_Q_25-format workbook per FOR vertex (FOR_v<k>_25.xls, heavy: ~37 files). 0 = write only the FOR_ref_25.xls reference (fast). The reference is always written.";
			}
			Parameter FOR_RefSave_ACAP {
				Comment: "Save slot: AllowChargeAtPmax is forced to 0 (article) for the reference solve, then restored from this. Internal to the FOR_ref export.";
			}
			Parameter FOR_RefSave_PolS {
				Comment: "Save slot: FOR_PolyS is forced to 0 (exact S-circle) for the reference solve, then restored from this.";
			}
			Parameter FOR_RefSave_LVmx {
				Comment: "Save slot: FOR_LinearizeVmax is forced to 0 (exact Vmax) for the reference solve, then restored from this.";
			}
		}
	}
	Section NetworkReduction {
		Comment: "Per-transformer decomposition: keep one transformer in full detail, lump the LV demand of every other transformer as per-phase MV loads (their batteries dropped - passive), then shrink the network sets. Approximation: lumped transformer impedance/losses ignored. Called from Load_data_dsn when ReduceNetwork=1.";
		DeclarationSection ReductionControls {
			Parameter ReduceNetwork {
				Comment: {
					"Master switch: 1 = apply the reduction in Load_data_dsn; 0 = full feeder (default, existing behaviour)."
				}
			}
			StringParameter DetailTagCSV {
				Comment: {
					"Comma-separated transformer tags to keep in FULL detail, e.g. TR9 or TR8,TR9. Empty (or naming all 9) = no reduction; the others are lumped as MV loads. A plain string, so it survives the empty/reload of Trafos in the case runners."
				}
			}
			StringParameter DetailLoadPattern {
				Comment: "Optional sub-cluster filter (micro-test): when non-empty, narrows the kept LV buses inside DetailedTrafos to those whose bus label contains this substring (e.g. \'_two\' selects only the TR9_two* sub-branch). Empty (default) keeps the full LV side of every DetailedTrafo. Use to isolate a small, hand-checkable cluster for understanding the model.";
			}
		}
		DeclarationSection ReductionWorking {
			Set DetailedTrafos {
				SubsetOf: Trafos;
				Comment: {
					"Working: transformers kept in full detail; rebuilt from DetailTagCSV in ApplyNetworkReduction each call."
				}
			}
			Set ExcludedTrafos {
				SubsetOf: Trafos;
				Comment: "Working: Trafos - DetailedTrafos (the lumped ones).";
			}
			StringParameter BusLabel {
				IndexDomain: n;
				Comment: "Element label of each bus (e.g. \'TR9_one223\', \'MV_40\'), used for prefix matching.";
			}
			StringParameter TrLabel {
				IndexDomain: tr;
				Comment: "Element label of each transformer (e.g. \'Trafo_TR9\').";
			}
			StringParameter TrTag {
				IndexDomain: tr;
				Comment: {
					"Transformer tag without the \'Trafo_\' prefix (e.g. \'TR9\'); matches the LV bus name prefix."
				}
			}
			ElementParameter BusTr {
				IndexDomain: n;
				Range: Trafos;
				Comment: {
					"Transformer owning each LV bus (by name prefix); empty for MV/TX buses."
				}
			}
			Set MVBuses {
				SubsetOf: Buses;
				Comment: "Buses whose label starts with \'MV_\' (the MV feeder, always kept).";
			}
			Set KeepBuses {
				SubsetOf: Buses;
			}
			Set KeepLines {
				SubsetOf: Lines;
			}
			Set KeepLoads {
				SubsetOf: LoadsAndPV;
			}
			Set KeepBatts {
				SubsetOf: Batteries;
			}
			ElementParameter AggElem {
				Range: LoadsAndPV;
				Comment: "Working handle for each lumped MV load element being created.";
			}
			Parameter AggP0 {
				IndexDomain: (tr,f,t);
				Comment: "Aggregated active load of a lumped transformer, per phase and period.";
			}
			Parameter AggQ0 {
				IndexDomain: (tr,f,t);
			}
			Parameter AggGen {
				IndexDomain: (tr,f,t);
			}
		}
		Procedure ApplyNetworkReduction {
			Body: {
				! labels + tags (e.g. 'Trafo_TR9' -> 'TR9'), then build the detailed set from the CSV tag list
				BusLabel(n) := FormatString("%e", n);
				TrLabel(tr) := FormatString("%e", tr);
				TrTag(tr)   := SubString(TrLabel(tr), 7, StringLength(TrLabel(tr)));
				DetailedTrafos := {tr | FindString("," + DetailTagCSV + ",", "," + TrTag(tr) + ",") > 0};

				! only act on a genuine partial selection; empty or all = leave the feeder alone
				if card(DetailedTrafos) > 0 and card(DetailedTrafos) < card(Trafos) then

					! --- map every LV bus to its transformer via the name prefix ('TR9_' etc.) ---
					empty BusTr;
					for (tr) do
						BusTr(n | SubString(BusLabel(n), 1, StringLength(TrTag(tr))+1) = TrTag(tr) + "_") := tr;
					endfor;

					ExcludedTrafos := Trafos - DetailedTrafos;

					! --- lump each excluded transformer's LV demand as a per-phase load on its MV bus ---
					for (tr | ExcludedTrafos(tr)) do
						for (f) do
							AggP0(tr,f,t)  := sum(d | BusTr(LoadBus(d)) = tr and LoadPhase(d) = f, P0(d,t));
							AggQ0(tr,f,t)  := sum(d | BusTr(LoadBus(d)) = tr and LoadPhase(d) = f, Q0(d,t));
							AggGen(tr,f,t) := sum(d | BusTr(LoadBus(d)) = tr and LoadPhase(d) = f, GenP0(d,t));
							SetElementAdd(LoadsAndPV, AggElem, "AGG_" + TrLabel(tr) + "_p" + FormatString("%e", f));
							LoadBus(AggElem)   := StartBusTr(tr);
							LoadPhase(AggElem) := f;
							PVsize(AggElem)    := 0;
							P0(AggElem,t)      := AggP0(tr,f,t);
							Q0(AggElem,t)      := AggQ0(tr,f,t);
							GenP0(AggElem,t)   := AggGen(tr,f,t);
						endfor;
					endfor;

					! --- snapshot what to keep, then shrink the network sets ---
					MVBuses   := {n | SubString(BusLabel(n),1,3) = "MV_"};
					KeepBuses := MVBuses + {n | DetailedTrafos(BusTr(n))}
					                     + {n | exists(tr | DetailedTrafos(tr) and EndBusTr(tr) = n)};

					! optional sub-cluster filter (micro-test): keep only LV buses whose label contains DetailLoadPattern
					if StringLength(DetailLoadPattern) > 0 then
						KeepBuses := MVBuses
						           + {n | exists(tr | DetailedTrafos(tr) and EndBusTr(tr) = n)}
						           + {n | DetailedTrafos(BusTr(n)) and FindString(BusLabel(n), DetailLoadPattern) > 0};
					endif;

					KeepLines := {l | KeepBuses(StartBus(l)) and KeepBuses(EndBus(l))};
					KeepLoads := {d | KeepBuses(LoadBus(d))};
					KeepBatts := {bat | KeepBuses(BattBus(bat))};

					Buses      := KeepBuses;
					Lines      := KeepLines;
					Trafos     := DetailedTrafos;
					LoadsAndPV := KeepLoads;
					Batteries  := KeepBatts;

				endif;
			}
			Comment: {
				"Keeps DetailedTrafos in full detail; lumps each other transformer\'s LV demand (per phase) as a load on its MV bus (StartBusTr); then shrinks the network sets. Called from Load_data_dsn when ReduceNetwork=1. Approximations: transformer impedance/losses of the lumped transformers are ignored, and their batteries (flexibility) are dropped."
			}
		}
	}
	Section RollingHorizonFOR {
		Comment: "PRODUCTION: the MPC-style daily rolling FOR. Each half-hour the 48-point day is rotated so now = slot 1; the committed self-consumption baseline is solved (MinImports), slot-1 dispatch is executed to advance the realised SOC, then 12 directions are swept for the service slot (slot 2) with the slot-1 battery dispatch fixed. RunTR1..RunTR9 are the per-transformer entry points.";
		DeclarationSection RollingHorizon {
			Comment: {
				"RunFOR_Rolling: MPC-style daily rolling FOR. Each half-hour \'now\' the day is rotated so \'now\' is slot 1, the battery starts from its realised SOC (BattSOCstart), a cyclic self-consumption day is solved (MinImports), the slot-1 dispatch is executed to advance the SOC (and stored in RollChgExec/RollDisExec), and the direction sweep maps the flexibility region for slot 2 (= now+1) with slot 1 fixed to that committed dispatch; results go to FOR_rolling.csv."
			}
			Parameter RollNow {
				Comment: "Current decision step / \'now\' period (1..nPeriods). Window slot 1 maps to this real period.";
			}
			Parameter RollCyclicSOC {
				Comment: "Toggle: 1 = force net-zero battery energy over the wrapped 48-slot day (drives CyclicSOC in BatteryModel). 0 = inactive, so existing runs are unaffected.";
			}
			Parameter P0raw {
				IndexDomain: (d,t);
				Comment: {
					"Un-rotated load/PV inputs captured once after Load_data_dsn; working P0/Q0/GenP0/Irradiance are rebuilt from these each step via the wrap map."
				}
			}
			Parameter Q0raw {
				IndexDomain: (d,t);
			}
			Parameter GenP0raw {
				IndexDomain: (d,t);
			}
			Parameter Irrraw {
				IndexDomain: t;
			}
			Parameter BattSOCstart {
				IndexDomain: bat;
				Comment: {
					"Realised SOC carried forward between steps; seeds BattSOCini for the current window."
				}
			}
			Parameter RollSOCtraj {
				IndexDomain: (bat,t);
				Comment: "Diagnostic: realised SOC at the start of each real period over the 48-step roll (used to check daily drift).";
			}
			Parameter RollDispatchExec {
				IndexDomain: (bat,t);
				Comment: "Diagnostic: executed (slot-1) net battery power at each real period.";
			}
			ElementParameter RollMap {
				IndexDomain: tt;
				Range: Time;
				Comment: "Wrap map for the current step: working slot tt -> real period Element(Time, mod(ord(tt)-1+RollNow-1, nPeriods)+1). Slot 1 = now, earlier periods wrap to the tail.";
			}
			Parameter RollSOCnext {
				IndexDomain: bat;
				Comment: {
					"Holds the SOC after executing the slot-1 dispatch; applied to BattSOCstart at the end of the step so the direction sweep keeps the window-start SOC."
				}
			}
			Parameter RollChgExec {
				IndexDomain: bat;
				Comment: "Committed slot-1 charge from the self-consumption baseline solve. The direction sweep fixes BattP_Chg(bat,\'1\') to this so every boundary point offered for slot 2 is reachable from the dispatch actually executed during \'now\'.";
			}
			Parameter RollDisExec {
				IndexDomain: bat;
				Comment: {
					"Committed slot-1 discharge; pairs with RollChgExec."
				}
			}
			StringParameter RollFileSuffix {
				Comment: "Appended to FOR_rolling / FOR_rolling_soc filenames so per-transformer runs write distinct files (e.g. \'_TR9\' -> FOR_rolling_TR9.csv). Empty (default) keeps the original filenames, so single-feeder runs are unchanged.";
			}
			StringParameter FairFileTag {
				Comment: {
					"Appended AFTER RollFileSuffix so the case tag and the transformer tag compose:
					RollFileSuffix=\'_TR9\' + FairFileTag=\'_fairL2\' -> FOR_rolling_TR9_fairL2.csv. Kept as a
					SEPARATE string on purpose: RunTrafoFOR overwrites RollFileSuffix with \'_\'+TrafoTag on
					every call, so a fairness wrapper that set RollFileSuffix itself would lose its tag the
					moment it called RunTR9. Empty (default) reproduces the original filenames exactly."
				}
			}
			StringParameter FOR_RollCSVName {
				Definition: "FOR_rolling" + RollFileSuffix + FairFileTag + ".csv";
			}
			StringParameter FOR_RollSOCCSVName {
				Definition: "FOR_rolling_soc" + RollFileSuffix + FairFileTag + ".csv";
			}
			StringParameter FOR_RollFairCSVName {
				Definition: "FOR_rolling_fair" + RollFileSuffix + FairFileTag + ".csv";
			}
			File FOR_RollCSV {
				Name: FOR_RollCSVName;
			}
			File FOR_RollSOCCSV {
				Name: FOR_RollSOCCSVName;
			}
			File FOR_RollFairCSV {
				Name: FOR_RollFairCSVName;
				Comment: {
					"Stage 0 fairness log, written by RunFOR_Rolling: one row per (period, direction,
					aggregator). A THIRD file on purpose - the schemas of FOR_rolling.csv and
					FOR_rolling_soc.csv must not change, because compare_FOR_runs.py and build_workbook.py
					parse them and the case-A no-regression test compares them byte-for-byte against the
					pre-fairness baseline. Written for every FairMode including 0, so case A supplies the
					reference split against which the contraction and dispersion metrics are computed."
				}
			}
			File FOR_RollBaseCSV {
				Name: "FOR_rolling_baseline.csv";
			}
			Parameter PerTrafoN {
				Comment: "Number of transformers captured at full-feeder load by RunFOR_Rolling_PerTrafo (drives PerTrafoIdx).";
			}
			Set PerTrafoIdx {
				SubsetOf: Integers;
				Index: pti;
				Definition: ElementRange(1, PerTrafoN);
				Comment: {
					"Stable integer index over the captured transformer list; immune to the Trafos set being shrunk inside RunFOR_Rolling."
				}
			}
			StringParameter PerTrafoTag {
				IndexDomain: pti;
				Comment: "Captured transformer tag (e.g. \'TR9\') for each PerTrafoIdx slot, snapshot before any network reduction.";
			}
			Parameter CyclicSOCBand {
				Comment: {
					"Cyclic-SOC tolerance dSOC (fraction of capacity). 0 = strict equality (default, original behavior; activates CyclicSOC). >0 = |SOC_end - SOC_start| <= dSOC (e.g. 0.05 = 5% of capacity; activates CyclicSOC_ub + CyclicSOC_lb)."
				}
			}
			Parameter RelaxCyclicBand {
				Default: 0.05;
				Comment: "EXPERIMENT toggle: the value RunFOR_Rolling assigns to CyclicSOCBand. Default 0.05 = production (unchanged). Set to 1.0 (via RunTR9_RelaxCyclic) to make the cyclic band non-binding so batteries may end the day discharged; the SOC floor (MinSOC_def) and Emax stay enforced.";
			}
			Parameter BaselineOnly {
				Default: 0;
				Comment: "EXPERIMENT toggle: 1 = RunFOR_Rolling skips the 12-direction FOR sweep and writes only the committed self-consumption dispatch (the soc CSV), ~48 solves. 0 = production (full sweep).";
			}
			Parameter SOCFloorOverride {
				Default: -1;
				Comment: "EXPERIMENT toggle: >=0 overrides every battery's BattSOCmin (the MinSOC_def floor) with this value AFTER each Load_data_dsn reset inside RunFOR_Rolling, e.g. 0.0 = allow full discharge. -1 (default) = off, DB floor untouched (production).";
			}
			Parameter FOR_SweepWarmStart {
				Default: 0;
				Comment: {
					"PERFORMANCE toggle for the direction sweep in RunFOR_Rolling. 0 = production (DEFAULT since
					2026-07-29, measured): solve FOR_VertexCont directly from the flat start left by Load_data_reset.
					1 = legacy: first run MainExecution (a full solve of MinImportsMaxReverseP), leaving the cost-min
					optimum as the starting point. Kept as the way back, and it is also forced ON whenever
					UseBattComp=1 (see below).

					MEASURED on the TR9_two micro test bed, 48 periods x 12 directions, 2026-07-29:

					                         warm start ON     warm start OFF
					  wall-clock                41m 22s           10m 12s      -> 4.06x faster
					  vertex solve time         731.0 s           358.7 s      -> 2.05x faster per solve
					  max |delta proj|                  0.000e+00 (bit-identical)
					  solve status              576/576 Optimal   576/576 Optimal

					Every recorded column is IDENTICAL, and FOR_rolling_soc is byte-identical, so this is a pure
					runtime change. Three effects compound: 12 solves per period removed, their 12 math-program
					generations removed, and - the surprise - the 12 remaining vertex solves run 2.05x faster.
					That last one means MainExecution was actively HARMFUL: the cost-min optimum is an extreme
					point of the feasible set, hugging the boundary and poorly centred, which is the opposite of
					what an interior-point method wants. A badly centred primal point can be worse than a cold
					start, and here it was, by about double.

					Why it was inert as a warm start: the two programs declare the SAME constraint and variable sets
					(NotTobeExcluded_*), so they generate a row-for-row identical matrix and differ only in the
					objective column. The first solve's objective value and status go to ConvFlag/ConvTime, which the
					sweep never reads nor writes to CSV - only its variable levels survive. But AIMMS passes variable
					levels to CPLEX as a start only on the MIP path, and in production config (UseBattComp=0,
					FOR_PolyS=0, FOR_LinearizeVmax=0) the program is a continuous convex QCP solved by barrier, which
					takes no advanced basis - and the first solve, being barrier too, produces no basis to hand over.

					EXCEPTION - the MIQCP validations. With UseBattComp=1 (RunMicro_BattComp, RunFullTR9_BattComp)
					the program IS a MIP, where variable levels are a genuine start channel. The guards therefore
					read 'FOR_SweepWarmStart = 1 or UseBattComp = 1', so those cross-checks keep MainExecution
					automatically and nobody has to remember to flip this back. That path is UNMEASURED; leaving it
					as it was is the conservative choice.

					Acceptance test for any future A/B: 'proj' must reproduce to ~2e-6 p.u. Do NOT require P/Q
					equality - a flat face perpendicular to the sweep direction makes the argmax a segment, so the
					returned point may legitimately slide (measured exposure on TR9: median 0.65 kW, worst ~15 kW,
					with one real 179 kW face at period 36 / 0 deg). Use scripts/compare_FOR_runs.py, which checks
					proj and status and reports P/Q movement as informational."
				}
			}
			Parameter EnableRollDiag {
				Comment: {
					"Toggle: 1 = on each failed direction inside RunFOR_Rolling, retry with (Pass 1) cyclic relaxed to DiagCyclicBand, then (Pass 2) cyclic relaxed + GenP0 scaled by (1 - DiagPVcutFrac); write attribution to FOR_rolling_diag.csv. 0 = off."
				}
			}
			Parameter DiagCyclicBand {
				Comment: "Diagnostic-only: cyclic-SOC band tolerance used in Pass 1 / Pass 2 retries (e.g. 0.05). Independent of the main-scan CyclicSOCBand so the working CSV stays clean.";
			}
			Parameter DiagPVcutFrac {
				Comment: "Diagnostic-only: fraction of GenP0 to curtail in Pass 2 (e.g. 0.5 = halve PV). Proxy for an explicit curtailment variable.";
			}
			File FOR_RollDiagCSV {
				Name: "FOR_rolling_diag.csv";
			}
			Parameter Cmp_paperP {
				Comment: "Comparison: P at PCC from Stage A (paper-style single solve at PeriodMaxP=25). Set by RunCompareWithPaperT25.";
			}
			Parameter Cmp_paperQ {
				Comment: "Comparison: Q at PCC from Stage A (paper-style single solve).";
			}
			Parameter Cmp_rollingP {
				Comment: "Comparison: P at PCC from Stage B (rolling-style solve at now=24, target slot=2).";
			}
			Parameter Cmp_rollingQ {
				Comment: "Comparison: Q at PCC from Stage B.";
			}
			Parameter Cmp_SOC_t24 {
				IndexDomain: bat;
				Comment: "Comparison: SOC of each battery at end of t=24 in Stage Paper\'s optimal solution. Stage Rolling initialises BattSOCini with this so both stages face the same battery state at t=25.";
			}
			Parameter Cmp_scP {
				Comment: "Comparison: P at PCC from Stage SC (self-consumption only, no service request). MinImports objective.";
			}
			Parameter Cmp_scQ {
				Comment: "Comparison: Q at PCC from Stage SC.";
			}
			Parameter Cmp_volumeP {
				Comment: "Volume of services in P (paper terminology): Cmp_paperP - Cmp_scP.";
			}
			Parameter Cmp_volumeQ {
				Comment: "Volume of services in Q: Cmp_paperQ - Cmp_scQ.";
			}
			Parameter Cmp_relP {
				Comment: "Comparison: relative diff of P (rolling vs paper) in %. Pre-computed to keep put format simple.";
			}
			Parameter Cmp_relQ {
				Comment: "Comparison: relative diff of Q in %.";
			}
			File FOR_CompareCSV {
				Name: "FOR_compare_paper_t25.csv";
			}
			Parameter PreflightSlot {
				IndexDomain: t;
				Comment: "RunFOR_RollingPreflight: 1 at the slots to sweep, 0 elsewhere. Default = t12, t25, t40 (set inside the procedure). Edit there to change which slots get tested.";
			}
			Parameter PreflightReduce {
				Default: 0;
				Comment: "EXPERIMENT: the value RunFOR_RollingPreflight assigns to ReduceNetwork. Default 0 = full feeder (original behaviour). 1 = reduced (one transformer detailed, via PreflightDetailTag).";
			}
			StringParameter PreflightDetailTag {
				Comment: "EXPERIMENT: the value RunFOR_RollingPreflight assigns to DetailTagCSV. Default empty = full feeder. E.g. \"TR9\" with PreflightReduce=1 for a TR9-only preflight.";
			}
			Parameter PreflightBand {
				Default: 0.05;
				Comment: "EXPERIMENT: the value RunFOR_RollingPreflight assigns to CyclicSOCBand. Default 0.05 = production. Set 1.0 to relax the cyclic band and test FOR sensitivity.";
			}
			StringParameter PreflightSuffix {
				Comment: "EXPERIMENT: suffix appended to the preflight output filename so paired runs (e.g. cyclic on vs off) write separate files. Default empty = FOR_rolling_preflight.csv.";
			}
			StringParameter FOR_RollPreflightName {
				Definition: "FOR_rolling_preflight" + PreflightSuffix + ".csv";
			}
			File FOR_RollPreflightCSV {
				Name: FOR_RollPreflightName;
			}
			Parameter Preflight_TotalTime {
				Comment: "Pre-flight diagnostic: cumulative Gurobi solve time (seconds) across all directions actually solved. Use to extrapolate the full-day runtime.";
			}
			Parameter Preflight_nSolves {
				Comment: "Pre-flight diagnostic: number of vertex solves attempted (= nPreflightSlots * FOR_nAngles).";
			}
			Parameter Preflight_nFail {
				Comment: "Pre-flight diagnostic: number of directions that did NOT return Optimal/LocallyOptimal. Should be 0 before launching the full run.";
			}
		}
		Procedure RunFOR_Rolling {
			Body: {
				! ---- daily rolling FOR (see header). The window is rotated, not the model: slot 1 = now (committed
				! ----   self-consumption dispatch, fixed during the sweep), slot 2 = service. ----
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				! NEW mathprog generator: it passes the exact quadratic constraints to CPLEX
				! compactly. The legacy generator (:=1) expands them and its memory grew across
				! the 48x13 solves until an out-of-memory abort at ~step 37/48 on TR9 (2026-07-03).
				! Required for the exact QCP; matches RunFOR_TR9_Exact.
				option disable_new_mathprog_generator := 0;

				! Exact-QCP barrier robustness (mirrors RunFOR_TR9_Exact): a looser acceptable
				! error and stronger scaling so the barrier completes cleanly on every vertex
				! (without these the exact solve raised CPLEX feasibility / status-13 warnings).
				option Feasibility_Tolerance         := 1.0e-3;
				option Barrier_Convergence_Tolerance := 1.0e-2;
				option Scaling_Flag                  := 2;

				! production config: EXACT quadratic inverter S-circle + exact Vmax (convex QCP, CPLEX barrier);
				! tractable per transformer on the reduced network. Set both toggles to 1 for the linearized
				! (polygon + tangent-Vmax) variant used in the historical whole-feeder runs.
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;   ! bidirectional flexibility (absorb or inject)
				FOR_PolyS                 := 0;   ! exact inverter S-circle: BattP_Balance^2 + Qinv^2 <= BattMaxP^2
				FOR_LinearizeVmax         := 0;   ! exact voltage cap:       Vre^2 + Vim^2 <= MaxV^2
				FOR_nAngles               := 12;  ! every 30 deg
				RollCyclicSOC             := 1;   ! battery returns to its window-start SOC over the day
				CyclicSOCBand             := if RelaxCyclicBand > 0 then RelaxCyclicBand else 0.05 endif;   ! PRODUCTION band 0.05 (via RelaxCyclicBand default); RunTR9_RelaxCyclic sets RelaxCyclicBand:=1.0 to relax it. Strict (=0) was numerically fragile (2026-06-11: 16 vs 119 fails on identical reruns). Must match the restore in the diag block below.
				PeriodMaxP                := 2;   ! service slot is always window position 2 (= now+1)
				FOR_TieEps                := 0;   ! pin the vertex tiebreaker: pure directional objective, independent of session history
				! UseBattComp is deliberately NOT pinned here. Every production wrapper (RunTrafoFOR, RunCoupledFOR,
				! RunTR9_RelaxCyclic, RunTR9_RelaxFloor) already sets it to 0, and RunMicro_BattComp /
				! RunFullTR9_BattComp set it to 1 on purpose before calling in - pinning it here would silently
				! downgrade those MIQCP validations to the production QCP while still writing *_comp.csv.

				! load DB+Excel once and freeze the un-rotated inputs + the starting SOC
				empty allvariables;
				run Load_data_dsn;
				P0raw(d,t)        := P0(d,t);
				Q0raw(d,t)        := Q0(d,t);
				GenP0raw(d,t)     := GenP0(d,t);
				Irrraw(t)         := Irradiance(t);
				BattSOCstart(bat) := BattSOCini(bat);

				! CSV headers (all files stay open; switch the active one with 'put <file>')
				FOR_RollCSV.PageWidth     := 32767;
				FOR_RollSOCCSV.PageWidth  := 32767;
				FOR_RollFairCSV.PageWidth := 32767;
				put FOR_RollCSV;
				put "now,target,angle_deg,P,Q,proj,status,time,VminTrue,VmaxTrue,UVviol,OVviol,LinErr" / ;
				put FOR_RollSOCCSV;
				put "now,battery,SOC_start,Pexec,Chg1,Dis1,base_status,TotPV1_pu" / ;
				! Stage 0 fairness log: one row per (period, direction, aggregator). Written for EVERY
				! FairMode including 0, so case A provides the reference split for the contraction and
				! dispersion metrics. util = realised utilisation of the aggregator's installed capacity;
				! under FairMode=1 or 2 every aggregator's util must equal Zeta, which is the check.
				put FOR_RollFairCSV;
				put "now,target,angle_deg,FairMode,zeta,status,aggregator,n_batt,cap_pu,sumP_pu,util,util_min,util_max" / ;
				if EnableRollDiag = 1 then
					FOR_RollDiagCSV.PageWidth := 32767;
					put FOR_RollDiagCSV;
					put "now,target,angle_deg,pass,status,P,Q,proj,time" / ;
				endif;

				for (t) do
					RollNow     := ord(t);
					RollMap(tt) := Element(Time, mod(ord(tt)-1 + (RollNow-1), nPeriods) + 1);

					! ---- committed self-consumption dispatch = the point the battery actually realises ----
					empty allvariables;
					run Load_data_reset;                        ! warm-start, taps, Qinv fix; inputs back to raw (static data already loaded)
					P0(d,tt)        := P0raw(d, RollMap(tt));    ! rotate the day onto slot order (slot 1 = now)
					Q0(d,tt)        := Q0raw(d, RollMap(tt));
					GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
					Irradiance(tt)  := Irrraw(RollMap(tt));
					BattSOCini(bat) := BattSOCstart(bat);        ! start from the carried-forward realised SOC
					if SOCFloorOverride >= 0 then BattSOCmin(bat) := SOCFloorOverride; endif;   ! EXPERIMENT: re-apply floor override after the Load_data_dsn reset
					BattP_Chg(bat,'1').nonvar := 0;              ! slot-1 dispatch is free ONLY in this baseline solve
					BattP_Dis(bat,'1').nonvar := 0;
					FairActive := 0;                             ! fairness OFF in the committed baseline: it must not pre-commit
					                                             ! the service slot, and case B must inherit case A's SOC path.
					                                             ! FairBaseline=1 overrides this (see FairActive's comment).
					run MinOFminImports;                         ! PURE self-consumption baseline (MinImports; no max-export term at the service slot)
					if ConvFlag <> 'Optimal' and ConvFlag <> 'LocallyOptimal' then
						! baseline rescue: a silent NoSolution here would execute a zeros (do-nothing) dispatch -- feasible but not the SC trajectory
						solve MinImports
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       method              := 'deterministic concurrent',
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 3000;
						ConvFlag := MinImports.ProgramStatus;
					endif;

					! record realised state; stage the SOC advance from the executed slot-1 (now) dispatch
					RollSOCtraj(bat,t)      := BattSOCstart(bat);
					RollDispatchExec(bat,t) := BattP_Balance(bat,'1');
					RollChgExec(bat)        := BattP_Chg(bat,'1');   ! committed slot-1 dispatch; the sweep below fixes the batteries to this
					RollDisExec(bat)        := BattP_Dis(bat,'1');
					RollSOCnext(bat)        := BattSOCini(bat)
						+ (BattP_Chg(bat,'1')*etaChg(bat) - BattP_Dis(bat,'1')/etaDis(bat))*DeltaT/BattEcap(bat);
					put FOR_RollSOCCSV;
					for (bat) do
						put RollNow:3:0, ",", bat:24, ",", BattSOCstart(bat):12:6, ",", RollDispatchExec(bat,t):14:6, ",",
						    RollChgExec(bat):14:6, ",", RollDisExec(bat):14:6, ",", ConvFlag, ",", sum(d, GenP0(d,'1')):14:6 / ;
					endfor;

					if BaselineOnly = 0 then   ! EXPERIMENT: baseline-only runs skip the 12-direction sweep
					! ---- sweep directions: region offered for the service slot (now+1) ----
					FairActive := 1;           ! fairness ON for every directional solve (incl. the diagnostic retries below)
					put FOR_RollCSV;
					for (ia) do
						FOR_Angle    := FOR_AngleDeg(ia);
						FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;

						empty allvariables;
						run Load_data_reset;                        ! same proven reset as the time-family scan (static data already loaded)
						P0(d,tt)        := P0raw(d, RollMap(tt));
						Q0(d,tt)        := Q0raw(d, RollMap(tt));
						GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
						Irradiance(tt)  := Irrraw(RollMap(tt));
						BattSOCini(bat) := BattSOCstart(bat);
						if SOCFloorOverride >= 0 then BattSOCmin(bat) := SOCFloorOverride; endif;   ! EXPERIMENT: re-apply floor override after the Load_data_dsn reset
						BattP_Chg(bat,'1') := RollChgExec(bat);     ! slot 1 (= now) is already committed: fix the batteries to the
						BattP_Chg(bat,'1').nonvar := 1;             ! executed dispatch so the region offered for slot 2 is reachable
						BattP_Dis(bat,'1') := RollDisExec(bat);
						BattP_Dis(bat,'1').nonvar := 1;
						if FOR_SweepWarmStart = 1 or UseBattComp = 1 then
							run MainExecution;                      ! cost-min start point; ~30% of wall-clock. See FOR_SweepWarmStart
						endif;

						FOR_Lambda := 1;
						solve FOR_VertexCont
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       method     := 'deterministic concurrent',
							       time_limit := 3000;

						if FOR_VertexCont.ProgramStatus <> 'Optimal' and
						   FOR_VertexCont.ProgramStatus <> 'LocallyOptimal' then
							solve FOR_VertexCont
								where  MIP_Relative_Optimality_Tolerance := 0.01,
								       method              := 'deterministic concurrent',
								       numeric_focus       := 3,
								       barrier_homogeneous := 1,
								       time_limit          := 3000;
						endif;

						FOR_StatCur := FOR_VertexCont.ProgramStatus;

						if FOR_VertexCont.ProgramStatus = 'Optimal' or
						   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
							FOR_Pcur    := P_PCC(PeriodMaxP);
							FOR_Qcur    := Q_PCC(PeriodMaxP);
							FOR_VmaxCur := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
							FOR_LinCur  := max((n,f), abs(Vmag2approx(n,f,PeriodMaxP) - (Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
							put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
							    FOR_Pcur:14:6, ",", FOR_Qcur:14:6, ",",
							    (cos(FOR_AngleRad)*FOR_Pcur + sin(FOR_AngleRad)*FOR_Qcur):14:6, ",",
							    FOR_StatCur, ",", FOR_VertexCont.SolutionTime:12:2, ",",
							    (min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2))):10:5, ",",
							    FOR_VmaxCur:10:5, ",",
							    (max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)))):10:5, ",",
							    (max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)))):10:5, ",",
							    FOR_LinCur:12:6 / ;
						else
							put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
							    0:14:6, ",", 0:14:6, ",", 0:14:6, ",",
							    FOR_StatCur, ",", FOR_VertexCont.SolutionTime:12:2, ",",
							    0:10:5, ",", 0:10:5, ",", 0:10:5, ",", 0:10:5, ",", 0:12:6 / ;
						endif;

						! ---- fairness log: one row per aggregator for this direction ----
						! Reported for every FairMode, so case A (FairMode=0) supplies the unconstrained split
						! that the contraction and dispersion metrics are measured against. util_min/util_max
						! are the extreme per-prosumer utilisations inside the aggregator: under FairMode=1 they
						! collapse onto util, under FairMode=2 they are free to spread while the total tracks Zeta.
						put FOR_RollFairCSV;
						for (a) do
							put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
							    FairMode:2:0, ",", Zeta:14:6, ",", FOR_StatCur, ",",
							    a:8, ",", (sum(bat | BattAgg(bat) = a, 1)):4:0, ",",
							    (sum(bat | BattAgg(bat) = a, FairCap(bat))):14:6, ",",
							    (sum(bat | BattAgg(bat) = a, BattP_Balance(bat,PeriodMaxP))):14:6, ",",
							    (sum(bat | BattAgg(bat) = a, BattP_Balance(bat,PeriodMaxP))
							        / max(sum(bat | BattAgg(bat) = a, FairCap(bat)), 1e-9)):14:6, ",",
							    (min(bat | BattAgg(bat) = a, BattP_Balance(bat,PeriodMaxP)/max(FairCap(bat),1e-9))):14:6, ",",
							    (max(bat | BattAgg(bat) = a, BattP_Balance(bat,PeriodMaxP)/max(FairCap(bat),1e-9))):14:6 / ;
						endfor;
						put FOR_RollCSV;   ! restore the active file for the next direction

						! ---- diagnostic retry for failed directions (Pass 1: cyclic relaxed; Pass 2: + PV scaled) ----
						if EnableRollDiag = 1 and
						   FOR_StatCur <> 'Optimal' and
						   FOR_StatCur <> 'LocallyOptimal' then

							put FOR_RollDiagCSV;

							! --- Pass 1: cyclic SOC band relaxed to DiagCyclicBand ---
							empty allvariables;
							run Load_data_reset;
							P0(d,tt)        := P0raw(d, RollMap(tt));
							Q0(d,tt)        := Q0raw(d, RollMap(tt));
							GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
							Irradiance(tt)  := Irrraw(RollMap(tt));
							BattSOCini(bat) := BattSOCstart(bat);
							if SOCFloorOverride >= 0 then BattSOCmin(bat) := SOCFloorOverride; endif;   ! EXPERIMENT: retry under the SAME floor as the direction that failed (explicit since the loader split; the old full reload used to silently restore the DB floor here)
							BattP_Chg(bat,'1') := RollChgExec(bat);     ! keep the committed slot-1 fix in the diagnostic retries too
							BattP_Chg(bat,'1').nonvar := 1;
							BattP_Dis(bat,'1') := RollDisExec(bat);
							BattP_Dis(bat,'1').nonvar := 1;
							CyclicSOCBand   := DiagCyclicBand;
							if FOR_SweepWarmStart = 1 or UseBattComp = 1 then
								run MainExecution;                  ! keep the diagnostic retries on the same footing as the direction that failed
							endif;
							FOR_Lambda := 1;
							solve FOR_VertexCont
								where  MIP_Relative_Optimality_Tolerance := 0.01,
								       method              := 'deterministic concurrent',
								       numeric_focus       := 3,
								       barrier_homogeneous := 1,
								       time_limit          := 1500;
							FOR_StatCur := FOR_VertexCont.ProgramStatus;
							if FOR_VertexCont.ProgramStatus = 'Optimal' or
							   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
								FOR_Pcur := P_PCC(PeriodMaxP);
								FOR_Qcur := Q_PCC(PeriodMaxP);
								put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
								    "pass1_cyclic,", FOR_StatCur, ",",
								    FOR_Pcur:14:6, ",", FOR_Qcur:14:6, ",",
								    (cos(FOR_AngleRad)*FOR_Pcur + sin(FOR_AngleRad)*FOR_Qcur):14:6, ",",
								    FOR_VertexCont.SolutionTime:12:2 / ;
							else
								put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
								    "pass1_cyclic,", FOR_StatCur, ",",
								    0:14:6, ",", 0:14:6, ",", 0:14:6, ",",
								    FOR_VertexCont.SolutionTime:12:2 / ;
							endif;

							! --- Pass 2: cyclic relaxed + PV scaled by (1 - DiagPVcutFrac) ---
							empty allvariables;
							run Load_data_reset;
							P0(d,tt)        := P0raw(d, RollMap(tt));
							Q0(d,tt)        := Q0raw(d, RollMap(tt));
							GenP0(d,tt)     := GenP0raw(d, RollMap(tt)) * (1 - DiagPVcutFrac);
							Irradiance(tt)  := Irrraw(RollMap(tt));
							BattSOCini(bat) := BattSOCstart(bat);
							if SOCFloorOverride >= 0 then BattSOCmin(bat) := SOCFloorOverride; endif;   ! EXPERIMENT: retry under the SAME floor as the direction that failed (explicit since the loader split; the old full reload used to silently restore the DB floor here)
							BattP_Chg(bat,'1') := RollChgExec(bat);     ! keep the committed slot-1 fix in the diagnostic retries too
							BattP_Chg(bat,'1').nonvar := 1;
							BattP_Dis(bat,'1') := RollDisExec(bat);
							BattP_Dis(bat,'1').nonvar := 1;
							CyclicSOCBand   := DiagCyclicBand;
							if FOR_SweepWarmStart = 1 or UseBattComp = 1 then
								run MainExecution;                  ! keep the diagnostic retries on the same footing as the direction that failed
							endif;
							FOR_Lambda := 1;
							solve FOR_VertexCont
								where  MIP_Relative_Optimality_Tolerance := 0.01,
								       method              := 'deterministic concurrent',
								       numeric_focus       := 3,
								       barrier_homogeneous := 1,
								       time_limit          := 1500;
							FOR_StatCur := FOR_VertexCont.ProgramStatus;
							if FOR_VertexCont.ProgramStatus = 'Optimal' or
							   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
								FOR_Pcur := P_PCC(PeriodMaxP);
								FOR_Qcur := Q_PCC(PeriodMaxP);
								put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
								    "pass2_curtail,", FOR_StatCur, ",",
								    FOR_Pcur:14:6, ",", FOR_Qcur:14:6, ",",
								    (cos(FOR_AngleRad)*FOR_Pcur + sin(FOR_AngleRad)*FOR_Qcur):14:6, ",",
								    FOR_VertexCont.SolutionTime:12:2 / ;
							else
								put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
								    "pass2_curtail,", FOR_StatCur, ",",
								    0:14:6, ",", 0:14:6, ",", 0:14:6, ",",
								    FOR_VertexCont.SolutionTime:12:2 / ;
							endif;

							! --- restore the production band and switch put target back to main CSV for next direction ---
							CyclicSOCBand := if RelaxCyclicBand > 0 then RelaxCyclicBand else 0.05 endif;   ! must match the config block at the top of this procedure
							put FOR_RollCSV;
						endif;
					endfor;
					endif;   ! EXPERIMENT: end BaselineOnly sweep-skip guard

					! advance the realised SOC to the next step (executed slot-1 dispatch)
					BattSOCstart(bat) := RollSOCnext(bat);
				endfor;

				putclose FOR_RollCSV;
				putclose FOR_RollSOCCSV;
				putclose FOR_RollFairCSV;
				if EnableRollDiag = 1 then
					putclose FOR_RollDiagCSV;
				endif;
				RollCyclicSOC := 0;   ! leave the model in its normal (non-rolling) state
				CyclicSOCBand := 0;   ! defensive: clear band so subsequent runs see strict cyclic if they re-enable it
				FairActive    := 0;   ! defensive: leave the fairness gate closed so a later non-fairness run is unaffected
				BattP_Chg(bat,t).nonvar := 0;   ! defensive: free the slot-1 fixes so later runs see normal variables
				BattP_Dis(bat,t).nonvar := 0;
				display RollSOCtraj;
			}
			Comment: {
				"FOR - PRODUCTION. MPC-style daily rolling FOR. Each half-hour \'now\' the 48-point day is rotated so \'now\' is slot 1 and the service slot now+1 is slot 2; the window starts from the realised SOC, the committed baseline is solved with the PURE self-consumption objective (MinImports, no max-export term), the slot-1 dispatch is executed to advance the SOC, then the directions are swept with BattP_Chg/Dis(bat,\'1\') FIXED to that committed dispatch, so every boundary point offered for now+1 is reachable from what the batteries actually do during \'now\'. Exact quadratic config (FOR_PolyS=0, FOR_LinearizeVmax=0): convex QCP under CPLEX barrier, tractable per transformer on the reduced network. 48 steps -> FOR_rolling.csv (now,target columns); realised SOC + executed power -> FOR_rolling_soc.csv. Overlay with plot_FOR_rolling.py."
			}
		}
		Procedure RunTrafoFOR {
			Arguments: (TrafoTag);
			Body: {
				! One per-transformer rolling FOR: TrafoTag detailed, all other transformers lumped
				! as passive MV loads. Writes FOR_rolling_<tag>.csv + FOR_rolling_soc_<tag>.csv.
				UseBattComp       := 0;   ! production is the pure QCP (the binary lives in Validation)
				RollFileSuffix    := "_" + TrafoTag;
				ReduceNetwork     := 1;
				DetailTagCSV      := TrafoTag;
				DetailLoadPattern := "";
				run RunFOR_Rolling;
				RollFileSuffix    := "";
			}
			StringParameter TrafoTag {
				Property: Input;
			}
			Comment: "Single per-transformer rolling FOR runner (replaces the nine per-TR copy-paste procedures). BattThroughputPen is NOT set here: the production value is the declared default (0.2). Use the one-click wrappers RunTR1..RunTR9.";
		}
		Procedure RunCoupledFOR {
			Arguments: (TagList);
			Body: {
				! COUPLED rolling FOR for a comma-separated transformer list (e.g. "TR3,TR4"): all
				! listed transformers detailed TOGETHER - their batteries flex in one problem, sharing
				! the MV feeder - while the rest are lumped passive. Writes FOR_rolling_<tags>.csv
				! (e.g. FOR_rolling_TR3TR4.csv). Purpose: measure the MV coupling gap by comparing this
				! coupled region against the decomposed Minkowski sum of the same transformers
				! (combine_FOR_pertrafo.py --tags TR3,TR4 --compare FOR_rolling_TR3TR4.csv).
				! COST grows superlinearly with total battery count: pairs of small transformers are
				! cheap; ALL nine together is the monolithic full feeder, which is documented
				! intractable (a single vertex solve ran >5.5 h) - do not attempt it.
				UseBattComp       := 0;
				RollFileSuffix    := "_" + FindReplaceStrings(TagList, ",", "");
				ReduceNetwork     := 1;
				DetailTagCSV      := TagList;
				DetailLoadPattern := "";
				run RunFOR_Rolling;
				RollFileSuffix    := "";
			}
			StringParameter TagList {
				Property: Input;
			}
			Comment: "Coupled multi-transformer rolling FOR (the transformers in TagList detailed together, rest lumped passive). For the coupling-gap validation of the Minkowski decomposition: pass a comma list such as TR3,TR4 and compare with the decomposed sum of the same pair. Historical (linearized, 2026-06): TR3+TR4 gap 0.2-3%, TR5+TR6 gap 0.7-4%, outer bound held.";
		}
		Procedure RunTR9_RelaxCyclic {
			Body: {
				! EXPERIMENT (one click): TR9 rolling self-consumption dispatch with the cyclic-SOC
				! band relaxed so batteries may end the day discharged (SOC floor + Emax still hold),
				! and the 12-direction FOR sweep skipped (committed baseline dispatch only, ~48 solves).
				! Writes FOR_rolling_soc_TR9_relaxcyc.csv - the production TR9 files are NOT touched.
				! Purpose: test whether prosumer import falls toward zero once batteries are freed from
				! the net-zero daily-energy constraint. Compare vs the 0.05-band FOR_rolling_soc_TR9.csv.
				RelaxCyclicBand   := 1.0;   ! |SOC_end - SOC_start| <= 100% of cap: cyclic band non-binding
				BaselineOnly      := 1;     ! skip the direction sweep; commit the dispatch only
				UseBattComp       := 0;
				RollFileSuffix    := "_TR9_relaxcyc";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				BaselineOnly      := 0;     ! restore production defaults
				RelaxCyclicBand   := 0.05;
			}
			Comment: "EXPERIMENT (one click): TR9 rolling self-consumption dispatch, cyclic-SOC band relaxed (RelaxCyclicBand=1.0) and FOR sweep skipped (BaselineOnly=1). Fast (~48 baseline solves). Output FOR_rolling_soc_TR9_relaxcyc.csv; production TR9 files untouched. Tests whether prosumer import -> 0 when batteries are freed from net-zero daily energy.";
		}
		Procedure RunTR9_RelaxFloor {
			Body: {
				! EXPERIMENT (one click): TR9 rolling self-consumption dispatch with the SOC floor
				! (BattSOCmin, the MinSOC_def constraint) lowered to 0 so batteries may fully discharge,
				! the FOR sweep skipped (committed baseline dispatch only, ~48 solves). Cyclic band stays
				! at the production 0.05. Writes FOR_rolling_soc_TR9_floor0.csv - production TR9 files are
				! NOT touched. Purpose: the floor is the binding limit (83% of import sits at batteries
				! parked at their 10% floor), so this tests how far prosumer import falls when they are
				! allowed to finish the day completely discharged. Compare vs FOR_rolling_soc_TR9.csv.
				SOCFloorOverride  := 0.0;   ! allow full discharge (floor 10% -> 0%); Emax + cyclic unchanged
				BaselineOnly      := 1;     ! skip the direction sweep; commit the dispatch only
				UseBattComp       := 0;
				RollFileSuffix    := "_TR9_floor0";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				BaselineOnly      := 0;     ! restore production defaults
				SOCFloorOverride  := -1;
			}
			Comment: "EXPERIMENT (one click): TR9 rolling self-consumption dispatch with the SOC floor lowered to 0 (SOCFloorOverride=0.0) and FOR sweep skipped (BaselineOnly=1). Cyclic band at production 0.05. Fast (~48 baseline solves). Output FOR_rolling_soc_TR9_floor0.csv; production TR9 files untouched. Tests how far prosumer import falls when batteries may finish the day fully discharged.";
		}

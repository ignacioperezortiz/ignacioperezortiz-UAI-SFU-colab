			}
			Comment: "H4 on the micro bed, P1 as hard constraint: TSO takes the 180 deg vertex (rho 0.99) at 00:30-04:30 and 16:00-20:00.";
		}
		Procedure SCT_Micro_K0IP {
			Body: {
				SCT_KappaRun( 0, 1, "_SCT_micro_k000ip", "_two" );
			}
			Comment: "H1 on the micro bed with the per-prosumer and imports-first regret columns (production FOR, vertices only).";
		}
		Procedure SCT_SC1Run {
			Arguments: (Kappa,ExpShare,Alpha,Tag,Pattern);
			Body: {
				! H5: NO HOLE. SCFirst = 1 gives the service slot its normal self-consumption weight in P1, so the
				! no-service point B is the real self-consumption dispatch. SCFirst = 1 also switches on
				! SCNoImportFuture; Alpha = 0 keeps it (P1 as constraint), Alpha = 1000 makes it non-binding.
				SCFirst := 1;
				SCAlpha := Alpha;
				SCT_KappaRun( Kappa, ExpShare, Tag, Pattern );
				SCFirst := 0;
				SCAlpha := 0;
			}
			Parameter Kappa {
				Property: Input;
			}
			Parameter ExpShare {
				Property: Input;
			}
			Parameter Alpha {
				Property: Input;
			}
			StringParameter Tag {
				Property: Input;
			}
			StringParameter Pattern {
				Property: Input;
			}
		}
		Procedure SCT_H4SC1Run {
			Arguments: (Kappa,ExpShare,Alpha,Svc,Tag,Pattern);
			Body: {
				SCFirst := 1;
				SCAlpha := Alpha;
				SCT_H4Run( Kappa, ExpShare, 0, Svc, Tag, Pattern );
				SCFirst := 0;
				SCAlpha := 0;
			}
			Parameter Kappa {
				Property: Input;
			}
			Parameter ExpShare {
				Property: Input;
			}
			Parameter Alpha {
				Property: Input;
			}
			Parameter Svc {
				Property: Input;
			}
			StringParameter Tag {
				Property: Input;
			}
			StringParameter Pattern {
				Property: Input;
			}
		}

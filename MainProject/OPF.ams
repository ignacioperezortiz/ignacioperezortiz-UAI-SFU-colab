		Procedure RunTR4_OfferTest {
			Body: {
				! WHO OFFERS WHAT, AND HOW MUCH OF IT IS TAKEN. Same bed and same settings as
				! RunTR4_SvcChain, but only the FairMode 2 pass, and with RollOfferLog on. Writes a
				! fourth CSV, FOR_rolling_offer_TR4_offer.csv, with one row per (period, direction,
				! battery) plus one row per battery at each committed point.
				!
				! Two columns answer the question. offer_chg_pu / offer_dis_pu are what the prosumer
				! COULD do at the flexibility slot given the charge it enters with - power rating, room
				! below SOCmax, energy above SOCmin. take_chg_pu / take_dis_pu are what the directional
				! solve actually used. The offer is a single-slot physical envelope and therefore an
				! UPPER BOUND: the network, the inverter circle and the rest of the window can all make
				! the achievable contribution smaller, so take <= offer is expected, not a defect.
				!
				! About 1 h 40: the warm-up day to reach the recurring state, then one 576-vertex sweep.
				! For a 20-minute preview instead, set RollMaxPeriods := 12 before calling - but then the
				! warm-up is capped too, so the run is a transient day and only the shape is meaningful.
				MainInitialization;
				UseBattComp       := 0;
				FOR_ThruPenSlot   := 0.2;   ! keeps the swept dispatch physical
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				RollSvcPeriodsCSV := "5,10,25,40";
				RollSvcAngle      := 180;
				RollSvcRho        := 0.5;

				! ---- pass 0: warm-up, no logging, only to reach the recurring state ----
				RollOfferLog := 0;
				FairMode := 0;   RollSvcMode := 0;   BaselineOnly := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_offwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				! ---- the logged pass ----
				RollOfferLog := 1;
				FairMode := 2;   RollSvcMode := 1;   BaselineOnly := 0;
				RollFileSuffix := "_TR4_offer";   run RunFOR_Rolling;

				FOR_ThruPenSlot   := 0;   ! restore production defaults
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				SCAlpha           := 0;
				FairMode          := 0;
				RollSvcMode       := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "PER-PROSUMER OFFER AND TAKE-UP ON TR4 (~1 h 40). Warm-up day, then one FairMode 2 sweep with RollOfferLog = 1. Answers who offers what and how much of it the directional OPF uses, in FOR_rolling_offer_TR4_offer.csv: one row per (period, direction, battery), angle_deg = -1 marking the committed point. The offer columns are a single-slot physical envelope and an UPPER BOUND on what is achievable, so take <= offer is expected. Set RollMaxPeriods := 12 first for a 20-minute preview, at the cost of the warm-up being capped too.";
		}
		Procedure RunTR4_ThruPenTest {
			Body: {
				! DOES THE PHANTOM DUMP INFLATE THE REGION, AND DOES A LINEAR PENALTY REMOVE IT?
				! Three passes over the SAME state, sweeping only periods 28-33 - the window where the
				! batteries are full and the SOC ceiling binds, which is where the dump was measured to
				! be worth most. The committed baseline still runs at every period, so the trajectory
				! entering period 28 is the ordinary steady-state one.
				!
				!   k0     FOR_ThruPen = 0      production as published - the dump is free
				!   k10    FOR_ThruPen = 0.1    the proposed setting, still a convex QCP
				!   comp   UseBattComp = 1      MIQCP reference: complementarity by binary
				!
				! The binary pass is a MEASUREMENT ONLY. It never enters production - it is here to say
				! what the region is when simultaneous charge/discharge is forbidden outright, so that
				! k10 can be checked against it rather than merely asserted.
				!
				! No service is requested in any pass, so all three share one trajectory and the regions
				! are directly comparable. About 1 h: the warm-up day, then 3 x 72 vertices, the binary
				! pass being the slow one.
				MainInitialization;
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				FairMode          := 2;

				! ---- pass 0: warm-up over the whole day, no sweep, only to reach the recurring state ----
				RollSweepFrom := 0;   RollMaxPeriods := 0;   FOR_ThruPen := 0;   RollOfferLog := 0;
				BaselineOnly  := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_tpwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				! ---- the three passes: baseline everywhere, sweep only 28..33 ----
				BaselineOnly   := 0;
				RollSweepFrom  := 28;
				RollMaxPeriods := 33;
				RollOfferLog   := 1;

				FOR_ThruPen := 0;     UseBattComp := 0;
				RollFileSuffix := "_TR4_k0";     run RunFOR_Rolling;

				FOR_ThruPen := 0.1;   UseBattComp := 0;
				RollFileSuffix := "_TR4_k10";    run RunFOR_Rolling;

				FOR_ThruPen := 0;     UseBattComp := 1;
				RollFileSuffix := "_TR4_comp";   run RunFOR_Rolling;

				FOR_ThruPen       := 0;   ! restore production defaults
				UseBattComp       := 0;
				RollSweepFrom     := 0;
				RollMaxPeriods    := 0;
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				FairMode          := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "DOES THE PHANTOM DUMP INFLATE THE FOR? (~1 h) Warm-up day, then three passes sweeping only periods 28-33 from the same steady state: FOR_ThruPen = 0 (production as published), FOR_ThruPen = 0.1 (proposed, still a convex QCP), and UseBattComp = 1 (MIQCP reference, measurement only - never production). No service requested, so the three share one trajectory and the regions compare directly. Writes FOR_rolling_TR4_k0 / _k10 / _comp plus the matching offer logs.";
		}
		Procedure RunTR4_ThruPen006 {
			Body: {
				! O LIMIAR BASTA, OU PRECISA DA MARGEM? RunTR4_ThruPenTest mostrou que FOR_ThruPen = 0.1
				! zera a ciclagem e reproduz o vertice de maxima importacao da formulacao binaria, ao
				! custo de 3.1x no tempo de solve. 0.06 fica logo acima do limiar fechado 1/19 = 0.0526.
				! Se o dump morre igual com menos margem e o solve custa menos, 0.06 e a escolha melhor.
				! Mesmos periodos 28-33, mesma trajetoria: comparavel linha a linha com _k0 / _k10 / _comp.
				! Cerca de 25 min.
				MainInitialization;
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				FairMode          := 2;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   FOR_ThruPen := 0;   RollOfferLog := 0;
				BaselineOnly  := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_t6warm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly   := 0;
				RollSweepFrom  := 28;
				RollMaxPeriods := 33;
				RollOfferLog   := 1;
				FOR_ThruPen    := 0.06;
				RollFileSuffix := "_TR4_k06";   run RunFOR_Rolling;

				FOR_ThruPen       := 0;   ! restore production defaults
				RollSweepFrom     := 0;
				RollMaxPeriods    := 0;
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				FairMode          := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "FOR_ThruPen = 0.06, logo acima do limiar 1/19 = 0.0526 (~25 min). Mesmos periodos 28-33 e mesma trajetoria de RunTR4_ThruPenTest, portanto comparavel linha a linha com _k0, _k10 e _comp. Responde se a margem de 0.1 e necessaria ou se o limiar basta - o que importa porque 0.1 custou 3.1x no tempo de solve.";
		}
		Procedure RunTR4_ThruPenSlot {
			Body: {
				! PENALIZAR SO O SLOT OFERTADO BASTA? FOR_ThruPen = 0.1, somando os 48 slots, zera a
				! ciclagem e reproduz a regiao da formulacao binaria, mas custa 3.1x. O custo e uniforme
				! entre direcoes e some em 0.06, o que aponta para a face degenerada: a penalidade zera
				! um de cada par (Chg,Dis) em |bat| x |t| pares de uma vez. Restringir ao slot ofertado
				! deixa so |bat| pares, 48 vezes menos.
				!
				! Mesmos periodos 28-33 e mesma trajetoria de RunTR4_ThruPenTest, portanto comparavel
				! linha a linha com _k0, _k06, _k10 e _comp. Cerca de 25 min.
				!
				! O que pode dar errado: o dump indireto. Queimar energia num slot posterior relaxa a
				! banda terminal e libera o slot ofertado a carregar mais, e esse caminho fica sem
				! penalidade aqui. E estreito - nos periodos onde o dump paga o que binda e o teto de SOC
				! do proprio slot ofertado - mas estreito nao e zero, e e exatamente isso que se mede.
				MainInitialization;
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				FairMode          := 2;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				FOR_ThruPen   := 0;   FOR_ThruPenSlot := 0;
				BaselineOnly  := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_kswarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly    := 0;
				RollSweepFrom   := 28;
				RollMaxPeriods  := 33;
				RollOfferLog    := 1;
				FOR_ThruPen     := 0;
				FOR_ThruPenSlot := 0.1;
				RollFileSuffix  := "_TR4_ks";   run RunFOR_Rolling;

				FOR_ThruPen       := 0;   ! restore production defaults
				FOR_ThruPenSlot   := 0;
				RollSweepFrom     := 0;
				RollMaxPeriods    := 0;
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				FairMode          := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "FOR_ThruPenSlot = 0.1: a penalidade de throughput somada SO no slot ofertado, em vez dos 48 (~25 min). Mesmos periodos 28-33 e mesma trajetoria de RunTR4_ThruPenTest, comparavel linha a linha com _k0, _k06, _k10 e _comp. Testa se o custo de 3.1x do escopo completo pode ser cortado sem reabrir o dump - o caminho indireto pela banda terminal fica sem penalidade e e o que se mede.";
		}
		Procedure RunTR4_ThruPenSlot05 {
			Body: {
				! A PENALIDADE NO SLOT E BARATA DEMAIS PARA ECONOMIZAR NELA. Medida em 0.9x o tempo de
				! solve - mais barata que nao ter penalidade nenhuma. Foi fixada em 0.1 por analogia com
				! o limiar 1/19 = 0.0526 da penalidade de 48 slots, mas nesse escopo nao ha motivo.
				!
				! O QUE ISSO RESPONDE. Com FOR_ThruPenSlot = 0.1 sobraram 717 de 26496 linhas ciclando no
				! dia inteiro (contra 22418 com kappa = 0), todas nas tres direcoes de carga, com o SOC
				! terminando o slot em 100.000% exato e razao throughput/liquido = 19.0: o dump classico a
				! SOC fixo. Resta 1.07% da largura da regiao na mediana, 5.31% no pior vertice.
				!
				! DUAS HIPOTESES, E ELAS SE SEPARAM AQUI:
				!   (a) LIMIAR. 0.1 nao basta e 0.5 mata. Conserto exato de graca.
				!   (b) FORCADO. A aritmetica ja nao fecha em 0.1 - o dump que sobrou custa 0.684 e rende
				!       0.360, ou seja o dobro do que ganha, e um otimo nao escolheria isso. Sob FairMode=2
				!       o agregador tem de entregar Zeta*capacidade de potencia liquida, e numa bateria a
				!       100% de SOC o unico jeito de produzir liquido positivo sem furar o teto e ciclar.
				!       Se for isso, 0.5 devolve as mesmas linhas e nenhum kappa resolve.
				!
				! DESENHO. Duas passagens a partir da MESMA semente, varrendo so 14-24 (a janela mais densa,
				! 39 linhas por periodo), com RollSvcMode = 0 para que nenhum servico desvie a trajetoria:
				! as duas passagens compartilham um unico caminho de SOC e comparam linha a linha. ~20 min.
				MainInitialization;
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				FairMode          := 2;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				FOR_ThruPen   := 0;   FOR_ThruPenSlot := 0;
				BaselineOnly  := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_k05warm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly    := 0;
				RollSweepFrom   := 14;
				RollMaxPeriods  := 24;
				RollOfferLog    := 1;
				FOR_ThruPen     := 0;

				FOR_ThruPenSlot := 0.1;
				RollFileSuffix  := "_TR4_ks01";   run RunFOR_Rolling;

				FOR_ThruPenSlot := 0.5;
				RollFileSuffix  := "_TR4_ks05";   run RunFOR_Rolling;

				FOR_ThruPen       := 0;   ! restore production defaults
				FOR_ThruPenSlot   := 0;
				RollSweepFrom     := 0;
				RollMaxPeriods    := 0;
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				FairMode          := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "LIMIAR OU FORCADO? (~20 min) A/B de FOR_ThruPenSlot 0.1 vs 0.5 nos periodos 14-24, duas passagens da mesma semente com RollSvcMode = 0, portanto uma unica trajetoria e comparacao linha a linha. Com 0.1 sobraram 717 de 26496 linhas ciclando no dia inteiro, e a aritmetica diz que esse resto CUSTA o dobro do que rende - o que aponta para ele ser forcado pela restricao de justica (FairMode=2 exige liquido positivo de baterias que estao a 100% de SOC) e nao escolhido. Se 0.5 zerar, o conserto e exato e de graca, porque a penalidade no slot custa 0.9x. Se devolver as mesmas linhas, nenhum kappa resolve e o resto se documenta. Escreve FOR_rolling_TR4_ks01 / _ks05 e os logs de oferta.";
		}
		Procedure RunTR4_ThruPenSlotRef {
			Body: {
				! QUAL KAPPA A FORMULACAO BINARIA ESCOLHE? RunTR4_ThruPenSlot05 mostrou que kappa_slot
				! nao e um parametro que se possa subir de graca. Em 0.5 a ciclagem zera (0 de 6072) e o
				! solve fica ate mais barato (0.58x), mas a regiao ENCOLHE em todas as doze direcoes,
				! inclusive nas de exportacao, onde ciclagem nunca houve: -20.8 kW em 120 graus e -19.4 em
				! 240. Sao 78 dos 132 vertices encolhendo mais do que o dump removido poderia justificar.
				!
				! POR QUE. A penalidade nao distingue throughput fantasma de legitimo, taxa os dois. Uma
				! bateria que se move 1 kW na direcao teta ganha |cos teta| na projecao e paga kappa. Em
				! 120 e 240 graus |cos| = 0.5 = kappa e o coeficiente liquido da bateria vira exatamente
				! zero, dai o colapso ser maior ali. E como o inversor tem o cone P^2 + Q^2 <= S^2, o otimo
				! vive numa curva e nao num vertice de caixa, entao QUALQUER kappa desloca o ponto trocando
				! P por Q - 0.1 tambem distorce, cinco vezes menos. A janela util e 1/19 < kappa < 0.5.
				!
				! O ARBITRO. So a MIQCP com a complementaridade exata (UseBattComp = 1) diz onde a regiao
				! realmente esta. Ela ja validou kappa_slot = 0.1 nos periodos 28-33, batendo nos seis
				! alvos - mas 28-33 e justamente onde 0.1 nao deixa ciclagem nenhuma, entao esse teste nao
				! prova nada sobre a janela onde 0.1 falha. Aqui ela roda em 14-24, onde 0.1 deixa 299 de
				! 6072 linhas ciclando e ate 4.93 kW de inflacao.
				!
				! DESENHO. O warm-up e IDENTICO ao de RunTR4_ThruPenSlot05, logo a semente e a mesma e as
				! quatro passagens - ks01 e ks05 ja no disco, mais ks02 e kscomp aqui - comparam linha a
				! linha sobre uma unica trajetoria de SOC. ~80 min: a binaria custa 32x.
				MainInitialization;
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				FairMode          := 2;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				FOR_ThruPen   := 0;   FOR_ThruPenSlot := 0;
				BaselineOnly  := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_krefwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly    := 0;
				RollSweepFrom   := 14;
				RollMaxPeriods  := 24;
				RollOfferLog    := 1;
				FOR_ThruPen     := 0;

				FOR_ThruPenSlot := 0.2;   UseBattComp := 0;
				RollFileSuffix  := "_TR4_ks02";    run RunFOR_Rolling;

				FOR_ThruPenSlot := 0;     UseBattComp := 1;
				RollFileSuffix  := "_TR4_kscomp";  run RunFOR_Rolling;

				UseBattComp       := 0;   ! restore production defaults
				FOR_ThruPen       := 0;
				FOR_ThruPenSlot   := 0;
				RollSweepFrom     := 0;
				RollMaxPeriods    := 0;
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				FairMode          := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "FECHA O KAPPA (~80 min). Roda kappa_slot = 0.2 e a referencia binaria MIQCP (UseBattComp = 1) nos periodos 14-24, com warm-up identico ao de RunTR4_ThruPenSlot05 - logo ks01, ks05, ks02 e kscomp compartilham uma unica trajetoria e comparam linha a linha. A janela importa: e onde kappa_slot = 0.1 ainda deixa 299 de 6072 linhas ciclando, ao contrario de 28-33, onde a binaria ja validou o 0.1 e portanto nada provou sobre o caso dificil. Em 0.5 a ciclagem zera mas a regiao encolhe ate 20.8 kW mesmo em direcoes que nunca ciclaram, porque a penalidade taxa throughput legitimo junto com o fantasma. A binaria diz onde a regiao esta de verdade. Escreve FOR_rolling_TR4_ks02 / _kscomp e os logs de oferta.";
		}
		Procedure RunTR4_ThruPenSlot02 {
			Body: {
				! CONFIRMA O KAPPA = 0.2 CONTRA A REFERENCIA BINARIA COMPLETA (~10 min). Nos periodos
				! 14-24, com 7 vertices binarios, 0.2 ganhou em todos os eixos: ciclagem 0 de 6072 (contra
				! 299 em 0.1), inflacao residual zero, erro RMS contra a binaria 1.28 kW (contra 2.36 em
				! 0.1 e 11.24 em 0.5), e 2.55 s/vertice contra 7.79 em 0.1 - tres vezes mais rapido, porque
				! a penalidade elimina a face degenerada onde o barrier penava. Na direcao 0 graus bateu
				! EXATO com a binaria, -967.04 nos dois, onde 0.1 inflava +6.22 kW.
				!
				! Mas eram 7 vertices de um periodo so. Esta passagem usa a mesma janela e a mesma
				! trajetoria de RunTR4_ThruPenTest / RunTR4_ThruPenSlot, portanto compara linha a linha
				! contra os 72 vertices binarios de _comp que ja estao em evidence_phantom_dump - dez vezes
				! mais referencia, e numa janela diferente daquela onde 0.2 foi escolhido.
				!
				! O QUE PODE DAR ERRADO. Em 28-33 o kappa_slot = 0.1 ja batia com a binaria, porque ali nao
				! havia ciclagem para remover. Entao 0.2 nao tem dump a matar e so pode PIORAR: o excedente
				! de penalidade taxa throughput legitimo. Se o desvio contra _comp crescer muito, a escolha
				! vira dependente da janela e nenhum kappa unico serve.
				MainInitialization;
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				FairMode          := 2;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				FOR_ThruPen   := 0;   FOR_ThruPenSlot := 0;
				BaselineOnly  := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_k2warm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly    := 0;
				RollSweepFrom   := 28;
				RollMaxPeriods  := 33;
				RollOfferLog    := 1;
				FOR_ThruPen     := 0;
				FOR_ThruPenSlot := 0.2;
				RollFileSuffix  := "_TR4_ks2b";   run RunFOR_Rolling;

				FOR_ThruPen       := 0;   ! restore production defaults
				FOR_ThruPenSlot   := 0;
				RollSweepFrom     := 0;
				RollMaxPeriods    := 0;
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				FairMode          := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "CONFIRMA kappa_slot = 0.2 CONTRA OS 72 VERTICES BINARIOS (~10 min). Mesma janela 28-33 e mesma trajetoria de RunTR4_ThruPenTest, portanto compara linha a linha com o _comp binario guardado em evidence_phantom_dump, alem de _k0, _k06, _k10 e _ks. O 0.2 foi escolhido em 14-24 contra apenas 7 vertices binarios, onde venceu em ciclagem, inflacao, erro RMS e tempo de solve ao mesmo tempo; aqui ele enfrenta dez vezes mais referencia numa janela onde nao ha dump para remover e portanto so pode piorar. Escreve FOR_rolling_TR4_ks2b e o log de oferta.";
		}
		Procedure RunTR9_InfeasProbe {
			Body: {
				! A INFACTIBILIDADE 28-37 DA TR9 VEM DO KAPPA OU JA EXISTIA? (~25 min)
				!
				! RunTR9_SvcChain com FOR_ThruPenSlot = 0.2 devolveu 121 de 576 vertices nao-Optimal no
				! passe _L2 e 120 no _free, em um bloco contiguo de periodos 28-37 que recupera em 38,
				! uniforme nas doze direcoes. A corrida de 2026-09-03, mesma semente (10.00-92.65 %), foi
				! 576/576 Optimal. Um termo de OBJETIVO nao pode esvaziar o conjunto factivel, entao ou a
				! causa nao e o kappa, ou o CPLEX esta reportando Infeasible para um problema que ele apenas
				! nao conseguiu resolver.
				!
				! O QUE APONTA PARA CADA LADO. Contra o kappa: _free tem FairMode = 0 e falha igual, logo
				! nao e justica; a base e Optimal nos 48 periodos; e o SOC medio no bloco (97.8-99.5 %) nao
				! separa do periodo 25 (98.8 %), que passa. A favor do kappa: o periodo 27 na direcao 0
				! lutou 164 s e saiu IntermediateNonOptimal antes de o bloco comecar, o que e cara de
				! dificuldade numerica, e a TR4 inteira passou 576/576 com o mesmo kappa.
				! Contra a hipotese numerica: de 28 em diante o Infeasible sai em 1.2 s, tempo de presolve,
				! e presolve so declara isso por razao estrutural.
				!
				! DESENHO. Warm-up de 48 periodos para a semente, depois duas passagens varrendo so 28-29,
				! identicas em tudo menos o kappa. RollSvcMode = 0 nas duas: o passe _free ja mostrou que
				! servico e justica nao sao a causa, e sem servico as duas passagens compartilham uma
				! trajetoria unica. Se kappa = 0 der Optimal e 0.2 der Infeasible, a causa e o kappa e a
				! decisao de producao reabre para a TR9. Se as duas derem Infeasible, o defeito e anterior
				! e o registro de 576/576 de 2026-09-03 precisa ser reexaminado.
				MainInitialization;
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				FairMode          := 2;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				FOR_ThruPen   := 0;   FOR_ThruPenSlot := 0;
				BaselineOnly  := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_ipwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly    := 0;
				RollSweepFrom   := 28;
				RollMaxPeriods  := 29;
				RollOfferLog    := 1;
				FOR_ThruPen     := 0;

				FOR_ThruPenSlot := 0;
				RollFileSuffix  := "_TR9_ip0";   run RunFOR_Rolling;

				FOR_ThruPenSlot := 0.2;
				RollFileSuffix  := "_TR9_ip2";   run RunFOR_Rolling;

				FOR_ThruPen       := 0;   ! restore production defaults
				FOR_ThruPenSlot   := 0;
				RollSweepFrom     := 0;
				RollMaxPeriods    := 0;
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				SCFirst           := 0;
				FairMode          := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "A INFACTIBILIDADE 28-37 DA TR9 VEM DO KAPPA? (~25 min) RunTR9_SvcChain com FOR_ThruPenSlot = 0.2 devolveu 121 de 576 vertices nao-Optimal num bloco contiguo 28-37, uniforme nas doze direcoes, com a base Optimal nos 48 periodos e a mesma semente da corrida 576/576 de 2026-09-03. Um termo de objetivo nao pode esvaziar o conjunto factivel, entao a causa e outra ou o CPLEX esta reportando Infeasible por dificuldade numerica. Varre so 28-29 em duas passagens identicas menos o kappa (0 e 0.2), sem servico, a partir de uma semente comum. Escreve FOR_rolling_TR9_ip0 / _ip2.";
		}
		Procedure RunTR9_InfeasProbe2 {
			Body: {
				! A REGRA DE DUAS CAMADAS E A CAUSA DA INFACTIBILIDADE 28-37 DA TR9? (~30 min)
				!
				! RunTR9_InfeasProbe ja descartou o kappa: FOR_ThruPenSlot 0 e 0.2 dao os mesmos 24 de 24
				! Infeasible nos periodos 28-29, e o log diz "After zero iterations CPLEX 22.1 concluded
				! that FOR_VertexCont is infeasible" - presolve, portanto estrutural, nao falha numerica.
				! Nao e justica tambem: o passe _free roda com FairMode = 0 e falha igual.
				!
				! O QUE SOBRA. SCNoImportFuture, ativa nos dois passes porque ambos usam SCFirst = 1. Ela
				! prende cada prosumidor, em todo slot depois do ofertado, ao que ele compra sob a BASE:
				! TotPcust <= SCImpRef + SCAlpha*BattMaxP + SCEps, com SCAlpha = 0 na producao. A base e
				! resolvida com FairActive = 0 e SCRefActive = 0; a varredura adiciona essa restricao e,
				! no passe L2, tambem a justica. Duas referencias tiradas de solves diferentes podem ser
				! incompativeis, e presolve detectaria isso na hora - que e exatamente o que se ve.
				!
				! Nos periodos 28-37 o SOC medio da frota e 97.8-99.5 % e varias baterias estao em 100 %.
				! Uma bateria cheia nao pode absorver PV, entao a casa exporta; se a base ja exportava tudo
				! o que podia, SCImpRef = 0 naqueles slots e a varredura fica proibida de importar QUALQUER
				! coisa ali, mesmo o que a propria fisica da casa obriga. Na TR4 isso nao aparece, e a
				! diferenca entre as duas e justamente quantas casas ficam sem margem.
				!
				! TRES PASSAGENS, mesma semente, varrendo so 28-29:
				!   _t9a  SCFirst = 0              regra desligada - isola a regra
				!   _t9b  SCFirst = 1, SCAlpha = 0.1   regra afrouxada em 10 % da potencia da bateria
				!   _t9c  SCFirst = 1, SCAlpha = 0, FairMode = 0   so a regra, sem justica
				! Se _t9a der Optimal, a causa e a regra. Se _t9b tambem der, ela e sensivel ao aperto e
				! SCAlpha e o remedio. Se _t9a AINDA der Infeasible, a causa esta em outro lugar e o
				! proximo suspeito e a banda ciclica de SOC.
				MainInitialization;
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				FOR_ThruPen       := 0;
				FOR_ThruPenSlot   := 0;

				SCFirst := 1;   SCAlpha := 0;   FairMode := 2;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly  := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_t9warm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly    := 0;
				RollSweepFrom   := 28;
				RollMaxPeriods  := 29;
				RollOfferLog    := 1;

				SCFirst := 0;   SCAlpha := 0;     FairMode := 2;
				RollFileSuffix := "_TR9_t9a";   run RunFOR_Rolling;

				SCFirst := 1;   SCAlpha := 0.1;   FairMode := 2;
				RollFileSuffix := "_TR9_t9b";   run RunFOR_Rolling;

				SCFirst := 1;   SCAlpha := 0;     FairMode := 0;
				RollFileSuffix := "_TR9_t9c";   run RunFOR_Rolling;

				SCFirst           := 0;   ! restore production defaults
				SCAlpha           := 0;
				FairMode          := 0;
				RollSweepFrom     := 0;
				RollMaxPeriods    := 0;
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "A REGRA DE DUAS CAMADAS CAUSA A INFACTIBILIDADE 28-37 DA TR9? (~30 min) O kappa ja foi descartado por RunTR9_InfeasProbe (0 e 0.2 dao os mesmos 24 Infeasible) e a justica pelo passe _free (FairMode = 0 falha igual). Sobra SCNoImportFuture, ativa nos dois porque ambos usam SCFirst = 1: ela prende cada prosumidor ao que compra sob a BASE, com SCAlpha = 0, e nos periodos 28-37 a frota esta a 97.8-99.5 % de SOC, onde SCImpRef pode ser 0 e proibir qualquer importacao que a fisica da casa obrigue. Tres passagens da mesma semente varrendo 28-29: _t9a regra desligada, _t9b SCAlpha = 0.1, _t9c regra sozinha sem justica.";
		}
		Procedure RunTR9_SCAlphaLadder {
			Body: {
				! QUANTA FOLGA A REGRA DE DUAS CAMADAS PRECISA, NOS PERIODOS 28-29 DA TR9? (~25 min)
				!
				! RunTR9_InfeasProbe2 fechou a causa: SCFirst = 0 da 24 de 24 Optimal, SCFirst = 1 da 24 de
				! 24 Infeasible com SCAlpha = 0 ou 0.1 e com ou sem justica. A regra e SCNoImportFuture.
				!
				! O QUE ESTA LADEIRA DECIDE, E POR QUE IMPORTA MAIS QUE PARECE. SCImpRef = max(0, TotPcust
				! da base), logo A PROPRIA SOLUCAO DA BASE SATISFAZ a regra: TotPcust <= max(0,TotPcust).
				! O ponto da base deveria portanto ser sempre factivel para a varredura, e presolve nunca
				! deveria declarar vazio. Que declare significa que a referencia nao corresponde ao problema
				! resolvido. Duas leituras, e a folga necessaria as separa:
				!
				!   APERTO. Se uma folga moderada (SCAlpha = 1, 3.6 kW por bateria) devolve Optimal, a
				!   restricao esta apenas justa demais para o estado daquele periodo e SCAlpha e o remedio;
				!   o artigo declara a faixa onde a regra estrita se aplica.
				!
				!   DESALINHAMENTO. Se nem SCAlpha = 5 (18 kW por bateria, muito acima de qualquer casa
				!   desta rede) devolve Optimal, nenhuma folga por bateria fecha a lacuna e o defeito e de
				!   INDEXACAO, nao de aperto: a referencia estaria caindo em slots trocados. A janela rota a
				!   cada periodo por t_k(h) = 1 + mod(k+h-2, 48), e SCImpRef e indexada sobre o slot t. Se a
				!   captura e a leitura ficam em rotacoes diferentes, a regra prende cada casa ao consumo de
				!   OUTRO horario - e o efeito seria estado-dependente, o que explicaria os periodos 1-27
				!   passarem e 28-37 nao.
				!
				! Tres passagens da mesma semente, varrendo so 28-29, identicas menos SCAlpha: 1, 5, e 1e6
				! (folga efetivamente infinita, controle que prova que a restricao e mesmo a unica em jogo -
				! se ATE ESSA der Infeasible, o problema nao esta no lado direito da desigualdade).
				MainInitialization;
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				FOR_ThruPen       := 0;
				FOR_ThruPenSlot   := 0;
				FairMode          := 2;

				SCFirst := 1;   SCAlpha := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly  := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_ldwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly    := 0;
				RollSweepFrom   := 28;
				RollMaxPeriods  := 29;
				RollOfferLog    := 1;
				SCFirst         := 1;

				SCAlpha := 1;      RollFileSuffix := "_TR9_ld1";    run RunFOR_Rolling;
				SCAlpha := 5;      RollFileSuffix := "_TR9_ld5";    run RunFOR_Rolling;
				SCAlpha := 1e6;    RollFileSuffix := "_TR9_ldinf";  run RunFOR_Rolling;

				SCFirst           := 0;   ! restore production defaults
				SCAlpha           := 0;
				FairMode          := 0;
				RollSweepFrom     := 0;
				RollMaxPeriods    := 0;
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "QUANTA FOLGA A REGRA DE DUAS CAMADAS PRECISA? (~25 min) RunTR9_InfeasProbe2 provou que SCNoImportFuture causa a infactibilidade 28-37 da TR9 (SCFirst = 0 da 24/24 Optimal; SCFirst = 1 da 24/24 Infeasible com SCAlpha 0 ou 0.1, com ou sem justica). Mas SCImpRef = max(0, TotPcust da base), logo o ponto da base SATISFAZ a regra e deveria ser sempre factivel - presolve nunca deveria declarar vazio. Esta ladeira de SCAlpha (1, 5 e 1e6) separa as duas leituras: se uma folga moderada resolve, a regra esta apenas apertada e SCAlpha e o remedio; se nem folga infinita resolve, o defeito e de INDEXACAO - a referencia caindo em slots trocados pela rotacao da janela - e nenhum SCAlpha conserta.";
		}
		Procedure RunTR9_CyclicProbe {
			Body: {
				! E A SOC CICLICA EM IGUALDADE ESTRITA? (~20 min) A infactibilidade 28-37 da TR9 nao vem do
				! kappa (0 e 0.2 identicos) nem do APERTO da regra de duas camadas: com SCAlpha = 1e6 a
				! restricao fica nao-vinculante e o problema SEGUE Infeasible, e uma linha nao-vinculante nao
				! esvazia conjunto nenhum. Logo o que SCFirst = 1 faz de relevante e mudar a BASE - ele da
				! peso w2 normal ao slot ofertado - e com ela o despacho executado e a trajetoria de SOC.
				! (Por isso o teste anterior com SCFirst = 0 nao provou o que eu li nele: aquela passagem
				! rodou com OUTRA trajetoria, nao apenas sem as linhas da regra.)
				!
				! O MECANISMO CANDIDATO. A varredura FIXA o slot 1 no despacho executado (.nonvar := 1)
				! enquanto a base o resolve livre. Com RollCyclicSOC = 1 a SOC fecha a janela em IGUALDADE
				! ESTRITA, e nos periodos 28-37 a frota esta a 97.8-100 % de SOC: os 47 slots restantes tem
				! de compensar exatamente o slot fixo sem furar o teto de 100 %. Na base o slot 1 e livre e
				! sempre existe saida; na varredura nao.
				!
				! DUAS PASSAGENS, base identica as que falham (SCFirst = 1), varrendo so 28-29:
				!   _cyb  CyclicSOCBand = 0.05   troca a igualdade pela banda ub/lb (ver CyclicSOC_eq)
				!   _cy0  RollCyclicSOC = 0      remove o fechamento da janela por completo
				! Se _cyb der Optimal, a causa e a igualdade estrita e a banda e o conserto - e a memoria ja
				! registra a banda como nao-vinculante na TR9, portanto de graca. Se so _cy0 der Optimal, o
				! fechamento da janela e incompativel com o slot fixo nesses periodos e a decisao e de modelo.
				MainInitialization;
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				RollSvcMode       := 0;
				RollSvcPeriodsCSV := "";
				FOR_ThruPen       := 0;
				FOR_ThruPenSlot   := 0;
				FairMode          := 2;
				SCFirst           := 1;
				SCAlpha           := 0;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly  := 1;   RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_cycwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly    := 0;
				RollSweepFrom   := 28;
				RollMaxPeriods  := 29;
				RollOfferLog    := 1;

				CyclicSOCBand := 0.05;   RollCyclicSOC := 1;
				RollFileSuffix := "_TR9_cyb";   run RunFOR_Rolling;

				CyclicSOCBand := 0;      RollCyclicSOC := 0;
				RollFileSuffix := "_TR9_cy0";   run RunFOR_Rolling;

				CyclicSOCBand     := 0;   ! restore production defaults
				RollCyclicSOC     := 0;
				SCFirst           := 0;
				SCAlpha           := 0;
				FairMode          := 0;
				RollSweepFrom     := 0;
				RollMaxPeriods    := 0;
				RollOfferLog      := 0;
				RollUseSOCSeed    := 0;
				BaselineOnly      := 0;
				RollFileSuffix    := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "E A SOC CICLICA EM IGUALDADE ESTRITA QUE CAUSA A INFACTIBILIDADE 28-37 DA TR9? (~20 min) Kappa esta descartado e o APERTO da regra de duas camadas tambem: com SCAlpha = 1e6 a restricao fica nao-vinculante e o problema segue Infeasible. O que SCFirst = 1 faz de relevante e mudar a base e com ela a trajetoria. A varredura fixa o slot 1 no despacho executado (.nonvar) enquanto a base o resolve livre; com RollCyclicSOC = 1 a janela fecha em igualdade estrita e nos periodos 28-37 a frota esta a 97.8-100 % de SOC, sem espaco para compensar o slot fixo. Duas passagens da mesma base: CyclicSOCBand = 0.05 (banda em vez de igualdade) e RollCyclicSOC = 0 (sem fechamento).";
		}
		Procedure RunTR9_KappaLadder {
			Body: {
				! O KAPPA CALIBRADO NA TR4 NAO TRANSFERE PARA A TR9 (~25 min para decidir o que usar).
				! Com o clamp de SOC no lugar, a TR9 varrida em 28-29 da: kappa_slot = 0 deixa 2117 de 2160
				! linhas ciclando, e kappa_slot = 0.2 - o valor fixado na producao a partir da TR4, onde
				! zerou 26496 de 26496 - ainda deixa 359, alem de devolver 3 vertices como lixo
				! (IntermediateNonOptimal com P = Q = 0). A TR9 tem 90 baterias contra 46 e e bem mais dura.
				!
				! Duas passagens, mesma semente, varrendo so 28-29, para cobrir as duas escolhas de ESCOPO:
				!   _ka5  FOR_ThruPenSlot = 0.5   mais penalidade no slot ofertado
				!   _kaA  FOR_ThruPen     = 0.1   a penalidade somada nos 48 slots
				! A segunda importa porque na TR4 ela tambem zerava a ciclagem e so foi preterida por custar
				! 3.1x; se o dump da TR9 age por outro caminho que nao o slot ofertado, ela e a que funciona.
				! Julgue pelas duas colunas juntas: linhas ciclando E vertices nao-Optimal. Na TR4 medimos que
				! kappa alto encolhe a regiao mesmo onde ciclagem nunca houve (0.5 tirou 20.8 kW em 120 graus),
				! entao matar a ciclagem nao basta como criterio.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 0;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";
				SCFirst := 1;       SCAlpha := 0;   FairMode := 2;
				FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_kawarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 28;   RollMaxPeriods := 29;   RollOfferLog := 1;

				FOR_ThruPen := 0;     FOR_ThruPenSlot := 0.5;
				RollFileSuffix := "_TR9_ka5";   run RunFOR_Rolling;

				FOR_ThruPen := 0.1;   FOR_ThruPenSlot := 0;
				RollFileSuffix := "_TR9_kaA";   run RunFOR_Rolling;

				FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;   SCFirst := 0;   SCAlpha := 0;   FairMode := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "O KAPPA DA TR4 NAO SERVE NA TR9 - QUAL SERVE? (~25 min) Com o clamp de SOC, a TR9 em 28-29 fica com 359 de 2160 linhas ciclando sob FOR_ThruPenSlot = 0.2 (o valor de producao, que na TR4 zerou 26496 de 26496) e perde 3 vertices para IntermediateNonOptimal. Duas passagens cobrindo as duas escolhas de escopo: FOR_ThruPenSlot = 0.5 e FOR_ThruPen = 0.1 (48 slots). Julgar por ciclagem E vertices nao-Optimal juntos, porque kappa alto encolhe a regiao mesmo onde ciclagem nunca houve.";
		}
		Procedure RunTR9_ScaleInvProbe {
			Body: {
				! OS VERTICES PERDIDOS DA TR9 SAO CONDICIONAMENTO? (~25 min)
				! Com o clamp de SOC no lugar e a metrica certa - importacao fantasma em kW, nao contagem de
				! linhas - kappa_slot = 0.2 FUNCIONA na TR9: corta a inflacao de 27.9 kW medianos para 1.17
				! numa regiao de 438 kW. (A contagem de linhas engana aqui: 270 das 359 linhas marcadas sob
				! kappa = 0.5 sao residuo do barrier, 5 W de carga ao lado de 1.9 kW de descarga, razao
				! circ/liquido 0.003 contra 19 do dump de verdade. O limiar de 1 W do detector marca isso;
				! na TR4 os residuos ficaram abaixo dele e por isso nunca apareceram.)
				!
				! O QUE SOBRA E O CUSTO EM VERTICES: 3 de 24 sob kappa = 0.2 e 4 sob 0.5 voltam
				! IntermediateNonOptimal com P = Q = 0, contra 0 sob kappa = 0. Num dia inteiro seriam 70-100
				! de 576. Nao e limite de tempo (time_limit = 3000 s, os solves gastaram ~31 s) e nao e falta
				! de retry: o fallback com numeric_focus = 3 e barrier_homogeneous = 1 ja existe e esses
				! vertices passaram por ele. Sobra o condicionamento do proprio cone.
				!
				! FOR_ScaleInv normaliza P e Q do inversor por BattMaxP, trocando o cone S por um cone
				! unitario com variaveis O(1) - existe no modelo exatamente para isso. Duas passagens com ele
				! ligado, kappa_slot 0.2 e 0.5, comparaveis linha a linha com _ip2 e _ka5.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 0;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";
				SCFirst := 1;       SCAlpha := 0;   FairMode := 2;
				FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;   FOR_ScaleInv := 0;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_siwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 28;   RollMaxPeriods := 29;   RollOfferLog := 1;
				FOR_ScaleInv := 1;

				FOR_ThruPenSlot := 0.2;   RollFileSuffix := "_TR9_si2";   run RunFOR_Rolling;
				FOR_ThruPenSlot := 0.5;   RollFileSuffix := "_TR9_si5";   run RunFOR_Rolling;

				FOR_ScaleInv := 0;   FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;
				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "OS VERTICES PERDIDOS DA TR9 SAO CONDICIONAMENTO? (~25 min) Sob kappa_slot = 0.2 a TR9 perde 3 de 24 vertices para IntermediateNonOptimal com P = Q = 0 (4 sob 0.5), contra 0 sob kappa = 0 - num dia inteiro, 70-100 de 576. Nao e time_limit e nao e falta de retry: o fallback numeric_focus/barrier_homogeneous ja existe e esses vertices passaram por ele. FOR_ScaleInv normaliza o cone do inversor para variaveis O(1) e existe no modelo para exatamente esse fim. Duas passagens com ele ligado, kappa 0.2 e 0.5, comparaveis linha a linha com _ip2 e _ka5. NOTA: a contagem de linhas ciclando engana na TR9 - a maioria e residuo do barrier de 5 W, razao circ/liquido 0.003 contra 19 do dump real; julgue por importacao fantasma em kW.";
		}
		Procedure RunTR9_P11Probe {
			Body: {
				! O QUE TRAVA A TR9 NO PERIODO 11? (~20 min se nao travar)
				! RunTR9_SvcChain com o clamp de SOC e RollSOCEps travou no periodo 11: os 10 primeiros
				! periodos correram a 9.8 s/vertice, o periodo 10 fechou os 12 vertices e entregou o servico,
				! a base do 11 resolveu (o SOC foi escrito), e entao um unico vertice consumiu 3 h 49 min
				! queimando CPU - com time_limit = 3000 s, ou seja 4.6 vezes o limite. Que o limite nao segure
				! indica tempo gasto FORA do solver, provavelmente na geracao da matriz, que ele nao limita.
				!
				! A corrida ANTERIOR, sem clamp e com o mesmo kappa, passou pelo periodo 11 sem nada e so
				! falhou em 28-37. Entao ou o clamp mudou a trajetoria o bastante para cair num instante
				! duro, ou ele introduziu o problema. Esta sonda reproduz o estado exato do periodo 11 -
				! varrendo a partir do 5 para que os servicos em 5 e 10 aconteçam como na corrida cheia,
				! sem o que a trajetoria seria outra - e para no 12.
				!
				! Acompanhe por FOR_rolling_progress_TR9_p11.txt, reescrito a cada vertice.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 0;    RollGMPBaseline := 0;   RollAsyncK := 0;
				SCFirst := 1;       SCAlpha := 0;
				RollSvcAngle := 180;   RollSvcRho := 0.5;
				FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;

				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FairMode := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_p11warm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollOfferLog := 1;   FairMode := 2;
				RollSvcMode := 1;    RollSvcPeriodsCSV := "5,10";
				RollSweepFrom := 5;  RollMaxPeriods := 12;
				FOR_ThruPenSlot := 0.2;
				RollFileSuffix := "_TR9_p11";   run RunFOR_Rolling;

				FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;   SCFirst := 0;   SCAlpha := 0;   FairMode := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "O QUE TRAVA A TR9 NO PERIODO 11? (~20 min se nao travar) Reproduz o estado exato do periodo 11 da corrida cheia: varre a partir do periodo 5 para que os servicos em 5 e 10 aconteçam como la - sem eles a trajetoria seria outra - e para no 12. Na corrida cheia os 10 primeiros periodos correram a 9.8 s/vertice e entao um unico vertice do periodo 11 consumiu 3 h 49 min de CPU, com time_limit = 3000 s, o que aponta tempo gasto fora do solver. A corrida anterior, sem o clamp de SOC, passou pelo 11 sem nada. Acompanhe por FOR_rolling_progress_TR9_p11.txt.";
		}
		Procedure RunTR9_CapCheck {
			Body: {
				! O CAP DO DESPACHO EXECUTADO FECHA OS PERIODOS 27-28? (~15 min)
				! A cadeia da TR9 com GMP e o clamp de SOC passou 554 de 576, perdendo exatamente dois
				! periodos: 27 com 10 de 12 IntermediateNonOptimal e 28 com 12 de 12 Infeasible. A causa foi
				! medida: o despacho de slot 1 que a varredura fixa, recalculado por aritmetica exata, punha
				! o SOC acima de BattSOCmax em 3 de 90 baterias no periodo 27 (ate 5.0e-5 p.u.) e 2 no 28
				! (1.3e-5); no 29, nenhuma, e o 29 passou inteiro. RollChgExec/RollDisExec agora sao limitados
				! ao envelope de um slot e RollSOCnext e recalculado deles.
				! Varre 27-28 a partir da mesma semente. Ambos Optimal = fechado, e so entao vale a cadeia.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 1;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";
				SCFirst := 1;       SCAlpha := 0;   FairMode := 2;
				FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_capwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 27;   RollMaxPeriods := 28;   RollOfferLog := 1;
				FOR_ThruPenSlot := 0.2;
				RollFileSuffix := "_TR9_cap";   run RunFOR_Rolling;

				FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;   SCFirst := 0;   SCAlpha := 0;   FairMode := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "O CAP DO DESPACHO EXECUTADO FECHA OS PERIODOS 27-28 DA TR9? (~15 min) A cadeia com GMP e o clamp de SOC perdeu exatamente esses dois periodos - 27 com 10 de 12 IntermediateNonOptimal, 28 com 12 de 12 Infeasible - porque o despacho de slot 1 que a varredura fixa punha o SOC acima do teto em 3 e 2 baterias respectivamente, por ate 5.0e-5 p.u.; o periodo 29 nao tinha nenhuma e passou inteiro. Valida o cap antes de gastar as 2 h 30 da cadeia.";
		}
		Procedure RunTR9_P27Bisect {
			Body: {
				! POR QUE O PERIODO 27 DA TR9 E INFACTIVEL? (~1 h) Bisseccao, uma variavel por passagem.
				!
				! ESTADO. Com os tres consertos - clamp de BattSOCstart, RollSOCEps e o cap de RollChgExec -
				! a cadeia caiu de 22 vertices ruins para 12, todos no periodo 27, todos Infeasible, todas as
				! doze direcoes. O periodo 28, que era 12 de 12 Infeasible, agora passa inteiro.
				!
				! NAO E MAIS TRANSBORDO DE SOC: no periodo 27 nenhuma bateria no teto carrega no slot 1, o
				! cap garante isso por construcao. O que o periodo 27 tem de proprio e ser a TRANSICAO DE
				! SATURACAO da frota - as baterias no teto saltam de 7 para 84 de 90 de um periodo para o
				! outro, e as que carregam caem de 79 para 5.
				!
				! DESENHO. Varre SO o periodo 27, 12 vertices por passagem, a partir de uma semente comum.
				! RollSvcMode = 0 e legitimo aqui: RunTR9_CapCheck rodou sem servicos e reproduziu o mesmo
				! padrao da cadeia com servicos (27 Infeasible, 28 Optimal), entao o fenomeno nao depende
				! deles e a passagem fica barata.
				!
				! LER COM CUIDADO: SCFirst muda a restricao SCNoImportFuture E o peso w2 da base, portanto
				! muda a trajetoria - se b3 for o unico a passar, isso ainda nao isola qual dos dois efeitos
				! e responsavel. Os outros toggles nao mexem na base.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 1;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   SCAlpha := 0;   FOR_ThruPen := 0;

				SCFirst := 1;   FairMode := 2;   FOR_ThruPenSlot := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_bswarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 27;   RollMaxPeriods := 27;   RollOfferLog := 1;

				! ---- controle, tudo como a cadeia
				RollCyclicSOC := 1;   FairMode := 2;   SCFirst := 1;   FOR_ThruPenSlot := 0.2;   AllowChargeAtPmax := 1;
				! nenhum toggle
				RollFileSuffix := "_TR9_b0";   run RunFOR_Rolling;

				! ---- RollCyclicSOC = 0
				RollCyclicSOC := 1;   FairMode := 2;   SCFirst := 1;   FOR_ThruPenSlot := 0.2;   AllowChargeAtPmax := 1;
				RollCyclicSOC := 0;
				RollFileSuffix := "_TR9_b1";   run RunFOR_Rolling;

				! ---- FairMode = 0
				RollCyclicSOC := 1;   FairMode := 2;   SCFirst := 1;   FOR_ThruPenSlot := 0.2;   AllowChargeAtPmax := 1;
				FairMode := 0;
				RollFileSuffix := "_TR9_b2";   run RunFOR_Rolling;

				! ---- SCFirst = 0
				RollCyclicSOC := 1;   FairMode := 2;   SCFirst := 1;   FOR_ThruPenSlot := 0.2;   AllowChargeAtPmax := 1;
				SCFirst := 0;
				RollFileSuffix := "_TR9_b3";   run RunFOR_Rolling;

				! ---- FOR_ThruPenSlot = 0
				RollCyclicSOC := 1;   FairMode := 2;   SCFirst := 1;   FOR_ThruPenSlot := 0.2;   AllowChargeAtPmax := 1;
				FOR_ThruPenSlot := 0;
				RollFileSuffix := "_TR9_b4";   run RunFOR_Rolling;

				! ---- AllowChargeAtPmax = 0
				RollCyclicSOC := 1;   FairMode := 2;   SCFirst := 1;   FOR_ThruPenSlot := 0.2;   AllowChargeAtPmax := 1;
				AllowChargeAtPmax := 0;
				RollFileSuffix := "_TR9_b5";   run RunFOR_Rolling;

				RollCyclicSOC := 0;   FairMode := 0;   SCFirst := 0;   FOR_ThruPenSlot := 0;   AllowChargeAtPmax := 1;
				FOR_ThruPen := 0;   SCAlpha := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "POR QUE O PERIODO 27 DA TR9 E INFACTIVEL? (~1 h) Bisseccao com uma variavel por passagem, varrendo so o periodo 27. Depois dos tres consertos de SOC a cadeia perde exatamente 12 vertices, todos ali, todas as direcoes, e o periodo 28 - que era 12 de 12 Infeasible - passa inteiro. Nao e mais transbordo: nenhuma bateria no teto carrega no slot 1. O que o 27 tem de proprio e ser a transicao de saturacao, com as baterias no teto saltando de 7 para 84 de 90. Passagens: b0 controle, b1 sem SOC ciclica, b2 sem justica, b3 sem SCFirst, b4 sem penalidade, b5 sem carga no slot de servico.";
		}
		Procedure RunTR9_P27Round2 {
			Body: {
				! SCFirst DESTRAVA O PERIODO 27 - MAS POR QUAL DOS SEUS DOIS EFEITOS? (~25 min)
				! RunTR9_P27Bisect: das seis passagens, so SCFirst = 0 devolveu 12 Optimal. RollCyclicSOC,
				! FairMode, FOR_ThruPenSlot e AllowChargeAtPmax nao mudaram nada, 12 Infeasible cada.
				!
				! Mas SCFirst faz DUAS coisas: gateia as linhas de SCNoImportFuture, e da peso w2 normal ao
				! slot ofertado na base - o que muda o despacho executado e portanto a trajetoria inteira.
				! Desligar os dois de uma vez nao diz qual importa.
				!
				! SCAlpha separa: com folga grande as linhas continuam existindo mas nao podem vincular,
				! enquanto a base fica exatamente a mesma.
				!   c0  SCAlpha = 0      controle, Infeasible esperado
				!   c1  SCAlpha = 1e6    linhas nao-vinculantes, base intacta
				!   c2  SCAlpha = 0.5    folga moderada, para ver se ha gradiente
				! c1 Optimal  -> sao as LINHAS, e SCAlpha (ou uma referencia melhor) e o remedio.
				! c1 Infeasible -> e a TRAJETORIA que SCFirst produz, e o remedio e outro: o estado em que a
				! base deixa a frota no periodo 27 e que nao admite varredura.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 1;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				RollCyclicSOC := 1; AllowChargeAtPmax := 1;

				SCFirst := 1;   SCAlpha := 0;   FairMode := 2;   FOR_ThruPenSlot := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_r2warm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 27;   RollMaxPeriods := 27;   RollOfferLog := 1;
				SCFirst := 1;   FairMode := 2;   FOR_ThruPenSlot := 0.2;

				SCAlpha := 0;     RollFileSuffix := "_TR9_c0";   run RunFOR_Rolling;
				SCAlpha := 1e6;   RollFileSuffix := "_TR9_c1";   run RunFOR_Rolling;
				SCAlpha := 0.5;   RollFileSuffix := "_TR9_c2";   run RunFOR_Rolling;

				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;   FOR_ThruPenSlot := 0;   RollCyclicSOC := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "SCFirst DESTRAVA O PERIODO 27 DA TR9 - POR QUAL DOS SEUS DOIS EFEITOS? (~25 min) Na bisseccao so SCFirst = 0 devolveu 12 Optimal; RollCyclicSOC, FairMode, FOR_ThruPenSlot e AllowChargeAtPmax nao mudaram nada. Mas SCFirst gateia as linhas de SCNoImportFuture E da peso w2 ao slot ofertado na base, mudando a trajetoria. SCAlpha separa os dois: folga grande deixa as linhas nao-vinculantes com a base intacta. c1 Optimal aponta para as linhas; c1 Infeasible aponta para a trajetoria.";
		}
		Procedure RunTR9_P27GMP {
			Body: {
				! O PERIODO 27 SO FALHA NO CAMINHO GMP? (~25 min)
				! Tudo o que foi eliminado ate aqui, sempre 12 de 12 Infeasible no periodo 27: RollCyclicSOC,
				! FairMode, FOR_ThruPenSlot, AllowChargeAtPmax, e as linhas de SCNoImportFuture (SCAlpha =
				! 1e6, nao-vinculante, segue Infeasible). So SCFirst = 0 destrava, e como as linhas estao
				! descartadas sobra o efeito dele sobre a BASE - logo sobre a trajetoria.
				!
				! A leitura fisica nao fecha. O periodo 27 nao e extremo: o 29 tem MENOS folga de carga (0.43
				! contra 0.71 em soma de 1-SOC sobre a frota) e passa, e os periodos 24-25 tem PV MAIOR e
				! passam. O cap de tensao esta colado em 1.1 em 8 de 12 vertices em todos eles igualmente.
				!
				! O QUE NAO FOI TESTADO. A corrida PRE-CLAMP, com RollUseGMP = 0, deu 10 IntermediateNonOptimal
				! no periodo 27 - nao 12 Infeasible. Todo teste desde entao usou GMP = 1, que foi ligado no
				! meio desta investigacao para contornar o travamento de 3 h 49 do periodo 11. No caminho GMP
				! a matriz e gerada uma vez por periodo e o slot 1 e preso por GMP::Column::FreezeMulti em vez
				! de .nonvar; se o congelamento e a geracao discordarem, presolve ve um problema vazio - o que
				! descreve exatamente o sintoma, e explicaria por que nenhum toggle de MODELO muda nada.
				! Duas passagens identicas menos RollUseGMP.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				RollCyclicSOC := 1; AllowChargeAtPmax := 1;
				SCFirst := 1;   SCAlpha := 0;   FairMode := 2;   FOR_ThruPenSlot := 0;

				RollUseGMP := 1;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_gpwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 27;   RollMaxPeriods := 27;   RollOfferLog := 1;
				FOR_ThruPenSlot := 0.2;

				RollUseGMP := 1;   RollFileSuffix := "_TR9_g1";   run RunFOR_Rolling;
				RollUseGMP := 0;   RollFileSuffix := "_TR9_g0";   run RunFOR_Rolling;

				RollUseGMP := 0;   SCFirst := 0;   SCAlpha := 0;   FairMode := 0;   FOR_ThruPenSlot := 0;
				RollCyclicSOC := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "O PERIODO 27 DA TR9 SO FALHA NO CAMINHO GMP? (~25 min) Nenhum toggle de modelo muda o sintoma - RollCyclicSOC, FairMode, FOR_ThruPenSlot, AllowChargeAtPmax e ate SCAlpha = 1e6 deixam os 12 vertices Infeasible - e a leitura fisica nao fecha, porque o periodo 29 tem menos folga de carga e passa. Mas a corrida pre-clamp, com RollUseGMP = 0, dava 10 IntermediateNonOptimal ali, nao 12 Infeasible, e todo teste desde entao usou GMP = 1. No caminho GMP o slot 1 e preso por FreezeMulti sobre uma matriz gerada uma vez por periodo; se congelamento e geracao discordarem, presolve ve vazio - o que casa com nenhum toggle de modelo importar. Duas passagens identicas menos RollUseGMP.";
		}
		Procedure RunTR9_P27Relax {
			Body: {
				! QUAL FAMILIA DE RESTRICOES ESVAZIA O PERIODO 27 DA TR9? (~25 min) IIS na mao.
				! Nenhuma hipotese de MECANISMO sobreviveu: RollCyclicSOC, FairMode, FOR_ThruPenSlot,
				! AllowChargeAtPmax, as linhas de SCNoImportFuture (SCAlpha = 1e6) e o caminho GMP - todos
				! deixam os 12 vertices Infeasible. So SCFirst = 0 destrava, e pelas linhas descartadas isso
				! so pode ser o efeito dele sobre a base, logo sobre a trajetoria. A leitura fisica tambem nao
				! fecha: o periodo 29 tem MENOS folga de carga que o 27 e passa, e 24-25 tem PV maior.
				!
				! Entao pare de propor mecanismo e IDENTIFIQUE o conjunto vinculante: relaxe uma familia por
				! vez ate o problema resolver. Quem destravar aponta a restricao que esta vazia.
				!   d0  controle                      Infeasible esperado
				!   d1  SOCCeilOverride = 1.05        teto de SOC relaxado 5 %
				!   d2  SOCFloorOverride = 0.0        piso de SOC de 10 % para 0
				!   d3  os dois                       se nenhum sozinho bastar
				! Se nenhum destravar, a familia e a rede (tensao) e o proximo passo e relaxar MaxV - que
				! precisa de outro ponto de aplicacao, fora do laço de baterias, por ser indexado por barra.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 1;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				RollCyclicSOC := 1; AllowChargeAtPmax := 1;
				SCFirst := 1;   SCAlpha := 0;   FairMode := 2;   FOR_ThruPenSlot := 0;
				SOCCeilOverride := -1;   SOCFloorOverride := -1;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_rxwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 27;   RollMaxPeriods := 27;   RollOfferLog := 1;
				FOR_ThruPenSlot := 0.2;

				SOCCeilOverride := -1;    SOCFloorOverride := -1;    RollFileSuffix := "_TR9_d0";   run RunFOR_Rolling;
				SOCCeilOverride := 1.05;  SOCFloorOverride := -1;    RollFileSuffix := "_TR9_d1";   run RunFOR_Rolling;
				SOCCeilOverride := -1;    SOCFloorOverride := 0.0;   RollFileSuffix := "_TR9_d2";   run RunFOR_Rolling;
				SOCCeilOverride := 1.05;  SOCFloorOverride := 0.0;   RollFileSuffix := "_TR9_d3";   run RunFOR_Rolling;

				SOCCeilOverride := -1;   SOCFloorOverride := -1;
				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;   FOR_ThruPenSlot := 0;   RollCyclicSOC := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "QUAL FAMILIA DE RESTRICOES ESVAZIA O PERIODO 27 DA TR9? (~25 min) IIS na mao: relaxa uma familia por vez ate o problema resolver, porque nenhuma hipotese de mecanismo sobreviveu - RollCyclicSOC, FairMode, FOR_ThruPenSlot, AllowChargeAtPmax, as linhas de SCNoImportFuture com SCAlpha = 1e6 e o caminho GMP deixam todos os 12 vertices Infeasible, e a leitura fisica nao fecha porque o periodo 29 tem menos folga de carga e passa. d0 controle, d1 teto de SOC 1.05, d2 piso 0, d3 os dois. Se nenhum destravar, a familia e a tensao.";
		}
		Procedure RunTR9_P27Volt {
			Body: {
				! A FAMILIA QUE ESVAZIA O PERIODO 27 E A TENSAO? (~25 min)
				! RunTR9_P27Relax eliminou a familia SOC inteira: teto 1.05, piso 0, e os dois juntos, todos
				! 12 de 12 Infeasible. Some isso ao que ja caiu - RollCyclicSOC, FairMode, FOR_ThruPenSlot,
				! AllowChargeAtPmax, as linhas de SCNoImportFuture e o caminho GMP - e sobra a rede.
				! MaxVBoost soma ao cap de tensao no fim de Load_data_reset, que toda passagem executa.
				!   e1  +0.02 p.u.   folga pequena
				!   e2  +0.10 p.u.   folga grande
				!   e3  +1.00 p.u.   cap efetivamente removido - se ATE ESSE ficar Infeasible, nao e tensao,
				!                    e o proximo suspeito e a corrente de linha ou o limite do trafo.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 1;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				RollCyclicSOC := 1; AllowChargeAtPmax := 1;
				SCFirst := 1;   SCAlpha := 0;   FairMode := 2;   FOR_ThruPenSlot := 0;
				SOCCeilOverride := -1;   SOCFloorOverride := -1;   MaxVBoost := 0;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_vxwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 27;   RollMaxPeriods := 27;   RollOfferLog := 1;
				FOR_ThruPenSlot := 0.2;

				MaxVBoost := 0.02;   RollFileSuffix := "_TR9_e1";   run RunFOR_Rolling;
				MaxVBoost := 0.10;   RollFileSuffix := "_TR9_e2";   run RunFOR_Rolling;
				MaxVBoost := 1.00;   RollFileSuffix := "_TR9_e3";   run RunFOR_Rolling;

				MaxVBoost := 0;   SOCCeilOverride := -1;   SOCFloorOverride := -1;
				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;   FOR_ThruPenSlot := 0;   RollCyclicSOC := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "A FAMILIA QUE ESVAZIA O PERIODO 27 DA TR9 E A TENSAO? (~25 min) A familia SOC foi eliminada por RunTR9_P27Relax - teto 1.05, piso 0 e os dois juntos, todos 12 Infeasible - e com RollCyclicSOC, FairMode, FOR_ThruPenSlot, AllowChargeAtPmax, SCNoImportFuture e o caminho GMP ja fora, sobra a rede. Tres folgas no cap de tensao: +0.02, +0.10 e +1.00 p.u.; se nem a ultima destravar, nao e tensao e o proximo suspeito e corrente de linha ou limite de trafo.";
		}
		Procedure RunTR9_P27CapOff {
			Body: {
				! O CAP DO DESPACHO EXECUTADO E QUE CAUSA A INFACTIBILIDADE DO PERIODO 27? (~20 min)
				! A familia vinculante ja foi identificada: e a TENSAO. Somar +0.02 p.u. a MaxV devolve os 12
				! vertices Optimal, e +0.10 e +1.00 dao a MESMA solucao (VmaxTrue 1.2035 nos tres), ou seja o
				! cap recusa um ponto em vez de moldar um.
				!
				! A hipotese do ponto de linearizacao esta MORTA: Vre0/Vim0 so sao atribuidos dentro de
				! Load_data_reset, que base e varredura executam no mesmo laco - os dois linearizam no mesmo
				! ponto, entao nao e por ai que discordam do mesmo despacho.
				!
				! SOBRA UMA SUSPEITA DESCONFORTAVEL: o cap e meu. Antes dele o periodo 27 dava 10
				! IntermediateNonOptimal e o 28 dava 12 Infeasible; depois, o 28 ficou limpo e o 27 virou 12
				! Infeasible. A falha MUDOU DE LUGAR. O cap apara o despacho que a varredura congela, e com
				! ele aparado o estado de rede daquele slot deixa de ser o que a base validou em tensao - o
				! que casa exatamente com a familia vinculante ser a tensao.
				! Duas passagens identicas menos RollExecCap.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 1;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				RollCyclicSOC := 1; AllowChargeAtPmax := 1;
				SCFirst := 1;   SCAlpha := 0;   FairMode := 2;   FOR_ThruPenSlot := 0;
				SOCCeilOverride := -1;   SOCFloorOverride := -1;   MaxVBoost := 0;   RollExecCap := 1;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_cpwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 27;   RollMaxPeriods := 27;   RollOfferLog := 1;
				FOR_ThruPenSlot := 0.2;

				RollExecCap := 1;   RollFileSuffix := "_TR9_f1";   run RunFOR_Rolling;
				RollExecCap := 0;   RollFileSuffix := "_TR9_f0";   run RunFOR_Rolling;

				RollExecCap := 1;   MaxVBoost := 0;   SOCCeilOverride := -1;   SOCFloorOverride := -1;
				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;   FOR_ThruPenSlot := 0;   RollCyclicSOC := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "O CAP DO DESPACHO EXECUTADO CAUSA A INFACTIBILIDADE DO PERIODO 27 DA TR9? (~20 min) A familia vinculante e a tensao: +0.02 p.u. em MaxV devolve 12 Optimal e +0.10/+1.00 dao a mesma solucao, logo o cap de tensao recusa um ponto em vez de molda-lo. A hipotese do ponto de linearizacao esta morta - Vre0 so e setado em Load_data_reset, que base e varredura rodam no mesmo laco. Sobra que o cap de RollChgExec, acrescentado nesta investigacao, apara o despacho congelado e muda o estado de rede que a base havia validado: a falha migrou do periodo 28 para o 27 exatamente quando o cap entrou. Duas passagens identicas menos RollExecCap.";
		}
		Procedure RunTR9_P2728Fix {
			Body: {
				! O CONSERTO CERTO: NAO APARAR O DESPACHO, E TOLERAR O TETO DE SOC (~30 min)
				! RunTR9_P27CapOff provou que o cap de RollChgExec e que quebra o periodo 27: com ele,
				! 12 Infeasible; sem ele, 11 Optimal + 1 nao-otimo, com VmaxTrue exatamente 1.1000. Mas sem o
				! cap o periodo 28 falhava por transbordo de SOC. O cap trocou uma falha por outra.
				!
				! POR QUE APARAR ERA A ESCOLHA ERRADA. O despacho congelado precisa ser viavel em SOC E em
				! TENSAO ao mesmo tempo. O valor bruto da base e viavel em tensao - a base imposse isso - mas
				! transborda o SOC por tolerancia aritmetica, ja que RollSOCnext reaplica o despacho fora do
				! solver. Aparar conserta o SOC e destroi a viabilidade de tensao que a base havia garantido.
				! O certo e nao tocar no despacho e dar ao TETO a mesma tolerancia que o solver usou ao
				! produzi-lo: os transbordos medidos foram 5.0e-5 (periodo 27) e 1.3e-5 p.u. (periodo 28),
				! entao 1e-4 - 0.42 Wh - cobre com folga.
				!
				! Varre 27-28, que sao os dois periodos que cada escolha quebrava:
				!   g1  cap OFF + teto 1.0001   o conserto proposto: ambos os periodos devem passar
				!   g2  cap OFF + teto padrao   controle: o 28 deve falhar, como antes do cap
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 1;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				RollCyclicSOC := 1; AllowChargeAtPmax := 1;
				SCFirst := 1;   SCAlpha := 0;   FairMode := 2;   FOR_ThruPenSlot := 0;
				SOCCeilOverride := -1;   SOCFloorOverride := -1;   MaxVBoost := 0;   RollExecCap := 1;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_fxwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 27;   RollMaxPeriods := 28;   RollOfferLog := 1;
				FOR_ThruPenSlot := 0.2;   RollExecCap := 0;

				SOCCeilOverride := 1.0001;   RollFileSuffix := "_TR9_g1";   run RunFOR_Rolling;
				SOCCeilOverride := -1;       RollFileSuffix := "_TR9_g2";   run RunFOR_Rolling;

				RollExecCap := 1;   SOCCeilOverride := -1;   SOCFloorOverride := -1;   MaxVBoost := 0;
				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;   FOR_ThruPenSlot := 0;   RollCyclicSOC := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "O CONSERTO CERTO PARA OS PERIODOS 27-28 DA TR9 (~30 min). RunTR9_P27CapOff provou que o cap de RollChgExec quebra o periodo 27 - com ele 12 Infeasible, sem ele 11 Optimal e VmaxTrue exatamente 1.1000 - enquanto sem o cap era o periodo 28 que falhava por transbordo de SOC. O despacho congelado precisa ser viavel em SOC E em tensao: o valor bruto da base e viavel em tensao mas transborda o teto por tolerancia aritmetica, e apara-lo destroi a viabilidade de tensao. O conserto e nao tocar no despacho e tolerar o teto em 1e-4 (0.42 Wh), acima dos transbordos medidos de 5.0e-5 e 1.3e-5. g1 e o conserto, g2 o controle.";
		}
		Procedure RunTR9_TolLadder {
			Body: {
				! QUANTA TOLERANCIA NO TETO DE SOC LEVA OS PERIODOS 27-28 A ZERO NAO-OTIMOS? (~45 min)
				! RunTR9_P2728Fix fechou o diagnostico: NAO aparar o despacho (RollExecCap = 0) e tolerar o
				! teto em 1e-4 tira TODOS os Infeasible. Contagem de vertices ruins nos periodos 27-28:
				!   cap ON, teto padrao      12  (o 27 inteiro Infeasible)   <- producao hoje
				!   cap OFF, teto padrao     13  (o 28 inteiro Infeasible)   <- antes do cap
				!   cap OFF, teto 1.0001      5  (nenhum Infeasible)
				! Os 5 que restam sao IntermediateNonOptimal: devolvem ponto viavel, so nao provado otimo -
				! bem menos grave, mas subestimam a regiao nesses vertices, e a corrida publicada de
				! 2026-09-03 era 576/576 Optimal.
				!
				! A suspeita e degenerescencia de fio de navalha, a mesma que RollSOCEps tratou no valor
				! carregado: com 1e-4 a folga entre o SOC preso (1 - 1e-6 pelo clamp) e o teto e de apenas
				! 1.01e-4. Esta ladeira abre mais e ve se os nao-otimos somem. Se 1e-2 tambem deixar 5, nao e
				! folga que falta e o proximo passo e o caminho do solver, nao o modelo.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 1;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				RollCyclicSOC := 1; AllowChargeAtPmax := 1;
				SCFirst := 1;   SCAlpha := 0;   FairMode := 2;   FOR_ThruPenSlot := 0;
				SOCCeilOverride := -1;   SOCFloorOverride := -1;   MaxVBoost := 0;   RollExecCap := 1;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_tlwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 27;   RollMaxPeriods := 28;   RollOfferLog := 1;
				FOR_ThruPenSlot := 0.2;   RollExecCap := 0;

				SOCCeilOverride := 1.001;   RollFileSuffix := "_TR9_h1";   run RunFOR_Rolling;
				SOCCeilOverride := 1.01;    RollFileSuffix := "_TR9_h2";   run RunFOR_Rolling;

				RollExecCap := 1;   SOCCeilOverride := -1;   SOCFloorOverride := -1;   MaxVBoost := 0;
				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;   FOR_ThruPenSlot := 0;   RollCyclicSOC := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "QUANTA TOLERANCIA NO TETO DE SOC ZERA OS NAO-OTIMOS DOS PERIODOS 27-28 DA TR9? (~45 min) Com RollExecCap = 0 e teto 1.0001 os Infeasible somem (12 vertices ruins caem para 5), mas restam 5 IntermediateNonOptimal e a corrida publicada era 576/576. A folga entre o SOC preso pelo clamp (1 - 1e-6) e o teto e so 1.01e-4; esta ladeira testa 1e-3 e 1e-2. Se 1e-2 tambem deixar 5, o problema nao e folga e sim o caminho do solver.";
		}
		Procedure RunTR9_FixCheck {
			Body: {
				! VALIDA O CONSERTO DEFINITIVO NOS PERIODOS 27-28 (~15 min), com os defaults de producao:
				! RollExecCap = 0 (nao apara o despacho) e RollSOCCeilTol = 1e-4 (tolera o teto SO na
				! varredura, enquanto a base e o clamp mantem o teto fisico). Esperado: nenhum Infeasible e
				! cerca de 5 IntermediateNonOptimal, que sao ruido de caminho do solver e nao falta de folga -
				! a ladeira 1e-4 / 1e-3 / 1e-2 deu 5 / 9 / 4 vertices ruins, nao monotona, com Infeasible
				! voltando em 1e-2.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR9";   DetailLoadPattern := "";
				RollUseGMP := 1;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				RollCyclicSOC := 1; AllowChargeAtPmax := 1;
				SCFirst := 1;   SCAlpha := 0;   FairMode := 2;   FOR_ThruPenSlot := 0;
				SOCCeilOverride := -1;   SOCFloorOverride := -1;   MaxVBoost := 0;

				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR9_fkwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 27;   RollMaxPeriods := 28;   RollOfferLog := 1;
				FOR_ThruPenSlot := 0.2;
				RollFileSuffix := "_TR9_fk";   run RunFOR_Rolling;

				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;   FOR_ThruPenSlot := 0;   RollCyclicSOC := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "VALIDA O CONSERTO DEFINITIVO DOS PERIODOS 27-28 DA TR9 (~15 min) com os defaults de producao: RollExecCap = 0 e RollSOCCeilTol = 1e-4. Esperado nenhum Infeasible e ~5 IntermediateNonOptimal, que sao ruido do solver: a ladeira de tolerancia deu 5/9/4 vertices ruins em 1e-4/1e-3/1e-2, nao monotona e com Infeasible de volta no maior.";
		}
		Procedure RunTR4_NoQTest {
			Body: {
				! QUANTO DE ATIVO A FROTA PAGA PELO REATIVO QUE ENTREGA? (~15 min)
				!
				! O cone do inversor, BattP_Balance^2 + Qinv^2 <= BattMaxP^2, esta SATURADO em praticamente
				! 100 % das linhas varridas: S = 3.600 kVA exatos, em todas as doze direcoes. A unica escolha
				! do sweep e ONDE no circulo cada casa se posiciona - e ela se posiciona quase toda em Q.
				! Mediana de Q por bateria, por direcao, como fracao dos 3.6 kVA:
				!   30 graus  93 %    60 graus  96 %    90 graus 100 %
				!  120 graus  95 %   150 graus  82 %   210 graus  81 %
				! Nao existe direcao onde o ativo seja majoritario. Em 60 graus o custo marginal dP/dQ e 3.5:
				! cada kvar a mais custa 3.5 kW de ativo, porque perto do topo do circulo a curva e ingreme.
				!
				! (As direcoes 0 e 180 ficam de fora dessa leitura: ali sin(theta) = 0, Q nao tem coeficiente
				! no objetivo, e o Q reportado e degenerescencia - sinal dividido quase meio a meio entre as
				! casas, desvio de 2.7 kvar cobrindo toda a faixa. Nas outras dez o sinal e unanime.)
				!
				! ESTE TESTE mede o preco disso. Com RollNoQ = 1 o Qinv fica preso em zero tambem no slot
				! ofertado, entao a regiao perde a dimensao Q por completo mas os 3.6 kVA vao INTEIROS para
				! ativo. A diferenca em P entre as duas passagens e o que a frota paga pelo reativo.
				!
				! Duas passagens da mesma semente, varrendo 20-25 (manha ate o pico solar), sem servico para
				! que compartilhem uma trajetoria unica.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR4";   DetailLoadPattern := "";
				RollUseGMP := 0;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				SCFirst := 1;       SCAlpha := 0;   FairMode := 2;

				RollNoQ := 0;   FOR_ThruPenSlot := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_qwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollOfferLog := 1;   FOR_ThruPenSlot := 0.2;

				! janela A: 20-25, pico solar, frota cheia - o ativo NAO e limitado pelo inversor
				RollSweepFrom := 20;  RollMaxPeriods := 25;
				RollNoQ := 0;   RollFileSuffix := "_TR4_withQ";   run RunFOR_Rolling;
				RollNoQ := 1;   RollFileSuffix := "_TR4_noQ";     run RunFOR_Rolling;

				! janela B: 40-45, noite, a frota TEM espaco para carregar - o regime oposto
				RollSweepFrom := 40;  RollMaxPeriods := 45;
				RollNoQ := 0;   RollFileSuffix := "_TR4_withQ_n";   run RunFOR_Rolling;
				RollNoQ := 1;   RollFileSuffix := "_TR4_noQ_n";     run RunFOR_Rolling;

				RollNoQ := 0;   FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;
				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "QUANTO DE ATIVO A FROTA PAGA PELO REATIVO? (~15 min) O cone do inversor esta saturado em ~100 % das linhas varridas e as baterias gastam 81-100 % dos 3.6 kVA em Q, sobrando 0 a 2.1 kW para P; em 60 graus o custo marginal dP/dQ chega a 3.5. Este teste desliga a capacidade reativa no slot ofertado (RollNoQ = 1), o que colapsa a regiao em Q mas libera o inversor inteiro para ativo. Duas passagens da mesma semente varrendo 20-25, sem servico. Escreve FOR_rolling_TR4_withQ e _noQ.";
		}
		Procedure RunTR4_QAllSlotsTest {
			Body: {
				! E SE AS BATERIAS SUSTENTASSEM A REDE O DIA TODO? (~20 min)
				!
				! Na producao o reativo do inversor so existe no slot ofertado. No despacho de autoconsumo
				! ele e zero, e portanto TODO o reativo que as cargas consomem sobe pelo alimentador desde o
				! PCC - o modelo nao tem outra fonte: nao ha capacitor (a leitura de CapacitorsData esta
				! comentada), nao ha susceptancia shunt, e o PV nao gera reativo (Q0minGenQ se reduz a Q0
				! porque GenQ nunca existiu).
				!
				! Medido no dia da TR4, no ponto em que a frota contribui reativo liquido zero: a rede entrega
				! 159 kvar em media, de 59 a 259 conforme o periodo. A frota inteira poderia dar 165.6 kvar e
				! fica parada. E RunTR4_NoQTest ja mostrou que essa capacidade e GRATUITA em potencia ativa -
				! o inversor nunca e o gargalo do ativo, nem de dia nem de noite.
				!
				! O QUE ESTE TESTE MEDE. Com RollQAllSlots = 1 o Qinv vira variavel de decisao em todos os
				! slots, inclusive o que e de fato executado. A comparacao e sobre o DESPACHO COMPROMETIDO:
				!   - quanto do reativo deixa de subir pelo PCC
				!   - o que isso faz com a potencia ativa trocada, ja que menos corrente reativa significa
				!     menos perda resistiva
				!   - o que isso faz com a tensao, que e o motivo pelo qual reativo local costuma ajudar
				!
				! O CSV de SOC passou a registrar Qinv1, P_PCC1 e Q_PCC1 para que o efeito seja visivel; antes
				! nada do slot 1 era gravado alem de carga e descarga.
				!
				! Duas passagens da mesma semente, dia inteiro de base, varrendo so 20-25 para nao gastar
				! tempo com a regiao - o que interessa aqui e a base, nao a varredura.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR4";   DetailLoadPattern := "";
				RollUseGMP := 0;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				SCFirst := 1;       SCAlpha := 0;   FairMode := 2;   RollNoQ := 0;

				RollQAllSlots := 0;   FOR_ThruPenSlot := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_qawarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 20;   RollMaxPeriods := 25;   RollOfferLog := 1;
				FOR_ThruPenSlot := 0.2;

				RollQAllSlots := 0;   RollFileSuffix := "_TR4_qslot";   run RunFOR_Rolling;
				RollQAllSlots := 1;   RollFileSuffix := "_TR4_qall";    run RunFOR_Rolling;

				RollQAllSlots := 0;   RollNoQ := 0;   FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;
				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "E SE AS BATERIAS SUSTENTASSEM A REDE O DIA TODO? (~20 min) Na producao o reativo do inversor so existe no slot ofertado, entao o autoconsumo nao da nenhum e todo o reativo das cargas sobe pelo PCC - o modelo nao tem capacitor, shunt nem reativo de PV. Medido: a rede entrega 159 kvar medios no dia da TR4, contra uma frota capaz de 165.6 que fica parada, e RunTR4_NoQTest ja mostrou que essa capacidade nao custa ativo. Com RollQAllSlots = 1 o Qinv vira decisao em todos os slots. Compara o despacho comprometido: reativo no PCC, ativo trocado e tensao. O CSV de SOC agora registra Qinv1, P_PCC1 e Q_PCC1.";
		}
		Procedure RunTR4_QimpLadder {
			Body: {
				! O AUTOCONSUMO DEVE INCLUIR O REATIVO? (~30 min) Ladeira do peso QimpPen.
				!
				! Hoje o objetivo do autoconsumo e feito so de grandezas ativas, entao todo o reativo que as
				! cargas consomem sobe pelo PCC: 159 kvar medios no dia da TR4, contra uma frota capaz de
				! 165.6 kvar que fica parada - e RunTR4_NoQTest mostrou que essa capacidade nao custa ativo.
				!
				! Soltar Qinv sem mais nada NAO resolve: RunTR4_QAllSlotsTest mediu o solver parando em 51.6
				! kvar de ABSORCAO, o que faz o PCC importar MAIS reativo, porque a variavel e degenerada -
				! ninguem no objetivo se importa com ela. A dispersao denuncia: mediana de 1.05 kvar por
				! bateria contra os 3.6 que o circulo permitiria se houvesse proposito.
				!
				! ESTA LADEIRA da ao objetivo a razao que faltava: minimizar o reativo IMPORTADO no PCC, pela
				! parte positiva de Q_PCC. Quatro pesos, para ver a curva de compromisso entre o reativo que
				! deixa de subir e o que isso custa em autoconsumo ativo:
				!   0     producao, o termo nem existe
				!   0.2   um decimo do preco de uma unidade de troca ativa numa casa
				!   2     o MESMO preco (w2max = 2.0) - a referencia natural
				!   20    dez vezes, para ver onde a curva satura
				!
				! So a base, sem varredura: o que muda aqui e o despacho executado, nao a regiao. Por isso
				! BaselineOnly = 1 nas quatro passagens, o que as torna baratas.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR4";   DetailLoadPattern := "";
				RollUseGMP := 0;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;   FOR_ThruPenSlot := 0;
				SCFirst := 1;       SCAlpha := 0;   FairMode := 0;   RollNoQ := 0;

				RollQAllSlots := 0;   QimpPen := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_qiwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;   BaselineOnly := 1;

				! referencia: producao, reativo preso em zero fora do slot ofertado
				RollQAllSlots := 0;   QimpPen := 0;
				RollFileSuffix := "_TR4_qi_prod";   run RunFOR_Rolling;

				! com o reativo solto e o circulo valendo em todos os slots
				RollQAllSlots := 1;
				QimpPen := 0.2;   RollFileSuffix := "_TR4_qi_02";   run RunFOR_Rolling;
				QimpPen := 2;     RollFileSuffix := "_TR4_qi_2";    run RunFOR_Rolling;
				QimpPen := 20;    RollFileSuffix := "_TR4_qi_20";   run RunFOR_Rolling;

				QimpPen := 0;   RollQAllSlots := 0;   RollNoQ := 0;
				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "O AUTOCONSUMO DEVE INCLUIR O REATIVO? (~30 min) Ladeira de QimpPen, o peso sobre o reativo importado no PCC. O objetivo de producao e feito so de grandezas ativas, entao os 159 kvar medios que as cargas pedem sobem todos pelo PCC enquanto a frota capaz de 165.6 fica parada. Soltar Qinv sem termo no objetivo nao resolve - a variavel fica degenerada e o solver parou em 51.6 kvar de absorcao, piorando o balanco. Quatro pesos (0, 0.2, 2, 20) para ver a curva de compromisso; w2max = 2.0 e a referencia natural. So a base, sem varredura.";
		}
		Procedure RunTR4_QimpRegion {
			Body: {
				! O QUE A SUFICIENCIA REATIVA CUSTA NA REGIAO? (~20 min)
				! RunTR4_QimpLadder mostrou que dar ao autoconsumo um termo sobre o reativo importado no PCC
				! derruba esse reativo de 159.1 para 23.9 kvar - 85 % - custando 0.14 % em ativo, e que a
				! curva satura ja no menor peso porque o limite e a capacidade da frota, nao o preco.
				!
				! Mas isso ocupa os inversores o dia inteiro: mediana de 3.578 dos 3.6 kvar, 60 % das linhas
				! coladas no circulo. A capacidade que antes estava livre para o SERVICO passou a ter dono, e
				! a regiao ofertada deve encolher em Q. Este teste mede quanto.
				!
				! Duas passagens da mesma semente, varrendo 20-25. A segunda so e comparavel porque
				! RollQinvExec agora congela tambem o reativo comprometido do slot 1 - sem isso as doze
				! direcoes partiriam de estados diferentes.
				MainInitialization;
				UseBattComp := 0;   ReduceNetwork := 1;   DetailTagCSV := "TR4";   DetailLoadPattern := "";
				RollUseGMP := 0;    RollGMPBaseline := 0;   RollAsyncK := 0;
				RollSvcMode := 0;   RollSvcPeriodsCSV := "";   FOR_ThruPen := 0;
				SCFirst := 1;       SCAlpha := 0;   FairMode := 2;   RollNoQ := 0;

				RollQAllSlots := 0;   QimpPen := 0;   FOR_ThruPenSlot := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;
				BaselineOnly := 1;    RollUseSOCSeed := 0;
				RollFileSuffix := "_TR4_qrwarm";   run RunFOR_Rolling;
				SeedCount := 0;
				for (bat) do
					SeedCount := SeedCount + 1;
					SeedBatt( Element(SeedIdx, SeedCount) ) := FormatString("%e", bat);
					SeedSOC ( Element(SeedIdx, SeedCount) ) := BattSOCstart(bat);
				endfor;
				RollUseSOCSeed := 1;

				BaselineOnly := 0;   RollSweepFrom := 20;   RollMaxPeriods := 25;   RollOfferLog := 1;
				FOR_ThruPenSlot := 0.2;

				RollQAllSlots := 0;   QimpPen := 0;   RollFileSuffix := "_TR4_reg_prod";   run RunFOR_Rolling;
				RollQAllSlots := 1;   QimpPen := 2;   RollFileSuffix := "_TR4_reg_qimp";   run RunFOR_Rolling;

				RollQAllSlots := 0;   QimpPen := 0;   RollNoQ := 0;   FOR_ThruPenSlot := 0;
				SCFirst := 0;   SCAlpha := 0;   FairMode := 0;
				RollSweepFrom := 0;   RollMaxPeriods := 0;   RollOfferLog := 0;   RollUseSOCSeed := 0;
				BaselineOnly := 0;   RollFileSuffix := "";   ReduceNetwork := 0;   DetailTagCSV := "";
			}
			Comment: "O QUE A SUFICIENCIA REATIVA CUSTA NA REGIAO OFERTADA? (~20 min) Com QimpPen o autoconsumo passa a usar os inversores o dia inteiro (mediana 3.578 dos 3.6 kvar), entao a capacidade que estava livre para o servico agora tem dono e a regiao deve encolher em Q. Duas passagens da mesma semente varrendo 20-25, comparaveis porque RollQinvExec congela tambem o reativo comprometido do slot 1.";
		}
		Procedure RunMicro_SCAlphaSweep {
			Body: {
				! WHAT DOES THE CAUTION COST? SCAlpha is how much a prosumer may be left buying at a FUTURE
				! slot as a consequence of serving now, as a fraction of its battery rating. At 0 - the
				! production setting - serving now may not make anyone buy later at all, and SCNoImportFuture
				! holds every slot after the service one to the baseline outcome. Raising it trades that
				! guarantee for a larger offer.
				!
				! It does NOT relax the baseline. That never buys, at any value of SCAlpha - the two layers
				! stay apart. What moves is only how much of a later purchase the OFFER is allowed to cause.
				!
				! ~10 min per point, about an hour for the six below. Edit the list here and keep SCAlphaN in
				! step with its length.
				!
				! WHAT TO PLOT: region area and P span from FOR_rolling_micro_a<n>.csv against the purchases
				! that appear in FOR_rolling_soc_micro_a<n>.csv outside the service slots, relative to the
				! alpha = 0 run, which causes none by construction.
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "_two";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				FairMode          := 0;
				SCFirst           := 1;
				RollSvcPeriodsCSV := "5,10";
				RollSvcAngle      := 180;
				RollSvcRho        := 0.5;
				RollSvcMode       := 1;   ! GENERATE at every point, from that alpha's own region
				
				SCAlphaList( Element(SCAlphaSet,1) ) := 0.00;
				SCAlphaList( Element(SCAlphaSet,2) ) := 0.05;
				SCAlphaList( Element(SCAlphaSet,3) ) := 0.10;
				SCAlphaList( Element(SCAlphaSet,4) ) := 0.25;
				SCAlphaList( Element(SCAlphaSet,5) ) := 0.50;
				SCAlphaList( Element(SCAlphaSet,6) ) := 1.00;
				
				for (sa) do
					SCAlpha        := SCAlphaList(sa);
					RollFileSuffix := "_micro_a" + FormatString("%i", round(SCAlpha*100));
					run RunFOR_Rolling;
				endfor;
				
				SCFirst           := 0;   ! restore production defaults
				SCAlpha           := 0;
				RollSvcMode       := 0;
				RollFileSuffix    := "";
				DetailLoadPattern := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "SCAlpha sweep on the micro bed (~1 h): the same day at 0, 0.05, 0.10, 0.25, 0.50, 1.00, where SCAlpha is how much a prosumer may be left buying at a later slot because of serving now. Traces what the strict guarantee costs in offered range. The baseline never buys at any setting - only the offer loosens. Writes FOR_rolling*_micro_a0 / _a5 / _a10 / _a25 / _a50 / _a100.";
		}
		Procedure RunMicro_L2TwoLayer {
			Body: {
				! (Named RunMicro_L2TwoLayer, not RunMicro_FairL2: that name is already taken by the
! pre-existing level-2 wrapper from the fairness work, which runs a different case.)
! Is period 36 a level-1 problem or a fairness problem? RunMicro_TSOChain came back with all
				! twelve directions of period 36 infeasible under FairMode = 1, with every battery at 100 % SOC
				! and zeta pinned into a 0.002-wide slot. Level 2 allocates between AGGREGATORS and leaves the
				! split inside each one free, so if the cause is the rigidity of level 1 this run clears it.
				! That is the same way level 2 escaped the collapse level 1 suffered on TR9.
				!
				! ~10 min, standalone. The four points are the ones RunMicro_TSOChain actually requested in its
				! no-fairness pass, written out here so this run needs no earlier run in the session and lands
				! on exactly the same targets. It goes through RollSvcMode = 3, the TSO-names-its-own-point
				! path, which also gives that path its first exercise.
				!
				! EXPECT SOME REFUSALS, and they are a result rather than a fault. The points were built at half
				! the reach of the UNFAIR region, and the fair region is 22 % narrower in P, so a point can sit
				! outside it. Those come out as event=refused, status=OutsideFOR in FOR_rolling_svc_micro_L2.csv
				! instead of being silently dropped - which is precisely what the interiority check is for.
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "_two";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;
				RollSvcPeriodsCSV := "5,10,25,40";
				RollSvcMode       := 3;   ! the TSO names the point; no generate pass needed
				
				! nPeriods FIRST. Time is ElementRange(1,nPeriods) and RunFOR_Rolling only sets nPeriods
				! once it starts, so in a fresh session Time is still empty here - Element(Time,5) resolves
				! to nothing and the assignments below are silently discarded. That is exactly how the
				! 2026-09-01 run came back with four refusals against a request of (0,0).
				nPeriods := 48;
				
				RollSvcAskP( Element(Time, 5) ) :=  0.290242;   RollSvcAskQ( Element(Time, 5) ) := 0.038293;
				RollSvcAskP( Element(Time,10) ) :=  0.077381;   RollSvcAskQ( Element(Time,10) ) := 0.035206;
				RollSvcAskP( Element(Time,25) ) := -2.123147;   RollSvcAskQ( Element(Time,25) ) := 0.204624;
				RollSvcAskP( Element(Time,40) ) :=  0.929639;   RollSvcAskQ( Element(Time,40) ) := 0.204393;
				
				FairMode := 2;   RollFileSuffix := "_micro_L2";   run RunFOR_Rolling;
				
				SCFirst           := 0;   ! restore production defaults
				FairMode          := 0;
				RollSvcMode       := 0;
				RollFileSuffix    := "";
				DetailLoadPattern := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "FairMode 2 on the micro bed (~10 min, standalone) under the two-layer rule, asking for the same four points RunMicro_TSOChain requested. Built to settle whether the period-36 infeasibility is specific to level 1 - level 2 leaves the split inside each aggregator free. Uses RollSvcMode = 3, so it is also the first exercise of the TSO-names-its-own-point path; points that fall outside the narrower fair region are logged as refused rather than dropped.";
		}
		Procedure RunMicro_TSOChain {
			Body: {
				! THE FULL CHAIN, on the micro bed (~30 min). One pass per link:
				!
				!   prosumer  covers its own load, never buying          -> SCFirst = 1
				!   aggregator pools whatever is left                    -> the per-aggregator columns of the fair CSV
				!   TSO        gets the region computed twice            -> FairMode 0 then 1
				!   DSO        picks which of the two applies            -> chooses which CSV to act on
				!   TSO        names an operating point inside it        -> RollSvcMode = 3, any (P,Q)
				!
				! Run 1 GENERATES the request from its own region; run 2 REPLAYS the same point under fairness, so
				! the two views are answering the same question. Run 3 asks for nothing and is the reference the
				! induced-import check is made against - the whole point of SCNoImportFuture is that runs 1 and 2
				! buy no more than run 3 outside the service slots.
				!
				! To let the TSO name its own point instead, set RollSvcMode := 3 and fill RollSvcAskP/RollSvcAskQ
				! for the periods in RollSvcPeriodsCSV. A point outside the region is logged as 'refused' with
				! status OutsideFOR rather than silently skipped.
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "_two";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				SCFirst           := 1;
				SCAlpha           := 0;   ! strict: serving now may not leave anyone buying later
				RollSvcPeriodsCSV := "5,10,25,40";   ! night, early morning, midday peak, evening
				RollSvcAngle      := 180;
				RollSvcRho        := 0.5;
				
				FairMode := 0;   RollSvcMode := 1;   RollFileSuffix := "_micro_nofair";   run RunFOR_Rolling;
				FairMode := 1;   RollSvcMode := 2;   RollFileSuffix := "_micro_fair";     run RunFOR_Rolling;
				FairMode := 0;   RollSvcMode := 0;   RollFileSuffix := "_micro_ref";      run RunFOR_Rolling;
				
				SCFirst           := 0;   ! restore production defaults
				FairMode          := 0;
				RollSvcMode       := 0;
				RollFileSuffix    := "";
				DetailLoadPattern := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "THE FULL DSO/TSO CHAIN (~30 min, micro bed) under the two-layer rule. Three passes: FairMode 0 generating the request, FairMode 1 replaying the same point, and a no-service reference. Requests at periods 5, 10, 25 and 40 so night, morning, midday and evening are all exercised. Compare the two FORs to see what fairness costs the offer; compare either against _micro_ref to confirm no purchase was induced outside the service slots.";
		}
		Procedure RunMicro_SCFirst {
			Body: {
				! TWO-LAYER RULE (SCFirst = 1). The baseline never buys from the grid for a prosumer's own load;
				! the offer on top of it is bounded by physics, and by SCNoImportFuture so that serving now
				! cannot leave anyone buying later. Two runs, ~20 min:
				!
				!   FOR_rolling_soc_micro_scfirst.csv        services requested and delivered
				!   FOR_rolling_soc_micro_scfirst_nosvc.csv  same run, nothing ever requested
				!
				! THE TEST IS NOT THAT THEY MATCH - under this rule a delivered service DOES move the batteries,
				! deliberately. The test is that the two runs buy the SAME AMOUNT from the grid outside the two
				! service slots. Any extra purchase at a later period means SCNoImportFuture is not binding where
				! it should. On the reference run only h312_C and h316_A ever buy, for seven half-hours, both
				! because they reach the 10 % floor - that much is unavoidable and is what SCImpRef encodes.
				!
				! What SHOULD differ is the offered region: FOR_rolling_micro_scfirst.csv against
				! FOR_rolling_micro_nosvc.csv shows what pinning the active dispatch costs the offer. Expect the
				! reactive extent to survive nearly intact and the active extent to collapse - see the
				! SelfConsumptionFirst section.
				!
				! FairMode is free now. The two-layer rule pins nothing at the service slot, so modes 1 and 2 no
				! longer contradict it - run at 0 first, then at 1 and 2 for the DSO's two views.
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "_two";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				FairMode          := 0;
				SCFirst           := 1;
				SCAlpha           := 0;   ! strict: the service may cost NOTHING in self-consumption
				RollSvcPeriodsCSV := "5,10";
				RollSvcAngle      := 180;
				RollSvcRho        := 0.5;
				
				RollSvcMode := 1;   RollFileSuffix := "_micro_scfirst";        run RunFOR_Rolling;
				RollSvcMode := 0;   RollFileSuffix := "_micro_scfirst_nosvc";  run RunFOR_Rolling;
				
				SCFirst           := 0;   ! restore production defaults
				RollSvcMode       := 0;
				RollFileSuffix    := "";
				DetailLoadPattern := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "TWO-LAYER RULE test (~20 min, micro bed). Runs the day twice under SCFirst=1, once delivering the two services and once refusing them. The test is NOT that the two match - a delivered service moves the batteries on purpose here - but that neither run buys from the grid outside the service slots beyond the unavoidable floor purchases. FairMode is free under this rule.";
		}
		Procedure RunMicro_NoSvc {
			Body: {
				! COUNTERFACTUAL for the closed-loop service test: the SAME micro bed, the SAME fairness
				! setting, the SAME everything - except that no service is ever requested. Differencing this
				! against RunMicro_SvcSmoke's output is what turns "the service costs self-consumption" from
				! an attribution into a measurement.
				!
				! ONE no-service run serves as the baseline for BOTH scenarios. Fairness reaches the executed
				! dispatch only through the commitment solve (FairActive = 1 there); the committed baseline runs
				! with FairActive = 0 either way. So with no service delivered, FairMode does not move the SOC
				! trajectory at all - which is the same property that makes the pre-service case-A comparison
				! legitimate. FairMode is set to 1 here only so the swept REGIONS pair with _micro_svcL1.
				!
				! Full sweep rather than BaselineOnly: the dispatch would be identical either way, but the
				! regions are wanted too - comparing the FOR at a period AFTER a delivered service against the
				! same period here is the direct evidence that the offer adapts to what was already taken.
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "_two";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				RollSvcMode       := 0;   ! <- the only difference from RunMicro_SvcSmoke
				FairMode          := 1;
				RollFileSuffix    := "_micro_nosvc";
				run RunFOR_Rolling;
				
				FairMode          := 0;
				RollFileSuffix    := "";
				DetailLoadPattern := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "COUNTERFACTUAL (~10 min): the micro bed with NO service requested, everything else identical to RunMicro_SvcSmoke. Difference FOR_rolling_soc_micro_nosvc.csv against the _svcL1 / _svcA trajectories to measure what the two delivered services actually cost in self-consumption. One run covers both scenarios: with no service delivered, FairMode does not reach the executed dispatch.";
		}
		Procedure RunMicro_ProRataDump {
			Body: {
				ProRataOn   := 1;
				ProRataDump := 1;
				run RunMicro_SvcSmoke;
				ProRataDump := 0;
				ProRataOn   := 0;
			}
			Comment: "RunMicro_SvcSmoke with the pro-rata diagnostic AND its per-battery dump on, about 10 min. Written to settle why four TR4 points solved Optimal while the pro-rata split asked 3.69-3.71 kW of a 3.6 kW inverter. Reads FOR_rolling_prdump_micro_*.csv: if set_* equals got_* on every row then .nonvar held and the anomaly is elsewhere; if they differ - most likely on q - the solver was free to re-optimise that variable, which would explain the Optimal status and would also mean the delivery errors measured on TR4 belong to a partly re-optimised dispatch rather than to the pro-rata rule.";
		}
		Procedure RunMicro_ProRataSmoke {
			Body: {
				ProRataOn := 1;
				run RunMicro_SvcSmoke;
				ProRataOn := 0;
			}
			Comment: "SMOKE TEST for ProRataOn on the TR9_two micro bed, about 10 min. Runs RunMicro_SvcSmoke unchanged with the pro-rata diagnostic switched on, so the service CSVs it writes must be IDENTICAL to a plain RunMicro_SvcSmoke - the diagnostic solve sits before the commit loop, which reopens with empty allvariables and Load_data_reset, so it can only measure, never steer. That equality is the acceptance test. The new output is FOR_rolling_prorata_micro_svcL1.csv and _micro_svcA.csv: one row per committed point, with alphaP/alphaQ, where the network landed with the batteries FIXED to the pro-rata split (pr_P/pr_Q) against what was asked (req_P/req_Q), the largest |S| the split demanded, and the voltage extremes it caused. Check before trusting any number: status Optimal on every row, and pr_* close to req_*.";
		}
		Procedure RunMicro_SvcSmoke {
			Body: {
				! SMOKE TEST of the closed-loop service path on the TR9_two micro bed (12 batteries, ~10 min
				! per run against ~1.1 h on TR4). Exercises BOTH modes - one GENERATE and one REPLAY - because
				! they are different branches: GENERATE builds the request from a swept vertex, REPLAY reads it
				! back and can shrink it. Run this before spending hours on RunTR4_SvcChain.
				!
				! WHAT TO CHECK in FOR_rolling_svc_micro*.csv:
				!   - two rows per request, event=commit then event=execute;
				!   - real_P/real_Q on the execute row reproduce req_P/req_Q to solver tolerance. That is the
				!     acceptance test: it says the committed dispatch really was executed. If P matches but Q
				!     does not, the Qinv re-fix at slot 1 is the thing to look at;
				!   - scale = 1 everywhere. Anything less means a request was not deliverable as asked.
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "_two";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollAsyncK        := 0;
				RollSvcPeriodsCSV := "5,10";
				RollSvcAngle      := 180;
				RollSvcRho        := 0.5;

				FairMode := 1;   RollSvcMode := 1;   RollFileSuffix := "_micro_svcL1";   run RunFOR_Rolling;
				FairMode := 0;   RollSvcMode := 2;   RollFileSuffix := "_micro_svcA";    run RunFOR_Rolling;

				FairMode          := 0;
				RollSvcMode       := 0;
				RollFileSuffix    := "";
				DetailLoadPattern := "";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
			}
			Comment: "SMOKE TEST (~20 min) of the closed-loop service path on the TR9_two micro bed: one GENERATE run and one REPLAY run, so both branches are exercised. Acceptance test is real_P/real_Q reproducing req_P/req_Q on the execute rows of FOR_rolling_svc_micro*.csv. Run before RunTR4_SvcChain.";
		}
		Procedure RunTR1 {
			Body: {
				RunTrafoFOR("TR1");
			}
			Comment: "One click: rolling FOR for TR1 -> FOR_rolling_TR1.csv + FOR_rolling_soc_TR1.csv.";
		}

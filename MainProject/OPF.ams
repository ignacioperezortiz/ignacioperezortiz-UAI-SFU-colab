		Procedure RunTR4_Base_Net {
			Body: {
				! EXPERIMENT CONTROL (Prof. Luis, baseline-without-network test), step 1 of 2.
				! Baseline-only TR4 run WITH the network: the same 48 committed self-consumption
				! solves the production run makes, sweep skipped. Writes FOR_rolling_soc_TR4_basenet.csv
				! only - production TR4 files are NOT touched.
				! Purpose: prove the BaselineOnly harness reproduces the production committed dispatch
				! (compare vs FOR_rolling_soc_TR4_gmp.csv, expect Chg1/Dis1/SOC identical), so any
				! difference seen in RunTR4_Base_NoNet is attributable to the network constraints alone.
				UseBattComp       := 0;
				BaselineOnly      := 1;
				RollFileSuffix    := "_TR4_basenet";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				BaselineOnly      := 0;
			}
			Comment: "EXPERIMENT CONTROL: TR4 committed baseline only (48 solves, no sweep), network constraints ON, suffix _TR4_basenet. Expect Chg1/Dis1/SOC identical to FOR_rolling_soc_TR4_gmp.csv. Run before RunTR4_Base_NoNet.";
		}
		Procedure RunTR4_Base_NoNet {
			Body: {
				! EXPERIMENT (Prof. Luis, baseline-without-network test), step 2 of 2.
				! Same 48 committed self-consumption solves, but with BaseNoNetwork=1 so
				! IncludeNetworkConstraints=0: battery/energy model only - no voltage, thermal or
				! power-flow rows. Writes FOR_rolling_soc_TR4_basenonet.csv only.
				! Hypothesis: the network never binds on the slot-1 dispatch (imports are
				! SOC-floor-limited, midday export is saturation-forced), so Chg1/Dis1/SOC should be
				! identical to the _basenet control. If they are, the baseline can be solved as a
				! per-house energy problem and the network work left to the sweep.
				UseBattComp       := 0;
				BaselineOnly      := 1;
				BaseNoNetwork     := 1;
				RollFileSuffix    := "_TR4_basenonet";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				BaseNoNetwork     := 0;
				BaselineOnly      := 0;
			}
			Comment: "EXPERIMENT: TR4 committed baseline only (48 solves, no sweep), network constraints OFF via BaseNoNetwork=1, suffix _TR4_basenonet. Compare against the _TR4_basenet control: identical Chg1/Dis1/SOC means the network never binds on the committed self-consumption dispatch.";
		}
		Procedure RunTR4_GMP_BaseNoNet {
			Body: {
				! EXPERIMENT (Prof. Luis, baseline-without-network), STAGE 2: the full production TR4
				! rolling FOR - GMP sweep, network ON in every directional solve - but the committed
				! baseline solved as the battery/energy model only (BaseNoNetwork=1).
				! RollGMPBaseline stays 0: the baseline no longer rides the sweep instance; its own
				! battery-only matrix generates+solves in ~0.3 s/period (measured: 48 solves in 13 s).
				! Writes FOR_rolling_TR4_gmpnonet.csv + FOR_rolling_soc_TR4_gmpnonet.csv.
				! A/B against the production GMP run:
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR4_gmp.csv FOR_rolling_TR4_gmpnonet.csv
				! Expect: identical SOC (stage 1 proved Chg1/Dis1 network-independent to 0.27 W) and
				! proj within tolerance. Any vertex infeasibility would mean the committed dispatch
				! needs the network after all - that is the thing this stage tests.
				UseBattComp       := 0;
				BaseNoNetwork     := 1;
				RollFileSuffix    := "_TR4_gmpnonet";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 0;
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				BaseNoNetwork     := 0;
			}
			Comment: "EXPERIMENT STAGE 2: full TR4 rolling FOR (GMP sweep, network ON) with the committed baseline solved battery-only (BaseNoNetwork=1). 576 vertices -> FOR_rolling_TR4_gmpnonet.csv. Compare against FOR_rolling_TR4_gmp.csv; the invariant is proj, not P/Q.";
		}
		Procedure RunTR4_Timing_ABA {
			Body: {
				! FAIR-TIMING experiment. The Aug-10 vs Aug-13 wall-clock comparison of RunTR4_GMP vs
				! RunTR4_GMP_BaseNoNet was confounded by machine load: the 576 sweep solves - identical
				! problems in both runs - took +70% solver time on the loaded Aug-13 machine, burying the
				! baseline saving. This wrapper reruns the pair back-to-back in ONE session on an idle
				! machine, A-B-A order: production GMP (A1), BaseNoNetwork (B), production GMP again (A2).
				! If A1 ~ A2 the environment was stable and the A-B gap is attributable to BaseNoNetwork
				! alone. Fresh suffixes so the Aug-10/13 reference files are NOT overwritten.
				! Wall clock per leg = CSV CreationTime -> LastWriteTime. Expect ~36 min/leg idle, ~1h50 total.

				! A1 - production GMP config (clone of RunTR4_GMP, suffix changed)
				UseBattComp       := 0;
				RollFileSuffix    := "_TR4_gmpA1";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				run RunFOR_Rolling;

				! B - committed baseline battery-only (clone of RunTR4_GMP_BaseNoNet, suffix changed)
				RollGMPBaseline   := 0;
				BaseNoNetwork     := 1;
				RollFileSuffix    := "_TR4_gmpnonetB";
				run RunFOR_Rolling;

				! A2 - production GMP config again (drift check)
				BaseNoNetwork     := 0;
				RollGMPBaseline   := 1;
				RollFileSuffix    := "_TR4_gmpA2";
				run RunFOR_Rolling;

				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "FAIR-TIMING: RunTR4_GMP vs RunTR4_GMP_BaseNoNet back-to-back on an idle machine, A-B-A order. Writes _TR4_gmpA1 / _TR4_gmpnonetB / _TR4_gmpA2 files (Aug-10/13 references untouched). Wall clock per leg from CSV CreationTime -> LastWriteTime; A1 ~ A2 certifies a stable environment.";
		}
		Procedure RunTR1_Base {
			Body: {
				! ---------------------------------------------------------------------------
				! FIRST OF THE CONTROLLED-BASELINE SET (RunTR1_Base .. RunTR9_Base).
				! One transformer per FRESH AIMMS session, so every run starts from the same
				! machine state and the wall clocks are comparable to EACH OTHER. This is the
				! point of the set: the 2026-08-17/18 campaign was measured across a batch,
				! across days and across machine loads, and a measured 1.48x of it turned out
				! to be session state rather than the model.
				!
				! PROTOCOL (all nine, or the comparison is void):
				!   1. reboot, and open nothing but AIMMS;
				!   2. start scripts/watch_runs.ps1 once, and leave it running;
				!   3. open AIMMS, run ONE RunTRn_Base, close AIMMS WITHOUT SAVING;
				!   4. repeat from 3 for the next transformer.
				! Closing between runs is not optional - it is what makes the base the same.
				!
				! Split is size-adaptive, from the TR6 probe of 2026-08-18: 6x4 at or below
				! ~120 batteries, 4x6 above. Sizes (batteries): TR4 46, TR3 49, TR1 77,
				! TR9 90, TR2 95, TR8 124, TR5 214, TR7 259, TR6 262.
				!
				! Writes FOR_rolling_TRn_base.csv, so nothing from the earlier passes
				! (_gmp, _async, _asyncB) is touched.
				! ---------------------------------------------------------------------------

				! CONTROLLED BASELINE, TR1 (77 batteries, small -> 6 sessions x 4 threads).
				! Run this alone in a fresh AIMMS session, then close AIMMS without saving.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR1_gmp.csv FOR_rolling_TR1_base.csv --tol 5e-5
				UseBattComp       := 0;
				RollFileSuffix    := "_TR1_base";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR1";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
				RollAsyncK        := 6;
				RollAsyncThreads  := 4;
				run RunFOR_Rolling;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "CONTROLLED BASELINE, TR1: one transformer in a fresh AIMMS session at 6 sessions x 4 threads (77 batteries, small band). Run alone, then close AIMMS without saving - the whole point of the set is that every transformer starts from the same machine state. Writes FOR_rolling_TR1_base.csv.";
		}

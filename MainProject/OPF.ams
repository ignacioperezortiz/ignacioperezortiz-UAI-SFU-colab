		Procedure RunTR9_DerivFix {
			Body: {
				! A/B PARTNER of RunTR9_Base, for the LINEARIZATION-DERIVATIVE FIX (2026-08-24).
				! Identical configuration in every respect; only the output suffix differs, so the
				! reference file FOR_rolling_TR9_base.csv is NOT touched and stays comparable.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR9_base.csv FOR_rolling_TR9_dfix.csv
				! What changed in the model between the two runs (NetworkModel/Linearization):
				!   dIimdVim_Load - closing parenthesis moved so the Q0 cross term is no longer
				!                   multiplied by P0:  (P0*(Vre0^2-Vim0^2) + 2*Q0*Vre0*Vim0)/(.)^2
				!   dIredVim_Gen  - P0minGenP replaced by GenP0, matching every other _Gen derivative
				!                   and the definition of Ire_Gen from which it is differentiated.
				! Both are coefficients on (V - V0) in the load/PV current linearization, so the
				! measured FOR movement is the quantity of interest here.
				UseBattComp       := 0;
				RollFileSuffix    := "_TR9_dfix";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
				RollAsyncK        := 6;
				RollAsyncThreads  := 4;
				run RunFOR_Rolling;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "A/B PARTNER of RunTR9_Base for the 2026-08-24 linearization-derivative fix (dIimdVim_Load parenthesis, dIredVim_Gen parameter). Same config, suffix _TR9_dfix, so FOR_rolling_TR9_base.csv is left intact as the pre-fix reference. Compare with scripts/compare_FOR_runs.py.";
		}
		Procedure RunTR3_Base4x6 {
			Body: {
				! SPLIT TEST: TR3 (49 batteries) on 4 sessions x 6 threads instead of the 6x4
				! its size band prescribes. Same controlled-baseline protocol - run alone in a
				! fresh AIMMS session, close without saving.
				!
				! WHY: the completed 2026-08-19/20 baseline shows per-solve inflation splits by
				! SPLIT, not by size. Every 6x4 transformer sits at 2.20-2.33x (TR4 2.20,
				! TR3 2.33, TR1 2.31, TR2 2.21; TR9 1.59 is the lone exception), while the two
				! healthy 4x6 runs sit at 1.11-1.18x (TR5 1.11, TR8 1.18). If inflation is a
				! property of the split, 4x6 should cut TR3's mean solve from 8.24 s toward
				! ~4.5 s. Concurrency will fall from 3.95 to about 2.4, so the wall clock is
				! the arbiter, not the mean: TR3 must beat 20.1 min to be worth adopting.
				!
				! The ~120-battery crossover in README/PDF section 6 rests on the TR4 tuning of
				! 2026-08-14, which never tried 4x6. This is the cheapest test of it - 20 min.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR3_base.csv FOR_rolling_TR3_base4x6.csv --tol 5e-6
				UseBattComp       := 0;
				RollFileSuffix    := "_TR3_base4x6";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR3";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
				RollAsyncK        := 4;
				RollAsyncThreads  := 6;
				run RunFOR_Rolling;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "SPLIT TEST, TR3 at 4 sessions x 6 threads: tests whether the 2.2-2.3x per-solve inflation seen on every 6x4 transformer is a property of the split rather than of size. Must beat TR3's baseline 20.1 min to justify moving the small band to 4x6. Writes FOR_rolling_TR3_base4x6.csv, leaving FOR_rolling_TR3_base.csv intact.";
		}
		Procedure RunTR3_Linear {
			Body: {
				! LINEARIZATION COST TEST: TR3 with the linearized formulation, everything else
				! identical to RunTR3_Base. Run alone in a fresh AIMMS session, close without
				! saving. ~20 min (the exact run was 20.05 min).
				!
				! WHY: the production formulation is exact because the linearized one is an OUTER
				! RELAXATION - the tangent plane lies below the true convex Vre^2+Vim^2, and the
				! 16-gon circumscribes the S-circle - so it admits points the real network rejects.
				! Two facts from the completed baseline make that bite here: VmaxTrue is 1.10000 on
				! every one of the nine transformers, i.e. the voltage cap is BINDING and sets the
				! region boundary; and LinErr (max |Vmag2approx - (Vre^2+Vim^2)| at the solved
				! vertex, already logged by the exact runs) reaches 0.0106 p.u.^2 on TR3 and 0.0377
				! on TR7. At TR7's worst that is a true voltage near 1.117 p.u. reported as feasible
				! at 1.10 - about 17% of the whole 1.00-1.10 band.
				!
				! The repository has long claimed the linearized region is "~1% larger". As far as
				! the record shows that was never measured. This measures it.
				!
				! WHAT TO READ, against FOR_rolling_TR3_base.csv direction by direction:
				!   proj      - how much the region inflates (the headline number)
				!   OVviol    - vertices that violate the TRUE cap; stays exact under linearization
				!   VmaxTrue  - how far past 1.10 the relaxed vertices actually sit
				!   status    - the linearized era left TR4 with 71 NoSolution directions; see if
				!               TR3's 576/576 survives the change of formulation
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR3_base.csv FOR_rolling_TR3_linear.csv --tol 5e-6
				! Expect that comparison to FAIL loudly. It is measuring a modelling difference, not
				! solver noise - the tolerance gates were built for the latter.
				UseBattComp       := 0;
				RollFileSuffix    := "_TR3_linear";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR3";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
				RollAsyncK        := 6;
				RollAsyncThreads  := 4;
				RollLinearized    := 1;   ! <- the only difference from RunTR3_Base
				run RunFOR_Rolling;
				RollLinearized    := 0;   ! MUST reset: leaving this at 1 would silently relax every later run
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "LINEARIZATION COST TEST, TR3: the linearized formulation (16-gon inverter capability + tangent-plane Vmax) against the otherwise identical exact run FOR_rolling_TR3_base.csv. Measures how much the outer relaxation inflates the region and how many vertices breach the true voltage cap - the evidence behind the choice to publish only exact results. ~20 min. Writes FOR_rolling_TR3_linear.csv; resets RollLinearized to 0 on the way out.";
		}
		Procedure RunTR7_Linear {
			Body: {
				! LINEARIZATION COST TEST, LARGE END: TR7 (259 batteries) linearized, against the
				! otherwise identical exact run RunTR7_Base. Fresh AIMMS session, close without
				! saving. Budget ~4-5 h (exact was 5.24 h; the relaxation solves a little faster).
				!
				! WHY A SECOND ONE: the TR3 test (2026-08-20) is close to a BEST case. TR3 has the
				! second-lowest LinErr of the nine - max 0.0106 p.u.^2 against TR7's 0.0377 - and it
				! still lost 115 of 576 vertices (20%) through the true voltage cap, with the region
				! 1.6% larger by area (median; 5.0% worst). TR7 is the WORST-conditioned of the nine
				! by LinErr, so this anchors the other end of the size range and tells us whether
				! the 20% is typical or optimistic.
				!
				! Note the split differs from TR3's on purpose: TR7 is in the large band, so it uses
				! 4x6 exactly as RunTR7_Base did. The comparison stays like-for-like because the
				! split changes only the wall clock, never the answer (proven on TR3: 6x4 and 4x6
				! agreed to 2e-6 p.u. with the SOC file bit-identical).
				!
				!   py -3 scripts/compare_linearization.py --tag TR7
				! That writes TR7_linearization.xlsx and the two figures beside TR3's.
				UseBattComp       := 0;
				RollFileSuffix    := "_TR7_linear";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR7";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
				RollAsyncK        := 4;
				RollAsyncThreads  := 6;
				RollLinearized    := 1;   ! <- the only difference from RunTR7_Base
				run RunFOR_Rolling;
				RollLinearized    := 0;   ! MUST reset: leaving this at 1 would silently relax every later run
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "LINEARIZATION COST TEST, TR7 (259 batteries, the worst-conditioned of the nine by LinErr): the linearized formulation against the exact FOR_rolling_TR7_base.csv. Anchors the large end of the size range after the TR3 test, which is close to a best case and still lost 20% of its vertices through the true voltage cap. ~4-5 h, 4x6 split. Writes FOR_rolling_TR7_linear.csv; resets RollLinearized to 0 on the way out.";
		}
		Procedure RunTR6_AsyncTune {
			Body: {
				! ASYNC SPLIT PROBE on TR6, the LARGEST transformer (262 batteries).
				! Four session/thread splits at a constant 24 threads, each capped to the
				! first 2 periods (24 solves) by RollMaxPeriods, so the whole probe costs
				! roughly 1.5 h instead of the 4 x 10 h a full-day sweep would.
				!
				! WHY: RollAsyncK=6 x 4 threads was tuned on TR4 (46 batteries) and does
				! NOT generalise. Measured on the 2026-08-17/18 per-transformer batch,
				! per-solve inflation (async mean / sequential mean) rises with size while
				! achieved concurrency falls, and the two cross over near ~120 batteries:
				!     TR9  ( 90 batt)  inflation 1.6x  concurrency 3.7  -> 2.62x FASTER
				!     TR1  ( 77 batt)  inflation 2.5x  concurrency 3.8  -> 1.80x faster
				!     TR5  (214 batt)  inflation 2.4x  concurrency 2.5  -> 1.19x faster
				!     TR6  (262 batt)  inflation 4.4x  concurrency 2.4  -> 0.65x SLOWER
				! Six concurrent barrier solves of a 262-battery horizon saturate memory
				! bandwidth - the same wall that killed the whole-feeder run, reached from
				! the other side. Fewer, fatter sessions should trade concurrency for a
				! working set that fits.
				!
				! Periods 1-2 are representative: the TR6 async run averaged 146 s/solve
				! over periods 1-4 against a 154 s full-day mean, a 6% difference.
				!
				! Writes FOR_rolling_TR6_tune_<K>x<T>.csv - a fresh name per split, so no
				! existing result is touched. Read the mean of the time column and the
				! wall clock (CSV CreationTime -> LastWriteTime) for each.
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR6";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				RollMaxPeriods    := 2;
				! ---- 6x4 ----   ! control - the split the batch used
				RollFileSuffix    := "_TR6_tune_6x4";
				EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
				RollAsyncK        := 6;
				RollAsyncThreads  := 4;
				run RunFOR_Rolling;
				! ---- 4x6 ----
				RollFileSuffix    := "_TR6_tune_4x6";
				RollAsyncK        := 4;
				RollAsyncThreads  := 6;
				run RunFOR_Rolling;
				! ---- 3x8 ----   (the hypothesis)
				RollFileSuffix    := "_TR6_tune_3x8";
				RollAsyncK        := 3;
				RollAsyncThreads  := 8;
				run RunFOR_Rolling;
				! ---- 2x12 ----
				RollFileSuffix    := "_TR6_tune_2x12";
				RollAsyncK        := 2;
				RollAsyncThreads  := 12;
				run RunFOR_Rolling;
				! restore production defaults
				RollMaxPeriods    := 0;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "ASYNC SPLIT PROBE, TR6: four session/thread splits (6x4, 4x6, 3x8, 2x12 - all 24 threads) over the first 2 periods only, ~1.5 h total. Answers whether fewer/fatter CPLEX sessions beat 6x4 on the large transformers before committing a full day-long run. Writes FOR_rolling_TR6_tune_<K>x<T>.csv; compare the mean of the time column and the wall clock across the four.";
		}
		Procedure RunTR6_Async38 {
			Body: {
				! FULL-DAY TR6 async at 3 sessions x 8 threads - the split RunTR6_AsyncTune
				! is meant to justify before this is worth 3-10 h. Identical to RunTR6_Base
				! in every other respect (exact quadratic form, production switches), except the split.
				! Writes FOR_rolling_TR6_async38.csv, leaving FOR_rolling_TR6_async.csv
				! (the 6x4 result, 632 min) and FOR_rolling_TR6_gmp.csv (sequential,
				! 409 min) untouched, so all three are directly comparable.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR6_gmp.csv FOR_rolling_TR6_async38.csv --tol 5e-5
				! NOTE the looser gate: proj drift grows with instance size on the async
				! path (8e-6 p.u. on TR1, 4.3e-5 on TR6). 4.3e-5 p.u. = 43 W is still ~23x
				! inside the model's own Feasibility_Tolerance of 1e-3 p.u., and the
				! committed-dispatch SOC file stayed bit-identical on all six transformers
				! checked - but do not quote an async vertex where the 5e-6 gate matters.
				UseBattComp       := 0;
				RollFileSuffix    := "_TR6_async38";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR6";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
				RollAsyncK        := 3;
				RollAsyncThreads  := 8;
				run RunFOR_Rolling;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "ASYNC, TR6 at 3 sessions x 8 threads: the full 48-period rolling FOR with a fewer/fatter session split, for the large transformers where 6x4 lost to sequential. Writes FOR_rolling_TR6_async38.csv; the 6x4 and sequential results are left in place for comparison. Run RunTR6_AsyncTune first - it settles the split in ~1.5 h instead of gambling 3-10 h here.";
		}
		Procedure RunFOR_Rolling_PerTrafo_Async {
			Body: {
				! PER-TRANSFORMER PRODUCTION, ASYNC - REVISED 2026-08-18 after the first run of
				! this procedure (TR1..TR7, 2026-08-17/18) came out SLOWER than sequential on the
				! large transformers. Two fixes, both measured:
				!
				! 1. NO up-front full-feeder Load_data_dsn. The original captured the transformer
				!    universe by loading the whole feeder once, then looped. RunFOR_Rolling's very
				!    first statements empty everything and reload, so that load bought nothing -
				!    but it had already grown the AIMMS heap to full-feeder size, and the process
				!    never gives that back. Cost, period-matched, same settings, standalone vs
				!    in-batch: TR4 7.76 -> 11.58 s/solve (1.49x), TR6 95.4 -> 141.0 s/solve
				!    (1.48x). Same penalty at the 4th and 6th call, so it is a constant, not
				!    cumulative fragmentation. The nine tags are fixed by the dataset, so they are
				!    just assigned here. If the feeder ever changes, re-capture them by running
				!    RunFOR_Rolling_PerTrafo (the sequential twin) once and reading PerTrafoTag.
				!
				! 2. SIZE-ADAPTIVE SPLIT. 6 sessions x 4 threads was tuned on TR4 (46 batteries)
				!    and does not generalise. TR6 probe, 2 periods, 24 threads throughout
				!    (RunTR6_AsyncTune, 2026-08-18): 6x4 692 s, 4x6 621 s, 3x8 706 s, 2x12 746 s.
				!    So 4x6 for the big ones (TR5 214, TR7 259, TR6 262 batteries, TR8 124 just
				!    past the ~120 crossover), 6x4 for the rest. NOTE 3x8 lost - fewer/fatter
				!    sessions is NOT monotonically better; concurrency falls faster than per-solve
				!    time improves below 4 sessions.
				!
				! Writes FOR_rolling_<tag>_asyncB.csv - a NEW suffix, so neither the sequential
				! _gmp results nor the first async pass (_async) is touched.
				! RESUME: put completed tags in the FindString list below (e.g. ",TR1,TR2,").
				showprogresswindow;
				option disable_new_mathprog_generator := 0;   ! NEW generator (exact QCP); RunFOR_Rolling re-pins it anyway
				nPeriods                  := 48;
				IncludeNetworkConstraints := 1;
				DetailLoadPattern := "";
				RollFileSuffix    := "";
				! transformer universe, fixed by the dataset - no full-feeder load needed
				PerTrafoN := 9;
				for (pti) do
					PerTrafoTag(pti) := FormatString("TR%i", ord(pti));
				endfor;
				UseBattComp       := 0;
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				for (pti) do
					if FindString(",", "," + PerTrafoTag(pti) + ",") = 0 then   ! RESUME LIST: empty = run all nine. Put finished tags here to skip them, e.g. ",TR1,TR2," after a crash.
						RollFileSuffix := "_" + PerTrafoTag(pti) + "_asyncB";
						ReduceNetwork  := 1;
						DetailTagCSV   := PerTrafoTag(pti);
						if FindString(",TR5,TR6,TR7,TR8,", "," + PerTrafoTag(pti) + ",") > 0 then
							EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
							RollAsyncK       := 4;   ! large: >~120 batteries
							RollAsyncThreads := 6;
						else
							RollAsyncK       := 6;   ! small: the TR4-tuned split
							RollAsyncThreads := 4;
						endif;
						run RunFOR_Rolling;
					endif;
				endfor;
				! defensive reset to full-feeder / sequential defaults
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
				RollFileSuffix    := "";
			}
			Comment: "PER-TRANSFORMER PRODUCTION, ASYNC (revised 2026-08-18). Drops the up-front full-feeder load, which cost a measured 1.48x on every solve for nothing, and picks the session/thread split by transformer size (4x6 for TR5-TR8, 6x4 for the rest) after the TR6 probe showed the TR4-tuned 6x4 does not generalise. Writes FOR_rolling_<tag>_asyncB.csv, leaving both the sequential _gmp results and the first async pass untouched.";
		}
		Procedure RunAllTrafos_DerivFix {
			Body: {
				! FULL RE-GENERATION UNDER THE 2026-08-24 LINEARIZATION-DERIVATIVE FIX.
				! Clone of RunFOR_Rolling_PerTrafo_Async - same size-adaptive split, same GMP
				! settings, no up-front full-feeder load - with one difference: the suffix is
				! _<tag>_dfix, so nothing already in the repo is overwritten.
				!
				! Writes, per transformer:  FOR_rolling_<tag>_dfix.csv
				!                           FOR_rolling_soc_<tag>_dfix.csv
				!                           FOR_rolling_fair_<tag>_dfix.csv
				!                           FOR_rolling_progress_<tag>_dfix.txt   <- watch this
				!
				! EXPECTED WALL CLOCK, from the timings of the _base set (2026-08-19/20):
				!   TR1 0.8h  TR2 1.2h  TR3 0.4h  TR4 0.3h  TR5 3.4h
				!   TR6 5.0h  TR7 5.2h  TR8 2.1h  TR9 1.2h (already done, skipped below)
				!   -> about 18 h for the eight that remain.
				!
				! TR9 IS SKIPPED. It was already run under the fix on 2026-08-24 and its results
				! are in FOR_rolling_TR9_dfix.csv, measured in results/derivative_fix_2026-08/.
				! Re-running it would overwrite that file for no gain. To include it anyway,
				! change the resume list below from ",TR9," to ",".
				!
				! RESUME AFTER AN INTERRUPTION: add the finished tags to the same list, e.g.
				! ",TR9,TR1,TR2," to skip those three. Each transformer's CSVs are complete the
				! moment its progress file reports period 48, so a crash costs only the transformer
				! in flight - the finished ones are already on disk (RollFlushCSV writes per vertex).
				showprogresswindow;
				option disable_new_mathprog_generator := 0;   ! NEW generator (exact QCP); RunFOR_Rolling re-pins it anyway
				nPeriods                  := 48;
				IncludeNetworkConstraints := 1;
				DetailLoadPattern := "";
				RollFileSuffix    := "";
				! transformer universe, fixed by the dataset - no full-feeder load needed
				PerTrafoN := 9;
				for (pti) do
					PerTrafoTag(pti) := FormatString("TR%i", ord(pti));
				endfor;
				UseBattComp       := 0;
				FairMode          := 0;   ! m=0, explicit so the run cannot inherit a session value
				FairFileTag       := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				for (pti) do
					if FindString(",TR9,", "," + PerTrafoTag(pti) + ",") = 0 then   ! RESUME LIST - see header
						RollFileSuffix := "_" + PerTrafoTag(pti) + "_dfix";
						ReduceNetwork  := 1;
						DetailTagCSV   := PerTrafoTag(pti);
						EnableRollDiag := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
						if FindString(",TR5,TR6,TR7,TR8,", "," + PerTrafoTag(pti) + ",") > 0 then
							RollAsyncK       := 4;   ! large: >~120 batteries
							RollAsyncThreads := 6;
						else
							RollAsyncK       := 6;   ! small: the TR4-tuned split
							RollAsyncThreads := 4;
						endif;
						run RunFOR_Rolling;
					endif;
				endfor;
				! defensive reset to full-feeder / sequential defaults
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
				RollFileSuffix    := "";
			}
			Comment: "FULL RE-GENERATION under the 2026-08-24 derivative fix. Clone of RunFOR_Rolling_PerTrafo_Async writing FOR_rolling_<tag>_dfix.csv, so no existing result is overwritten. TR9 is skipped (already run under the fix); edit the resume list in the body to include it, or to skip transformers already finished after an interruption. About 18 h for the remaining eight. Compare each against its _base partner with scripts/compare_FOR_runs.py.";
		}
		Procedure RunFOR_Rolling_PerTrafo {
			Body: {
				! PER-TRANSFORMER rolling FOR. For each TRk: keep TRk detailed, lump every other transformer
				! as a passive MV load (its batteries dropped), keep the shared MV feeder, run the 48-step
				! rolling FOR -> FOR_rolling_<tag>.csv / FOR_rolling_soc_<tag>.csv. Combine in post-processing
				! (Minkowski sum about the all-passive baseline).
				showprogresswindow;
				option disable_new_mathprog_generator := 0;   ! NEW generator (exact QCP); RunFOR_Rolling re-pins it anyway
				! capture the transformer universe ONCE on the full feeder, before any reduction
				nPeriods                  := 48;     ! must precede the capture Load_data_dsn (fresh process has no inherited state)
				IncludeNetworkConstraints := 1;
				ReduceNetwork     := 0;
				DetailLoadPattern := "";
				RollFileSuffix    := "";
				empty Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				run Load_data_dsn;
				TrLabel(tr) := FormatString("%e", tr);
				TrTag(tr)   := SubString(TrLabel(tr), 7, StringLength(TrLabel(tr)));
				PerTrafoN   := card(Trafos);
				for (tr) do
					PerTrafoTag(Element(PerTrafoIdx, ord(tr))) := TrTag(tr);
				endfor;
				! one full rolling run per transformer (stable integer loop; Trafos is shrunk inside)
				! RESUME LIST: put already-completed tags in the string below (e.g. ",TR1,TR2,") to skip them
				! when resuming after an interruption. "," = do all.
				for (pti) do
					if FindString(",", "," + PerTrafoTag(pti) + ",") = 0 then
						RollFileSuffix := "_" + PerTrafoTag(pti);
						ReduceNetwork  := 1;
						DetailTagCSV   := PerTrafoTag(pti);
						run RunFOR_Rolling;
					endif;
				endfor;
				! defensive reset to full-feeder defaults
				ReduceNetwork  := 0;
				DetailTagCSV   := "";
				RollFileSuffix := "";
			}
			Comment: "PER-TRANSFORMER PRODUCTION: loops all transformers, each TRk detailed + others lumped passive, writing FOR_rolling_<tag>.csv / FOR_rolling_soc_<tag>.csv. Validate plumbing first with RunTR9.";
		}
		Procedure RunFOR_Rolling_Baseline_Full {
			Body: {
				! ALL-IDLE BASELINE B(t) ON THE FULL FEEDER. Same quantity as
				! RunFOR_Rolling_Baseline, computed with ReduceNetwork = 0 instead of on the
				! TR9-detailed reduction. Writes FOR_rolling_baseline_full.csv, leaving the
				! existing FOR_rolling_baseline.csv untouched.
				!
				! WHY IT IS WORTH A SEPARATE RUN. combine_FOR_pertrafo.py forms
				!     V(now,theta) = sum_k v_k(now,theta) - (N-1) * B(target)
				! and with nine transformers that subtracts EIGHT times B. |B| reaches 2.32 p.u.
				! over the day, so the term removes up to 18.6 p.u. from a region whose extent is
				! about 4.4 p.u. A 0.8% error in B therefore moves each combined vertex by as much
				! as the whole discrepancy being measured. The reduced-network B omits the eight
				! lumped transformers' LV losses, and fitting a per-period translation to the
				! 2026-08-21 comparison implied a correction of ~0.9% of |B| - the right size to
				! matter, and the reason this exists.
				!
				! REQUIRES A MACHINE THAT CAN HOLD THE FULL-FEEDER INSTANCE. Attempted on the 32 Gb
				! development machine 2026-08-21: 48/48 NoSolution, "Solver status 10: Error: Solver
				! failure" - the same signature the whole-feeder rolling FOR gives there.
				! Freezing the batteries does NOT make this small. It removes the battery columns,
				! but every bus voltage and every line current for all 48 periods stays, and that is
				! the bulk of the instance. It is the network REDUCTION that makes the original
				! procedure tractable, not the freezing. Run this wherever the whole-feeder rolling
				! FOR runs - it completed there in 82 h on 2026-08-17, and this is one solve, not 576.
				!
				! Same modest limit relaxation as the reduced version, and for the same reason: B
				! is an arithmetic reference, not a claimed operating point, so the idle state is
				! allowed to violate limits at midday. An extreme relaxation (1e9) puts ~1e18 into
				! the quadratic ampacity rows and returns 48/48 NoSolution - do not widen these.
				showprogresswindow;
				option disable_new_mathprog_generator := 0;
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 0;
				nPeriods                  := 48;
				ReduceNetwork             := 0;    ! <- the only structural difference: FULL feeder
				DetailLoadPattern         := "";
				DetailTagCSV              := "";
				RollFileSuffix            := "";
				BaseFileTag               := "_full";   ! -> FOR_rolling_baseline_full.csv
				FOR_PolyS                 := 0;
				FOR_LinearizeVmax         := 0;
				RollCyclicSOC             := 0;
				CyclicSOCBand             := 0;
				AllowChargeAtPmax         := 1;
				PeriodMaxP                := 25;
				empty allvariables;
				empty Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				run Load_data_dsn;
				MaxV(n)       := 1.5;
				MinV(n)       := 0.5;
				MaxCurrent(l) := 5*MaxCurrent(l);
				MaxAmps(tr)   := 5*MaxAmps(tr);
				BattP_Chg(bat,t) := 0;
				BattP_Dis(bat,t) := 0;
				BattP_Chg(bat,t).nonvar := 1;
				BattP_Dis(bat,t).nonvar := 1;
				solve MinImports where MIP_Relative_Optimality_Tolerance := 0.01,
				    method := 'deterministic concurrent', numeric_focus := 3, barrier_homogeneous := 1, time_limit := 21600;
				! time_limit is 6 h rather than the reduced version's 3000 s: this is the whole
				! network. If it hits the limit the status column will say so - do not use a
				! truncated B, the multiplier of 8 makes a partial answer worse than none.
				FOR_RollBaseCSV.PageWidth := 32767;
				put FOR_RollBaseCSV;
				put "period,P,Q,status" / ;
				for (t) do
					put ord(t):3:0, ",", P_PCC(t):14:6, ",", Q_PCC(t):14:6, ",", MinImports.ProgramStatus / ;
				endfor;
				putclose FOR_RollBaseCSV;
				BattP_Chg(bat,t).nonvar := 0;
				BattP_Dis(bat,t).nonvar := 0;
				BaseFileTag := "";   ! defensive reset so a later reduced baseline lands on its own name
			}
			Comment: "ALL-IDLE BASELINE on the FULL feeder (ReduceNetwork = 0), the de-duplication origin for combine_FOR_pertrafo.py. The reduced-network baseline omits the lumped transformers' LV losses, and the combination multiplies B by eight, so that omission is amplified into the same range as the discrepancy being measured. Writes FOR_rolling_baseline_full.csv and leaves FOR_rolling_baseline.csv alone. NEEDS A MACHINE THAT CAN HOLD THE FULL-FEEDER INSTANCE: 48/48 NoSolution on the 32 Gb development machine 2026-08-21. One solve, not a sweep, so it is far cheaper than the whole-feeder rolling FOR on a machine that can run that at all.";
		}
		Procedure RunFOR_Rolling_Baseline {
			Body: {
				! ALL-IDLE BASELINE trajectory B(t): full feeder, every battery fixed to zero P and Q.
				! This is the PCC point with no flexibility anywhere; needed to combine the per-transformer
				! FORs (Minkowski sum about B). Cheap: with batteries fixed there is no optimization, just a
				! determined linearized power flow. Writes FOR_rolling_baseline.csv (period,P,Q,status).
				showprogresswindow;
				option disable_new_mathprog_generator := 0;   ! NEW generator for the exact quadratic constraints (see RunFOR_Rolling)
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 0;
				nPeriods                  := 48;
				ReduceNetwork             := 1;     ! reduced net still carries the FULL passive load -> all-idle PCC ~ true B, and is tractable (full feeder is not)
				DetailLoadPattern         := BaseDetailPattern;   ! "" = original full-TR9 reduction; "_two" = match the micro bed
				DetailTagCSV              := "TR9";
				RollFileSuffix            := "";
				FOR_PolyS                 := 0;   ! match production (exact); irrelevant here anyway: batteries fixed to zero, limits relaxed below
				FOR_LinearizeVmax         := 0;
				RollCyclicSOC             := 0;
				CyclicSOCBand             := 0;
				AllowChargeAtPmax         := 1;
				PeriodMaxP                := 25;
				empty allvariables;
				empty Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				run Load_data_dsn;
				! relax network limits so B is the pure all-idle power-flow value (the de-duplication origin
				! for the Minkowski sum). The idle state itself may violate limits at midday; that is fine -
				! B is an arithmetic reference, not a claimed operating point. Feasibility lives in each FOR_k.
				! MODEST relaxation only (validated 2026-06-15): an extreme relax (1e9) puts ~1e18 in the
				! quadratic ampacity rows, destroys conditioning, and returned 48/48 NoSolution.
				MaxV(n)       := 1.5;
				MinV(n)       := 0.5;
				MaxCurrent(l) := 5*MaxCurrent(l);
				MaxAmps(tr)   := 5*MaxAmps(tr);
				! freeze every battery idle (P via Chg=Dis=0; Qinv already 0 since IncludeQforMaxP=0)
				BattP_Chg(bat,t) := 0;
				BattP_Dis(bat,t) := 0;
				BattP_Chg(bat,t).nonvar := 1;
				BattP_Dis(bat,t).nonvar := 1;
				solve MinImports where MIP_Relative_Optimality_Tolerance := 0.01,
					method := 'deterministic concurrent', numeric_focus := 3, barrier_homogeneous := 1, time_limit := 3000;
				FOR_RollBaseCSV.PageWidth := 32767;
				put FOR_RollBaseCSV;
				put "period,P,Q,status" / ;
				for (t) do
					put ord(t):3:0, ",", P_PCC(t):14:6, ",", Q_PCC(t):14:6, ",", MinImports.ProgramStatus / ;
				endfor;
				putclose FOR_RollBaseCSV;
				! release the fixes
				BattP_Chg(bat,t).nonvar := 0;
				BattP_Dis(bat,t).nonvar := 0;
			}
			Comment: "BASELINE for the per-transformer combination: full feeder, all batteries idle -> FOR_rolling_baseline.csv (the all-idle PCC trajectory B). Tractable because batteries are fixed (no optimization). Used by combine_FOR_pertrafo.py to de-duplicate the shared passive load when summing per-TR FORs.";
		}
		Procedure RunFOR_RollingPreflight {
			Body: {
				! ---- FULL-FEEDER PRE-FLIGHT for RunFOR_Rolling. Sweeps the 12 directions at a
				! ----   handful of representative slots (default: t=12, 25, 40) using the SAME
				! ----   solver config as the production rolling run, but with no SOC carry-forward
				! ----   between slots (each preflight slot starts from BattSOCini). Goal is a
				! ----   smoke test that the solver does not break down on the full feeder, plus
				! ----   per-direction timing so the full-day runtime can be extrapolated.
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 0;   ! NEW generator; kept even though this run linearizes
				! Barrier robustness, identical to RunFOR_Rolling. These are SESSION options in AIMMS, not
				! solve attributes: unpinned, the preflight inherited whatever the last procedure left, so its
				! timings were not reproducible. Production pins them because the exact solve otherwise raised
				! CPLEX feasibility / status-13 warnings.
				option Feasibility_Tolerance         := 1.0e-3;
				option Barrier_Convergence_Tolerance := 1.0e-2;
				option Scaling_Flag                  := 2;
				
				! ---- toggles: identical to the full-feeder leg of RunCompareWithPaperT25 ----
				ReduceNetwork             := PreflightReduce;   ! default 0 = FULL feeder; PreflightReduce=1 for a reduced (per-transformer) preflight
				DetailTagCSV              := PreflightDetailTag;   ! default "" = full feeder; e.g. "TR9" when reduced
				DetailLoadPattern         := "";
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				if PreflightExact = 1 then
					FOR_PolyS             := 0;        ! exact inverter S-circle
					FOR_LinearizeVmax     := 0;        ! exact voltage cap - no relaxation, so OVviol is meaningful
				else
					FOR_PolyS             := 1;        ! 16-gon inverter capability (LINEARIZED). Production uses 0
					FOR_LinearizeVmax     := 1;        ! tangent-plane Vmax (LINEARIZED). Production uses 0.
				endif;
				! Both toggles differ from production ON PURPOSE at full-feeder scale, so this is a solver
				! smoke test rather than a faithful rehearsal of the production formulation. And it does NOT
				! remove the dominant conic block: I2maxLines is quadratic with no toggle at all and scales
				! with line count -- 4569 lines on the full feeder against 339 on reduced TR9.
				FOR_nAngles               := 12;       ! every 30 deg
				RollCyclicSOC             := 1;
				CyclicSOCBand             := PreflightBand;     ! default 0.05 = production; PreflightBand=1.0 relaxes the cyclic band
				PeriodMaxP                := 2;        ! service slot is window position 2
				EnableRollDiag            := 0;
				! Pinned so the preflight cannot depend on session history. Each is left behind set by some
				! other procedure: FOR_TieEps=1e-5 by RunFOR_4Vertices, which never restores it; UseBattComp=1
				! by RunMicro_BattComp / RunFullTR9_BattComp, whose reset comes AFTER a full rolling run, so an
				! interruption leaves it on and silently turns this into a MIQCP; FairMode / FairActive by the
				! fairness wrappers. This is a SOLVER smoke test: deliberately no fairness rows.
				UseBattComp               := 0;   ! never a MIQCP here
				FairMode                  := 0;   ! no fairness rows in a solver smoke test
				FairActive                := 0;   ! and the gate closed, so none can appear
				FOR_TieEps                := 0;   ! pure directional objective, independent of session history
				
				! ---- pick the slots to test. Edit these three lines to change coverage. ----
				PreflightSlot(t) := 0;
				if PreflightSlotOnly >= 1 then
					PreflightSlot(Element(Time, PreflightSlotOnly)) := 1;   ! price a single slot
				else
					PreflightSlot(Element(Time, 12)) := 1;     ! morning ramp
					PreflightSlot(Element(Time, 25)) := 1;     ! midday PV peak (= paper PeriodMaxP)
					PreflightSlot(Element(Time, 40)) := 1;     ! evening
				endif;
				
				! ---- freeze the un-rotated day so each preflight slot rotates from a clean copy ----
				empty allvariables;
				run Load_data_dsn;
				P0raw(d,t)        := P0(d,t);
				Q0raw(d,t)        := Q0(d,t);
				GenP0raw(d,t)     := GenP0(d,t);
				Irrraw(t)         := Irradiance(t);
				BattSOCstart(bat) := BattSOCini(bat);   ! each preflight slot starts from the initial SOC
				
				! ---- CSV header (same columns as FOR_rolling.csv so existing scripts work) ----
				FOR_RollPreflightCSV.PageWidth := 32767;
				! The file is declared 'append' so rows can be flushed one at a time; that makes deleting
				! it here mandatory, or this run would be appended to the previous run's rows.
				if FileExists( FOR_RollPreflightName ) then
					FileDelete( FOR_RollPreflightName );
				endif;
				put FOR_RollPreflightCSV;
				put "now,target,angle_deg,P,Q,proj,status,time,VminTrue,VmaxTrue,UVviol,OVviol,LinErr" / ;
				if PreflightFlushCSV = 1 then
					putclose FOR_RollPreflightCSV;   ! header on disk before the first solve starts
					put FOR_RollPreflightCSV;
				endif;

				Preflight_TotalTime := 0;
				Preflight_nSolves   := 0;
				Preflight_nFail     := 0;
				
				for (t | PreflightSlot(t) = 1) do
					RollNow     := ord(t);
					RollMap(tt) := Element(Time, mod(ord(tt)-1 + (RollNow-1), nPeriods) + 1);
				
					! Skipped when the baseline is solved from the swept instance instead - see
					! PreflightGMPBaseline. That is the whole saving: this block generates a SECOND
					! full matrix per slot, as expensive as the sweep's own.
					if PreflightUseGMP * PreflightGMPBaseline = 0 then
						! ---- committed self-consumption baseline for this slot (mirrors RunFOR_Rolling) ----
						empty allvariables;
						run Load_data_reset;                        ! static data already loaded on entry; mirrors RunFOR_Rolling
						P0(d,tt)        := P0raw(d, RollMap(tt));
						Q0(d,tt)        := Q0raw(d, RollMap(tt));
						GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
						Irradiance(tt)  := Irrraw(RollMap(tt));
						BattSOCini(bat) := BattSOCstart(bat);
						BattP_Chg(bat,'1').nonvar := 0;
						BattP_Dis(bat,'1').nonvar := 0;
						run MinOFminImports;
						if ConvFlag <> 'Optimal' and ConvFlag <> 'LocallyOptimal' then
							! baseline rescue, mirrors RunFOR_Rolling
							solve MinImports
								where  MIP_Relative_Optimality_Tolerance := 0.01,
								       method              := 'deterministic concurrent',
								       numeric_focus       := 3,
								       barrier_homogeneous := 1,
								       time_limit          := 3000;
							ConvFlag := MinImports.ProgramStatus;
						endif;
						RollChgExec(bat) := BattP_Chg(bat,'1');
						RollDisExec(bat) := BattP_Dis(bat,'1');
					endif;
				
					! ---- GMP path: hoist the direction-INDEPENDENT setup out of the sweep and generate the
					! ---- matrix once. This is exactly the block the loop below repeats 12 times; it does not
					! ---- depend on ia, which is why one matrix serves all 12 directions.
					if PreflightUseGMP = 1 then
						empty allvariables;
						run Load_data_reset;
						P0(d,tt)        := P0raw(d, RollMap(tt));
						Q0(d,tt)        := Q0raw(d, RollMap(tt));
						GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
						Irradiance(tt)  := Irrraw(RollMap(tt));
						BattSOCini(bat) := BattSOCstart(bat);
						if PreflightGMPBaseline = 1 then
							! The instance has to be generated with slot 1 FREE - that is exactly what the
							! baseline solves for. It gets frozen at the committed dispatch below, for the
							! sweep only.
							BattP_Chg(bat,'1').nonvar := 0;
							BattP_Dis(bat,'1').nonvar := 0;
						else
							BattP_Chg(bat,'1') := RollChgExec(bat);
							BattP_Chg(bat,'1').nonvar := 1;
							BattP_Dis(bat,'1') := RollDisExec(bat);
							BattP_Dis(bat,'1').nonvar := 1;
						endif;
						FOR_Lambda := 1;                  ! must hold at generation: it scales OF_FOR inside OF_FOR_cont

						! The where-clause options of the solve become SESSION options here. They have to be in
						! force when the instance is generated and solved, and `method` is element-valued, which
						! GMP::Instance::SetOptionValue (numeric) cannot carry.
						option MIP_Relative_Optimality_Tolerance := 0.01;
						option method     := 'deterministic concurrent';
						option time_limit := 3000;
						! MinOFminImports sets this before its solve, and it is a SESSION option, so in the
						! original flow the sweep inherits it from the baseline that ran first. With
						! PreflightGMPBaseline = 1 that procedure is skipped, so it has to be set here or the
						! whole slot would run at a different tolerance than the reference.
						option Bound_Tolerance := 1e-006;

						! Generate AFTER the .nonvar fixes above, or those bounds are not in the matrix.
						! Generate at 45 deg on purpose: both objective coefficients are then non-zero, so the
						! sign convention can be READ BACK off the generated row instead of assumed. AIMMS moves
						! all variables to the left and OF_FOR carries a leading minus, so the sign is not
						! obvious - and getting it wrong mirrors the FOR with no visible symptom.
						FOR_AngleRad := 4*arctan(1) / 4;
						PreflightGMP := GMP::Instance::Generate( FOR_VertexCont, "FORsweep" );

						Preflight_SignP := GMP::Coefficient::Get( PreflightGMP, OF_FOR_definition, P_PCC(PeriodMaxP) ) / cos(FOR_AngleRad);
						Preflight_SignQ := GMP::Coefficient::Get( PreflightGMP, OF_FOR_definition, Q_PCC(PeriodMaxP) ) / sin(FOR_AngleRad);
						if abs(abs(Preflight_SignP) - 1) > 1e-6 or abs(abs(Preflight_SignQ) - 1) > 1e-6 then
							halt with "GMP: OF_FOR_definition does not carry +/-cos and +/-sin as expected - refusing to write coefficients into a row that is not what we think it is.";
						endif;

						if PreflightGMPBaseline = 1 then
							! ---- committed baseline from the SAME matrix: only the objective column changes.
							! MinImports and FOR_VertexCont declare the same constraint and variable sets, so the
							! row-for-row matrix is identical and both objective definition rows are already in it.
							GMP::Column::SetAsObjective( PreflightGMP, OFminImports );
							GMP::Instance::Solve( PreflightGMP );
							Preflight_SolState := GMP::Solution::GetProgramStatus( PreflightGMP, 1 );
							if Preflight_SolState <> 'Optimal' and Preflight_SolState <> 'LocallyOptimal' then
								option numeric_focus       := 3;
								option barrier_homogeneous := 1;
								GMP::Instance::Solve( PreflightGMP );
								Preflight_SolState := GMP::Solution::GetProgramStatus( PreflightGMP, 1 );
								option numeric_focus       := 0;
								option barrier_homogeneous := 0;
							endif;
							ConvFlag := Preflight_SolState;
							GMP::Solution::SendToModel( PreflightGMP, 1 );
							RollChgExec(bat) := BattP_Chg(bat,'1');
							RollDisExec(bat) := BattP_Dis(bat,'1');

							! Back to the sweep objective, and pin slot 1 to what the baseline just committed.
							! Freeze replaces .nonvar here: the matrix already exists, so the fix has to be applied
							! to the INSTANCE, not to the model - a .nonvar now would need a regeneration to matter.
							GMP::Column::SetAsObjective( PreflightGMP, OF_FOR_cont );
							GMP::Column::FreezeMulti( PreflightGMP, bat, BattP_Chg(bat,'1'), RollChgExec(bat) );
							GMP::Column::FreezeMulti( PreflightGMP, bat, BattP_Dis(bat,'1'), RollDisExec(bat) );
						endif;
					endif;

					put FOR_RollPreflightCSV;
					for (ia) do
						FOR_Angle    := FOR_AngleDeg(ia);
						FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;
				
						if PreflightUseGMP = 1 then
							! Only the objective row differs between directions; the matrix generated above is
							! reused untouched. This is the whole point of the migration.
							GMP::Coefficient::Set( PreflightGMP, OF_FOR_definition, P_PCC(PeriodMaxP), Preflight_SignP*cos(FOR_AngleRad) );
							GMP::Coefficient::Set( PreflightGMP, OF_FOR_definition, Q_PCC(PeriodMaxP), Preflight_SignQ*sin(FOR_AngleRad) );
							GMP::Instance::Solve( PreflightGMP );
							Preflight_SolState := GMP::Solution::GetProgramStatus( PreflightGMP, 1 );

							if Preflight_SolState <> 'Optimal' and Preflight_SolState <> 'LocallyOptimal' then
								! Same rescue as the non-GMP path. As session options these are STICKY - the
								! where clause used to scope them to one solve - so they are restored right after.
								option numeric_focus       := 3;
								option barrier_homogeneous := 1;
								GMP::Instance::Solve( PreflightGMP );
								Preflight_SolState := GMP::Solution::GetProgramStatus( PreflightGMP, 1 );
								option numeric_focus       := 0;
								option barrier_homogeneous := 0;
							endif;

							if Preflight_SolState = 'Optimal' or Preflight_SolState = 'LocallyOptimal' then
								GMP::Solution::SendToModel( PreflightGMP, 1 );   ! P_PCC/Q_PCC/Vre/Vim are read from the model below
							endif;
						else
							empty allvariables;
							run Load_data_reset;                        ! same proven reset as production; the full ODBC+Excel
							                                            ! reload once per direction was pure waste
							P0(d,tt)        := P0raw(d, RollMap(tt));
							Q0(d,tt)        := Q0raw(d, RollMap(tt));
							GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
							Irradiance(tt)  := Irrraw(RollMap(tt));
							BattSOCini(bat) := BattSOCstart(bat);
							BattP_Chg(bat,'1') := RollChgExec(bat);     ! slot 1 fixed to the committed dispatch (mirrors RunFOR_Rolling)
							BattP_Chg(bat,'1').nonvar := 1;
							BattP_Dis(bat,'1') := RollDisExec(bat);
							BattP_Dis(bat,'1').nonvar := 1;
							if FOR_SweepWarmStart = 1 or UseBattComp = 1 then
								run MainExecution;                      ! cost-min start point. Measured 4.06x SLOWER in wall
								                                        ! clock and bit-identical, hence off by default -- see
								                                        ! FOR_SweepWarmStart. Kept for UseBattComp, where the
								                                        ! variable levels ARE a real warm-start channel.
							endif;

							FOR_Lambda := 1;
							solve FOR_VertexCont
								where  MIP_Relative_Optimality_Tolerance := 0.01,
								       method     := 'deterministic concurrent',
								       time_limit := 3000;

							if FOR_VertexCont.ProgramStatus <> 'Optimal' and
							   FOR_VertexCont.ProgramStatus <> 'LocallyOptimal' then
								solve FOR_VertexCont
									where  MIP_Relative_Optimality_Tolerance := 0.01,
									       method              := 'deterministic concurrent',
									       numeric_focus       := 3,
									       barrier_homogeneous := 1,
									       time_limit          := 3000;
							endif;

							Preflight_SolState := FOR_VertexCont.ProgramStatus;
						endif;

						FOR_StatCur          := Preflight_SolState;
						Preflight_nSolves    := Preflight_nSolves + 1;
						Preflight_TotalTime  := Preflight_TotalTime + FOR_VertexCont.SolutionTime;
				
						if Preflight_SolState = 'Optimal' or
						   Preflight_SolState = 'LocallyOptimal' then
							FOR_Pcur    := P_PCC(PeriodMaxP);
							FOR_Qcur    := Q_PCC(PeriodMaxP);
							FOR_VmaxCur := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
							FOR_LinCur  := max((n,f), abs(Vmag2approx(n,f,PeriodMaxP) - (Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
							put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
							    FOR_Pcur:14:6, ",", FOR_Qcur:14:6, ",",
							    (cos(FOR_AngleRad)*FOR_Pcur + sin(FOR_AngleRad)*FOR_Qcur):14:6, ",",
							    FOR_StatCur, ",", FOR_VertexCont.SolutionTime:12:2, ",",
							    (min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2))):10:5, ",",
							    FOR_VmaxCur:10:5, ",",
							    (max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)))):10:5, ",",
							    (max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)))):10:5, ",",
							    FOR_LinCur:12:6 / ;
						else
							Preflight_nFail := Preflight_nFail + 1;
							put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
							    0:14:6, ",", 0:14:6, ",", 0:14:6, ",",
							    FOR_StatCur, ",", FOR_VertexCont.SolutionTime:12:2, ",",
							    0:10:5, ",", 0:10:5, ",", 0:10:5, ",", 0:10:5, ",", 0:12:6 / ;
						endif;

						if PreflightFlushCSV = 1 then
							putclose FOR_RollPreflightCSV;   ! this row is on disk now, not in a buffer
						endif;

						! ---- progress marker, flushed to disk after every vertex (see FOR_PreProgress) ----
						put FOR_PreProgress;
						put "slot ", RollNow:3:0, "  ->  target ", (mod(RollNow,nPeriods)+1):3:0,
						    "   direccion ", ord(ia):3:0, " de ", FOR_nAngles:3:0,
						    "   (", FOR_Angle:6:1, " grados)" / ;
						put "vertices resueltos : ", Preflight_nSolves:5:0 / ;
						put "sin resolver       : ", Preflight_nFail:5:0 / ;
						put "solver acumulado   : ", Preflight_TotalTime:12:2, " s" / ;
						put "ultimo vertice     : ", FOR_VertexCont.SolutionTime:12:2, " s   estado ", FOR_StatCur / ;
						putclose FOR_PreProgress;
						put FOR_RollPreflightCSV;   ! restore the active file for the next direction
					endfor;

					if PreflightUseGMP = 1 then
						GMP::Instance::Delete( PreflightGMP );   ! one instance per slot; the next slot generates its own
					endif;
				endfor;
				
				putclose FOR_RollPreflightCSV;

				! ---- GMP probe (PreflightGMPProbe = 1). Deliberately placed AFTER the CSV is closed and
				! ---- BEFORE the defensive resets below: the results are already safe on disk if GMP
				! ---- generation fails or exhausts memory, and the model state here is still the in-loop
				! ---- one the sweep actually solved (slot-1 dispatch frozen, cyclic band on). Reading the
				! ---- objective-row coefficients of the LAST direction is what pins down the sign
				! ---- convention before anything writes coefficients back.
				if PreflightGMPProbe = 1 then
					PreflightGMP     := GMP::Instance::Generate( FOR_VertexCont, "FORprobe" );
					Preflight_Rows   := GMP::Instance::GetNumberOfRows( PreflightGMP );
					Preflight_Cols   := GMP::Instance::GetNumberOfColumns( PreflightGMP );
					Preflight_Nz     := GMP::Instance::GetNumberOfNonzeros( PreflightGMP );
					Preflight_Mem    := GMP::Instance::GetMemoryUsed( PreflightGMP );
					Preflight_ObjRow := GMP::Instance::GetObjectiveRowNumber( PreflightGMP );
					! The row is OF_FOR_definition, NOT the objective row: FOR_VertexCont minimizes
					! OF_FOR_cont, and the angle only ever reaches the matrix through the defining
					! constraint of OF_FOR. Coefficient::Get/Set take a symbolic row reference in this
					! AIMMS version, not the row number GetObjectiveRowNumber returns.
					Preflight_CoefP  := GMP::Coefficient::Get( PreflightGMP, OF_FOR_definition, P_PCC(PeriodMaxP) );
					Preflight_CoefQ  := GMP::Coefficient::Get( PreflightGMP, OF_FOR_definition, Q_PCC(PeriodMaxP) );

					put FOR_GMPProbeTxt;
					put "GMP probe - estado del modelo en la ULTIMA direccion del barrido" / ;
					put "angulo             : ", FOR_Angle:12:1, " grados" / ;
					put "filas              : ", Preflight_Rows:12:0 / ;
					put "columnas           : ", Preflight_Cols:12:0 / ;
					put "no ceros           : ", Preflight_Nz:12:0 / ;
					put "memoria            : ", Preflight_Mem:12:2, " Mb" / ;
					put "fila objetivo      : ", Preflight_ObjRow:12:0 / ;
					put "coef P_PCC         : ", Preflight_CoefP:16:8, "    cos(ang) = ", cos(FOR_AngleRad):16:8 / ;
					put "coef Q_PCC         : ", Preflight_CoefQ:16:8, "    sin(ang) = ", sin(FOR_AngleRad):16:8 / ;
					putclose FOR_GMPProbeTxt;

					GMP::Instance::Delete( PreflightGMP );
				endif;

				RollCyclicSOC := 0;
				CyclicSOCBand := 0;
				BattP_Chg(bat,t).nonvar := 0;   ! defensive: free the slot-1 fixes so later runs see normal variables
				BattP_Dis(bat,t).nonvar := 0;
				
				display Preflight_nSolves, Preflight_nFail, Preflight_TotalTime;
			}
			Comment: {
				"FOR - PRE-FLIGHT. Smoke test for the production rolling run on the FULL feeder.
				 Sweeps the 12 directions at 3 representative slots (t=12 morning, t=25 PV peak,
				 t=40 evening). NOTE: unlike RunFOR_Rolling it runs LINEARIZED (FOR_PolyS=1,
				 FOR_LinearizeVmax=1), with RollCyclicSOC=1 and NC_Q. Each preflight slot starts from
				 BattSOCini (no SOC carry-forward between preflight slots, to keep this fast),
				 solves the same committed self-consumption baseline (MinImports) as production,
				 and fixes slot 1 to that dispatch during the sweep.
				 Writes FOR_rolling_preflight.csv (same columns as FOR_rolling.csv) and
				 reports Preflight_nFail / Preflight_TotalTime so the full-day runtime
				 (= TotalTime * 48 / 3) can be extrapolated. RUN THIS BEFORE RunFOR_Rolling on
				 the full feeder; if any direction returns non-Optimal, debug before launching."
			}
		}
		Procedure RunTR9_PreflightCyclicTest {
			Body: {
				! EXPERIMENT (one click): does relaxing the cyclic-SOC band inflate the FOR?
				! Runs the 3-slot x 12-direction preflight (t=12/25/40) for TR9 (reduced network)
				! TWICE - once at the production band 0.05, once relaxed (1.0) - both starting from
				! the same BattSOCini (no carry-forward), so the vertices are directly comparable.
				! Writes FOR_rolling_preflight_TR9_cyc05.csv and FOR_rolling_preflight_TR9_cycOff.csv.
				! ~72 vertex solves (~15-25 min). If the relaxed region is materially larger, the
				! cyclic band is doing real work in the FOR (offered flexibility that is not repeatable
				! day to day); if the two regions coincide, the band is inert for the FOR too.
				PreflightReduce    := 1;
				PreflightDetailTag := "TR9";
				
				PreflightBand   := 0.05;   PreflightSuffix := "_TR9_cyc05";
				run RunFOR_RollingPreflight;
				
				PreflightBand   := 1.0;    PreflightSuffix := "_TR9_cycOff";
				run RunFOR_RollingPreflight;
				
				! restore production defaults
				PreflightReduce    := 0;
				PreflightDetailTag := "";
				PreflightBand      := 0.05;
				PreflightSuffix    := "";
			}
			Comment: "EXPERIMENT (one click): FOR sensitivity to the cyclic-SOC band. Runs the TR9 reduced-network preflight (3 slots x 12 directions) at band 0.05 and at band 1.0, writing FOR_rolling_preflight_TR9_cyc05.csv and _cycOff.csv for comparison. ~72 solves (~15-25 min). Production preflight behaviour is unchanged (defaults preserved).";
		}
		Procedure RunTR9_PreflightRef {
			Body: {
				! REFERENCE RUN for the GMP migration of the directional sweep (one click).
				! Runs the 3-slot x 12-direction preflight on the REDUCED TR9 network with the
				! production cyclic band, writing FOR_rolling_preflight_TR9_ref.csv. This is the
				! no-GMP baseline: the GMP version must reproduce its proj column to 2e-6 and its
				! rows/cols/nz exactly (scripts/compare_FOR_runs.py). Reduced on purpose - the full
				! feeder has never completed a run, so there is nothing there to compare against.
				PreflightReduce    := 1;
				PreflightDetailTag := "TR9";
				PreflightBand      := 0.05;
				PreflightSuffix    := "_TR9_ref";
				PreflightGMPProbe  := 1;        ! matrix size + memory + objective-row signs, after the CSV closes
				run RunFOR_RollingPreflight;

				! restore production defaults
				PreflightReduce    := 0;
				PreflightDetailTag := "";
				PreflightBand      := 0.05;
				PreflightSuffix    := "";
				PreflightGMPProbe  := 0;
			}
			Comment: "REFERENCE RUN for the GMP migration: the TR9 reduced-network preflight (3 slots x 12 directions, ~36 vertex solves) with the production cyclic band, written to FOR_rolling_preflight_TR9_ref.csv. Establishes the pre-GMP baseline for proj and for the matrix size (rows/cols/nz), which the GMP version must match before anything is attempted on the full feeder. Production preflight defaults are restored on exit.";
		}
		Procedure RunTR9_PreflightGMP {
			Body: {
				! A/B PARTNER of RunTR9_PreflightRef (one click): the same TR9 reduced preflight with the
				! directional sweep served by ONE generated matrix per slot instead of 12. Writes
				! FOR_rolling_preflight_TR9_gmp.csv; compare with
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_preflight_TR9_ref.csv FOR_rolling_preflight_TR9_gmp.csv
				! The criterion is proj within 2e-6 and no status change, NOT P/Q equality.
				PreflightReduce    := 1;
				PreflightDetailTag := "TR9";
				PreflightBand      := 0.05;
				PreflightSuffix    := "_TR9_gmp";
				PreflightGMPProbe  := 1;        ! same matrix/size probe as the reference, for the row-count check
				PreflightUseGMP    := 1;
				run RunFOR_RollingPreflight;

				! restore production defaults
				PreflightReduce    := 0;
				PreflightDetailTag := "";
				PreflightBand      := 0.05;
				PreflightSuffix    := "";
				PreflightGMPProbe  := 0;
				PreflightUseGMP    := 0;
			}
			Comment: "A/B PARTNER of RunTR9_PreflightRef: the same TR9 reduced preflight (3 slots x 12 directions) with PreflightUseGMP=1, so the sweep generates one matrix per slot and rewrites only the two objective coefficients per direction. Writes FOR_rolling_preflight_TR9_gmp.csv for comparison with scripts/compare_FOR_runs.py. Restores the production defaults on exit.";
		}
		Procedure RunTR9_PreflightGMPBase {
			Body: {
				! A/B de PreflightGMPBaseline: mismo caso TR9 reducido que RunTR9_PreflightRef, pero con el
				! baseline resuelto desde la MISMA instancia generada que el barrido. Escribe
				! FOR_rolling_preflight_TR9_gmpbase.csv.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_preflight_TR9_ref.csv FOR_rolling_preflight_TR9_gmpbase.csv
				! Esta validacion NO es opcional: el baseline fija el despacho comprometido del slot 1, y ese
				! despacho condiciona las 12 direcciones. Un baseline distinto mueve el FOR entero.
				PreflightReduce      := 1;
				PreflightDetailTag   := "TR9";
				PreflightBand        := 0.05;
				PreflightSuffix      := "_TR9_gmpbase";
				PreflightGMPProbe    := 1;
				PreflightUseGMP      := 1;
				PreflightGMPBaseline := 1;
				run RunFOR_RollingPreflight;

				PreflightReduce      := 0;
				PreflightDetailTag   := "";
				PreflightSuffix      := "";
				PreflightGMPProbe    := 0;
				PreflightUseGMP      := 0;
				PreflightGMPBaseline := 0;
			}
			Comment: "A/B de PreflightGMPBaseline sobre TR9 reducido: el baseline comprometido se resuelve intercambiando la columna objetivo de la instancia del barrido, en vez de generar una segunda matriz. Escribe FOR_rolling_preflight_TR9_gmpbase.csv para comparar con FOR_rolling_preflight_TR9_ref.csv. Vale ~665 s por slot en alimentador completo, unas 9 h por dia simulado.";
		}
		Procedure RunFullFeeder_PreflightExact1Slot {
			Body: {
				! PRECIO DE LA FORMULACION EXACTA. Un solo slot x 12 direcciones sobre alimentador completo,
				! con FOR_PolyS=0 y FOR_LinearizeVmax=0 - o sea SIN relajar el limite de tension.
				! Existe porque la corrida linealizada reporta VmaxTrue > 1.1 p.u. con OVviol > 0: sus
				! vertices son un smoke test de solver, no capacidad de alojamiento reportable.
				! OJO: ambos toggles AGREGAN filas conicas. Esperar mas tiempo Y mas memoria que la
				! linealizada, y vigilar que los solves no toquen el time_limit de 3000 s - si lo tocan, lo
				! medido es una cota inferior del costo, no el costo.
				PreflightReduce      := 0;        ! alimentador completo
				PreflightDetailTag   := "";
				PreflightBand        := 0.05;
				PreflightSlotOnly    := 25;       ! pico solar = PeriodMaxP del paper, el slot mas exigente
				PreflightExact       := 1;        ! sin linealizar
				PreflightSuffix      := "_full_exact";
				PreflightGMPProbe    := 1;        ! tamano de matriz y memoria de la formulacion exacta
				PreflightUseGMP      := 1;
				PreflightGMPBaseline := 1;
				run RunFOR_RollingPreflight;

				PreflightSlotOnly    := 0;
				PreflightExact       := 0;
				PreflightSuffix      := "";
				PreflightGMPProbe    := 0;
				PreflightUseGMP      := 0;
				PreflightGMPBaseline := 0;
			}
			Comment: "PRECIO DE LA FORMULACION EXACTA: un slot (25, pico solar) x 12 direcciones sobre alimentador completo con FOR_PolyS=0 y FOR_LinearizeVmax=0, con GMP y con el baseline en la misma instancia. Mide lo que cuesta la formulacion que SI es reportable, contra la linealizada que relaja el limite de tension. Escribe FOR_rolling_preflight_full_exact.csv y FOR_gmp_probe_full_exact.txt.";
		}
		Procedure RunFullFeeder_PreflightGMP {
			Body: {
				! FULL FEEDER preflight with the GMP sweep (step 3 of the migration plan). Only run this
				! after the reduced A/B has passed - RunTR9_PreflightRef vs RunTR9_PreflightGMP compared
				! with scripts/compare_FOR_runs.py - because the full feeder has never completed a run and
				! there is therefore no reference here to catch a wrong answer.
				! 3 slots x 12 directions. Writes FOR_rolling_preflight_full_gmp.csv, one row at a time
				! (PreflightFlushCSV), so an interrupted run keeps what it already produced.
				PreflightReduce    := 0;        ! full feeder
				PreflightDetailTag := "";
				PreflightBand      := 0.05;
				PreflightSuffix    := "_full_gmp";
				PreflightGMPProbe  := 1;        ! matrix size + memory at full scale - the number the plan wants
				PreflightUseGMP    := 1;
				PreflightSlotOnly    := 0;   ! defensive pin: RunFullFeeder_PreflightExact1Slot, just above, leaves it at 25
				PreflightExact       := 0;   ! defensive pin: the same neighbour leaves it at 1
				PreflightGMPBaseline := 0;   ! defensive pin: the same neighbour leaves it at 1
				run RunFOR_RollingPreflight;

				! restore production defaults
				PreflightSuffix    := "";
				PreflightGMPProbe  := 0;
				PreflightUseGMP    := 0;
			}
			Comment: "STEP 3 of the GMP migration: the FULL-FEEDER preflight (3 slots x 12 directions) with PreflightUseGMP=1, so the matrix is generated once per slot instead of 12 times. Writes FOR_rolling_preflight_full_gmp.csv incrementally and FOR_gmp_probe_full_gmp.txt. Run only after the reduced A/B has passed: there is no reference run on the full feeder to catch a wrong answer.";
		}
		Procedure RunFullFeeder_AsyncSmoke {
			Body: {
				! STEP 1 OF THE PARALLEL WHOLE-FEEDER RUN: does this machine have the memory?
				!
				! RunFullFeeder_Async capped to the first 2 periods - an exact match on every assignment,
				! not RunFullFeeder_NoFairness parallelised, which pins fewer parameters.
				! The cap does NOT shrink the problem: every period still builds the full 48-slot
				! instance, so peak memory here is the peak memory of the full run. Only the number of
				! periods is reduced, which is what makes this a ~3 h question instead of a 3-day one.
				!
				! WHY IT HAS TO BE ASKED. Each concurrent direction holds its own copy of the period
				! matrix. Measured peak AIMMS memory on the reduced per-transformer networks:
				!     TR9   90 batteries, 6 sessions ->  7.2 Gb
				!     TR5  214 batteries, 4 sessions -> 11.2 Gb
				!     TR7  259 batteries, 4 sessions -> 14.8 Gb
				! The whole feeder is 1216 batteries and peaked at 18.8 Gb SEQUENTIALLY, which is what
				! exhausted a 32 Gb machine in 2026-08. K is 2 here for that reason, not 4 or 6.
				!
				! WHAT TO LOOK AT, in order:
				!   1. did it finish at all, and are the 24 rows of FOR_rolling_full_asyncsmoke.csv
				!      Optimal? Any NoSolution at this scale means memory, not mathematics - the
				!      2026-08-14 attempt returned NoSolution on every single vertex.
				!   2. peak memory while it ran. If free RAM approached zero, stop here: K=2 does not
				!      fit and the sequential RunFullFeeder_NoFairness is the only route.
				!   3. the time column, against the ~344 s/vertex of the sequential 2026-08-17 run.
				!      Expect it to RISE - concurrency costs each individual solve. The question is
				!      whether 2 at a time beats 1 at a time overall, not whether each is faster.
				!
				! Only if all three look right is RunFullFeeder_Async worth days of wall clock.
				UseBattComp       := 0;
				FairMode          := 0;
				FairFileTag       := "";
				RollFileSuffix    := "_full_asyncsmoke";
				ReduceNetwork     := 0;   ! FULL feeder - every transformer in detail, nothing lumped
				DetailTagCSV      := "";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
				RollAsyncK        := 2;   ! deliberately low: memory, not cores, is the binding constraint here
				RollAsyncThreads  := 12;
				RollMaxPeriods    := 2;   ! the cap. Full 48-slot instance per period, only fewer periods
				BaseNoNetwork     := 0;
				BaseNoNetGMP      := 0;
				RollLinearized    := 0;   ! defensive pin: RunTR3_Linear/RunTR7_Linear leave it at 1 if interrupted, which would silently relax this run
				run RunFOR_Rolling;
				RollMaxPeriods    := 0;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "WHOLE FEEDER, STEP 1: the memory question. RunFullFeeder_NoFairness parallelised at 2 sessions x 12 threads, capped to 2 periods - the cap does not shrink the instance, so peak memory here is the peak memory of the full run. About 3 h instead of 3 days. Run this BEFORE RunFullFeeder_Async and read the three checks in the body comment.";
		}
		Procedure RunFullFeeder_Async {
			Body: {
				! STEP 2: the full parallel whole-feeder run. 48 periods x 12 directions on the full
				! network, exact QCP, sweep parallelised. Identical to RunFullFeeder_NoFairness in every
				! respect except that RollAsyncK directions solve at once - and except that it pins
				! EnableRollDiag and RollAsyncThreads, which RunFullFeeder_NoFairness also pins since
				! 2026-08-23. Before that date the equivalence held only in a clean session.
				!
				! DO NOT START THIS UNTIL RunFullFeeder_AsyncSmoke HAS PASSED. It commits days of wall
				! clock, and the failure mode at this scale is memory exhaustion, which shows up as
				! NoSolution on every vertex rather than as an error.
				!
				! HOW MUCH TO EXPECT. On the reduced per-transformer networks the gain shrinks as the
				! instance grows: 2.73x at 90 batteries, 2.53x at 214, and only 1.31-1.36x at 259-262.
				! The whole feeder is 1216. Extrapolating past measured ground is unsafe, but the trend
				! points down - if 1.3x holds, the 82.17 h sequential run of 2026-08-17 becomes roughly
				! 63 h. Worth having, not transformative. If the smoke run shows per-solve time more
				! than doubling, the gain is already gone and sequential is the better run.
				!
				! The per-vertex flush and the progress marker work here: they were carried into the
				! async branch deliberately, because without them a multi-day run writes nothing until
				! it finishes and there is no way to tell a slow solve from a hung one.
				! Watch FOR_rolling_progress_full_async.txt.
				UseBattComp       := 0;
				FairMode          := 0;
				FairFileTag       := "";
				RollFileSuffix    := "_full_async";
				ReduceNetwork     := 0;   ! FULL feeder
				DetailTagCSV      := "";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
				RollAsyncK        := 2;   ! keep whatever the smoke run proved. Raise only after re-smoking
				RollAsyncThreads  := 12;
				BaseNoNetwork     := 0;
				BaseNoNetGMP      := 0;
				RollMaxPeriods    := 0;   ! defensive pin: RunFullFeeder_AsyncSmoke and RunTR6_AsyncTune leave it at 2 if interrupted -> a 2-period run with a complete-looking CSV
				RollLinearized    := 0;   ! defensive pin: RunTR3_Linear/RunTR7_Linear leave it at 1 if interrupted, which would silently relax this run
				run RunFOR_Rolling;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "WHOLE FEEDER, STEP 2: the full 48-period parallel run, all transformers at once on the full network. Same configuration as RunFullFeeder_NoFairness with RollAsyncK directions solving concurrently. Run RunFullFeeder_AsyncSmoke first - this commits days of wall clock and the failure mode is memory. Writes FOR_rolling_full_async.csv plus its soc and fair companions, and FOR_rolling_progress_full_async.txt after every vertex.";
		}
		Procedure RunFullFeeder_AsyncNoNet {
			Body: {
				! WHOLE-FEEDER PRODUCTION, m=0, PARALLEL SWEEP + BATTERY-ONLY COMMITTED BASELINE.
				! This is RunFullFeeder_Async with BaseNoNetwork = 1. It is the configuration the
				! 2026-08-21 task asks for: the two accelerations applied together.
				!
				! WHY BOTH. The sequential 2026-08-17 run was 82.17 h of wall clock, of which
				! 55.05 h is sweep solver time (576 vertices, 344.1 s mean) and 27.1 h is period
				! boundary: Load_data_reset, the GMP generation, and the committed baseline solve.
				! RollAsyncK attacks the 55 h. BaseNoNetwork attacks the 27 h - it is the only one
				! of the two that touches the baseline solve, which on the full feeder carries the
				! whole network for all 48 slots. On TR4 the 48 baseline solves fell from ~6 min to
				! 13 s with max |dP| = 2.7e-7 p.u. RunFullFeeder_Async does NOT set it.
				!
				! RollGMPBaseline is 0 on purpose: with BaseNoNetwork = 1 the shared-instance path
				! is skipped anyway (it carries the network rows), so the sweep generates its own
				! matrix in the block after the baseline. Stating it here rather than relying on
				! that is what RunTR4_GMP_BaseNoNet does.
				!
				! WHAT MAY MOVE. The parallel sweep is bit-identical (Tulio, TR3: proj 0.000e+00,
				! _soc_ and _fair_ identical byte for byte). BaseNoNetwork is the half that can
				! move numbers, and the invariant to test is proj, not P/Q:
				!   py -3 scripts/compare_FOR_runs.py results/full_feeder_2026-08/FOR_rolling_full_m0_20260817.csv FOR_rolling_full_asyncnonet.csv
				!
				! NO RESUME. RollFlushCSV keeps every finished vertex on disk, but RunFOR_Rolling
				! cannot pick up where it stopped - an interruption means starting at period 1.
				! Watch FOR_rolling_progress_full_asyncnonet.txt, rewritten after every vertex.
				UseBattComp       := 0;
				FairMode          := 0;   ! m=0, no fairness. Explicit so the run cannot inherit a session value
				FairFileTag       := "";
				RollFileSuffix    := "_full_asyncnonet";
				ReduceNetwork     := 0;   ! FULL feeder - every transformer in detail, nothing lumped
				DetailTagCSV      := "";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 0;   ! see above: BaseNoNetwork skips the shared instance regardless
				BaseNoNetwork     := 1;   ! committed baseline solved as the battery/energy model only
				EnableRollDiag    := 0;   ! the parallel branch is gated on this; pin it so a session value cannot silently force the sequential path
				RollAsyncK        := 2;   ! memory, not cores, is the binding constraint at 1216 batteries
				RollAsyncThreads  := 12;
				BaseNoNetGMP      := 0;
				RollMaxPeriods    := 0;   ! defensive pin: RunFullFeeder_AsyncSmoke and RunTR6_AsyncTune leave it at 2 if interrupted -> a 2-period run with a complete-looking CSV
				RollLinearized    := 0;   ! defensive pin: RunTR3_Linear/RunTR7_Linear leave it at 1 if interrupted, which would silently relax this run
				run RunFOR_Rolling;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				BaseNoNetwork     := 0;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "WHOLE FEEDER, m=0, the 2026-08-21 production configuration: RunFullFeeder_Async plus BaseNoNetwork=1, so the sweep runs RollAsyncK=2 directions at once AND the committed baseline is solved battery-only. Writes FOR_rolling_full_asyncnonet.csv with its soc and fair companions, and FOR_rolling_progress_full_asyncnonet.txt after every vertex. A/B against results/full_feeder_2026-08/FOR_rolling_full_m0_20260817.csv with scripts/compare_FOR_runs.py; the invariant is proj, not P/Q.";
		}
		Procedure RunTR3_BaseNoNet {
			Body: {
				! DIAGNOSTIC (2026-08-22): does BaseNoNetwork = 1 break the PARALLEL sweep?
				!
				! RunTR3_Base with the two settings that RunFullFeeder_AsyncNoNet added and that no
				! run of the async campaign ever used: RollGMPBaseline = 0 and BaseNoNetwork = 1.
				! Everything else - transformer, split, threads - is RunTR3_Base exactly, so the two
				! are comparable and the only variable is the generation path.
				!
				! WHY. The whole-feeder run of 2026-08-21 stalled: 9 h 06, one thread at 100%, memory
				! frozen at 17.08 GB, zero vertices. It ran with RollGMPBaseline = 0, which generates
				! the sweep matrix in the sweep block instead of sharing the baseline's instance - so
				! GMP::Instance::Copy was called on a NEVER-SOLVED instance, which the async campaign
				! never did. This isolates that from the sheer scale of the full feeder.
				!
				! READ IT AGAINST RunTR3_Base: 576/576 Optimal and ~20 min means the generation path
				! is innocent and the whole-feeder stall is scale. A stall here means the opposite,
				! and RunFullFeeder_Async (RollGMPBaseline = 1) deserves a retry.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR3_base.csv FOR_rolling_TR3_basenonet.csv
				UseBattComp       := 0;
				RollFileSuffix    := "_TR3_basenonet";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR3";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 0;   ! <-- la variable bajo prueba
				BaseNoNetwork     := 1;   ! <-- la variable bajo prueba
				EnableRollDiag    := 0;
				RollAsyncK        := 6;   ! identico a RunTR3_Base
				RollAsyncThreads  := 4;
				run RunFOR_Rolling;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				BaseNoNetwork     := 0;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "DIAGNOSTIC: RunTR3_Base plus RollGMPBaseline=0 and BaseNoNetwork=1, the two settings the whole-feeder stall of 2026-08-21 ran with and that the async campaign never used. Same transformer, same 6x4 split. If this matches RunTR3_Base in time and answers, the generation path is innocent and the stall is scale. Writes FOR_rolling_TR3_basenonet.csv.";
		}
		Procedure RunTR3_Base3b {
			Body: {
				! TEST 3b VALIDATION at TR3 scale. Identical to RunTR3_BaseNoNet in what it asks the
				! model for - a network-free committed baseline with the 12 sweep directions solved
				! 6 at a time - but obtained through BaseNoNetGMP = 1 on the SHARED instance instead
				! of through BaseNoNetwork = 1, which forces RollGMPBaseline = 0 and leaves the
				! instance never solved when the async path copies it.
				!
				! THE COMPARISON THAT MATTERS is against FOR_rolling_TR3_basenonet.csv, not against
				! RunTR3_Base: 3b must reproduce the NETWORK-FREE baseline, and the strongest single
				! check is the soc CSV, which is the committed dispatch the sweep inherits.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR3_basenonet.csv FOR_rolling_TR3_base3b.csv
				UseBattComp       := 0;
				RollFileSuffix    := "_TR3_base3b";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR3";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;   ! instancia COMPARTIDA - lo contrario de BaseNoNetwork
				BaseNoNetwork     := 0;   ! debe quedar en 0 o el camino compartido se salta
				BaseNoNetGMP      := 1;   ! <-- la receta bajo prueba
				EnableRollDiag    := 0;
				RollAsyncK        := 6;
				RollAsyncThreads  := 4;
				run RunFOR_Rolling;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				BaseNoNetGMP      := 0;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "TEST 3b VALIDATION: RunTR3_BaseNoNet's question answered through BaseNoNetGMP=1 on the shared instance. Compare FOR_rolling_TR3_base3b.csv and its soc companion against the _TR3_basenonet pair.";
		}
		Procedure RunFullFeeder_Production {
			Body: {
				! WHOLE-FEEDER PRODUCTION, m=0. THE standard way to run the full network as of
				! 2026-08-23. Supersedes RunFullFeeder_NoFairness, which is the same run without the
				! network-free baseline and is kept as the reference that produced results/full_feeder_2026-08.
				!
				!   RollGMPBaseline = 1   one generated matrix per period, shared by baseline and sweep
				!   BaseNoNetGMP    = 1   that baseline solved with the NetworkModel rows deactivated
				!   RollAsyncK      = 0   SEQUENTIAL sweep - see below, this is deliberate
				!
				! WHY THE SWEEP IS SEQUENTIAL HERE. This is the conservative entry point and stays that
				! way. Two whole-feeder runs with the parallel sweep at K=2 stopped producing vertices:
				!   2026-08-21  RunFullFeeder_AsyncNoNet   period 1, 9 h 06, zero vertices
				!   2026-08-22  this procedure at K=2      periods 1-6 fine, then period 7 for 16.7 h
				!
				! Tracing on 2026-08-25/26 added two things. GMP::Instance::Copy takes about 3 s at this
				! scale and completed every one of ~60 traced calls, so the copy is not where the trouble
				! is. What does fail, in EVERY batch, is the last solver session launched: it returns
				! SolverFailure / NoSolution because a whole-feeder barrier factorisation reserves memory
				! per thread, and two of them at 12 threads do not fit. The synchronous rescue in
				! RunFOR_Rolling then re-solves it correctly, which is why the CSVs never showed it.
				!
				! So the cost of going sequential is lower than previously recorded: at K=2 x 12 every
				! second vertex was being solved twice, and the measured sweep rate (349 s/vertex) was
				! slightly worse than sequential (~334 s/vertex).
				!
				! RunFullFeeder_ProductionK3, just below, is the same run at K=3 x 5 threads, which does
				! fit: 156/156 Optimal with zero rescues over 13 periods. Prefer it once the split has
				! been checked on the machine at hand. See docs/parallel-sweep-memory.md.
				!
				! WHAT IS ESTABLISHED. BaseNoNetGMP cuts the period boundary from 36 min to 24 min - about
				! 9.6 h over 48 periods - and does not move results: at TR3 the committed dispatch is
				! identical column by column, and over the six whole-feeder periods that did complete,
				! 72/72 Optimal, OVviol unchanged at 1.867e-10, and the FOR area within +/-0.0024 % of the
				! 2026-08-17 reference.
				!
				! NO RESUME. RollFlushCSV keeps every finished vertex on disk, but RunFOR_Rolling restarts
				! at period 1. Watch FOR_rolling_progress_full_prod.txt, rewritten after every vertex, and
				! alarm on a STALL, not only on a slow start: both hangs were silent.
				UseBattComp       := 0;
				FairMode          := 0;   ! m=0, explicit so the run cannot inherit a session value
				FairFileTag       := "";
				RollFileSuffix    := "_full_prod";
				ReduceNetwork     := 0;   ! FULL feeder, every transformer in detail
				DetailTagCSV      := "";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				BaseNoNetwork     := 0;   ! must stay 0 - BaseNoNetGMP is the network-free baseline here
				BaseNoNetGMP      := 1;
				EnableRollDiag    := 0;
				RollAsyncK        := 0;   ! SEQUENTIAL - the instance copy hangs at this scale, see above
				RollAsyncThreads  := 2;
				RollMaxPeriods    := 0;   ! defensive pin: RunFullFeeder_AsyncSmoke and RunTR6_AsyncTune leave it at 2 if interrupted -> a 2-period run with a complete-looking CSV
				RollLinearized    := 0;   ! defensive pin: RunTR3_Linear/RunTR7_Linear leave it at 1 if interrupted, which would silently relax this run
				run RunFOR_Rolling;
				BaseNoNetGMP      := 0;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "WHOLE-FEEDER PRODUCTION, m=0, the standard run as of 2026-08-23: shared instance, committed baseline solved network-free (BaseNoNetGMP=1), sweep SEQUENTIAL. The parallel sweep is deliberately off: GMP::Instance::Copy hangs intermittently on the full feeder - period 1 on 2026-08-21 and period 7 on 2026-08-22, the second with the instance already solved. BaseNoNetGMP alone saves about 9.6 h of the 82.17 h reference and does not move results. Writes FOR_rolling_full_prod.csv plus soc/fair companions. See docs/whole-feeder-production.md.";
		}
		Procedure RunFullFeeder_ProductionK3 {
			Body: {
				! WHOLE-FEEDER PRODUCTION, m=0, with THREE sweep directions solved at a time. Identical
				! to RunFullFeeder_Production in every assignment except RollAsyncK and RollAsyncThreads.
				!
				! WHY 3 x 5 AND NOT 2 x 12. The CPLEX barrier reserves working memory PER THREAD, so
				! RollAsyncThreads governs how much a sweep session needs, not just how much CPU it takes:
				!
				!     12 threads  ->  about 74 GB per session
				!      5 threads  ->  about 42 GB per session
				!
				! The whole-feeder instance is 6,214,854 rows / 6,095,686 columns / 24,289,627 nonzeros,
				! so a single factorisation is already large. What fits is:
				!
				!     base (about 37 GB)  +  K x memory_per_session  <=  commit limit
				!
				! On the machine these were measured on the commit limit is 182.55 GB (63.45 GB of RAM +
				! 119.10 GB of page file), which predicted and then matched:
				!
				!     K=2 x 12  ->  37 + 2x74 = 185 GB  ->  1 of 2 sessions fails
				!     K=4 x  5  ->  37 + 4x42 = 205 GB  ->  3 of 4 succeed
				!     K=3 x  5  ->  37 + 3x42 = 163 GB  ->  all 3 succeed
				!
				! A session that cannot get its memory returns SolverFailure / NoSolution and is then
				! re-solved by the synchronous rescue in RunFOR_Rolling. The vertex is still correct, so
				! this costs a full extra solve without showing up anywhere in the CSVs.
				!
				! ON A DIFFERENT MACHINE THE SPLIT WILL DIFFER - use the rule, not these numbers. Run one
				! period and check that no direction needed a rescue before committing days of wall clock.
				!
				! EVIDENCE. 13 periods, 156/156 Optimal, zero rescues, max abs dproj 2.27e-04 against the
				! 2026-08-17 sequential reference, FOR area within +0.0066 / -0.0035 %. Versioned under
				! results/parallel_k3_2026-08; write-up in docs/parallel-sweep-memory.md.
				!
				! NO RESUME. RollFlushCSV keeps every finished vertex on disk, but RunFOR_Rolling restarts
				! at period 1. Watch FOR_rolling_progress_full_k3.txt and alarm on a STALL, not only on a
				! slow start.
				UseBattComp       := 0;
				FairMode          := 0;   ! m=0, explicit so the run cannot inherit a session value
				FairFileTag       := "";
				RollFileSuffix    := "_full_k3";
				ReduceNetwork     := 0;   ! FULL feeder, every transformer in detail
				DetailTagCSV      := "";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				BaseNoNetwork     := 0;   ! must stay 0 - BaseNoNetGMP is the network-free baseline here
				BaseNoNetGMP      := 1;
				EnableRollDiag    := 0;
				RollFlushCSV      := 1;   ! every vertex reaches disk as it is produced; there is no resume
				RollAsyncK        := 3;   ! <-- this and RollAsyncThreads are the only difference against RunFullFeeder_Production
				RollAsyncThreads  := 5;   ! 3 x 5 = 15 threads, which also avoids oversubscribing a 22-thread machine
				RollMaxPeriods    := 0;   ! defensive pin: RunFullFeeder_AsyncSmoke and RunTR6_AsyncTune leave it at 2 if interrupted -> a 2-period run with a complete-looking CSV
				RollLinearized    := 0;   ! defensive pin: RunTR3_Linear/RunTR7_Linear leave it at 1 if interrupted, which would silently relax this run
				run RunFOR_Rolling;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				BaseNoNetGMP      := 0;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "WHOLE-FEEDER PRODUCTION, m=0, sweep parallel at K=3 x 5 threads. Same model and settings as RunFullFeeder_Production; only RollAsyncK and RollAsyncThreads differ. RollAsyncThreads is a MEMORY knob: the CPLEX barrier reserves working space per thread, so a session needs about 74 GB at 12 threads and about 42 GB at 5. At K=2 x 12 the second session of every batch failed and was silently re-solved by the rescue; at K=3 x 5 all three fit. Evidence: 13 periods, 156/156 Optimal, zero rescues, under results/parallel_k3_2026-08. Re-check the split on a different machine. Writes FOR_rolling_full_k3.csv plus its soc and fair companions. See docs/parallel-sweep-memory.md.";
		}
		Procedure RunFullFeeder_ParallelRepro {
			Body: {
				! REPRODUCES THE HANG. Not a production run - this configuration is expected to stop
				! producing vertices at some period and never resume. It exists so the failure can be
				! investigated instead of only described, and so Tulio can reach it: he has never been
				! able to run the whole feeder on his own machine.
				!
				! RunFullFeeder_Production with RollAsyncK = 2 and RollAsyncThreads = 12 (the latter inert
				! below K=2). This is the configuration that ran on 2026-08-22 under the working name
				! RunFullFeeder_3b, from a scratch copy of the project that was never committed - so that
				! name appears nowhere in this file and the identity cannot be checked against source.
				!
				! WHAT HAPPENS. GMP::Instance::Copy does not return: one thread of ~72 at 100 %, memory
				! flat, no vertex written, no error raised, and no time limit fires because nothing ever
				! reaches a solver. Observed twice on the full feeder, never on a reduced transformer:
				!   2026-08-21  RunFullFeeder_AsyncNoNet   hung in period 1, 9 h 06, zero vertices
				!   2026-08-22  RunFullFeeder_3b (= this)  periods 1-6 fine, hung in period 7, 16.7 h
				! The second had the shared instance ALREADY SOLVED by the baseline - its SOC block is
				! on disk timestamped 23:06:53 - so "the copy acts on a never-solved instance" is not
				! the cause. Ruled out: memory (33.7 GB free, RSS flat rather than growing), the machine
				! (RunTR3_Base gives 9.78 cores and 306/306 Optimal), and the settings (RunTR3_BaseNoNet
				! reproduces this configuration at reduced scale, 48/48 Optimal in 83 s).
				!
				! HOW TO WATCH IT. FOR_rolling_progress_full_parrepro.txt is rewritten after every
				! vertex. Alarm when its mtime stops advancing for more than ~45 min - a period boundary
				! plus a solve. Both hangs were silent; the 2026-08-22 one ran 16.7 h unnoticed because
				! the monitor only checked that the FIRST vertex appeared.
				!
				! The 2026-08-22 partial - 6 periods, 72 vertices, 72/72 Optimal, OVviol unchanged and
				! FOR area within +/-0.0024 % of the reference - was kept under the suffix _full_3b.
				! See docs/whole-feeder-production.md section 3.
				UseBattComp       := 0;
				FairMode          := 0;
				FairFileTag       := "";
				RollFileSuffix    := "_full_parrepro";
				ReduceNetwork     := 0;
				DetailTagCSV      := "";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				BaseNoNetwork     := 0;
				BaseNoNetGMP      := 1;
				EnableRollDiag    := 0;
				RollAsyncK        := 2;   ! <-- this and RollAsyncThreads are what changes against RunFullFeeder_Production;
				                          ! RollAsyncThreads only has an effect with RollAsyncK >= 2, so this is the effective change
				RollAsyncThreads  := 12;
				RollMaxPeriods    := 0;   ! defensive pin: RunFullFeeder_AsyncSmoke and RunTR6_AsyncTune leave it at 2 if interrupted -> a 2-period run with a complete-looking CSV
				RollLinearized    := 0;   ! defensive pin: RunTR3_Linear/RunTR7_Linear leave it at 1 if interrupted, which would silently relax this run
				run RunFOR_Rolling;
				RollAsyncK        := 0;
				RollAsyncThreads  := 2;
				BaseNoNetGMP      := 0;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "REPRODUCES THE WHOLE-FEEDER PARALLEL HANG. Not for production: expected to stop producing vertices at some period and never resume. RunFullFeeder_Production with RollAsyncK=2, which is what ran on 2026-08-22 as RunFullFeeder_3b - periods 1-6 clean, period 7 hung for 16.7 h with one thread at 100 %. Kept so the failure can be investigated rather than only described. See docs/whole-feeder-production.md section 3.";
		}
		Procedure RunFullFeeder_NoFairness {
			Body: {
				! WHOLE-FEEDER PRODUCTION, no fairness (m=0). This is the run docs/network-scope.md section 4
				! recorded as never yet completed when this was written. It COMPLETED on 2026-08-17 in
				! 82.17 h, 576/576 Optimal, and is versioned under results/full_feeder_2026-08.
				! 48 periods x 12 directions on the full network, exact QCP,
				! with the sweep matrix generated once per period (the GMP phase, docs/rolling-for-performance.md
				! section 6).
				!
				! Scope is set HERE, not in RunFOR_Rolling, which uses whatever ReduceNetwork holds.
				! ReduceNetwork = 0 keeps every transformer in full detail, so no battery is dropped and no
				! transformer is lumped as passive MV load. There is consequently nothing to combine
				! afterwards: combine_FOR_pertrafo.py and FOR_rolling_baseline.csv belong to the
				! per-transformer path and play no part in this run.
				!
				! Writes FOR_rolling_full.csv, FOR_rolling_soc_full.csv and FOR_rolling_fair_full.csv
				! incrementally (RollFlushCSV, on by default), plus FOR_rolling_progress_full.txt after every
				! vertex. At a projected ~2.9 days those two are what make the run interruptible and
				! observable from outside the process.
				!
				! Runtime expectation is ~5300 s per period, projected from the 3-slot preflight in
				! docs/rolling-for-performance.md section 7.3 - a projection, not a measurement of this
				! configuration.
				UseBattComp       := 0;   ! production is the pure QCP (the binary lives in Validation)
				FairMode          := 0;   ! m=0, no fairness. Explicit so the run cannot inherit a session value
				FairFileTag       := "";
				RollFileSuffix    := "_full";
				ReduceNetwork     := 0;   ! FULL feeder
				DetailTagCSV      := "";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				EnableRollDiag    := 0;   ! defensive pin: the parallel path is gated on this
				RollAsyncK        := 0;   ! defensive pin: an inherited value would make this run parallel
				RollAsyncThreads  := 2;
				BaseNoNetwork     := 0;
				BaseNoNetGMP      := 0;
				RollMaxPeriods    := 0;   ! defensive pin: RunFullFeeder_AsyncSmoke and RunTR6_AsyncTune leave it at 2 if interrupted -> a 2-period run with a complete-looking CSV
				RollLinearized    := 0;   ! defensive pin: RunTR3_Linear/RunTR7_Linear leave it at 1 if interrupted, which would silently relax this run
				run RunFOR_Rolling;
				! restore the session defaults
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "WHOLE-FEEDER PRODUCTION, m=0 (no fairness): 48 periods x 12 directions on the full network, exact QCP, one generated matrix per period (RollUseGMP/RollGMPBaseline = 1). Writes FOR_rolling_full.csv plus its soc and fair companions incrementally, and FOR_rolling_progress_full.txt after every vertex. Projected at about 2.9 days - see docs/network-scope.md section 3. Intended to be launched headless with AimmsCmd --run-only.";
		}
		Procedure RunReducedTest_RollingMicro {
			Body: {
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "_two";   ! keep only TR9_two* buses (sub-branch with ~12 PV+battery houses)
				run RunFOR_Rolling;
				DetailLoadPattern := "";       ! defensive reset: back to TR9-full behaviour for subsequent runs
			}
			Comment: "MICRO TEST (one click): the smallest controllable test bed - isolate the TR9_two* sub-branch (12 batteries, 21 loads, 21 buses) and run the daily rolling FOR on it. Goal is understanding: small enough to hand-check SOC trajectories, predict the FOR shape, and trace what each constraint does. Back to TR9-full: leave DetailLoadPattern empty. Back to the full feeder: set ReduceNetwork:=0.";
		}
		Procedure RunReducedTest_RollingMicro_LegacyWarm {
			Body: {
				FOR_SweepWarmStart := 1;   ! legacy: run MainExecution before every vertex solve
				run RunReducedTest_RollingMicro;
				FOR_SweepWarmStart := 0;   ! defensive reset: back to the production default
			}
			Comment: {
				"A/B PARTNER of RunReducedTest_RollingMicro (one click): the same micro test with the legacy
				per-direction MainExecution solve switched back ON. Since 2026-07-29 the default is OFF, so this
				is the procedure that reproduces the OLD behaviour - use it to re-run the A/B after any change to
				the sweep or after a solver/AIMMS upgrade. Compare the two FOR_rolling.csv files with
				scripts/compare_FOR_runs.py. Time the RUNS with a clock, not with the CSV \'time\' column - that
				column is FOR_VertexCont.SolutionTime only and does not see the solve this toggle adds.
				Acceptance: \'proj\' must reproduce within ~2e-6 p.u. and no direction may change solve status;
				P/Q are allowed to slide along a flat face. Measured 2026-07-29 on TR9_two: legacy 41m22s vs
				default 10m12s, outputs bit-identical. See FOR_SweepWarmStart."
			}
		}
		Procedure RunReducedTest_RollingDiag {
			Body: {
				ReduceNetwork  := 1;
				DetailTagCSV   := "TR9";
				EnableRollDiag := 1;
				DiagCyclicBand := 0.10;   ! Pass 1: |SOC_end - SOC_start| <= 10% of capacity (must exceed the 5% production band in RunFOR_Rolling to be a real relaxation)
				DiagPVcutFrac  := 0.50;   ! Pass 2: halve PV (proxy for explicit curtailment)
				run RunFOR_Rolling;
				EnableRollDiag := 0;       ! defensive reset
			}
			Comment: "TEST (one click) + DIAGNOSTIC: same as RunTR9, but for each failed direction inside RunFOR_Rolling, retry with (Pass 1) cyclic-SOC band relaxed to DiagCyclicBand (default 0.05), then (Pass 2) cyclic relaxed + GenP0 scaled by (1 - DiagPVcutFrac) (default 0.50). Attribution is written to FOR_rolling_diag.csv (cols: now,target,angle_deg,pass,status,P,Q,proj,time). Use to tell apart cyclic-SOC-bound vs PV-saturation-bound vs linearization-bound failures.";
		}
		Procedure RunMicro_GMP_Validate {
			Body: {
				! A/B COMPLETO de la migracion GMP sobre el banco micro (TR9_two, 12 baterias).
				! Corre CUATRO veces el mismo caso: referencia y GMP, sin fairness y con m=1.
				! El par con m=1 es el que ejercita GMP::Row::Deactivate/Activate - sin el, la
				! migracion quedaria validada solo donde las filas de fairness no existen.
				! Las referencias se re-generan aca en vez de usar los CSV historicos, porque
				! aquellos son de AIMMS 26.1.3.1 y estos de 26.2.3.3.
				! ~40 min. Comparar con scripts/compare_FOR_runs.py:
				!   FOR_rolling_mAref.csv  vs  FOR_rolling_mAgmp.csv
				!   FOR_rolling_mL1ref.csv vs  FOR_rolling_mL1gmp.csv
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "_two";
				UseBattComp       := 0;

				FairMode := 0;
				RollUseGMP := 0;  RollGMPBaseline := 0;  RollFileSuffix := "_mAref";
				run RunFOR_Rolling;
				RollUseGMP := 1;  RollGMPBaseline := 1;  RollFileSuffix := "_mAgmp";
				run RunFOR_Rolling;

				FairMode := 1;
				RollUseGMP := 0;  RollGMPBaseline := 0;  RollFileSuffix := "_mL1ref";
				run RunFOR_Rolling;
				RollUseGMP := 1;  RollGMPBaseline := 1;  RollFileSuffix := "_mL1gmp";
				run RunFOR_Rolling;

				FairMode          := 0;
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollFileSuffix    := "";
				DetailLoadPattern := "";
			}
			Comment: "A/B completo de la migracion GMP sobre el banco micro: cuatro corridas del mismo caso (referencia y GMP, FairMode 0 y 1) escritas a _mAref/_mAgmp/_mL1ref/_mL1gmp. El par con FairMode=1 valida la desactivacion de filas de fairness, que es lo que permite resolver el baseline desde la instancia del barrido con cualquier criterio. ~40 min. Las referencias se re-generan en la misma version de AIMMS para que la comparacion no arrastre el cambio 26.1.3.1 -> 26.2.3.3.";
		}
		Procedure RunMicro_Baseline {
			Body: {
				BaseDetailPattern := "_two";       ! same reduced network as the micro test bed
				BaseFileTag       := "_micro";     ! -> FOR_rolling_baseline_micro.csv
				run RunFOR_Rolling_Baseline;
				BaseDetailPattern := "";           ! defensive reset: back to the feeder-wide baseline
				BaseFileTag       := "";
			}
			Comment: {
				"STAGE 0 (one click): the ALL-IDLE trajectory B(t) for the MICRO test bed ->
				FOR_rolling_baseline_micro.csv. Needed to express the FOR as a DEVIATION region
				(dP = P - B_P, dQ = Q - B_Q), which is the view to use for fairness and dispatch: the
				absolute region is dominated by the feeder\'s passive imbalance, which swings ~3.3 MW
				across the day and which nobody controls inside the service slot.
				
				Why a separate baseline instead of reusing FOR_rolling_baseline.csv: that one is computed
				with DetailLoadPattern empty, i.e. TR9 in full. Under the micro filter \'_two\' the TR9 buses
				outside the sub-cluster are DROPPED rather than lumped (ApplyNetworkReduction only lumps
				EXCLUDED transformers), so the micro network carries less passive load and its all-idle PCC
				is a genuinely different point. Mixing the two would compare regions against the wrong origin.
				
				CHEAP: every battery is fixed to zero, so there is no optimisation left - one determined
				power flow over the 48-period window, not a 12-direction sweep."
			}
		}
		Procedure RunMicro_FairL1 {
			Body: {
				FairMode    := 1;          ! C1 between PROSUMERS
				FairFileTag := "_fairL1";
				run RunReducedTest_RollingMicro;
				FairMode    := 0;          ! defensive reset: back to case A
				FairFileTag := "";
			}
			Comment: "STAGE 0 (one click): micro test bed under C1 fairness between PROSUMERS. Writes FOR_rolling_fairL1.csv (+ _soc_, + the fairness log). ~10 min. Validate case A (RunReducedTest_RollingMicro, FairMode=0) FIRST and confirm it still reproduces the baseline exactly before trusting any fairness number.";
		}
		Procedure RunMicro_FairL2 {
			Body: {
				FairMode    := 2;          ! C1 between AGGREGATORS
				FairFileTag := "_fairL2";
				run RunReducedTest_RollingMicro;
				FairMode    := 0;
				FairFileTag := "";
			}
			Comment: "STAGE 0 (one click): micro test bed under C1 fairness between AGGREGATORS. ~10 min. The micro bed carries all three aggregators with a 1/7/4 battery split (3.6 / 25.2 / 14.4 kW), which is far more unbalanced than TR9\'s 28/32/30 - so this is the SHARPER test of level 2, not a weaker one.";
		}
		Procedure RunTR9_FairL1 {
			Body: {
				FairMode    := 1;
				FairFileTag := "_fairL1";
				run RunTR9;                ! sets RollFileSuffix := '_TR9'; FairFileTag composes -> FOR_rolling_TR9_fairL1.csv
				FairMode    := 0;
				FairFileTag := "";
			}
			Comment: "STAGE 0 PRODUCTION (one click): TR9 rolling FOR under C1 fairness between PROSUMERS. ~3h40. Run only after the micro bed passes.";
		}
		Procedure RunTR9_FairL2 {
			Body: {
				FairMode    := 2;
				FairFileTag := "_fairL2";
				run RunTR9;
				FairMode    := 0;
				FairFileTag := "";
			}
			Comment: "STAGE 0 PRODUCTION (one click): TR9 rolling FOR under C1 fairness between AGGREGATORS. ~3h40. Expect a SMALL contraction: TR9\'s three aggregators hold 28/32/30 prosumers by design, so their capacities are nearly equal and the level-2 constraint has little to bite on. That is a finding of the deliverable, not a defect - the micro bed\'s 1/7/4 split is where level 2 shows its teeth.";
		}
		Procedure RunMicro_FairL3 {
			Body: {
				FairMode    := 3;
				FairFileTag := "_fairL3";
				run RunReducedTest_RollingMicro;
				FairMode    := 0;
				FairFileTag := "";
			}
			Comment: {
				"STAGE 0 (one click): micro test bed under C1 fairness between PROSUMERS on the EXCHANGE (m=3, Prof. Luis 31-Jul-2026). ~10 min. Run this BEFORE the TR9 version. FairCap switches to BattMaxP + the PV of the service instant automatically (keyed off FairMode), so s_i becomes the export capability actually available then, and no flag has to be remembered. Zeta > 0 means the fleet is exporting. TWO THINGS TO EXPECT: the bound is one-sided here, Zeta <= 1 holds by construction but Zeta >= -1 does NOT, so report the realised range rather than assuming it; and the criterion CAN be infeasible in some periods - a result, not a defect, see the constraint comment."
			}
		}
		Procedure RunMicro_FairL4 {
			Body: {
				FairMode    := 4;
				FairFileTag := "_fairL4";
				run RunReducedTest_RollingMicro;
				FairMode    := 0;
				FairFileTag := "";
			}
			Comment: {
				"STAGE 0 (one click): micro test bed under C1 fairness between AGGREGATORS on the EXCHANGE (m=4). ~10 min. The micro bed\'s 1/7/4 aggregator split makes this the sharper test of level 4, exactly as it is for level 2. FairCap switches to BattMaxP + the PV of the service instant automatically (keyed off FairMode), so s_i becomes the export capability actually available then, and no flag has to be remembered. Zeta > 0 means the fleet is exporting. TWO THINGS TO EXPECT: the bound is one-sided here, Zeta <= 1 holds by construction but Zeta >= -1 does NOT, so report the realised range rather than assuming it; and the criterion CAN be infeasible in some periods - a result, not a defect, see the constraint comment."
			}
		}
		Procedure RunTR9_FairL3 {
			Body: {
				FairMode    := 3;
				FairFileTag := "_fairL3";
				run RunTR9;
				FairMode    := 0;
				FairFileTag := "";
			}
			Comment: {
				"STAGE 0 PRODUCTION (one click): TR9 rolling FOR under C1 fairness between PROSUMERS on the EXCHANGE (m=3). ~3h40-4h. Run only after RunMicro_FairL3 passes. Unlike m=1, this one has genuinely heterogeneous capacities to work with - PV runs 1 to 4 kW across the fleet while the batteries are all 3.6 kW - so \'proportional\' no longer coincides with \'equal absolute\'. FairCap switches to BattMaxP + the PV of the service instant automatically (keyed off FairMode), so s_i becomes the export capability actually available then, and no flag has to be remembered. Zeta > 0 means the fleet is exporting. TWO THINGS TO EXPECT: the bound is one-sided here, Zeta <= 1 holds by construction but Zeta >= -1 does NOT, so report the realised range rather than assuming it; and the criterion CAN be infeasible in some periods - a result, not a defect, see the constraint comment."
			}
		}
		Procedure RunTR9_FairL4 {
			Body: {
				FairMode    := 4;
				FairFileTag := "_fairL4";
				run RunTR9;
				FairMode    := 0;
				FairFileTag := "";
			}
			Comment: {
				"STAGE 0 PRODUCTION (one click): TR9 rolling FOR under C1 fairness between AGGREGATORS on the EXCHANGE (m=4). ~3h40-4h30. Budget MORE wall-clock than m=3: level 2 cost +19.9% against level 1 because it leaves the fleet many coupled degrees of freedom instead of collapsing it to one, and m=4 stands to m=3 the same way. FairCap switches to BattMaxP + the PV of the service instant automatically (keyed off FairMode), so s_i becomes the export capability actually available then, and no flag has to be remembered. Zeta > 0 means the fleet is exporting. TWO THINGS TO EXPECT: the bound is one-sided here, Zeta <= 1 holds by construction but Zeta >= -1 does NOT, so report the realised range rather than assuming it; and the criterion CAN be infeasible in some periods - a result, not a defect, see the constraint comment."
			}
		}
	}
	Section DOE_Dispatch {
		Comment: "Two-level fair dispatch study (thesis chapter): the DSO disaggregates a requested PCC service point into per-aggregator Dynamic Operating Envelopes (level-1 fairness, capacity-proportional across aggregators) and then per-prosumer DOEs (level-2 fairness, capacity-proportional within each aggregator). All constraints are gated by DOE_Stage=0 by default, so this section adds NOTHING to the production solves. Entry points: RunDOE_Dispatch (one target point) and RunDOE_Envelope (per-prosumer DOE bands from the P-extremes of the FOR).";
		DeclarationSection DOE_Declarations {
			Parameter DOE_Stage {
				Default: 0;
				Comment: "0 = section inactive (no rows generated anywhere - production untouched). 1 = level-1 solve (aggregator fairness). 2 = level-2 solve (prosumer fairness, aggregator allocations held by DOE_HoldAgg).";
			}
			Parameter DOE_NAggs {
				Default: 2;
				Comment: "Number of aggregators the prosumers are randomly split into.";
			}
			Set DOE_Aggs {
				SubsetOf: Integers;
				Index: ag;
				Definition: ElementRange(1, DOE_NAggs);
			}
			Parameter DOE_Seed {
				Default: 42;
				Comment: "Random seed for the prosumer->aggregator split (reproducible).";
			}
			ElementParameter DOE_AggOf {
				IndexDomain: bat;
				Range: DOE_Aggs;
				Comment: {
					"Aggregator of each battery/prosumer; set by DOE_AssignAggregators."
				}
			}
			Parameter DOE_CapAgg {
				IndexDomain: ag;
				Definition: sum(bat | DOE_AggOf(bat) = ag, BattMaxP(bat));
				Comment: "Installed battery power capacity per aggregator (p.u.).";
			}
			Parameter DOE_CapTot {
				Definition: sum(bat, BattMaxP(bat));
			}
			Parameter DOE_Now {
				Default: 25;
				Comment: "Chosen rolling step (1..48). The dispatch happens at that step\'s service slot (window slot 2 = period now+1), starting from the realised SOC reconstructed by re-committing steps 1..DOE_Now.";
			}
			Parameter DOE_TargetP {
				Default: 0;
				Comment: "Requested PCC active power (p.u.) at the service slot - pick a point inside the FOR of step DOE_Now (see FOR_rolling_<tag>.csv).";
			}
			Parameter DOE_TargetQ {
				Default: 0;
				Comment: "Requested PCC reactive power (p.u.) at the service slot.";
			}
			Parameter DOE_PinTol {
				Default: 0.001;
				Comment: {
					"Half-width of the PCC pin band (p.u.). A hair of slack keeps re-pinned FOR-boundary points numerically feasible; 0.001 p.u. = 1 kW."
				}
			}
			Parameter DOE_TiePen {
				Default: 0.0001;
				Comment: "Tiny battery-throughput tiebreaker in both fairness objectives: kills charge+discharge degeneracy without measurably distorting fairness (fairness terms are O(1e-4..1e-2) p.u.^2).";
			}
			StringParameter DOE_TrafoTag {
				InitialData: "TR9";
				Comment: "Transformer the dispatch study runs on (per-TR reduced network, like the production FOR).";
			}
			Parameter DOE_AggAlloc {
				IndexDomain: ag;
				Comment: "Level-1 result: committed net injection per aggregator (p.u.), held fixed in level 2 by DOE_HoldAgg.";
			}
			Parameter DOE_ShareB {
				IndexDomain: bat;
				Comment: "Level-2 fair target per prosumer: its aggregator\'s allocation times BattMaxP share.";
			}
			Parameter DOE_BandLo {
				IndexDomain: bat;
				Comment: "RunDOE_Envelope: prosumer dispatch at the max-export end of the FOR.";
			}
			Parameter DOE_BandMid {
				IndexDomain: bat;
				Comment: "RunDOE_Envelope: prosumer dispatch at the requested target.";
			}
			Parameter DOE_BandHi {
				IndexDomain: bat;
				Comment: "RunDOE_Envelope: prosumer dispatch at the max-import end of the FOR.";
			}
			Variable DOE_NetB {
				IndexDomain: bat | DOE_Stage;
				Range: free;
				Definition: BattP_Dis(bat, PeriodMaxP) - BattP_Chg(bat, PeriodMaxP);
				Comment: "Prosumer net service-slot injection (discharge positive, battery frame).";
			}
			Variable DOE_NetAgg {
				IndexDomain: ag | DOE_Stage;
				Range: free;
				Definition: sum(bat | DOE_AggOf(bat) = ag, DOE_NetB(bat));
				Comment: "Aggregator net service-slot injection.";
			}
			Variable DOE_UtilTot {
				Range: free;
				Definition: sum(bat | DOE_Stage, DOE_NetB(bat)) / max(DOE_CapTot, 1e-9);
				Comment: "Fleet-wide utilisation (net injection / installed capacity). Trivial 0-row when DOE_Stage=0.";
			}
			Variable DOE_OF1 {
				Range: free;
				Definition: sum(ag | DOE_Stage, (DOE_NetAgg(ag) - DOE_UtilTot*DOE_CapAgg(ag))^2) + DOE_TiePen*sum((bat,t) | DOE_Stage, BattP_Chg(bat,t) + BattP_Dis(bat,t));
				Comment: "Level-1 fairness: squared deviation of each aggregator from its capacity-proportional share of the total, + throughput tiebreaker.";
			}
			Variable DOE_OF2 {
				Range: free;
				Definition: sum(bat | DOE_Stage, (DOE_NetB(bat) - DOE_ShareB(bat))^2) + DOE_TiePen*sum((bat,t) | DOE_Stage, BattP_Chg(bat,t) + BattP_Dis(bat,t));
				Comment: "Level-2 fairness: squared deviation of each prosumer from its capacity-proportional share of its aggregator\'s allocation, + throughput tiebreaker.";
			}
			Constraint DOE_PinP {
				IndexDomain: ag | DOE_Stage and ord(ag) = 1;
				Definition: DOE_TargetP - DOE_PinTol <= P_PCC(PeriodMaxP) <= DOE_TargetP + DOE_PinTol;
				Comment: "Pin the PCC active power to the requested service point (band of +-DOE_PinTol). Indexed over the first aggregator element only = one row when active.";
			}
			Constraint DOE_PinQ {
				IndexDomain: ag | DOE_Stage and ord(ag) = 1;
				Definition: DOE_TargetQ - DOE_PinTol <= Q_PCC(PeriodMaxP) <= DOE_TargetQ + DOE_PinTol;
			}
			Constraint DOE_HoldAgg {
				IndexDomain: ag | DOE_Stage = 2;
				Definition: DOE_NetAgg(ag) = DOE_AggAlloc(ag);
				Comment: "Level 2: hold each aggregator at its level-1 fair allocation (lexicographic two-stage fairness).";
			}
			MathematicalProgram DOE_Level1 {
				Objective: DOE_OF1;
				Direction: minimize;
				Constraints: NotTobeExcluded_constraints;
				Variables: NotTobeExcluded_variables;
				Type: Automatic;
			}
			MathematicalProgram DOE_Level2 {
				Objective: DOE_OF2;
				Direction: minimize;
				Constraints: NotTobeExcluded_constraints;
				Variables: NotTobeExcluded_variables;
				Type: Automatic;
			}
			File DOE_DispatchCSV {
				Name: "DOE_dispatch.csv";
				Device: Disk;
				Mode: replace;
			}
			File DOE_AggCSV {
				Name: "DOE_aggregators.csv";
				Device: Disk;
				Mode: replace;
			}
			File DOE_EnvelopeCSV {
				Name: "DOE_envelopes.csv";
				Device: Disk;
				Mode: replace;
			}
		}
		Procedure DOE_AssignAggregators {
			Body: {
				! random, seeded, reproducible split of the (reduced-network) prosumers
				option seed := DOE_Seed;
				DOE_AggOf(bat) := Element(DOE_Aggs, ceil(Uniform(0, 1) * DOE_NAggs));
				display DOE_CapAgg;
			}
			Comment: "Random prosumer->aggregator split (Bernoulli per battery, seed DOE_Seed). Run after the network is loaded/reduced so only the study transformer\'s batteries are assigned.";
		}
		Procedure DOE_PrepWindow {
			Body: {
				! rotate the day so slot 1 = DOE_Now, restore realised SOC, freeze slot 1
				! (identical mechanics to the RunFOR_Rolling sweep preamble)
				RollNow     := DOE_Now;
				RollMap(tt) := Element(Time, mod(ord(tt)-1 + (RollNow-1), nPeriods) + 1);
				empty allvariables;
				run Load_data_dsn;
				P0(d,tt)        := P0raw(d, RollMap(tt));
				Q0(d,tt)        := Q0raw(d, RollMap(tt));
				GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
				Irradiance(tt)  := Irrraw(RollMap(tt));
				BattSOCini(bat) := BattSOCstart(bat);
				BattP_Chg(bat,'1') := RollChgExec(bat);
				BattP_Chg(bat,'1').nonvar := 1;
				BattP_Dis(bat,'1') := RollDisExec(bat);
				BattP_Dis(bat,'1').nonvar := 1;
				run MainExecution;
			}
			Comment: "Rotate window to DOE_Now, seed the realised SOC, freeze the committed slot-1 dispatch, generate warm start. Call before every DOE/probe solve (empty allvariables wipes the previous solve).";
		}
		Procedure DOE_RollToStep {
			Body: {
				! reconstruct the realised SOC trajectory by re-committing steps 1..DOE_Now
				! (baseline solves only - no sweeps - so this is fast: ~DOE_Now MinImports solves)
				BattSOCstart(bat) := BattSOCini(bat);
				for (t | ord(t) <= DOE_Now) do
					RollNow     := ord(t);
					RollMap(tt) := Element(Time, mod(ord(tt)-1 + (RollNow-1), nPeriods) + 1);
					empty allvariables;
					run Load_data_dsn;
					P0(d,tt)        := P0raw(d, RollMap(tt));
					Q0(d,tt)        := Q0raw(d, RollMap(tt));
					GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
					Irradiance(tt)  := Irrraw(RollMap(tt));
					BattSOCini(bat) := BattSOCstart(bat);
					BattP_Chg(bat,'1').nonvar := 0;
					BattP_Dis(bat,'1').nonvar := 0;
					run MinOFminImports;
					if ConvFlag <> 'Optimal' and ConvFlag <> 'LocallyOptimal' then
						solve MinImports
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       method              := 'deterministic concurrent',
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 3000;
						ConvFlag := MinImports.ProgramStatus;
					endif;
					RollChgExec(bat) := BattP_Chg(bat,'1');
					RollDisExec(bat) := BattP_Dis(bat,'1');
					if ord(t) < DOE_Now then
						! advance the realised SOC with the executed slot-1 dispatch (not at the final step:
						! the study happens AT step DOE_Now, from the SOC that step starts with)
						BattSOCstart(bat) := BattSOCini(bat)
							+ (BattP_Chg(bat,'1')*etaChg(bat) - BattP_Dis(bat,'1')/etaDis(bat))*DeltaT/BattEcap(bat);
					endif;
				endfor;
			}
			Comment: "Rebuild the rolling state at step DOE_Now: commit the self-consumption baseline step by step (same solves as RunFOR_Rolling, no sweeps), carrying the realised SOC forward. Leaves RollChgExec/RollDisExec = the committed dispatch of step DOE_Now.";
		}
		Procedure DOE_FairSolveAtTarget {
			Arguments: (TgtP,TgtQ);
			Body: {
				DOE_TargetP := TgtP;
				DOE_TargetQ := TgtQ;
				! ---- level 1: fair split between aggregators ----
				run DOE_PrepWindow;
				DOE_Stage := 1;
				solve DOE_Level1
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       method := 'deterministic concurrent', time_limit := 3000;
				DOE_AggAlloc(ag) := DOE_NetAgg(ag);
				DOE_ShareB(bat)  := DOE_AggAlloc(DOE_AggOf(bat)) * BattMaxP(bat) / max(DOE_CapAgg(DOE_AggOf(bat)), 1e-9);
				! ---- level 2: fair split between prosumers, aggregator allocations held ----
				run DOE_PrepWindow;
				DOE_Stage := 2;
				solve DOE_Level2
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       method := 'deterministic concurrent', time_limit := 3000;
				DOE_Stage := 0;
			}
			Comment: "Two-stage lexicographic fair dispatch at one requested PCC point. Leaves the level-2 solution in the model variables (DOE_NetB etc.) and the level-1 allocations in DOE_AggAlloc.";
			Parameter TgtP {
				Property: Input;
			}
			Parameter TgtQ {
				Property: Input;
			}
		}
		Procedure RunDOE_Dispatch {
			Body: {
				! ---- production config, mirrored from RunFOR_Rolling (exact QCP) ----
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 0;
				option Feasibility_Tolerance         := 1.0e-3;
				option Barrier_Convergence_Tolerance := 1.0e-2;
				option Scaling_Flag                  := 2;
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 0;
				FOR_LinearizeVmax         := 0;
				RollCyclicSOC             := 1;
				CyclicSOCBand             := 0.05;
				PeriodMaxP                := 2;
				FOR_TieEps                := 0;
				UseBattComp               := 0;
				ReduceNetwork             := 1;
				DetailTagCSV              := DOE_TrafoTag;
				DetailLoadPattern         := "";
				DOE_Stage                 := 0;
				! load once: freeze raw inputs + day-start SOC, then split the prosumers
				empty allvariables;
				run Load_data_dsn;
				P0raw(d,t)    := P0(d,t);
				Q0raw(d,t)    := Q0(d,t);
				GenP0raw(d,t) := GenP0(d,t);
				Irrraw(t)     := Irradiance(t);
				run DOE_AssignAggregators;
				! realised state at the chosen step, then the two-level fair dispatch
				run DOE_RollToStep;
				DOE_FairSolveAtTarget(DOE_TargetP, DOE_TargetQ);
				! ---- outputs ----
				DOE_AggCSV.PageWidth := 32767;
				put DOE_AggCSV;
				put "aggregator,n_prosumers,cap_pu,alloc_pu,util,targetP_pu,targetQ_pu,now" / ;
				for (ag) do
					put ord(ag):2:0, ",", sum(bat | DOE_AggOf(bat) = ag, 1):4:0, ",", DOE_CapAgg(ag):12:6, ",",
					    DOE_AggAlloc(ag):12:6, ",", (DOE_AggAlloc(ag)/max(DOE_CapAgg(ag),1e-9)):10:6, ",",
					    DOE_TargetP:12:6, ",", DOE_TargetQ:12:6, ",", DOE_Now:3:0 / ;
				endfor;
				putclose DOE_AggCSV;
				DOE_DispatchCSV.PageWidth := 32767;
				put DOE_DispatchCSV;
				put "battery,aggregator,BattMaxP_pu,SOC_start,Chg2_pu,Dis2_pu,net_pu,fair_share_pu,util" / ;
				for (bat) do
					put bat:24, ",", ord(DOE_AggOf(bat)):2:0, ",", BattMaxP(bat):10:6, ",", BattSOCstart(bat):10:6, ",",
					    BattP_Chg(bat,PeriodMaxP):12:6, ",", BattP_Dis(bat,PeriodMaxP):12:6, ",",
					    (BattP_Dis(bat,PeriodMaxP)-BattP_Chg(bat,PeriodMaxP)):12:6, ",", DOE_ShareB(bat):12:6, ",",
					    ((BattP_Dis(bat,PeriodMaxP)-BattP_Chg(bat,PeriodMaxP))/max(BattMaxP(bat),1e-9)):10:6 / ;
				endfor;
				putclose DOE_DispatchCSV;
				! leave the model clean
				BattP_Chg(bat,t).nonvar := 0;
				BattP_Dis(bat,t).nonvar := 0;
				RollCyclicSOC := 0;
				CyclicSOCBand := 0;
			}
			Comment: "ENTRY POINT 1 - single-point fair dispatch. Set DOE_Now + DOE_TargetP/Q (a point inside that step\'s FOR, from FOR_rolling_<tag>.csv), optionally DOE_Seed/DOE_NAggs/DOE_TrafoTag, then run. Writes DOE_aggregators.csv (level-1 allocations) and DOE_dispatch.csv (per-prosumer dispatch vs fair share).";
		}
		Procedure RunDOE_Envelope {
			Body: {
				! same preparation as RunDOE_Dispatch
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 0;
				option Feasibility_Tolerance         := 1.0e-3;
				option Barrier_Convergence_Tolerance := 1.0e-2;
				option Scaling_Flag                  := 2;
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 0;
				FOR_LinearizeVmax         := 0;
				RollCyclicSOC             := 1;
				CyclicSOCBand             := 0.05;
				PeriodMaxP                := 2;
				FOR_TieEps                := 0;
				UseBattComp               := 0;
				ReduceNetwork             := 1;
				DetailTagCSV              := DOE_TrafoTag;
				DetailLoadPattern         := "";
				DOE_Stage                 := 0;
				empty allvariables;
				run Load_data_dsn;
				P0raw(d,t)    := P0(d,t);
				Q0raw(d,t)    := Q0(d,t);
				GenP0raw(d,t) := GenP0(d,t);
				Irrraw(t)     := Irradiance(t);
				run DOE_AssignAggregators;
				run DOE_RollToStep;
				! ---- probe the P-extremes of this step's FOR (max export / max import) ----
				run DOE_PrepWindow;
				FOR_Angle    := 180;
				FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;
				FOR_Lambda   := 1;
				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       method := 'deterministic concurrent', time_limit := 3000;
				DOE_ProbeLoP := P_PCC(PeriodMaxP);
				DOE_ProbeLoQ := Q_PCC(PeriodMaxP);
				run DOE_PrepWindow;
				FOR_Angle    := 0;
				FOR_AngleRad := 0;
				FOR_Lambda   := 1;
				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       method := 'deterministic concurrent', time_limit := 3000;
				DOE_ProbeHiP := P_PCC(PeriodMaxP);
				DOE_ProbeHiQ := Q_PCC(PeriodMaxP);
				! ---- fair dispatch at lo / mid / hi; collect the per-prosumer bands ----
				DOE_FairSolveAtTarget(DOE_ProbeLoP, DOE_ProbeLoQ);
				DOE_BandLo(bat) := BattP_Dis(bat,PeriodMaxP) - BattP_Chg(bat,PeriodMaxP);
				DOE_FairSolveAtTarget(DOE_TargetP, DOE_TargetQ);
				DOE_BandMid(bat) := BattP_Dis(bat,PeriodMaxP) - BattP_Chg(bat,PeriodMaxP);
				DOE_FairSolveAtTarget(DOE_ProbeHiP, DOE_ProbeHiQ);
				DOE_BandHi(bat) := BattP_Dis(bat,PeriodMaxP) - BattP_Chg(bat,PeriodMaxP);
				! ---- write the per-prosumer DOEs ----
				DOE_EnvelopeCSV.PageWidth := 32767;
				put DOE_EnvelopeCSV;
				put "battery,aggregator,BattMaxP_pu,DOE_lo_pu,DOE_mid_pu,DOE_hi_pu,now,PloFOR,PhiFOR" / ;
				for (bat) do
					put bat:24, ",", ord(DOE_AggOf(bat)):2:0, ",", BattMaxP(bat):10:6, ",",
					    DOE_BandLo(bat):12:6, ",", DOE_BandMid(bat):12:6, ",", DOE_BandHi(bat):12:6, ",",
					    DOE_Now:3:0, ",", DOE_ProbeLoP:12:6, ",", DOE_ProbeHiP:12:6 / ;
				endfor;
				putclose DOE_EnvelopeCSV;
				BattP_Chg(bat,t).nonvar := 0;
				BattP_Dis(bat,t).nonvar := 0;
				RollCyclicSOC := 0;
				CyclicSOCBand := 0;
			}
			Comment: "ENTRY POINT 2 - per-prosumer DOE bands. Probes the max-export and max-import ends of step DOE_Now\'s FOR (two directional solves, slot 1 frozen), fair-dispatches lo/mid/hi, and writes each prosumer\'s [lo,mid,hi] band to DOE_envelopes.csv: the small DOEs the DSO sends down so every prosumer knows its range.";
			Parameter DOE_ProbeLoP;
			Parameter DOE_ProbeLoQ;
			Parameter DOE_ProbeHiP;
			Parameter DOE_ProbeHiQ;
		}
	}
	Section Validation {
		Comment: "Everything that VALIDATES the production model, fenced off from it. (1) BattComp: the MIQCP complementarity binary as cross-check of the QCP throughput-penalty formulation. (2) Exact-AC / SLP boundary validation of the linearized FOR (VoltageRefinement, RunFOR_TR9_Exact / RunFOR_TR9_Linearized, RunFOR_Ref). (3) Loss-balance / coverage audits and the raw-number dump. (4) Comparison against the original paper (RunFOR_4Vertices, RunCompareWithPaperT25).";
		DeclarationSection VoltageRefinement {
			Comment: "RunFOR_4Vertices SLP voltage-refinement working set: re-linearization seeds (VreSeed/VimSeed/HaveSeed), the damped trust-region state (Alpha/Stall/VreGood/VimGood, best-so-far OVbest/OVcur) and iteration controls (SLPMaxIter/OVtol/SLPIter).";
			Parameter FOR_VreSeed {
				IndexDomain: (n,f,t);
				Comment: "Vre of the last SOLVED direction. Used to re-linearize a failing direction (attempt 3).";
			}
			Parameter FOR_VimSeed {
				IndexDomain: (n,f,t);
				Comment: "Vim of the last SOLVED direction. Used to re-linearize a failing direction (attempt 3).";
			}
			Parameter FOR_HaveSeed {
				Comment: "1 once at least one direction has solved, so a re-linearization seed is available.";
			}
			Parameter FOR_SLPMaxIter {
				Comment: "Max successive-re-linearization (SLP) passes applied to a solved direction whose TRUE voltage still exceeds the cap.";
			}
			Parameter FOR_OVtol {
				Comment: "Overvoltage tolerance (p.u.). If FOR_OvervoltViol exceeds this after a solve, an SLP refinement pass is triggered.";
			}
			Parameter FOR_SLPIter {
				IndexDomain: ia;
				Comment: {
					"Number of SLP refinement passes actually applied at this direction (0 = none needed; linearization was already accurate)."
				}
			}
			Parameter FOR_OVbest {
				Comment: "Working: smallest FOR_OvervoltViol seen so far across SLP passes for the current direction.";
			}
			Parameter FOR_OVcur {
				Comment: "Working: FOR_OvervoltViol of the latest SLP pass for the current direction.";
			}
			Parameter FOR_Alpha {
				Comment: "Working: current SLP damping/trust-region fraction (reset to FOR_DampAlpha per direction, halved on a regressed or failed pass).";
			}
			Parameter FOR_VreGood {
				IndexDomain: (n,f,t);
				Comment: "Working: Vre of the BEST-so-far SLP solution for the current direction (re-linearization & warm start always restart from here).";
			}
			Parameter FOR_VimGood {
				IndexDomain: (n,f,t);
				Comment: "Working: Vim of the BEST-so-far SLP solution for the current direction.";
			}
			Parameter FOR_Stall {
				Comment: "Working: count of consecutive non-improving SLP passes. When it reaches 2, FOR_Alpha is re-energized to FOR_DampAlpha (break the alpha-collapse plateau) instead of being halved again.";
			}
		}
		DeclarationSection LossBalanceCheck {
			Comment: "DiagnoseLossBalance: independent reconstruction of P_PCC = CustPtot + losses (demand/PV/battery decomposition, coverage, branch loss) -> diag_lossbalance.csv.";
			Parameter FOR_LB_D {
				Comment: "Loss-balance diag: total raw demand sum(d,P0(d,PeriodMaxP)).";
			}
			Parameter FOR_LB_G {
				Comment: "Loss-balance diag: total PV sum(d,GenP0(d,PeriodMaxP)).";
			}
			Parameter FOR_LB_B {
				Comment: "Loss-balance diag: net battery sum(bat,BattP_Balance(bat,PeriodMaxP)) (>0 charge, <0 discharge).";
			}
			Parameter FOR_LB_CustBat {
				Comment: "Loss-balance diag: CustPtot the way the model computes it = sum(bat,TotPcust(BattBus,BattPhase,PeriodMaxP)).";
			}
			Parameter FOR_LB_CustAll {
				Comment: "Loss-balance diag: TotPcust summed over ALL (n,f). Equals FOR_LB_CustBat iff every load node has a battery (coverage proof).";
			}
			Parameter FOR_LB_Ppcc {
				Comment: "Loss-balance diag: P_PCC(PeriodMaxP) at the solved export-extreme vertex.";
			}
			Parameter FOR_LB_PlossRes {
				Comment: "Loss-balance diag: residual loss = P_PCC - CustPtot (the briefing number, true by construction).";
			}
			Parameter FOR_LB_LineLoss {
				Comment: "Loss-balance diag: independent line loss = sum over lines,phases of (Vstart-Vend).I.";
			}
			Parameter FOR_LB_TrLoss {
				Comment: "Loss-balance diag: independent transformer loss = sum over trafos,phases of Vprim.Iprim - Vsec.Isec.";
			}
			Parameter FOR_LB_PlossBr {
				Comment: "Loss-balance diag: independent total branch loss = line + trafo. Should match FOR_LB_PlossRes to ~0.1%.";
			}
			File FOR_LBCSV {
				Name: "diag_lossbalance.csv";
			}
			File FOR_LB_MicroCSV {
				Name: "diag_lossbalance_micro.csv";
			}
		}
		DeclarationSection CoverageCheck {
			Comment: "DiagnoseCoverageGap: per-(bus,phase) battery/load counts and TotPcust to localize the CustPtot coverage gap -> diag_coverage.csv.";
			Parameter FOR_CG_nBat {
				IndexDomain: (n,f);
				Comment: "Coverage diag: number of batteries mapped to (n,f). >1 means TotPcust(n,f) is double-counted in the model CustPtot.";
			}
			Parameter FOR_CG_nLoad {
				IndexDomain: (n,f);
				Comment: "Coverage diag: number of loads/PV at (n,f).";
			}
			Parameter FOR_CG_Tot {
				IndexDomain: (n,f);
				Comment: "Coverage diag: TotPcust(n,f,PeriodMaxP) at the solved 180deg vertex.";
			}
			Parameter FOR_CG_SumAll {
				Comment: "Coverage diag: sum over ALL (n,f) of TotPcust (true network net).";
			}
			Parameter FOR_CG_SumBat {
				Comment: "Coverage diag: sum(bat,TotPcust(BattBus,BattPhase)) (the model CustPtot).";
			}
			Parameter FOR_CG_Dup {
				Comment: "Coverage diag: over-count from nodes with >1 battery = sum (nBat-1)*TotPcust.";
			}
			Parameter FOR_CG_LoadNoBat {
				Comment: "Coverage diag: TotPcust at nodes that have load/PV but ZERO battery (missed by the model CustPtot).";
			}
			File FOR_CGCSV {
				Name: "diag_coverage.csv";
			}
		}
		DeclarationSection NumberDump {
			Comment: "DumpFORNumbers: per-element loss parameters and the dump_*.csv files (loads, batteries, lines, trafos, slack, voltages, currents, scalars) for spreadsheet re-derivation.";
			Parameter FOR_DBG_LineLoss {
				IndexDomain: l;
				Comment: "Audit dump: per-line real loss = Î£_f (Vstartâˆ’Vend)Â·I at PeriodMaxP.";
			}
			Parameter FOR_DBG_TrLoss {
				IndexDomain: tr;
				Comment: "Audit dump: per-transformer real loss = Î£_f VprimÂ·Iprim âˆ’ VsecÂ·Isec at PeriodMaxP.";
			}
			File FOR_DLoads {
				Name: "dump_loads.csv";
			}
			File FOR_DBatt {
				Name: "dump_batteries.csv";
			}
			File FOR_DLines {
				Name: "dump_lines.csv";
			}
			File FOR_DTraf {
				Name: "dump_trafos.csv";
			}
			File FOR_DSlack {
				Name: "dump_slack.csv";
			}
			File FOR_DScal {
				Name: "dump_scalars.csv";
			}
			File FOR_DVolt {
				Name: "dump_voltages.csv";
			}
			File FOR_DLineI {
				Name: "dump_line_currents.csv";
			}
			File FOR_DTrafI {
				Name: "dump_trafo_currents.csv";
			}
			File FOR_DLoadI {
				Name: "dump_loadgen_currents.csv";
			}
		}
		Procedure RunMicro_BattComp {
			Body: {
				UseBattComp       := 1;    ! enforce no simultaneous charge/discharge (complementarity binary)
				run RunReducedTest_RollingMicro;
				UseBattComp       := 0;    ! defensive reset: back to the production QCP
			}
			Comment: "ONE-CLICK VALIDATION (MIQCP): sets UseBattComp=1 (binary BattOn forbids simultaneous battery charge/discharge) and runs the TR9_two micro rolling FOR. Expected: same dispatch and FOR as the production QCP (whose BattThroughputPen=0.2 default already prevents the phantom dump). Resets UseBattComp=0 afterwards.";
		}
		Procedure RunFullTR9_BattComp {
			Body: {
				UseBattComp       := 1;           ! enforce complementarity (no simultaneous charge/discharge)
				RollFileSuffix    := "_TR9_comp"; ! NEW output FOR_rolling_TR9_comp.csv -- does NOT overwrite baseline FOR_rolling_TR9.csv
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				UseBattComp       := 0;           ! reset toggle so other runs are unaffected
			}
			Comment: "VALIDATION (MIQCP): full TR9 rolling FOR with the complementarity binary (UseBattComp=1) -> FOR_rolling_TR9_comp.csv. Cross-check of the production QCP throughput-penalty formulation (expect the same dispatch/FOR, much slower: 90x48 binaries).";
		}
		Procedure RunFOR_4Vertices {
			Body: {
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator:=1;
				
				! --- settings: network ON, battery Q at PeriodMaxP, period 25 ---
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				
				! relaxed FOR: batteries may also charge at PeriodMaxP so the feeder can import (0 = article = discharge-only)
				AllowChargeAtPmax := 1;   ! 0 = article ; 1 = relaxed
				! fully-linear model so all 36 directions solve:
				!   FOR_PolyS=1 = 16-gon inverter S-curve (~2% tol); FOR_LinearizeVmax=1 = Vmax linearized like Vmin.
				! set both to 0 for the exact model (then the 4 corners return NoSolution, bounded by neighbours).
				FOR_PolyS         := 1;
				FOR_LinearizeVmax := 1;
				
				! 1 = also write one workbook per vertex (slow, ~37 .xls); 0 = reference only. FOR_ref_25.xls always written.
				FOR_WriteVertexXls := 1;
				
				! tiny cost-min tiebreaker: pulls off-period dispatch to the cost-min solution so the vertex .xls are not
				! arbitrary, while keeping the period-25 vertex P/Q optimal. set 0 for previous behaviour.
				FOR_TieEps := 1.0e-5;
				
				empty allvariables;
				run Load_data_dsn;
				
				! clear last sweep
				empty FOR_Boundary, FOR_BndStatus, FOR_BndTime, FOR_BndProj;
				empty FOR_FixUsed, FOR_VreSeed, FOR_VimSeed, FOR_SLPIter;
				FOR_HaveSeed := 0;
				
				! --- sweep + rescue knobs ---
				FOR_nAngles   := 36;   ! number of scan directions (every 10 deg)
				FOR_nSteps    := 8;    ! continuation steps used only by the rescue path
				FOR_DampAlpha := 0.6;  ! re-linearization damping (0..1)
				
				! --- SLP knobs: linearized Vmax can sit ~0.5-1.5% over the true 1.10 cap. after each solve, if the true
				! overvoltage exceeds FOR_OVtol, re-linearize at the solved voltages and re-solve (1-2 passes). ---
				FOR_SLPMaxIter := 10;       ! damped steps + stall-resets need headroom
				FOR_OVtol      := 0.0005;   ! p.u. (VmaxTrue <= ~1.1005)
				
				! --- reference solve: force the EXACT model (3 toggles -> 0), solve the same cost-min OPF at p25 and write
				! FOR_ref_25.xls in NC_Q_25 format to check faithfulness, then restore the toggles. fully reversible. ---
				FOR_RefSave_ACAP := AllowChargeAtPmax;
				FOR_RefSave_PolS := FOR_PolyS;
				FOR_RefSave_LVmx := FOR_LinearizeVmax;
				AllowChargeAtPmax := 0;     ! article discharge-only at PeriodMaxP
				FOR_PolyS         := 0;     ! exact battery S-circle
				FOR_LinearizeVmax := 0;     ! exact Vmax quadratic
				empty allvariables;
				run Load_data_dsn;
				run MainExecution;
				run ComputeMetrics;
				ResultsFileRoot := "FOR_ref_";
				run WriteResultstoExcel;
				ResultsFileRoot := "FOR_";
				AllowChargeAtPmax := FOR_RefSave_ACAP;
				FOR_PolyS         := FOR_RefSave_PolS;
				FOR_LinearizeVmax := FOR_RefSave_LVmx;
				
				! --- directional scan: rotate the objective angle; each solve gives one boundary point of the FOR ---
				for (ia) do
					FOR_Angle    := FOR_AngleDeg(ia);
					FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;
				
					! attempt 1: clean baseline (Vre0/Vim0 reset to flat, warm-started from the cost-min OPF). FOR_Lambda=1 = pure direction.
					empty allvariables;
					run Load_data_dsn;
					run MainExecution;
				
					FOR_Lambda := 1;
					solve FOR_VertexCont
						where  MIP_Relative_Optimality_Tolerance := 0.01,
						       time_limit := 3000;
				
					FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
					FOR_BndTime(ia)   := FOR_VertexCont.SolutionTime;
					FOR_FixUsed(ia)   := "direct";
				
					! attempt 2: if not optimal, re-solve same model with stronger numerics
					! (Gurobi reported numerical breakdown, NOT infeasibility, on far-from-nominal directions).
					if FOR_VertexCont.ProgramStatus <> 'Optimal' and
					   FOR_VertexCont.ProgramStatus <> 'LocallyOptimal' then
				
						solve FOR_VertexCont
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 1500;
				
						FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
						FOR_BndTime(ia)   := FOR_BndTime(ia)
						                    + FOR_VertexCont.SolutionTime;
						if FOR_VertexCont.ProgramStatus = 'Optimal' or
						   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
							FOR_FixUsed(ia) := "numeric";
						endif;
					endif;
				
					! attempt 3: still stuck -> re-linearize around the last solved direction (a neighbour in scan order) and warm-start from it.
					if (FOR_VertexCont.ProgramStatus <> 'Optimal' and
					    FOR_VertexCont.ProgramStatus <> 'LocallyOptimal') and
					   FOR_HaveSeed = 1 then
				
						Vre0(n,f,t) := FOR_VreSeed(n,f,t);
						Vim0(n,f,t) := FOR_VimSeed(n,f,t);
						Vre(n,f,t)  := FOR_VreSeed(n,f,t);
						Vim(n,f,t)  := FOR_VimSeed(n,f,t);
				
						solve FOR_VertexCont
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 1500;
				
						FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
						FOR_BndTime(ia)   := FOR_BndTime(ia)
						                    + FOR_VertexCont.SolutionTime;
						if FOR_VertexCont.ProgramStatus = 'Optimal' or
						   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
							FOR_FixUsed(ia) := "reseed";
						endif;
					endif;
				
					! record only if some attempt solved
					if FOR_VertexCont.ProgramStatus = 'Optimal' or
					   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
				
						! store P,Q + Tier-2 AC checks + CustPtot/Ploss. re-run inside the SLP loop so the CSV keeps the best point.
						FOR_Boundary(ia, 'P') := P_PCC(PeriodMaxP);
						FOR_Boundary(ia, 'Q') := Q_PCC(PeriodMaxP);
						FOR_BndProj(ia) := cos(FOR_AngleRad)*P_PCC(PeriodMaxP) + sin(FOR_AngleRad)*Q_PCC(PeriodMaxP);
						FOR_VminTrue(ia)     := min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_VmaxTrue(ia)     := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_UndervoltViol(ia):= max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
						FOR_OvervoltViol(ia) := max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)));
						FOR_LinErrMax(ia)    := max((n,f), abs(Vmag2approx(n,f,PeriodMaxP) - (Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
						FOR_CustPtot(ia) := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
						FOR_Ploss(ia)    := P_PCC(PeriodMaxP) - FOR_CustPtot(ia);
				
						! optional: write this vertex full dispatch as FOR_v<ord(ia)>_25.xls (the converged solve BEFORE the SLP cleanup).
						if FOR_WriteVertexXls = 1 then
							run ComputeMetrics;
							ResultsFileRoot := "FOR_v" + ord(ia) + "_";
							run WriteResultstoExcel;
							ResultsFileRoot := "FOR_";
						endif;
				
						! SLP refinement: re-linearize toward the solved voltages to pull the true overvoltage onto the cap.
						! damped step (move Vre0/Vim0 a fraction FOR_Alpha toward best); keep best + shrink alpha on a bad pass so it can never degrade.
						FOR_SLPIter(ia)    := 0;
						FOR_OVbest         := FOR_OvervoltViol(ia);
						FOR_Alpha          := FOR_DampAlpha;
						FOR_Stall          := 0;
						FOR_VreGood(n,f,t) := Vre(n,f,t);
						FOR_VimGood(n,f,t) := Vim(n,f,t);
						while ( FOR_OVbest > FOR_OVtol and
						        FOR_SLPIter(ia) < FOR_SLPMaxIter ) do
							! damped move of the linearization point toward best; warm-start from it
							Vre0(n,f,t) := Vre0(n,f,t)
							              + FOR_Alpha*(FOR_VreGood(n,f,t) - Vre0(n,f,t));
							Vim0(n,f,t) := Vim0(n,f,t)
							              + FOR_Alpha*(FOR_VimGood(n,f,t) - Vim0(n,f,t));
							Vre(n,f,t)  := FOR_VreGood(n,f,t);
							Vim(n,f,t)  := FOR_VimGood(n,f,t);
				
							solve FOR_VertexCont
								where  MIP_Relative_Optimality_Tolerance := 0.01,
								       numeric_focus       := 3,
								       barrier_homogeneous := 1,
								       time_limit          := 1500;
				
							FOR_BndTime(ia) := FOR_BndTime(ia)
							                  + FOR_VertexCont.SolutionTime;
							FOR_SLPIter(ia) := FOR_SLPIter(ia) + 1;
				
							if FOR_VertexCont.ProgramStatus = 'Optimal' or
							   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
								FOR_OVcur := max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)));
								if FOR_OVcur <= FOR_OVbest then
									! better pass: accept, re-record, advance best
									FOR_OVbest := FOR_OVcur;
									FOR_Boundary(ia, 'P') := P_PCC(PeriodMaxP);
									FOR_Boundary(ia, 'Q') := Q_PCC(PeriodMaxP);
									FOR_BndProj(ia) := cos(FOR_AngleRad)*P_PCC(PeriodMaxP) + sin(FOR_AngleRad)*Q_PCC(PeriodMaxP);
									FOR_VminTrue(ia)     := min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
									FOR_VmaxTrue(ia)     := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
									FOR_UndervoltViol(ia):= max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
									FOR_OvervoltViol(ia) := FOR_OVcur;
									FOR_LinErrMax(ia)    := max((n,f), abs(Vmag2approx(n,f,PeriodMaxP) - (Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
									FOR_CustPtot(ia) := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
									FOR_Ploss(ia)    := P_PCC(PeriodMaxP) - FOR_CustPtot(ia);
									FOR_VreGood(n,f,t) := Vre(n,f,t);
									FOR_VimGood(n,f,t) := Vim(n,f,t);
									FOR_Stall := 0;              ! progress: reset stall
								else
									! overshoot: shrink alpha, but re-energize after 2 stalls so it does not collapse to ~0 (plateau)
									FOR_Stall := FOR_Stall + 1;
									if FOR_Stall >= 2 then
										FOR_Alpha := FOR_DampAlpha;
										FOR_Stall := 0;
									else
										FOR_Alpha := FOR_Alpha / 2;
									endif;
								endif;
							else
								! numeric fail: same stall-aware shrink
								FOR_Stall := FOR_Stall + 1;
								if FOR_Stall >= 2 then
									FOR_Alpha := FOR_DampAlpha;
									FOR_Stall := 0;
								else
									FOR_Alpha := FOR_Alpha / 2;
								endif;
							endif;
						endwhile;
				
						! tag if SLP ran
						if FOR_SLPIter(ia) > 0 then
							FOR_FixUsed(ia) := FOR_FixUsed(ia) + "+slp";
						endif;
				
						! seed the next direction attempt-3 with the best voltages
						FOR_VreSeed(n,f,t) := FOR_VreGood(n,f,t);
						FOR_VimSeed(n,f,t) := FOR_VimGood(n,f,t);
						FOR_HaveSeed       := 1;
					else
						FOR_FixUsed(ia) := "FAILED";
					endif;
				endfor;
				
				! --- write boundary CSV for the Python plot (widen page so the 14-col rows do not wrap) ---
				FOR_CSV.PageWidth := 32767;
				put FOR_CSV;
				put "angle_deg,P,Q,proj,status,time,VminTrue,VmaxTrue,UVviol,OVviol,LinErr,CustPtot,Ploss,FixUsed,SLPiter" / ;
				for (ia) do
					put FOR_AngleDeg(ia):6:1, ",", FOR_Boundary(ia,'P'):14:6, ",", FOR_Boundary(ia,'Q'):14:6, ",", FOR_BndProj(ia):14:6, ",", FOR_BndStatus(ia), ",", FOR_BndTime(ia):12:2, ",", FOR_VminTrue(ia):10:5, ",", FOR_VmaxTrue(ia):10:5, ",", FOR_UndervoltViol(ia):10:5, ",", FOR_OvervoltViol(ia):10:5, ",", FOR_LinErrMax(ia):12:6, ",", FOR_CustPtot(ia):14:6, ",", FOR_Ploss(ia):14:6, ",", FOR_FixUsed(ia), ",", FOR_SLPIter(ia):4:0 / ;
				endfor;
				putclose FOR_CSV;
				
				display FOR_Boundary, FOR_BndStatus, FOR_BndTime,
				        FOR_VminTrue, FOR_VmaxTrue, FOR_UndervoltViol,
				        FOR_OvervoltViol, FOR_LinErrMax,
				        FOR_CustPtot, FOR_Ploss, FOR_FixUsed, FOR_SLPIter;
			}
			Comment: {
				"Main FOR deliverable. Full P-Q region at the PCC for PeriodMaxP=25, 36 directions, with SLP voltage refinement; writes FOR_boundary.csv. If a direction struggles, FixUsed/SLPiter in the CSV show which rescue fired and how many SLP passes it took."
			}
		}
		Procedure RunFOR_TR9_Exact {
			Body: {
				! ===========================================================
				! EXPERIMENT (Prof. Luis): keep the EXACT quadratic
				! constraints (inverter S-circle + Vmax circle) and rely on
				! the robust Gurobi barrier + relaxed tolerance, INSTEAD of
				! linearizing. Runs on the TR9-reduced network (fast). Writes
				! FOR_boundary_TR9_exact.csv for side-by-side comparison with
				! the linearized FOR_boundary.csv. Reversible.
				! ===========================================================
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				! the EXACT model is a QCP - use the NEW mathprog generator so the
				! quadratic constraints reach Gurobi (the legacy one is LP-only here)
				option disable_new_mathprog_generator := 0;
				
				! --- TR9 network reduction (fast): keep TR9 detailed, lump TR1-8 ---
				ReduceNetwork := 1;
				DetailTagCSV  := "TR9";
				
				! --- base settings (mirror RunFOR_4Vertices) ---
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_WriteVertexXls        := 0;
				FOR_TieEps                := 1.0e-5;
				
				! --- THE EXPERIMENT: exact quadratic constraints ---
				FOR_PolyS         := 0;   ! exact inverter S-circle: BattP_Balance^2 + Qinv^2 <= BattMaxP^2
				FOR_LinearizeVmax := 0;   ! exact voltage cap:       Vre^2 + Vim^2 <= MaxV^2
				FOR_ScaleInv      := 0;   ! per-unit rescaling tried (did not help) -> isolate the warm-start lever
				FOR_WarmFromLin   := 0;   ! CPLEX solves the exact QCQP directly from cost-min; no linearized predictor needed (set 1 only for the Gurobi warm-start experiment)
				
				! --- loosen the solver "acceptable error" + scaling (Prof. Luis).
				!     The exact QCP hit Gurobi "unrecoverable numerical difficulties"
				!     (a numeric breakdown, NOT infeasibility). Looser tolerances and
				!     stronger scaling let the barrier complete. Loosen further (e.g.
				!     1.0e-3 / 1.0e-2) if some directions still fail. ---
				option Feasibility_Tolerance         := 1.0e-3;
				option Barrier_Convergence_Tolerance := 1.0e-2;
				option Scaling_Flag                  := 2;
				
				empty allvariables;
				run Load_data_dsn;
				
				empty FOR_Boundary, FOR_BndStatus, FOR_BndTime, FOR_BndProj;
				empty FOR_FixUsed, FOR_VreSeed, FOR_VimSeed, FOR_SLPIter;
				FOR_HaveSeed := 0;
				
				FOR_nAngles := 36;   ! full scan (every 10 deg); drop to 4 for a quick smoke test
				
				! --- directional scan with the EXACT (QCQP) model + robust barrier ---
				for (ia) do
					FOR_Angle    := FOR_AngleDeg(ia);
					FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;
				
					! clean warm start from the cost-min OPF
					empty allvariables;
					run Load_data_dsn;
					run MainExecution;
				
					! --- PREDICTOR: solve the well-conditioned LINEARIZED model for this direction,
					!     then re-linearize the loads AT that boundary point (Vre0/Vim0 := solved Vre/Vim)
					!     and let the exact solve below warm-start from it. Targets conditioning sources
					!     (c) stale flat-nominal linearization and (b) driving onto the boundary. ---
					if FOR_WarmFromLin = 1 then
						FOR_PolyS         := 1;
						FOR_LinearizeVmax := 1;
						FOR_Lambda        := 1;
						solve FOR_VertexCont
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       time_limit := 1500;
						if FOR_VertexCont.ProgramStatus = 'Optimal' or
						   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
							Vre0(n,f,t) := Vre(n,f,t);
							Vim0(n,f,t) := Vim(n,f,t);
						endif;
						FOR_PolyS         := 0;
						FOR_LinearizeVmax := 0;
					endif;
				
					FOR_Lambda := 1;
					! robust barrier FROM the first attempt (failure mode was numeric, not infeasibility)
					solve FOR_VertexCont
						where  MIP_Relative_Optimality_Tolerance := 0.01,
						       numeric_focus       := 3,
						       barrier_homogeneous := 1,
						       time_limit          := 3000;
				
					FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
					FOR_BndTime(ia)   := FOR_VertexCont.SolutionTime;
					FOR_FixUsed(ia)   := "exact";
				
					! retry: reseed from the last solved neighbour
					if (FOR_VertexCont.ProgramStatus <> 'Optimal' and
					    FOR_VertexCont.ProgramStatus <> 'LocallyOptimal') and
					   FOR_HaveSeed = 1 then
						Vre0(n,f,t) := FOR_VreSeed(n,f,t);
						Vim0(n,f,t) := FOR_VimSeed(n,f,t);
						Vre(n,f,t)  := FOR_VreSeed(n,f,t);
						Vim(n,f,t)  := FOR_VimSeed(n,f,t);
						solve FOR_VertexCont
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 1500;
						FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
						FOR_BndTime(ia)   := FOR_BndTime(ia) + FOR_VertexCont.SolutionTime;
						if FOR_VertexCont.ProgramStatus = 'Optimal' or
						   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
							FOR_FixUsed(ia) := "exact+reseed";
						endif;
					endif;
				
					! record if solved. NO SLP: the exact cap has no overshoot to refine.
					if FOR_VertexCont.ProgramStatus = 'Optimal' or
					   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
						FOR_Boundary(ia,'P') := P_PCC(PeriodMaxP);
						FOR_Boundary(ia,'Q') := Q_PCC(PeriodMaxP);
						FOR_BndProj(ia)      := cos(FOR_AngleRad)*P_PCC(PeriodMaxP) + sin(FOR_AngleRad)*Q_PCC(PeriodMaxP);
						FOR_VminTrue(ia)     := min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_VmaxTrue(ia)     := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_UndervoltViol(ia):= max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
						FOR_OvervoltViol(ia) := max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)));
						FOR_LinErrMax(ia)    := 0;
						FOR_CustPtot(ia)     := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
						FOR_Ploss(ia)        := P_PCC(PeriodMaxP) - FOR_CustPtot(ia);
						FOR_SLPIter(ia)      := 0;
						FOR_VreSeed(n,f,t)   := Vre(n,f,t);
						FOR_VimSeed(n,f,t)   := Vim(n,f,t);
						FOR_HaveSeed         := 1;
					else
						FOR_FixUsed(ia) := "FAILED";
					endif;
				endfor;
				
				! --- write the exact-run boundary to its own csv (same columns as FOR_boundary.csv) ---
				FOR_CSV_Exact.PageWidth := 32767;
				put FOR_CSV_Exact;
				put "angle_deg,P,Q,proj,status,time,VminTrue,VmaxTrue,UVviol,OVviol,LinErr,CustPtot,Ploss,FixUsed,SLPiter" / ;
				for (ia) do
					put FOR_AngleDeg(ia):6:1, ",", FOR_Boundary(ia,'P'):14:6, ",", FOR_Boundary(ia,'Q'):14:6, ",", FOR_BndProj(ia):14:6, ",", FOR_BndStatus(ia), ",", FOR_BndTime(ia):12:2, ",", FOR_VminTrue(ia):10:5, ",", FOR_VmaxTrue(ia):10:5, ",", FOR_UndervoltViol(ia):10:5, ",", FOR_OvervoltViol(ia):10:5, ",", FOR_LinErrMax(ia):12:6, ",", FOR_CustPtot(ia):14:6, ",", FOR_Ploss(ia):14:6, ",", FOR_FixUsed(ia), ",", FOR_SLPIter(ia):4:0 / ;
				endfor;
				putclose FOR_CSV_Exact;
				
				! --- restore production defaults (exact + full feeder) ---
				FOR_PolyS         := 0;
				FOR_LinearizeVmax := 0;
				FOR_ScaleInv      := 0;
				FOR_WarmFromLin   := 0;
				ReduceNetwork     := 0;
				
				display FOR_Boundary, FOR_BndStatus, FOR_FixUsed, FOR_VmaxTrue, FOR_OvervoltViol;
			}
			Comment: "EXPERIMENT (Prof. Luis): TR9-reduced FOR scan with EXACT quadratic constraints (FOR_PolyS=0, FOR_LinearizeVmax=0) and robust Gurobi barrier from attempt 1 - no linearization, no SLP. Writes FOR_boundary_TR9_exact.csv to compare with the linearized FOR_boundary.csv. Optional commented tolerance lines loosen the acceptable error. Reversible: restores FOR_PolyS=0, FOR_LinearizeVmax=0 (production exact config), ReduceNetwork=0.";
		}
		Procedure RunFOR_TR9_Linearized {
			Body: {
				! ===========================================================
				! COMPANION to RunFOR_TR9_Exact for the exact-vs-linearized
				! comparison. Same TR9-reduced network + period 25 + 36 dirs,
				! but the LINEARIZED capability model (FOR_PolyS=1 polygon S-cone,
				! FOR_LinearizeVmax=1 tangent Vmax). No SLP -> this is the RAW
				! linearized boundary (the outer approximation that slightly
				! overshoots Vmax on the import side; the production SLP loop is
				! what later pulls it back). Writes FOR_boundary_TR9_lin.csv with
				! the same columns. Records VmaxTrue/OVviol so the overshoot vs the
				! exact run is visible. Well-conditioned -> solves under any solver.
				! Reversible: restores production defaults.
				! ===========================================================
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 0;
				
				ReduceNetwork := 1;
				DetailTagCSV  := "TR9";
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_WriteVertexXls        := 0;
				FOR_TieEps                := 1.0e-5;
				
				! --- LINEARIZED capability model (the historical whole-feeder config, minus SLP) ---
				FOR_PolyS         := 1;   ! polygon (16-gon) inverter S-cone
				FOR_LinearizeVmax := 1;   ! tangent-plane voltage cap
				FOR_ScaleInv      := 0;
				FOR_WarmFromLin   := 0;
				
				empty allvariables;
				run Load_data_dsn;
				
				empty FOR_Boundary, FOR_BndStatus, FOR_BndTime, FOR_BndProj;
				empty FOR_FixUsed, FOR_SLPIter;
				
				FOR_nAngles := 36;   ! every 10 deg (match the exact run)
				
				for (ia) do
					FOR_Angle    := FOR_AngleDeg(ia);
					FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;
				
					empty allvariables;
					run Load_data_dsn;
					run MainExecution;
				
					FOR_Lambda := 1;
					solve FOR_VertexCont
						where  MIP_Relative_Optimality_Tolerance := 0.01,
						       time_limit := 1500;
				
					FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
					FOR_BndTime(ia)   := FOR_VertexCont.SolutionTime;
					FOR_FixUsed(ia)   := "linearized";
				
					if FOR_VertexCont.ProgramStatus = 'Optimal' or
					   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
						FOR_Boundary(ia,'P') := P_PCC(PeriodMaxP);
						FOR_Boundary(ia,'Q') := Q_PCC(PeriodMaxP);
						FOR_BndProj(ia)      := cos(FOR_AngleRad)*P_PCC(PeriodMaxP) + sin(FOR_AngleRad)*Q_PCC(PeriodMaxP);
						FOR_VminTrue(ia)     := min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_VmaxTrue(ia)     := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_UndervoltViol(ia):= max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
						FOR_OvervoltViol(ia) := max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)));
						FOR_LinErrMax(ia)    := max((n,f), abs(Vmag2approx(n,f,PeriodMaxP) - (Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
						FOR_CustPtot(ia)     := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
						FOR_Ploss(ia)        := P_PCC(PeriodMaxP) - FOR_CustPtot(ia);
						FOR_SLPIter(ia)      := 0;
					else
						FOR_FixUsed(ia) := "FAILED";
					endif;
				endfor;
				
				! --- write the linearized boundary (same columns as the exact run) ---
				FOR_CSV_Lin.PageWidth := 32767;
				put FOR_CSV_Lin;
				put "angle_deg,P,Q,proj,status,time,VminTrue,VmaxTrue,UVviol,OVviol,LinErr,CustPtot,Ploss,FixUsed,SLPiter" / ;
				for (ia) do
					put FOR_AngleDeg(ia):6:1, ",", FOR_Boundary(ia,'P'):14:6, ",", FOR_Boundary(ia,'Q'):14:6, ",", FOR_BndProj(ia):14:6, ",", FOR_BndStatus(ia), ",", FOR_BndTime(ia):12:2, ",", FOR_VminTrue(ia):10:5, ",", FOR_VmaxTrue(ia):10:5, ",", FOR_UndervoltViol(ia):10:5, ",", FOR_OvervoltViol(ia):10:5, ",", FOR_LinErrMax(ia):12:6, ",", FOR_CustPtot(ia):14:6, ",", FOR_Ploss(ia):14:6, ",", FOR_FixUsed(ia), ",", FOR_SLPIter(ia):4:0 / ;
				endfor;
				putclose FOR_CSV_Lin;
				
				! --- restore production defaults (exact) ---
				FOR_PolyS         := 0;
				FOR_LinearizeVmax := 0;
				FOR_ScaleInv      := 0;
				FOR_WarmFromLin   := 0;
				ReduceNetwork     := 0;
				
				display FOR_Boundary, FOR_BndStatus, FOR_VmaxTrue, FOR_OvervoltViol;
			}
			Comment: "Linearized companion to RunFOR_TR9_Exact: same TR9-reduced/period-25/36-dir scan with the polygon S-cone + tangent Vmax (FOR_PolyS=1, FOR_LinearizeVmax=1), NO SLP -> the raw linearized (outer) boundary. Writes FOR_boundary_TR9_lin.csv (records VmaxTrue/OVviol so the import-side overshoot vs the exact run is visible). Well-conditioned (solves under Gurobi or CPLEX). For the exact-vs-linearized comparison figure.";
		}
		Procedure RunFOR_Ref {
			Body: {
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator:=1;
				
				! force the exact article model (clears any toggle state left from a previous run)
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				AllowChargeAtPmax         := 0;
				FOR_PolyS                 := 0;
				FOR_LinearizeVmax         := 0;
				FOR_TieEps                := 0;     ! reference is exact cost-min; no tiebreaker
				
				empty allvariables;
				run Load_data_dsn;
				run MainExecution;
				run ComputeMetrics;
				ResultsFileRoot := "FOR_ref_";
				run WriteResultstoExcel;
				ResultsFileRoot := "FOR_";
			}
			Comment: "FOR - AUDIT. Quick (one solve, ~2 min) validation export. Solves Prof. Luis\'s EXACT, article-assumption OPF (NC+Q, PeriodMaxP=25, AllowChargeAtPmax=0, FOR_PolyS=0, FOR_LinearizeVmax=0) and writes FOR_ref_25.xls in the identical 11-sheet format as NC_Q_25.xls. Compare with compare_FOR_to_NCQ.py: should PASS within solver tolerance. Run THIS before launching the full RunFOR_4Vertices sweep.";
		}
		Procedure RunCompareWithPaperT25 {
			Body: {
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 1;
				
				! ---- shared paper-compatible toggles (NC-Q case) -- FULL FEEDER ----
				ReduceNetwork             := 0;        ! FULL feeder for paper reproduction; set 1 + DetailTagCSV:="TR9" (+ DetailLoadPattern:="_two") for fast micro
				DetailTagCSV              := "";
				DetailLoadPattern         := "";
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				AllowChargeAtPmax         := 1;        ! bidirectional flexibility (match rolling default); set 0 to reproduce paper Eq. (8) literally
				RollCyclicSOC             := 0;        ! disable cyclic SOC for fair paper-style comparison
				CyclicSOCBand             := 0;
				FOR_PolyS                 := 1;        ! polygonal S-envelope (~2% outer error vs exact circle) -- needed for numerical robustness at 1216-battery scale with wrapped+saturated SOC
				FOR_LinearizeVmax         := 1;        ! linearized Vmax for the same reason. Applied identically to Stage Paper and Stage Rolling so the equivalence test stays apples-to-apples.
				EnableRollDiag            := 0;
				ResultsFileRoot           := "FOR_";
				
				! ============ STAGE SC: self-consumption only (no service request) ============
				empty allvariables;
				run Load_data_dsn;
				run MinOFminImports;                                                          ! pure self-consumption baseline
				
				Cmp_scP := P_PCC('25');                                                       ! evaluate at the same real period for the comparison
				Cmp_scQ := Q_PCC('25');
				
				! ============ STAGE Paper: paper-style single solve at t=25 ============
				PeriodMaxP := 25;
				empty allvariables;
				run Load_data_dsn;
				run MainExecution;
				
				Cmp_paperP := P_PCC(PeriodMaxP);
				Cmp_paperQ := Q_PCC(PeriodMaxP);
				
				! SOC of each battery at end of t=24 (= start of t=25) under Stage Paper's optimal plan
				Cmp_SOC_t24(bat) := BattSOCini(bat)
					+ sum(t | ord(t) <= 24,
					      (BattP_Chg(bat,t)*etaChg(bat)
					       - BattP_Dis(bat,t)/etaDis(bat))
					      * DeltaT / BattEcap(bat));
				
				! snapshot un-rotated inputs so Stage Rolling can rotate them
				P0raw(d,t)    := P0(d,t);
				Q0raw(d,t)    := Q0(d,t);
				GenP0raw(d,t) := GenP0(d,t);
				Irrraw(t)     := Irradiance(t);
				
				! ============ STAGE Rolling: rolling step at now=24, target slot 2 = real t=25 ============
				PeriodMaxP  := 2;                                                            ! service slot inside the wrapped window
				RollNow     := 24;
				RollMap(tt) := Element(Time, mod(ord(tt)-1 + (RollNow-1), nPeriods) + 1);
				
				empty allvariables;
				run Load_data_dsn;
				P0(d,tt)        := P0raw(d, RollMap(tt));
				Q0(d,tt)        := Q0raw(d, RollMap(tt));
				GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
				Irradiance(tt)  := Irrraw(RollMap(tt));
				BattSOCini(bat) := Cmp_SOC_t24(bat);                                          ! same battery state Stage Paper would have at t=24
				
				! attempt 1: standard solve (succeeds on micro and most full-feeder cases)
				run MainExecution;
				
				! attempt 2: numeric-focus retry if Gurobi hit unrecoverable difficulties
				! (the wrapped window starting from saturated noon SOC can be ill-conditioned)
				if MinImportsMaxReverseP.ProgramStatus <> 'Optimal' and
				   MinImportsMaxReverseP.ProgramStatus <> 'LocallyOptimal' then
					solve MinImportsMaxReverseP
						where  MIP_Relative_Optimality_Tolerance := 0.01,
						       numeric_focus       := 3,
						       barrier_homogeneous := 1,
						       time_limit          := 3000;
				endif;
				
				Cmp_rollingP := P_PCC(PeriodMaxP);
				Cmp_rollingQ := Q_PCC(PeriodMaxP);
				
				! ============ post-process: volumes of services and relative percentages ============
				Cmp_volumeP := Cmp_paperP - Cmp_scP;
				Cmp_volumeQ := Cmp_paperQ - Cmp_scQ;
				
				Cmp_relP := 0;
				if abs(Cmp_paperP) > 0.000001 then
					Cmp_relP := (Cmp_rollingP - Cmp_paperP) / abs(Cmp_paperP) * 100;
				endif;
				Cmp_relQ := 0;
				if abs(Cmp_paperQ) > 0.000001 then
					Cmp_relQ := (Cmp_rollingQ - Cmp_paperQ) / abs(Cmp_paperQ) * 100;
				endif;
				
				! ============ write side-by-side comparison CSV ============
				FOR_CompareCSV.PageWidth := 32767;
				put FOR_CompareCSV;
				put "metric,SC_no_service,paper_t25,rolling_now24_slot2,volume_of_services,absolute_diff_rolling_minus_paper,relative_pct" / ;
				put "P_PCC,",
				    Cmp_scP:14:6, ",",
				    Cmp_paperP:14:6, ",",
				    Cmp_rollingP:14:6, ",",
				    Cmp_volumeP:14:6, ",",
				    (Cmp_rollingP - Cmp_paperP):14:6, ",",
				    Cmp_relP:10:3 / ;
				put "Q_PCC,",
				    Cmp_scQ:14:6, ",",
				    Cmp_paperQ:14:6, ",",
				    Cmp_rollingQ:14:6, ",",
				    Cmp_volumeQ:14:6, ",",
				    (Cmp_rollingQ - Cmp_paperQ):14:6, ",",
				    Cmp_relQ:10:3 / ;
				put "" / ;
				put "battery,SOC_at_t24_from_paper_solve" / ;
				for (bat) do
					put bat:24, ",", Cmp_SOC_t24(bat):10:6 / ;
				endfor;
				putclose FOR_CompareCSV;
				
				display Cmp_scP, Cmp_paperP, Cmp_rollingP, Cmp_volumeP, Cmp_scQ, Cmp_paperQ, Cmp_rollingQ, Cmp_volumeQ;
			}
			Comment: {
				"TEST (one click): three-stage comparison at t=25. (SC) self-consumption only via MinOFminImports -> baseline P at PCC. (Paper) Prof. Luis\'s services case via MainExecution with PeriodMaxP=25 -> paper-style services result. (Rolling) the rolling-horizon equivalent at now=t24 with target slot 2, starting from the SOC Stage Paper would have at t=24. All three use identical paper-compatible toggles (no cyclic, exact S-circle, exact Vmax). The volume of services (paper terminology) is reported as paper - SC; the equivalence of Rolling and Paper is reported as absolute and relative difference. Defaults to the TR9_two micro-test for fast demo; set ReduceNetwork:=0 and clear DetailTagCSV/DetailLoadPattern at the top of the body to compare on the full feeder."
			}
		}
		Procedure DiagnoseLossBalance {
			Body: {
				! independent check that P_PCC = CustPtot + Ploss at the 180deg export extreme:
				!   (a) coverage: CustPtot over battery nodes vs all nodes;  (b) D - G + B rebuilds CustPtot;
				!   (c) branch (V.I) loss, computed independently, must match the P_PCC - CustPtot residual.
				! one clean solve -> diag_lossbalance.csv
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 1;
				
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;   ! relaxed (same as 36-angle run)
				FOR_PolyS                 := 1;
				FOR_LinearizeVmax         := 1;
				
				FOR_Angle    := 180;
				FOR_AngleRad := 180 * 4*arctan(1) / 180;
				FOR_Lambda   := 1;
				
				empty allvariables;
				run Load_data_dsn;
				run MainExecution;
				
				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       numeric_focus       := 3,
					       barrier_homogeneous := 1,
					       time_limit          := 1500;
				
				FOR_StatCur := FOR_VertexCont.ProgramStatus;
				
				if FOR_VertexCont.ProgramStatus = 'Optimal' or
				   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
				
					! ---- (b) component decomposition at PeriodMaxP ----
					FOR_LB_D := sum(d, P0(d,PeriodMaxP));
					FOR_LB_G := sum(d, GenP0(d,PeriodMaxP));
					FOR_LB_B := sum(bat, BattP_Balance(bat,PeriodMaxP));
				
					! ---- (a) coverage : model sum vs all-node sum ----
					FOR_LB_CustBat := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
					FOR_LB_CustAll := sum((n,f), TotPcust(n,f,PeriodMaxP));
				
					FOR_LB_Ppcc     := P_PCC(PeriodMaxP);
					FOR_LB_PlossRes := FOR_LB_Ppcc - FOR_LB_CustBat;
				
					! ---- (c) independent branch loss = sum (Pin - Pout) ----
					FOR_LB_LineLoss := sum((l,f),
					      (Vre(StartBus(l),f,PeriodMaxP) - Vre(EndBus(l),f,PeriodMaxP)) * Ire_Line(l,f,PeriodMaxP)
					    + (Vim(StartBus(l),f,PeriodMaxP) - Vim(EndBus(l),f,PeriodMaxP)) * Iim_Line(l,f,PeriodMaxP) );
				
					FOR_LB_TrLoss := sum((tr,f),
					      ( Vre(StartBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,StartBusTr(tr),PeriodMaxP)
					      + Vim(StartBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,StartBusTr(tr),PeriodMaxP) )
					    - ( Vre(EndBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,EndBusTr(tr),PeriodMaxP)
					      + Vim(EndBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,EndBusTr(tr),PeriodMaxP) ) );
				
					FOR_LB_PlossBr := FOR_LB_LineLoss + FOR_LB_TrLoss;
				
					FOR_LBCSV.PageWidth := 32767;
					put FOR_LBCSV;
					put "quantity,value,note" / ;
					put "status,",            FOR_StatCur, ",solved direction 180deg (export extreme)" / ;
					put "D_demand_total,",    FOR_LB_D:14:6,        ",sum(d) P0  (all loads incl. no-PV houses)" / ;
					put "G_pv_total,",        FOR_LB_G:14:6,        ",sum(d) GenP0  (all PV)" / ;
					put "B_batt_net,",        FOR_LB_B:14:6,        ",sum(bat) BattP_Balance  (>0 charge, <0 discharge)" / ;
					put "Net_reconstruct,",   (FOR_LB_D-FOR_LB_G+FOR_LB_B):14:6, ",D - G + B  (should equal CustPtot_allnodes)" / ;
					put "CustPtot_allnodes,", FOR_LB_CustAll:14:6,  ",sum over ALL (n,f) of TotPcust" / ;
					put "CustPtot_batnodes,", FOR_LB_CustBat:14:6,  ",sum over battery nodes (the models CustPtot)" / ;
					put "Coverage_gap,",      (FOR_LB_CustAll-FOR_LB_CustBat):14:6, ",~0 proves every load node has a battery (no missed load)" / ;
					put "P_PCC,",             FOR_LB_Ppcc:14:6,     ",grid-side import-positive" / ;
					put "Ploss_residual,",    FOR_LB_PlossRes:14:6, ",P_PCC - CustPtot (true by construction)" / ;
					put "Line_loss,",         FOR_LB_LineLoss:14:6, ",independent: sum lines (Vstart-Vend).I" / ;
					put "Trafo_loss,",        FOR_LB_TrLoss:14:6,   ",independent: sum trafos Vprim.Iprim - Vsec.Isec" / ;
					put "Ploss_branch,",      FOR_LB_PlossBr:14:6,  ",independent total (should match Ploss_residual)" / ;
					put "Loss_discrepancy,",  (FOR_LB_PlossBr-FOR_LB_PlossRes):14:6, ",~0 proves the gap is I2R loss not missed demand" / ;
					putclose FOR_LBCSV;
				
					display FOR_LB_D, FOR_LB_G, FOR_LB_B,
					        FOR_LB_CustAll, FOR_LB_CustBat,
					        FOR_LB_Ppcc, FOR_LB_PlossRes,
					        FOR_LB_LineLoss, FOR_LB_TrLoss, FOR_LB_PlossBr;
				else
					FOR_LBCSV.PageWidth := 32767;
					put FOR_LBCSV;
					put "quantity,value,note" / ;
					put "status,", FOR_StatCur, ",solve did NOT reach optimal - rerun" / ;
					putclose FOR_LBCSV;
				endif;
			}
			Comment: "FOR - AUDIT. One 180deg solve, then checks P_PCC = CustPtot + Ploss independently: D-G+B decomposition, coverage, and branch loss summed line-by-line. Writes diag_lossbalance.csv. This is what proved the reported Ploss is not a clean loss.";
		}
		Procedure DiagnoseLossBalance_Micro {
			Body: {
				! ---- micro-test attribution: same balance check as DiagnoseLossBalance but
				! ---- runs on the TR9_two sub-cluster and writes to diag_lossbalance_micro.csv.
				! ---- Shows how PV is split between local consumers, losses, and TSO export.
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 1;
				
				! ---- MICRO toggles (TR9_two sub-cluster, 12 batteries + 9 no-battery loads) ----
				ReduceNetwork             := 1;
				DetailTagCSV              := "TR9";
				DetailLoadPattern         := "_two";
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;        ! midday PV peak
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 1;
				FOR_LinearizeVmax         := 1;
				
				FOR_Angle    := 180;                    ! direction of max export (most-negative P at PCC)
				FOR_AngleRad := 180 * 4*arctan(1) / 180;
				FOR_Lambda   := 1;
				
				empty allvariables;
				run Load_data_dsn;
				run MainExecution;
				
				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       numeric_focus       := 3,
					       barrier_homogeneous := 1,
					       time_limit          := 1500;
				
				FOR_StatCur := FOR_VertexCont.ProgramStatus;
				
				if FOR_VertexCont.ProgramStatus = 'Optimal' or
				   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
				
					! ---- component decomposition at PeriodMaxP ----
					FOR_LB_D := sum(d, P0(d,PeriodMaxP));
					FOR_LB_G := sum(d, GenP0(d,PeriodMaxP));
					FOR_LB_B := sum(bat, BattP_Balance(bat,PeriodMaxP));
				
					! ---- coverage : model sum vs all-node sum ----
					FOR_LB_CustBat := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
					FOR_LB_CustAll := sum((n,f), TotPcust(n,f,PeriodMaxP));
				
					FOR_LB_Ppcc     := P_PCC(PeriodMaxP);
					FOR_LB_PlossRes := FOR_LB_Ppcc - FOR_LB_CustBat;
				
					! ---- independent branch loss = sum (Pin - Pout) ----
					FOR_LB_LineLoss := sum((l,f),
					      (Vre(StartBus(l),f,PeriodMaxP) - Vre(EndBus(l),f,PeriodMaxP)) * Ire_Line(l,f,PeriodMaxP)
					    + (Vim(StartBus(l),f,PeriodMaxP) - Vim(EndBus(l),f,PeriodMaxP)) * Iim_Line(l,f,PeriodMaxP) );
				
					FOR_LB_TrLoss := sum((tr,f),
					      ( Vre(StartBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,StartBusTr(tr),PeriodMaxP)
					      + Vim(StartBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,StartBusTr(tr),PeriodMaxP) )
					    - ( Vre(EndBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,EndBusTr(tr),PeriodMaxP)
					      + Vim(EndBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,EndBusTr(tr),PeriodMaxP) ) );
				
					FOR_LB_PlossBr := FOR_LB_LineLoss + FOR_LB_TrLoss;
				
					FOR_LB_MicroCSV.PageWidth := 32767;
					put FOR_LB_MicroCSV;
					put "quantity,value,note" / ;
					put "status,",            FOR_StatCur, ",micro TR9_two, slot t=25, direction 180deg (max export)" / ;
					put "D_demand_total,",    FOR_LB_D:14:6,        ",sum(d) P0  (all loads in micro, incl. no-battery houses)" / ;
					put "G_pv_total,",        FOR_LB_G:14:6,        ",sum(d) GenP0  (all PV in micro)" / ;
					put "B_batt_net,",        FOR_LB_B:14:6,        ",sum(bat) BattP_Balance  (>0 charge, <0 discharge)" / ;
					put "D_minus_G,",         (FOR_LB_D-FOR_LB_G):14:6, ",natural net of all customers (no battery) at this slot" / ;
					put "D_minus_G_plus_B,",  (FOR_LB_D-FOR_LB_G+FOR_LB_B):14:6, ",customer net AFTER battery action  (= CustPtot allnodes)" / ;
					put "CustPtot_allnodes,", FOR_LB_CustAll:14:6,  ",sum over ALL (n,f) of TotPcust (true network net)" / ;
					put "CustPtot_batnodes,", FOR_LB_CustBat:14:6,  ",sum over battery nodes only" / ;
					put "Load_at_NoBatNodes,",(FOR_LB_CustAll-FOR_LB_CustBat):14:6, ",net at the 9 no-battery loads in the micro (= consumer absorption)" / ;
					put "P_PCC,",             FOR_LB_Ppcc:14:6,     ",grid-side at the PCC (negative = export to TSO)" / ;
					put "Ploss_residual,",    FOR_LB_PlossRes:14:6, ",P_PCC - CustPtot  (true losses by construction)" / ;
					put "Line_loss,",         FOR_LB_LineLoss:14:6, ",independent: sum lines (Vstart-Vend).I" / ;
					put "Trafo_loss,",        FOR_LB_TrLoss:14:6,   ",independent: sum trafos Vprim.Iprim - Vsec.Isec" / ;
					put "Ploss_branch,",      FOR_LB_PlossBr:14:6,  ",independent total (should match Ploss_residual)" / ;
					put "Loss_discrepancy,",  (FOR_LB_PlossBr-FOR_LB_PlossRes):14:6, ",~0 proves the gap is true I2R loss" / ;
					putclose FOR_LB_MicroCSV;
				
					display FOR_LB_D, FOR_LB_G, FOR_LB_B,
					        FOR_LB_CustAll, FOR_LB_CustBat,
					        FOR_LB_Ppcc, FOR_LB_PlossRes,
					        FOR_LB_LineLoss, FOR_LB_TrLoss, FOR_LB_PlossBr;
				else
					FOR_LB_MicroCSV.PageWidth := 32767;
					put FOR_LB_MicroCSV;
					put "quantity,value,note" / ;
					put "status,", FOR_StatCur, ",solve did NOT reach optimal - rerun" / ;
					putclose FOR_LB_MicroCSV;
				endif;
				
				! ---- defensive reset ----
				DetailLoadPattern := "";
			}
			Comment: "FOR - AUDIT (MICRO). Same balance check as DiagnoseLossBalance but runs on the TR9_two sub-cluster (12 batteries + 9 no-battery loads) and writes diag_lossbalance_micro.csv. The \'Load_at_NoBatNodes\' line directly answers: how much of the local PV is absorbed by neighbouring consumers before anything reaches the TSO.";
		}
		Procedure DiagnoseCoverageGap {
			Body: {
				! localize the CustPtot coverage gap: per (n,f) dump battery count, load count and TotPcust to see
				! if it is double-counting (>1 battery per node) or missing loads at no-battery nodes.
				! one clean 180deg solve (same vertex as DiagnoseLossBalance) -> diag_coverage.csv
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 1;
				
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 1;
				FOR_LinearizeVmax         := 1;
				
				FOR_Angle    := 180;
				FOR_AngleRad := 180 * 4*arctan(1) / 180;
				FOR_Lambda   := 1;
				
				empty allvariables;
				run Load_data_dsn;
				run MainExecution;
				
				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       numeric_focus       := 3,
					       barrier_homogeneous := 1,
					       time_limit          := 1500;
				
				FOR_StatCur := FOR_VertexCont.ProgramStatus;
				
				FOR_CG_nBat(n,f)  := sum(bat | BattBus(bat)=n and BattPhase(bat)=f, 1);
				FOR_CG_nLoad(n,f) := sum(d   | LoadBus(d)=n  and LoadPhase(d)=f,  1);
				FOR_CG_Tot(n,f)   := TotPcust(n,f,PeriodMaxP);
				
				FOR_CG_SumAll     := sum((n,f), FOR_CG_Tot(n,f));
				FOR_CG_SumBat     := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
				FOR_CG_Dup        := sum((n,f) | FOR_CG_nBat(n,f) > 1,
				                         (FOR_CG_nBat(n,f) - 1) * FOR_CG_Tot(n,f));
				FOR_CG_LoadNoBat  := sum((n,f) | FOR_CG_nBat(n,f) = 0 and FOR_CG_nLoad(n,f) > 0,
				                         FOR_CG_Tot(n,f));
				
				FOR_CGCSV.PageWidth := 32767;
				put FOR_CGCSV;
				put "bus,phase,nBat,nLoad,TotPcust,contrib_batsum,contrib_allsum" / ;
				for ( (n,f) | FOR_CG_nBat(n,f) > 0 or FOR_CG_nLoad(n,f) > 0 ) do
					put n, ",", f, ",", FOR_CG_nBat(n,f):4:0, ",", FOR_CG_nLoad(n,f):4:0, ",",
					    FOR_CG_Tot(n,f):14:6, ",",
					    (FOR_CG_nBat(n,f)*FOR_CG_Tot(n,f)):14:6, ",",
					    FOR_CG_Tot(n,f):14:6 / ;
				endfor;
				put "TOTAL_status,",     FOR_StatCur, ",,,," / ;
				put "TOTAL_SumAll,,,,",  FOR_CG_SumAll:14:6,    ",,(true net = sum over ALL nodes)" / ;
				put "TOTAL_SumBat,,,,",  FOR_CG_SumBat:14:6,    ",,(model CustPtot = sum over batteries)" / ;
				put "TOTAL_gap,,,,",     (FOR_CG_SumAll-FOR_CG_SumBat):14:6, ",,(SumAll - SumBat)" / ;
				put "DupTerm,,,,",       FOR_CG_Dup:14:6,       ",,(over-count from nodes with >1 battery)" / ;
				put "LoadNoBatTerm,,,,", FOR_CG_LoadNoBat:14:6, ",,(TotPcust at load nodes with NO battery)" / ;
				putclose FOR_CGCSV;
				
				display FOR_CG_SumAll, FOR_CG_SumBat, FOR_CG_Dup, FOR_CG_LoadNoBat;
			}
			Comment: "FOR - AUDIT. Per-(bus,phase) dump of battery count, load count and TotPcust. Writes diag_coverage.csv. Proves the CustPtot gap is entirely no-battery consumers (DupTerm=0).";
		}
		Procedure DumpFORNumbers {
			Body: {
				! full audit dump: every per-element number behind D, G, B, CustPtot, P_PCC and the branch losses,
				! so the aggregates can be re-derived in a spreadsheet. one 180deg solve -> dump_*.csv
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 1;
				
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 1;
				FOR_LinearizeVmax         := 1;
				
				FOR_Angle    := 180;
				FOR_AngleRad := 180 * 4*arctan(1) / 180;
				FOR_Lambda   := 1;
				
				empty allvariables;
				run Load_data_dsn;
				run MainExecution;
				
				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       numeric_focus       := 3,
					       barrier_homogeneous := 1,
					       time_limit          := 1500;
				
				FOR_StatCur := FOR_VertexCont.ProgramStatus;
				
				if FOR_VertexCont.ProgramStatus <> 'Optimal' and
				   FOR_VertexCont.ProgramStatus <> 'LocallyOptimal' then
					FOR_DScal.PageWidth := 32767;
					put FOR_DScal;
					put "status,", FOR_StatCur, ",solve did NOT reach optimal - rerun" / ;
					putclose FOR_DScal;
				else
					FOR_DBG_LineLoss(l) := sum(f,
					      (Vre(StartBus(l),f,PeriodMaxP) - Vre(EndBus(l),f,PeriodMaxP)) * Ire_Line(l,f,PeriodMaxP)
					    + (Vim(StartBus(l),f,PeriodMaxP) - Vim(EndBus(l),f,PeriodMaxP)) * Iim_Line(l,f,PeriodMaxP) );
					FOR_DBG_TrLoss(tr) := sum(f,
					      ( Vre(StartBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,StartBusTr(tr),PeriodMaxP)
					      + Vim(StartBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,StartBusTr(tr),PeriodMaxP) )
					    - ( Vre(EndBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,EndBusTr(tr),PeriodMaxP)
					      + Vim(EndBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,EndBusTr(tr),PeriodMaxP) ) );
				
					! ---- per-load ----
					FOR_DLoads.PageWidth := 32767;
					put FOR_DLoads;
					put "load,bus,phase,P0,GenP0,P0_minus_GenP0" / ;
					for (d) do
						put d, ",", LoadBus(d), ",", LoadPhase(d), ",",
						    P0(d,PeriodMaxP):16:8, ",", GenP0(d,PeriodMaxP):16:8, ",",
						    (P0(d,PeriodMaxP)-GenP0(d,PeriodMaxP)):16:8 / ;
					endfor;
					putclose FOR_DLoads;
				
					! ---- per-battery ----
					FOR_DBatt.PageWidth := 32767;
					put FOR_DBatt;
					put "battery,bus,phase,BattP_Balance" / ;
					for (bat) do
						put bat:24, ",", BattBus(bat):20, ",", BattPhase(bat), ",",
						    BattP_Balance(bat,PeriodMaxP):16:8 / ;
					endfor;
					putclose FOR_DBatt;
				
					! ---- per-line loss ----
					FOR_DLines.PageWidth := 32767;
					put FOR_DLines;
					put "line,startbus,endbus,line_loss" / ;
					for (l) do
						put l, ",", StartBus(l), ",", EndBus(l), ",",
						    FOR_DBG_LineLoss(l):16:8 / ;
					endfor;
					putclose FOR_DLines;
				
					! ---- per-transformer loss ----
					FOR_DTraf.PageWidth := 32767;
					put FOR_DTraf;
					put "trafo,startbus,endbus,trafo_loss" / ;
					for (tr) do
						put tr, ",", StartBusTr(tr), ",", EndBusTr(tr), ",",
						    FOR_DBG_TrLoss(tr):16:8 / ;
					endfor;
					putclose FOR_DTraf;
				
					! ---- per-slack-phase (P_PCC components) ----
					FOR_DSlack.PageWidth := 32767;
					put FOR_DSlack;
					put "slackgen,bus,phase,Vre_PCC,Vim_PCC,Ire_SlackGen,Iim_SlackGen,P_contribution" / ;
					for (sg) do
						put sg, ",", SlackGenBus(sg), ",", SlackGenPhase(sg), ",",
						    Vre_PCC(SlackGenPhase(sg)):16:8, ",",
						    Vim_PCC(SlackGenPhase(sg)):16:8, ",",
						    Ire_SlackGen(sg,PeriodMaxP):16:8, ",",
						    Iim_SlackGen(sg,PeriodMaxP):16:8, ",",
						    ( Vre_PCC(SlackGenPhase(sg))*Ire_SlackGen(sg,PeriodMaxP)
						    + Vim_PCC(SlackGenPhase(sg))*Iim_SlackGen(sg,PeriodMaxP) ):16:8 / ;
					endfor;
					putclose FOR_DSlack;
				
					! ---- per-bus voltages (Vre, Vim, Vmag2approx) ----
					FOR_DVolt.PageWidth := 32767;
					put FOR_DVolt;
					put "bus,phase,Vre,Vim,Vmag2approx" / ;
					for ((n,f)) do
						put n, ",", f, ",",
						    Vre(n,f,PeriodMaxP):16:8, ",",
						    Vim(n,f,PeriodMaxP):16:8, ",",
						    Vmag2approx(n,f,PeriodMaxP):16:8 / ;
					endfor;
					putclose FOR_DVolt;
				
					! ---- per-line currents (Ire_Line, Iim_Line) ----
					FOR_DLineI.PageWidth := 32767;
					put FOR_DLineI;
					put "line,phase,startbus,endbus,Ire_Line,Iim_Line" / ;
					for ((l,f)) do
						put l, ",", f, ",", StartBus(l), ",", EndBus(l), ",",
						    Ire_Line(l,f,PeriodMaxP):16:8, ",",
						    Iim_Line(l,f,PeriodMaxP):16:8 / ;
					endfor;
					putclose FOR_DLineI;
				
					! ---- per-transformer currents (start & end side) ----
					FOR_DTrafI.PageWidth := 32767;
					put FOR_DTrafI;
					put "trafo,phase,Ire_start,Iim_start,Ire_end,Iim_end" / ;
					for ((tr,f)) do
						put tr, ",", f, ",",
						    Ire_Trafo(tr,f,StartBusTr(tr),PeriodMaxP):16:8, ",",
						    Iim_Trafo(tr,f,StartBusTr(tr),PeriodMaxP):16:8, ",",
						    Ire_Trafo(tr,f,EndBusTr(tr),PeriodMaxP):16:8, ",",
						    Iim_Trafo(tr,f,EndBusTr(tr),PeriodMaxP):16:8 / ;
					endfor;
					putclose FOR_DTrafI;
				
					! ---- per-load/gen currents (Ire/Iim_Load, Ire/Iim_Gen) ----
					FOR_DLoadI.PageWidth := 32767;
					put FOR_DLoadI;
					put "load,bus,phase,Ire_Load,Iim_Load,Ire_Gen,Iim_Gen" / ;
					for (d) do
						put d, ",", LoadBus(d), ",", LoadPhase(d), ",",
						    Ire_Load(d,PeriodMaxP):16:8, ",",
						    Iim_Load(d,PeriodMaxP):16:8, ",",
						    Ire_Gen(d,PeriodMaxP):16:8, ",",
						    Iim_Gen(d,PeriodMaxP):16:8 / ;
					endfor;
					putclose FOR_DLoadI;
				
					! ---- scalar cross-checks (AIMMS-side, to verify the sheet) ----
					FOR_DScal.PageWidth := 32767;
					put FOR_DScal;
					put "quantity,value" / ;
					put "status,",            FOR_StatCur / ;
					put "D_sum_P0,",          sum(d, P0(d,PeriodMaxP)):16:8 / ;
					put "G_sum_GenP0,",       sum(d, GenP0(d,PeriodMaxP)):16:8 / ;
					put "B_sum_BattP,",       sum(bat, BattP_Balance(bat,PeriodMaxP)):16:8 / ;
					put "CustPtot_allnodes,", sum((n,f), TotPcust(n,f,PeriodMaxP)):16:8 / ;
					put "CustPtot_batnodes,", sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP)):16:8 / ;
					put "P_PCC,",             P_PCC(PeriodMaxP):16:8 / ;
					put "Line_loss_total,",   sum(l, FOR_DBG_LineLoss(l)):16:8 / ;
					put "Trafo_loss_total,",  sum(tr, FOR_DBG_TrLoss(tr)):16:8 / ;
					putclose FOR_DScal;
				
					display FOR_StatCur;
				endif;
			}
			Comment: "FOR - AUDIT. Full traceability: every per-element value (each load, battery, line, transformer, slack phase) to dump_*.csv so the aggregates can be re-derived in a spreadsheet.";
		}
	}
	Section ResultsOutput {
		Comment: {
			"Results writers. The rolling FOR writes its CSVs directly from RunFOR_Rolling; WriteResultstoExcel builds the 11-sheet workbook for the paper cases (RunOneCase/RunAllCases/RunBAU)."
		}
		Procedure WriteResultstoExcel {
			Body: {
				axll::CloseAllWorkBooks;
				
				axll::CreateNewWorkBook(
					WorkbookFilename:ResultsFile,
					FirstSheetName:"BattP_Balance");
				
				axll::WriteTable(
					IdentifierReference: BattP_Balance(bat,t),	!write BattP_Balance
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1);
				
				axll::CreateSheet(SheetName:"SOC");	!write SOC
				axll::WriteTable(
					IdentifierReference: BattSOC(bat,t),
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1);
				
				axll::CreateSheet(SheetName:"BattP_Chg");	!write BattP_Chg
				axll::WriteTable(
					IdentifierReference: BattP_Chg(bat,t),
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1);
				
				axll::CreateSheet(SheetName:"BattP_Dis");	!write BattP_Dis
				axll::WriteTable(
					IdentifierReference: BattP_Dis(bat,t),
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1);
				
				axll::CreateSheet(SheetName:"ChgDis");	!write ChgDis
				axll::WriteTable(
					IdentifierReference: ChgDis(bat,t),
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1
					);
				
				axll::CreateSheet(SheetName:"Qinv");	!write Qinv
				axll::WriteTable(
					IdentifierReference: Qinv(bat,t),
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1
					);
				
				!axll::CreateSheet(SheetName:"TotPCust");	!write TotPCust
				!axll::WriteTable(
				!	IdentifierReference:TotPCust(n,f,t),
				!	RowHeaderRange:"A2:B2431",
				!	ColumnHeaderRange:"C1:AX1",
				!	DataRange:"C2:AX2431",
				!	AllowRangeOverflow:1,
				!	WriteZeros:1,
				!	includeEmptyRows:1,
				!	includeEmptyColumns:1
				!	);
				
				axll::CreateSheet(SheetName:"AllCustWithBatPtot");	!write AllCustWithBatPtot
				axll::WriteTable(
					IdentifierReference:AllCustWithBatPtot(t),
					RowHeaderRange:"",
					ColumnHeaderRange:"A1:AV1",
					DataRange:"A2:AV2",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1);
				
				axll::CreateSheet(SheetName:"AllCustWithBatPtot_AggTr");	!write AllCustWithBatPtot_AggTr
				!axll::WriteTable(
				!	IdentifierReference:AllCustWithBatPtot_AggTr(tr,t),
				!	RowHeaderRange:"A2:B28",
				!	ColumnHeaderRange:"C1:AX1",
				!	DataRange:"C2:AX28",
				!	AllowRangeOverflow:1,
				!	WriteZeros:1,
				!	includeEmptyRows:1,
				!	includeEmptyColumns:1);
				
				
				
				
				axll::CreateSheet(SheetName:"VmagExPost_PeriodMaxP");	!write VmagExPost_PeriodMaxP
				axll::WriteTable(
					IdentifierReference:VmagExPost_PeriodMaxP(n,f),
					RowHeaderRange:"A1:B13737",
					ColumnHeaderRange:"",
					DataRange:"C1:C13737",
					AllowRangeOverflow:1,
					WriteZeros:1);
				
				axll::CreateSheet(SheetName:"LineUsage_PeriodMaxP");	!write LineUsage_PeriodMaxP
				axll::WriteTable(
					IdentifierReference:LineUsage_PeriodMaxP(l,f),
					RowHeaderRange:"A1:B13707",
					ColumnHeaderRange:"",
					DataRange:"C1:C13707",
					AllowRangeOverflow:1,
					WriteZeros:1);
				
				axll::CreateSheet(SheetName:"TrafoUsage_PeriodMaxP");	!write TrafoUsage_PeriodMaxP
				axll::WriteTable(
					IdentifierReference:TrafoUsage_PeriodMaxP(tr,f),
					RowHeaderRange:"A1:B27",
					ColumnHeaderRange:"",
					DataRange:"C1:C27",
					AllowRangeOverflow:1,
					WriteZeros:1);
				
				
				axll::CloseAllWorkBooks;
			}
		}
	}
	Section SCSafeTest {
		Comment: {
			"SELF-CONSUMPTION SAFETY OF THE OFFERED FOR (experiment, 2026-09-30). Isolated copy under
			experiments/2026-09-30_sc-safe-FOR - the production OPF.ams is not touched.
			.
			QUESTION. If the TSO picks a point inside the FOR, does it compromise self-consumption later?
			The sweep objective (FOR_Lambda = 1, FOR_TieEps = 0) carries NO self-consumption weight on the
			slots after the service slot, so a vertex may drain/fill the battery and leave the prosumers
			importing later. Nothing in production measures that.
			.
			H1/H3 (SCT_On = 1). After each period's sweep, re-plan pure self-consumption (MinImports, slot 1
			frozen) with the service-slot PCC point pinned to B + s*(V - B), V each vertex, B the no-service
			point, and log imports/exports left in slots > PeriodMaxP (SCT_regret<suffix>.csv).
			H2 (FOR_SCWeight = kappa > 0). Prof. Luis's weighting, put where the FOR is drawn: the sweep
			objective gains kappa * (the same w2-weighted self-consumption terms MinImports uses) over the
			slots after the service slot, plus the matching throughput penalty. kappa = 0 = production."
		}
		DeclarationSection SCT_Declarations {
			Parameter FOR_SCWeight {
				Default: 0;
				Comment: {
					"kappa: weight of future self-consumption inside the directional objective OF_FOR_cont.
					0 = production sweep (pure direction). Service earns 1 per unit of PCC power; losing a unit of
					stored energy that was needed later costs about kappa*w2(t) (w2 = 1.99 .. 1.54), so kappa*w2 > 1
					makes the sweep refuse service that would raise future imports/exports."
				}
			}
			Parameter FOR_SCExpWeight {
				Default: 1;
				Comment: {
					"Export share of the kappa term. 1 = the full MinImports self-consumption terms (imports AND exports
					penalised, as in the committed baseline). 0 = imports only: the sweep refuses service that makes the
					prosumers BUY more later, but not service that makes them export more later."
				}
			}
			Parameter SCT_Hard {
				Default: 0;
				Comment: {
					"H2c: P1 as a CONSTRAINT of the sweep. 1 = SCNoImportFuture is active in the directional solves with the
					production baseline (SCFirst stays 0): no prosumer may import more, in any slot after the service slot,
					than the committed self-consumption plan does. Exports are free."
				}
			}
			Parameter SCT_Regret {
				Default: 1;
				Comment: "1 = run the regret re-plans after each sweep. 0 = skip them (closed-loop H4 runs only need the realised log).";
			}
			StringParameter SCT_H4Periods {
				Comment: "H4: REAL target periods at which the TSO asks for service (RollSvcPeriodsCSV format).";
			}
			Parameter P1ExpScale {
				Default: 1;
				Comment: "Scale on the export term of OFminImports. 1 = production P1. Set to SCT_IPExp only inside SCT_SolveCase for the imports-first re-plan, then restored.";
			}
			Parameter SCT_IPExp {
				Default: 0.01;
			}
			Parameter SCT_DualReplan {
				Default: 1;
				Comment: "1 = every regret case is also re-planned imports-first (least achievable future purchase).";
			}
			Parameter SCT_FeasTol {
				Comment: "0 = production Feasibility_Tolerance (1e-3). > 0 overrides it inside RunFOR_Rolling (tolerance test).";
			}
			Parameter SCT_BarTol {
				Comment: "0 = production Barrier_Convergence_Tolerance (1e-2). > 0 overrides it.";
			}
			Parameter SCT_FlatW {
				Comment: "1 only inside the imports-first re-plan: every weighted slot counts a kWh the same (2), so the re-plan minimises kWh bought, not time-discounted kWh. 0 = production w2.";
			}
			Parameter SCT_W2 {
				IndexDomain: t;
				Definition: if SCT_FlatW = 1 and w2(t) > 0 then 2 else w2(t) endif;
				Comment: "The P1 slot weight actually used by OFminImports: w2 in production, flat 2 (same zero pattern) in the imports-first re-plan.";
			}
			StringParameter SCT_Trafo {
				Comment: "Transformer detailed by SCT_RunBed (empty = TR9).";
			}
			Parameter SCT_PlanDump {
				Comment: "1 = write SCT_plan<suffix>.csv: per prosumer and slot, the whole-window plan of the baseline (angle -1) and of every vertex, at the steps in SCT_PlanSteps.";
			}
			StringParameter SCT_PlanSteps;
			StringParameter SCT_PlanCSVName {
				Definition: "SCT_plan" + RollFileSuffix + ".csv";
			}
			File SCT_PlanCSV {
				Name: SCT_PlanCSVName;
				Mode: append;
			}
			Parameter SCT_On {
				Default: 0;
				Comment: "1 = run the regret re-plans after each period's sweep (RunFOR_Rolling). 0 = inert.";
			}
			Parameter SCT_Checked {
				Comment: "Internal: solver/type check already written for this run.";
			}
			Parameter SCT_PinOn {
				Comment: "Runtime gate of SCT_PinProw/SCT_PinQrow: 1 only inside SCT_SolveCase.";
			}
			Parameter SCT_PinP;
			Parameter SCT_PinQ;
			Parameter SCT_PinTol {
				Default: 1e-5;
				Comment: "Half-width of the PCC pin, p.u. (1e-5 = 10 W).";
			}
			Constraint SCT_PinProw {
				IndexDomain: ax | SCT_PinOn and ord(ax) = 1;
				Definition: SCT_PinP - SCT_PinTol <= P_PCC(PeriodMaxP) <= SCT_PinP + SCT_PinTol;
				Comment: "Pin the service-slot PCC active power. One row when SCT_PinOn = 1, zero rows otherwise (RollSvcPinP idiom).";
			}
			Constraint SCT_PinQrow {
				IndexDomain: ax | SCT_PinOn and ord(ax) = 2;
				Definition: SCT_PinQ - SCT_PinTol <= Q_PCC(PeriodMaxP) <= SCT_PinQ + SCT_PinTol;
				Comment: "Pin the service-slot PCC reactive power. One row when SCT_PinOn = 1, zero rows otherwise.";
			}
			Parameter SCT_nShrink {
				Default: 1;
			}
			Set SCT_ShrinkSet {
				SubsetOf: Integers;
				Index: ss;
				Property: ElementsAreNumerical;
				Definition: ElementRange(1, SCT_nShrink);
			}
			Parameter SCT_Shrink {
				IndexDomain: ss;
				Comment: "Pinned point = B + s*(V - B). 0.99 stands for the vertex itself (1 % inside, off the degenerate boundary).";
			}
			Parameter SCT_nKappa {
				Default: 1;
			}
			Set SCT_KappaSet {
				SubsetOf: Integers;
				Index: sk;
				Property: ElementsAreNumerical;
				Definition: ElementRange(1, SCT_nKappa);
			}
			Parameter SCT_KappaList {
				IndexDomain: sk;
			}
			StringParameter SCT_KappaTag {
				IndexDomain: sk;
			}
			Parameter SCT_BaseP;
			Parameter SCT_BaseQ;
			StringParameter SCT_BaseStat;
			StringParameter SCT_Stat;
			Parameter SCT_Time;
			Parameter SCT_ImpFut;
			Parameter SCT_ExpFut;
			Parameter SCT_OFfut;
			Parameter SCT_RealP;
			Parameter SCT_RealQ;
			Parameter SCT_SOC2;
			Parameter SCT_SOCmin;
			Parameter SCT_SOCend;
			Parameter SCT_NFloor;
			Parameter SCT_NFloor2;
			Parameter SCT_ImpBat {
				IndexDomain: bat;
			}
			Parameter SCT_ImpBatRef {
				IndexDomain: bat;
			}
			Parameter SCT_ImpSlot {
				IndexDomain: (bat,t);
			}
			Parameter SCT_ImpSlotRef {
				IndexDomain: (bat,t);
			}
			Parameter SCT_ImpBatMax;
			Parameter SCT_NBatReg;
			Parameter SCT_ImpSlotMax;
			Parameter SCT_ImpBatRefIP {
				IndexDomain: bat;
			}
			Parameter SCT_ImpSlotRefIP {
				IndexDomain: (bat,t);
			}
			StringParameter SCT_StatIP;
			Parameter SCT_ImpFutIP;
			Parameter SCT_ImpBatMaxIP;
			Parameter SCT_NBatRegIP;
			Parameter SCT_ImpSlotMaxIP;
			ElementParameter SCT_GMP {
				Range: AllGeneratedMathematicalPrograms;
			}
			ElementParameter SCT_Solver {
				Range: AllSolvers;
			}
			ElementParameter SCT_MPType {
				Range: AllMathematicalProgrammingTypes;
			}
			StringParameter SCT_CSVName {
				Definition: "SCT_regret" + RollFileSuffix + ".csv";
			}
			File SCT_CSV {
				Name: SCT_CSVName;
				Mode: append;
			}
			StringParameter SCT_ExecCSVName {
				Definition: "SCT_exec" + RollFileSuffix + ".csv";
			}
			File SCT_ExecCSV {
				Name: SCT_ExecCSVName;
				Mode: append;
			}
			StringParameter SCT_InfoName {
				Definition: "SCT_info" + RollFileSuffix + ".txt";
			}
			File SCT_Info {
				Name: SCT_InfoName;
				Mode: append;
			}
		}
		DeclarationSection PVC_Declarations {
			Comment: {
				"PV CURTAILMENT TEST (2026-10-02, experiments/2026-10-02_pv-curtailment). In the production model
				PV is a fixed parameter (GenP0 = PVsize*Irradiance/1000) that is always injected, and each BESS has
				its own inverter (MaxBattS_def holds only BattP_Balance and Qinv), so the FOR contains BESS
				flexibility only. Here every prosumer may also curtail its PV in the SERVICE slot of the
				directional sweep, as extra flexibility on the 'export less' side.
				.
				Where it exists: PVC_On = 1 and (SCRefActive = 1, i.e. the directional sweep, or SCT_PinOn = 1, i.e.
				a pinned regret re-plan) and only at t = PeriodMaxP. Never in the committed P1 baseline, so the
				baseline, SCImpRef and the carried SOC are those of the run without curtailment.
				Network: the curtailed power is withdrawn at the battery's bus and phase through Pbat with the
				battery's fixed-V0 power-to-current relation - the same zero-order term as the PV injection
				(Ire_Gen/Iim_Gen at V0), without the PV's first-order voltage term, which would be bilinear.
				Not inside the BESS S-circle: separate PV and BESS inverters, as in the production model."
			}
			Parameter PVC_On {
				Default: 0;
				Comment: "1 = offer PV curtailment in the service slot of the sweep (and allow it in pinned regret re-plans). 0 = model identical to the copy it came from: PVC_Cut has an empty domain.";
			}
			Parameter PVC_SweepPen {
				Default: 0.01;
				Comment: "Tie-break cost per p.u. of curtailment in the directional objective. Smaller than FOR_ThruPenSlot (0.2) and than any direction weight that matters, so it only decides ties.";
			}
			Parameter PVC_ReplanPen {
				Default: 10;
				Comment: "Cost per p.u. of curtailment in the pinned P1 re-plans (regret check). Far above the P1 weights (w2 <= 2 per import or export), so P1 curtails only what the pinned point needs.";
			}
			Parameter PVC_Avail {
				IndexDomain: (bat,t);
				Definition: sum(d | LoadBus(d) = BattBus(bat) and LoadPhase(d) = BattPhase(bat), GenP0(d,t));
				Comment: "PV output at the prosumer that owns this battery (one load and one PV array per battery bus and phase), p.u.";
			}
			Parameter PVC_Mode {
				Default: 0;
				Comment: "0 = Option A: a prosumer may cut all its PV. 1 = Option B: only the SURPLUS, PV minus the house's own load in that slot, so a request never makes the house buy for its own use (2026-10-02).";
			}
			Parameter PVC_Cap {
				IndexDomain: (bat,t);
				Definition: {
					if PVC_Mode = 1 then
						max(0, sum(d | LoadBus(d) = BattBus(bat) and LoadPhase(d) = BattPhase(bat), GenP0(d,t) - P0(d,t)))
					else
						PVC_Avail(bat,t)
					endif
				}
				Comment: "Upper bound of PVC_Cut, p.u.: all the PV (Option A) or the surplus over the house's own load (Option B).";
			}
			Variable PVC_Cut {
				IndexDomain: (bat,t) | PVC_On and (SCRefActive or SCT_PinOn) and ord(t) = PeriodMaxP;
				Range: [0, PVC_Cap(bat,t)];
				Comment: "PV curtailed at this prosumer in the service slot, p.u. Cannot exceed the PV available there.";
			}
			Parameter SCT_PVCcut;
			StringParameter PVC_CSVName {
				Definition: "PVC_cut" + RollFileSuffix + ".csv";
			}
			File PVC_CSV {
				Name: PVC_CSVName;
				Mode: append;
			}
		}
		DeclarationSection PV2_Declarations {
			Comment: {
				"TWO PV OPTIONS (2026-10-05, experiments/2026-10-05_two-pv-options). Option 1: surplus PV exported by
				default, cut only when the TSO asks (Option B in the FOR). Option 2: no export without agreement, surplus
				cut by default, batteries serve and PV refills them. Batteries-first delivery (FRQ_BF): a request is
				delivered from the stored solutions with the least PV cut. Inert at FRQ_BF = 0, PV2_Regime = 0."
			}
			Parameter PV2_Regime {
				Default: 0;
				Comment: "Read by PV2_Run: 1 = PV exported by default, surplus cut only on TSO request; 2 = no export without agreement (surplus cut by default, PV refills the batteries).";
			}
			Parameter FRQ_BF {
				Default: 0;
				Comment: "1 = batteries-first delivery: battery-only twins of the corners that cut PV, and the request rebuilt from the stored solutions with the least PV cut (needs the GMP sweep).";
			}
			Parameter FRQ_GenNow {
				Default: 0;
				Comment: "1 only while the period's GMP sweep instance is generated, so FRQ_NoCut exists in that instance and in no other solve.";
			}
			Parameter FRQ_BFTol {
				Default: 0.1;
				Comment: "kW. A corner cutting more PV than this gets a battery-only twin; a mix cutting more than 0.001 kW is rebuilt.";
			}
			Constraint FRQ_NoCut {
				IndexDomain: ax | ord(ax) = 1 and FRQ_GenNow and FRQ_BF and PVC_On and SRQ_Mode = 2;
				Definition: 1000*sum(bat, PVC_Cut(bat,PeriodMaxP)) <= 0;
				Comment: "Battery-only twin of a corner: the same direction with no PV cut. Kept inactive in the sweep instance, switched on only for the twin solve.";
			}
			Parameter FRQ_GP { IndexDomain: ia; }
			Parameter FRQ_GQ { IndexDomain: ia; }
			Parameter FRQ_GOK { IndexDomain: ia; }
			Parameter FRQ_GChg { IndexDomain: (ia,bat); }
			Parameter FRQ_GDis { IndexDomain: (ia,bat); }
			Parameter FRQ_GQv { IndexDomain: (ia,bat); }
			Parameter FRQ_GCut { IndexDomain: (ia,bat); }
			Parameter FRQ_NTwin { Comment: "Battery-only twin solves in the run."; }
			Parameter FRQ_NTwinFail { Comment: "Twin solves that did not reach Optimal (the twin is then left out)."; }
			Set FRQ_PtSet {
				SubsetOf: Integers;
				Index: bfp, bfq, bfr;
				Property: ElementsAreNumerical;
				Definition: ElementRange(1, 2*FOR_nAngles + 1);
				Comment: "Stored solutions at a request: 1 = no-service, 1+i = corner i, 1+n+i = battery-only twin of corner i.";
			}
			Parameter FRQ_BP { IndexDomain: bfp; }
			Parameter FRQ_BQ { IndexDomain: bfp; }
			Parameter FRQ_BOK { IndexDomain: bfp; }
			Parameter FRQ_BCut { IndexDomain: bfp; }
			Parameter FRQ_BThr { IndexDomain: bfp; }
			Parameter FRQ_BChg { IndexDomain: (bfp,bat); }
			Parameter FRQ_BDis { IndexDomain: (bfp,bat); }
			Parameter FRQ_BQv { IndexDomain: (bfp,bat); }
			Parameter FRQ_BCutB { IndexDomain: (bfp,bat); }
			ElementParameter FRQ_J2 { Range: FOR_AngleSet; }
			ElementParameter FRQ_B1 { Range: FRQ_PtSet; }
			ElementParameter FRQ_B2 { Range: FRQ_PtSet; }
			ElementParameter FRQ_B3 { Range: FRQ_PtSet; }
			Parameter FRQ_Det;
			Parameter FRQ_W1;
			Parameter FRQ_W2;
			Parameter FRQ_W3;
			Parameter FRQ_WS;
			Parameter FRQ_BW1;
			Parameter FRQ_BW2;
			Parameter FRQ_BW3;
			Parameter FRQ_TCut;
			Parameter FRQ_TThr;
			Parameter FRQ_BestCut;
			Parameter FRQ_BestThr;
			Parameter FRQ_BFound;
			Parameter FRQ_BFUsed;
			Parameter FRQ_CutA;
			Parameter FRQ_ThrA;
			Parameter FRQ_CutBF;
			Parameter FRQ_ThrBF;
			Parameter FRQ_GArea;
			Parameter FRQ_BChkP;
			Parameter FRQ_BChkQ;
			StringParameter FRQ_TwinCSVName {
				Definition: "FORtwin" + RollFileSuffix + ".csv";
			}
			File FRQ_TwinCSV {
				Name: FRQ_TwinCSVName;
				Mode: append;
			}
			Parameter SPD_P1Threads {
				Default: 0;
				Comment: "SPEED TEST (2026-10-06): CPLEX thread cap (option global_thread_limit) for every solve of PV2_Run that is not an async sweep copy (P1 steps, coordinated step, delivery, sequential sweep). 0 = solver default (all cores). The async copies use RollAsyncThreads.";
			}
			Parameter SPD_P1NoNet {
				Default: 0;
				Comment: "SPEED TEST (2026-10-07): 1 = P1 and the coordinated step behind the meter (no network); the plan is evaluated on the network only at steps with a FOR or a running service (see add_p1nonet.py). 0 = P1 with the network, as before.";
			}
			Parameter SPD_NVChg { IndexDomain: (bat,t); Comment: "SPEED TEST working: nonvar status saved around the network check."; }
			Parameter SPD_NVDis { IndexDomain: (bat,t); }
			Parameter SPD_NVQ { IndexDomain: (bat,t); }
			Parameter SPD_NVZX { IndexDomain: (bat,t); }
			Parameter SPD_TwoDays {
				Default: 0;
				Comment: "TWO DAYS (2026-10-08): 1 = PV2_Run simulates day 1 and then day 2 as its continuation (same profiles, no TSO request, SOC and the plan-once plan carried over midnight), files of day 2 with suffix _d2. 0 = one day.";
			}
			Parameter SeedPrevChg { IndexDomain: sd; Comment: "TWO DAYS: the plan of the last step of day 1 for the first half-hour of day 2 (charge), held against SeedBatt."; }
			Parameter SeedPrevDis { IndexDomain: sd; Comment: "TWO DAYS: as SeedPrevChg, discharge."; }
			Parameter SPD_FixSlotK {
				Default: 0;
				Comment: "DECISION TEST (2026-10-08): 1 = without a committed service, slot k keeps the BESS powers P1 planned for it at the previous step (plan once). 0 = P1 re-plans slot k (default).";
			}
			Parameter SPD_CornersOnly {
				Default: 0;
				Comment: "DECISION TEST (2026-10-08): 1 = a requested point is rebuilt from FOR corners only (option b), least-throughput triangle; 0 = mix with the no-service point S0 (option a, default).";
			}
			Parameter SPD_PrevChg { IndexDomain: bat; }
			Parameter SPD_PrevDis { IndexDomain: bat; }
			Parameter SPD_PrevOK;
			Parameter SPD_FixedNow;
			Parameter SPD_FixN { Comment: "DECISION TEST: steps where slot k kept the previous plan."; }
			Parameter SPD_FixFail { Comment: "DECISION TEST: steps where the kept plan was infeasible and slot k was freed."; }
			Parameter SPD_CON { Comment: "DECISION TEST: requests rebuilt from corners only."; }
			Parameter SPD_COMiss { Comment: "DECISION TEST: requests outside the corners' polygon (kept the S0 mix)."; }
			Parameter SPD_COFound;
			Parameter SPD_COBest;
			Parameter SPD_ThrA;
			Parameter SPD_ThrB;
			Parameter SPD_MaxDiff;
			Parameter SPD_NetA { IndexDomain: bat; }
			Parameter SPD_NCAll {
				Default: 0;
				Comment: "SPEED TEST (2026-10-07): 1 = with SPD_P1NoNet = 1, P1's plan (slots 1-2) is checked on the network at EVERY step, not only where a network point is needed; a failed check re-solves P1 with the network. For transformers where the network can bind P1 (TR2, TR9). Switches SPD_S0FOR off.";
			}
			StringParameter SPD_Trafo {
				Comment: "Transformer(s) of PV2_Run kept in detail (comma list, e.g. TR9); empty = TR4; ALL = the whole feeder (no reduction, every battery).";
			}
			Parameter SPD_S0FOR {
				Default: 0;
				Comment: "SPEED TEST (2026-10-07): 1 = with SPD_P1NoNet = 1, S0 and the realised slot-1 point come from one extra solve of the FOR problem (service-slot decisions fixed at P1's plan) instead of the full network check. Needs the async sweep and FairMode = 0. 0 = network check, as in add_p1nonet.py.";
			}
			Parameter SPD_ForStep { Comment: "SPEED TEST working: 1 when this step builds a FOR."; }
			Parameter SPD_S0Live { Comment: "SPEED TEST working: 1 when S0 comes from the FOR problem at this step."; }
			Parameter SPD_S0Bad { Comment: "SPEED TEST working: 1 when this step's S0 solve failed."; }
			Parameter SPD_S0Done { Comment: "SPEED TEST working: 1 once this step's S0 solve has been launched."; }
			Parameter SPD_S0Got { Comment: "SPEED TEST working: 1 once this step's S0 solve has been collected."; }
			Parameter SPD_S0N { Comment: "SPEED TEST: S0 solves on the FOR problem in the run."; }
			Parameter SPD_S0Fail { Comment: "SPEED TEST: S0 solves that failed (no FOR offered at that step)."; }
			ElementParameter SPD_S0GMP { Range: AllGeneratedMathematicalPrograms; }
			ElementParameter SPD_S0Ses { Range: AllSolverSessions; }
			ElementParameter SPD_S0Stat { Range: AllSolutionStates; }
			Parameter SPD_P1Q0 {
				Default: 0;
				Comment: "SPEED TEST (2026-10-07): 1 = inverter reactive power at the service slot fixed to 0 in P1 (and the coordinated step), so the no-request point S0 has Q = 0 whether P1 has the network or not. 0 = free in P1, as before (with the network the solver then leaves it at an arbitrary value).";
			}
			Parameter SPD_NCDone { Comment: "SPEED TEST working: 1 when a network check ran this step, so P1's plan is read from the saved values."; }
			Parameter SPD_TotP { IndexDomain: (n,f,t); Comment: "SPEED TEST working: P1's house exchange (behind the meter), saved before the network check."; }
			Parameter SPD_SOCP { IndexDomain: (bat,t); Comment: "SPEED TEST working: P1's SOC plan, saved before the network check."; }
			Parameter SPD_NC { Comment: "SPEED TEST: network checks of P1's plan in the run."; }
			Parameter SPD_NCFail { Comment: "SPEED TEST: network checks that failed (P1 then re-solved with the network)."; }
			ElementParameter SPD_NCStat { Range: AllSolutionStates; }
			Parameter SPD_SvcC { IndexDomain: bat; Comment: "NC RESCUE (2026-10-08): the committed service as the exact convex combination of the corner solutions, before netting and the SOC cap (charge)."; }
			Parameter SPD_SvcD { IndexDomain: bat; Comment: "NC RESCUE: as SPD_SvcC, discharge."; }
			Parameter SPD_NCResc { Comment: "NC RESCUE: steps where the network P1 after a failed check was still not optimal."; }
			Parameter SPD_RescUnnet { Comment: "NC RESCUE: of those, executed with the service as the exact combination (no netting, no cap)."; }
			Parameter SPD_RescOK { Comment: "NC RESCUE: of those, rescued (any step of the chain)."; }
			StringParameter SPD_RescStat0;
			StringParameter SPD_RescHow;
			Parameter SPD_SweepDiag {
				Default: 0;
				Comment: "SWEEP DIAGNOSTIC (2026-10-08): 1 = at the first direction of a step still failing after the numeric retry, re-solve it with one row family off at a time and log SWEEPDIAG lines (see add_sweepdiag.py). 0 = off.";
			}
			Parameter SPD_SDDone { Comment: "SWEEP DIAGNOSTIC working: 1 once this step has been diagnosed."; }
			ElementParameter SPD_SDG { Range: AllGeneratedMathematicalPrograms; }
			StringParameter SPD_SDStat;
			Parameter SPD_SOC1 { IndexDomain: bat; Comment: "NC RESCUE 3: SOC after slot 1 with the exact combination."; }
			Parameter SPD_ClipC { IndexDomain: bat; Comment: "NC RESCUE 3: charge clipped off the exact combination (SOC above the sweep's ceiling, solver tolerance), p.u."; }
			Parameter SPD_ClipD { IndexDomain: bat; Comment: "NC RESCUE 3: discharge clipped off (SOC below the floor), p.u."; }
			Parameter SPD_ClipWh { Comment: "NC RESCUE 3: energy clipped at this rescue, Wh."; }
			Parameter SPD_RescDiag {
				Default: 0;
				Comment: "RESCUE DIAGNOSTIC (2026-10-08): 1 = when a committed service fails the network check, solve the network P1 with slot 1 at each stored corner, at the exact combination with relaxed limits and without the network, and log RESCDIAG lines (see add_rescdiag.py). 0 = off.";
			}
			Parameter SPD_DiagM { IndexDomain: t; Comment: "RESCUE DIAGNOSTIC: worst V - MaxV per slot (p.u.)."; }
			Parameter SPD_DiagN { IndexDomain: t; Comment: "RESCUE DIAGNOSTIC: worst MinV^2 - Vmag2approx per slot (p.u.^2)."; }
			Parameter SPD_DiagL { IndexDomain: t; Comment: "RESCUE DIAGNOSTIC: worst line current / MaxCurrent per slot."; }
			Parameter SPD_TimeLog {
				Default: 0;
				Comment: "SPEED TEST: 1 = keep the wall clock of every rolling step (start, P1 done, FOR done) and write SPDtime<tag>.csv at the end of PV2_Run.";
			}
			StringParameter SPD_T0 { IndexDomain: t; Comment: "SPEED TEST: clock at the start of step t."; }
			StringParameter SPD_T1 { IndexDomain: t; Comment: "SPEED TEST: clock when P1 (and the coordinated step) of step t is done."; }
			StringParameter SPD_T2 { IndexDomain: t; Comment: "SPEED TEST: clock when the FOR of step t (sweep and twins) is done; empty when no FOR was built."; }
			Parameter SPD_TwinRank { IndexDomain: ia; Comment: "SPEED TEST working: order of the corners that need a battery-only twin in the async sweep (0 = no twin solve)."; }
			Parameter SPD_NTwinNeed { Comment: "SPEED TEST working: corners of this period that need a twin solve."; }
			StringParameter SPD_TimeCSVName {
				Definition: "SPDtime" + RollFileSuffix + ".csv";
			}
			File SPD_TimeCSV {
				Name: SPD_TimeCSVName;
				Mode: append;
			}
			Parameter SRQ_ExecShrink {
				Default: 0.999;
				Comment: "Factor on the committed battery set-points in the one retry before a service is released.";
			}
			Parameter SRQ_ExecRescued { Comment: "Committed services executed thanks to the shrunk retry."; }
			StringParameter SRQ_ExecStat0;
			StringParameter SRQ_ExecNoNet;
			Parameter SRQ_CapTolRetry {
				Default: 1e-3;
				Comment: "Tolerance of the coordinated caps in the retry of the second P1 step (kW for imports and throughput).";
			}
			Parameter SRQ_CapTol0;
			Parameter SRQ_Retry2 { Comment: "Coordinated second P1 steps that needed the numeric retry."; }
			Parameter SRQ_Fall2 { Comment: "Coordinated second P1 steps that still fell back to the first step."; }
			StringParameter BF_CSVName {
				Definition: "BF" + RollFileSuffix + ".csv";
			}
			File BF_CSV {
				Name: BF_CSVName;
				Mode: append;
			}
		}
		DeclarationSection ZX_Declarations {
			Comment: {
				"NO-EXPORT / PV-REFILL TEST (2026-10-05, experiments/2026-10-05_no-export-pv-refill). Surplus PV after the
				house and its battery cannot be exported without the TSO's agreement, so P1 cuts it (behind the meter).
				The FOR stays batteries only: at the service slot the cut is held at P1's value, so a battery that
				stops absorbing PV or discharges exports that power as the agreed service. PV that would be cut later
				refills the battery - that is the curtailment the service saves. Inert at ZX_On = 0."
			}
			Parameter ZX_On {
				Default: 0;
				Comment: "1 = no export without agreement, surplus PV cut in P1. 0 = model identical to the copy it came from.";
			}
			Parameter ZX_Pen {
				Default: 1;
				Comment: "Weight of a cut in P1, as a multiple of the export weight it replaces (1 = same decisions as today's P1).";
			}
			Parameter ZX_Eps {
				Default: 1e-6;
				Comment: "Tolerance of the no-export row, p.u. (1e-6 = 1 W), as SCEps.";
			}
			Parameter ZX_GMP {
				Default: 0;
				Comment: "Read from scenario.txt by ZX_Run: 1 = sweep on the GMP path (one matrix per period, objective changed in place).";
			}
			Parameter SCTight {
				Default: 0;
				Comment: "1 = self-consumption rule in kW with a 0.01 W slack (ZX_SCTight) instead of SCNoImportFuture (1 W slack, p.u.).";
			}
			Parameter ZX_TightTol {
				Default: 1e-5;
				Comment: "Slack of ZX_SCTight, kW (1e-5 kW = 0.01 W).";
			}
			Constraint ZX_SCTight {
				IndexDomain: (bat,t) | SCTight and (SCFirst = 1 or SCT_Hard = 1) and SCRefActive and ord(t) > PeriodMaxP;
				Definition: 1000*TotPcust(BattBus(bat),BattPhase(bat),t) <= 1000*SCImpRef(bat,t) + 1000*SCAlpha*BattMaxP(bat) + ZX_TightTol;
				Comment: "SCNoImportFuture in kW: the solver tolerance and the slack no longer add up to 1 W per later slot at every request.";
			}
			Parameter ZX_EndOn {
				Default: 0;
				Comment: "1 = a service may not leave less energy at the end of the window than P1's plan (ZX_EndCap).";
			}
			Parameter ZX_EndTol {
				Default: 1e-5;
			}
			Parameter ZX_SOCEndRef {
				IndexDomain: bat;
				Comment: "SOC at the end of the window in P1's plan, captured after the baseline solve.";
			}
			Constraint ZX_EndCap {
				IndexDomain: bat | ZX_EndOn and SCRefActive;
				Definition: 1000*sum(t | ord(t) = nPeriods, BattSOC(bat,t)) >= 1000*ZX_SOCEndRef(bat) - ZX_EndTol;
				Comment: "What a service takes from a battery must be back by the end of the 24-h window.";
			}
			Parameter ZX_AnchorOn {
				Default: 0;
				Comment: "1 = lower side of the terminal band anchored to the no-service schedule (ZX_SOCAnchor), not only to the SOC measured now.";
			}
			Parameter ZX_SOCAnchorDay {
				IndexDomain: (bat,t);
				Comment: "SOC at the start of each real period in the no-service (REF) day, read from anchor.txt.";
			}
			Parameter ZX_SOCAnchor {
				IndexDomain: bat;
				Comment: "No-service SOC for this step's window end (tomorrow, same time) = REF at the current real period.";
			}
			Parameter FRQ_Diag {
				Default: 1;
				Comment: "1 = FOR-first diagnostic (smallest PV cut for the same point, not executed); 0 = skipped.";
			}
			Parameter ZX_Cap {
				IndexDomain: (bat,t);
				Definition: max(0, sum(d | LoadBus(d) = BattBus(bat) and LoadPhase(d) = BattPhase(bat), GenP0(d,t) - P0(d,t)));
				Comment: "Surplus PV of the prosumer that owns this battery: PV minus its own load, p.u. (never the PV the house uses).";
			}
			Variable ZX_Cut {
				IndexDomain: (bat,t) | ZX_On;
				Range: [0, ZX_Cap(bat,t)];
				Comment: "Surplus PV cut at this prosumer, p.u.";
			}
			Parameter ZX_CutRef {
				IndexDomain: bat;
				Comment: "P1's cut at the service slot, captured after the baseline solve; the sweep holds the cut there.";
			}
			Parameter ZX_CutCommit {
				IndexDomain: bat;
				Comment: "Cut that goes with a committed service, executed at slot 1 of the next step.";
			}
			Constraint ZX_NoExport {
				IndexDomain: (bat,t) | ZX_On and SCRefActive = 0 and not ( ord(t) = 1 and RollSvcExec = 1 );
				Definition: TotPcust(BattBus(bat),BattPhase(bat),t) >= -ZX_Eps;
				Comment: "No export without agreement, in P1. Not in the sweep: there a cut can always replace a later export, so the FOR is the same without these rows.";
			}
			Constraint ZX_FixSvc {
				IndexDomain: bat | ZX_On and SCRefActive;
				Definition: ZX_Cut(bat,PeriodMaxP) = ZX_CutRef(bat);
				Comment: "PV is passive in the FOR: the service-slot cut stays at P1's value in every directional solve.";
			}
			Constraint ZX_FixExec {
				IndexDomain: bat | ZX_On and RollSvcExec = 1;
				Definition: ZX_Cut(bat,'1') = ZX_CutCommit(bat);
				Comment: "Slot 1 executing a committed service keeps the cut the FOR was built with.";
			}
		}
		DeclarationSection SRQ_Declarations {
			Comment: {
				"TSO-REQUEST STRESS TEST (2026-10-02, experiments/2026-10-02_tso-request-stress). Requests in kW
				read from scenario.txt, delivered as far as they fit (ray solve + pinned P1 commitment, executed at
				slot 1 of the next step, PV cut included), and an optional coordinated P1 (two steps: same
				purchases, charging moved to the PV surplus peak). Everything here is inert at SRQ_Mode = 0 and
				SRQ_Coord = 0: the gated rows have empty domains and PVC_Exec is 0."
			}
			Parameter SRQ_Mode {
				Default: 0;
				Comment: "1 = serve the TSO requests SRQ_dP/SRQ_dQ at the periods in RollSvcPeriodsCSV (needs RollSvcMode = 4).";
			}
			Parameter SRQ_Coord {
				Default: 0;
				Comment: "1 = coordinated P1: a second solve after the normal P1 keeps every import and the battery throughput at or below it and minimises the squared exports.";
			}
			Parameter SRQ_dP {
				IndexDomain: t;
				Comment: "Requested change of the transformer active power at REAL period t, p.u. from S0 (+ = more import / less export).";
			}
			Parameter SRQ_dQ {
				IndexDomain: t;
				Comment: "Requested change of the transformer reactive power at REAL period t, p.u. from S0.";
			}
			StringParameter SRQ_Tag;
			StringParameter SRQ_Periods;
			Parameter SRQ_MaxPer;
			Parameter SRQ_Sweep {
				Comment: "1 = also sweep the 12-direction FOR at every step (demonstration runs); 0 = stress runs (requests only).";
			}
			Parameter SRQ_ReqP;
			Parameter SRQ_ReqQ;
			Parameter SRQ_S0P;
			Parameter SRQ_S0Q;
			Parameter SRQ_Lam;
			Parameter SRQ_Try;
			Parameter SRQ_Back;
			StringParameter SRQ_RayStat;
			StringParameter SRQ_Stat2;
			Parameter SRQ_RayOn {
				Comment: "Runtime gate of the ray rows: 1 only around the ray solve.";
			}
			Parameter SRQ_RayTol {
				Default: 1e-5;
				Comment: "Half-width of the ray band at the transformer, p.u. (1e-5 = 10 W).";
			}
			Variable SRQ_Lambda {
				IndexDomain: ax | SRQ_RayOn and ord(ax) = 1;
				Range: [0, 1];
				Comment: "Fraction of the request delivered. One column during the ray solve, none otherwise.";
			}
			Variable SRQ_Obj {
				Range: free;
			}
			Constraint SRQ_ObjDef {
				IndexDomain: ax | SRQ_RayOn and ord(ax) = 1;
				Definition: SRQ_Obj = -SRQ_Lambda(ax);
			}
			Constraint SRQ_RayPlo {
				IndexDomain: ax | SRQ_RayOn and ord(ax) = 1;
				Definition: P_PCC(PeriodMaxP) >= SRQ_S0P + SRQ_Lambda(ax)*SRQ_ReqP - SRQ_RayTol;
			}
			Constraint SRQ_RayPhi {
				IndexDomain: ax | SRQ_RayOn and ord(ax) = 1;
				Definition: P_PCC(PeriodMaxP) <= SRQ_S0P + SRQ_Lambda(ax)*SRQ_ReqP + SRQ_RayTol;
			}
			Constraint SRQ_RayQlo {
				IndexDomain: ax | SRQ_RayOn and ord(ax) = 1;
				Definition: Q_PCC(PeriodMaxP) >= SRQ_S0Q + SRQ_Lambda(ax)*SRQ_ReqQ - SRQ_RayTol;
			}
			Constraint SRQ_RayQhi {
				IndexDomain: ax | SRQ_RayOn and ord(ax) = 1;
				Definition: Q_PCC(PeriodMaxP) <= SRQ_S0Q + SRQ_Lambda(ax)*SRQ_ReqQ + SRQ_RayTol;
			}
			MathematicalProgram SRQ_Ray {
				Objective: SRQ_Obj;
				Direction: minimize;
				Constraints: NotTobeExcluded_constraints;
				Variables: NotTobeExcluded_variables;
				Type: Automatic;
				Comment: "Largest fraction of the request that fits: every model constraint, the self-consumption rule (SCRefActive = 1) and PV curtailment (Option B) included.";
			}
			Parameter SRQ_CutCommit {
				IndexDomain: bat;
				Comment: "PV cut committed for the service slot, executed at slot 1 of the next step, p.u.";
			}
			Parameter PVC_Exec {
				IndexDomain: bat;
				Comment: "PV cut executed at slot 1 of the current step (= SRQ_CutCommit of the previous step when it carries a service), p.u.";
			}
			Parameter PVC_ExecT {
				IndexDomain: (bat,t);
				Definition: if ord(t) = 1 then PVC_Exec(bat) else 0 endif;
				Comment: "PVC_Exec placed at slot 1; enters Pbat and TotPcust like PVC_Cut does at the service slot.";
			}
			Parameter SRQ_Stage2 {
				Comment: "Runtime gate of the coordinated-P1 rows: 1 only around the second P1 solve.";
			}
			Parameter SRQ_ExpScale {
				Default: 1000;
				Comment: "Scale of the squared-export objective: exports in kW inside the square, divided by 1000 outside.";
			}
			Parameter SRQ_ImpRef1 {
				IndexDomain: (bat,t);
				Comment: "Import of each house in each slot in the first P1 solve, p.u. The second solve may not exceed it.";
			}
			Parameter SRQ_ThruRef1 {
				IndexDomain: bat;
				Comment: "Battery throughput (charge + discharge) over the window in the first P1 solve, p.u. The second solve may not exceed it, so it cannot burn energy in simultaneous cycling to cut exports.";
			}
			Parameter SRQ_Exp2Ref1;
			Parameter SRQ_Cyc {
				Comment: "Simultaneous charge and discharge in the last commitment solve, summed over the batteries, kW.";
			}
			Parameter SRQ_CycTol {
				Default: 0.5;
				Comment: "Largest simultaneous charge+discharge accepted in a commitment, kW over the feeder.";
			}
			Parameter SRQ_PSOC1 {
				IndexDomain: t;
			}
			Parameter SRQ_PBat1 {
				IndexDomain: t;
			}
			Parameter SRQ_PExp1 {
				IndexDomain: t;
			}
			Parameter SRQ_PImp1 {
				IndexDomain: t;
			}
			Parameter SRQ_PSOC2 {
				IndexDomain: t;
			}
			Parameter SRQ_PBat2 {
				IndexDomain: t;
			}
			Parameter SRQ_PExp2 {
				IndexDomain: t;
			}
			Parameter SRQ_PImp2 {
				IndexDomain: t;
			}
			StringParameter SRQ_PlanCSVName {
				Definition: "SRQ_plan" + RollFileSuffix + ".csv";
			}
			File SRQ_PlanCSV {
				Name: SRQ_PlanCSVName;
				Mode: append;
			}
			Parameter SRQ_SOCc {
				IndexDomain: bat;
				Comment: "SOC the next step starts from, clamped as BattSOCstart is (working).";
			}
			Parameter SRQ_Shave {
				Comment: "Energy shaved off committed set-points in the run, kWh (should be tolerance-sized).";
			}
			Parameter SRQ_ExecFail {
				Comment: "Committed services that could not be executed in the run (released, see EXECFAIL lines in SCT_info).";
			}
			Parameter SRQ_SunStart;
			Parameter SRQ_SunEnd {
				Comment: "Window slot (ord) of the last PV half-hour of the first sunny period in the window; 0 = no PV in the window.";
			}
			Parameter SRQ_SOCSun1 {
				IndexDomain: bat;
				Comment: "SOC of each battery at SRQ_SunEnd in the first P1 solve.";
			}
			Parameter SRQ_SOCEnd1 {
				IndexDomain: bat;
				Comment: "End-of-window SOC of each battery in the first P1 solve.";
			}
			Parameter SRQ_CapTolKW {
				Default: 0;
				Comment: "Tolerance of the coordinated-P1 caps, kW. 0: the step-1 plan satisfies its own caps exactly, and any slack is used by step 2 to export less by importing more (1e-4 kW gave +0.07 kWh over the window). Written in kW so the solver's feasibility tolerance (1e-6) is 1 mW per house and slot.";
			}
			Variable SRQ_Obj2 {
				Range: free;
			}
			Constraint SRQ_Obj2Def {
				IndexDomain: ax | SRQ_Stage2 and ord(ax) = 1;
				Definition: {
					sum((bat,t), (SRQ_ExpScale*ExportedPnode(BattBus(bat),BattPhase(bat),t))^2) / SRQ_ExpScale
					+ sum((bat,t), (SRQ_ExpScale*ZX_Cut(bat,t))^2) / SRQ_ExpScale
					+ BattThroughputPen*sum((bat,t), BattP_Chg(bat,t) + BattP_Dis(bat,t)) <= SRQ_Obj2
				}
				Comment: "Epigraph of the coordinated objective (convex quadratic, so the program stays a QCP).";
			}
			Constraint SRQ_ImpCap {
				IndexDomain: (bat,t) | SRQ_Stage2;
				Definition: 1000*TotPcust(BattBus(bat),BattPhase(bat),t) <= 1000*SRQ_ImpRef1(bat,t) + SRQ_CapTolKW;
			}
			Constraint SRQ_SunCap {
				IndexDomain: bat | SRQ_Stage2 and SRQ_SunEnd > 0;
				Definition: 1000*sum(t | ord(t) = SRQ_SunEnd, BattSOC(bat,t)) >= 1000*SRQ_SOCSun1(bat) - SRQ_CapTolKW;
				Comment: "Each battery is at least as charged as in step 1 at the end of the first sunny period of the window (today's by day, tomorrow's by night): step 2 re-times charging WITHIN that period and cannot push it to the next day. Without it, the batteries never filled (86 % at 16:00) and 30 kWh less PV was stored on the no-service day.";
			}
			Constraint SRQ_EndCap {
				IndexDomain: bat | SRQ_Stage2;
				Definition: 1000*sum(t | ord(t) = nPeriods, BattSOC(bat,t)) >= 1000*SRQ_SOCEnd1(bat) - SRQ_CapTolKW;
				Comment: "Each battery ends the window at least as charged as in step 1, so step 2 only re-times: without it, houses with spare energy sold it at night to make room for the next day (no-service day: +30 kWh exports, end SOC 35 % instead of 50 %).";
			}
			Constraint SRQ_ThruCap {
				IndexDomain: bat | SRQ_Stage2;
				Definition: 1000*sum(t, BattP_Chg(bat,t) + BattP_Dis(bat,t)) <= 1000*SRQ_ThruRef1(bat) + SRQ_CapTolKW;
			}
			MathematicalProgram SRQ_P1Coord {
				Objective: SRQ_Obj2;
				Direction: minimize;
				Constraints: NotTobeExcluded_constraints;
				Variables: NotTobeExcluded_variables;
				Type: Automatic;
				Comment: "Coordinated P1, step 2: same imports (or less) in every slot for every house, same throughput (or less), squared exports minimised.";
			}
			StringParameter SRQ_CSVName {
				Definition: "SRQ" + RollFileSuffix + ".csv";
			}
			File SRQ_CSV {
				Name: SRQ_CSVName;
				Mode: append;
			}
			StringParameter SRQ_P1CSVName {
				Definition: "SRQ_p1" + RollFileSuffix + ".csv";
			}
			File SRQ_P1CSV {
				Name: SRQ_P1CSVName;
				Mode: append;
			}
		}
		DeclarationSection FRQ_Declarations {
			Comment: {
				"FOR-FIRST TSO REQUESTS (2026-10-04, experiments/2026-10-04_for-requests). The TSO picks any point
				inside the published FOR; the set-points are the convex combination of the stored no-service and
				corner solutions with the point's weights (the recovery of the methodology draft). Inert unless
				SRQ_Mode = 2."
			}
			Parameter FRQ_PlanLog {
				Comment: "1 = log the window plan at every step (demonstration runs, SRQ_plan<tag>.csv).";
			}
			Parameter FRQ_SweepAll {
				Default: 1;
				Comment: "1 = sweep the FOR at every half-hour; 0 = only at half-hours with a TSO request (identical results: a FOR nobody uses changes nothing later).";
			}
			Parameter FRQ_U1 { IndexDomain: t; Comment: "Scenario: picks the triangle of the FOR by area (0-1), per REAL request period."; }
			Parameter FRQ_U2 { IndexDomain: t; Comment: "Scenario: distance from S0 inside the triangle (uniform over the area through sqrt)."; }
			Parameter FRQ_U3 { IndexDomain: t; Comment: "Scenario: position between the two corners."; }
			Parameter FRQ_Edge { IndexDomain: t; Comment: "Scenario: 1 = the point is on the FOR edge (V_i-V_next)."; }
			Parameter FRQ_VP { IndexDomain: ia; }
			Parameter FRQ_VQ { IndexDomain: ia; }
			Parameter FRQ_VOK { IndexDomain: ia; }
			Parameter FRQ_Chg { IndexDomain: (ia,bat); }
			Parameter FRQ_Dis { IndexDomain: (ia,bat); }
			Parameter FRQ_Qv { IndexDomain: (ia,bat); }
			Parameter FRQ_Cut { IndexDomain: (ia,bat); }
			Parameter FRQ_Chg0 { IndexDomain: bat; }
			Parameter FRQ_Dis0 { IndexDomain: bat; }
			Parameter FRQ_Q0 { IndexDomain: bat; }
			Parameter FRQ_S0P;
			Parameter FRQ_S0Q;
			Parameter FRQ_NextOrd { IndexDomain: ia; }
			Parameter FRQ_Area { IndexDomain: ia; }
			Parameter FRQ_AreaTot;
			Parameter FRQ_Off;
			Parameter FRQ_Cum;
			Parameter FRQ_Found;
			ElementParameter FRQ_I { Range: FOR_AngleSet; }
			ElementParameter FRQ_J { Range: FOR_AngleSet; }
			ElementParameter FRQ_Ilast { Range: FOR_AngleSet; }
			Parameter FRQ_U1v;
			Parameter FRQ_U2v;
			Parameter FRQ_U3v;
			Parameter FRQ_Edgev;
			Parameter FRQ_Sq;
			Parameter FRQ_A0;
			Parameter FRQ_A1;
			Parameter FRQ_A2;
			Parameter FRQ_RP;
			Parameter FRQ_RQ;
			Parameter FRQ_C { IndexDomain: bat; }
			Parameter FRQ_D { IndexDomain: bat; }
			Parameter FRQ_QQ { IndexDomain: bat; }
			Parameter FRQ_K { IndexDomain: bat; }
			Parameter FRQ_Net;
			Parameter FRQ_ShaveNow;
			Parameter FRQ_CutMin;
			Parameter FRQ_CycMin;
			StringParameter FRQ_StatMin;
			Parameter RollSvcQ_exec { IndexDomain: bat; }
			StringParameter FRQ_CSVName {
				Definition: "FRQ" + RollFileSuffix + ".csv";
			}
			File FRQ_CSV {
				Name: FRQ_CSVName;
				Mode: append;
			}
		}
		Procedure SCT_SolveCase {
			Arguments: (CaseAngle,CaseShrink,CasePin,CaseP,CaseQ);
			Body: {
				! rebuild the window exactly as the sweep does: data rotated, SOC from the carried state, slot 1
				! frozen at the committed dispatch
				empty allvariables;
				run Load_data_reset;
				P0(d,tt)        := P0raw(d, RollMap(tt));
				Q0(d,tt)        := Q0raw(d, RollMap(tt));
				GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
				Irradiance(tt)  := Irrraw(RollMap(tt));
				BattSOCini(bat) := BattSOCstart(bat);
				if SOCFloorOverride >= 0 then BattSOCmin(bat) := SOCFloorOverride; endif;
				BattP_Chg(bat,'1')        := RollChgExec(bat);
				BattP_Chg(bat,'1').nonvar := 1;
				BattP_Dis(bat,'1')        := RollDisExec(bat);
				BattP_Dis(bat,'1').nonvar := 1;
				if RollQAllSlots = 1 then Qinv(bat,'1') := RollQinvExec(bat); Qinv(bat,'1').nonvar := 1; endif;
				if RollSvcMode > 0 and RollSvcExec = 1 then
					Qinv(bat,'1')        := RollSvcQ(bat);
					Qinv(bat,'1').nonvar := 1;
				endif;
				SCT_PinP  := CaseP;
				SCT_PinQ  := CaseQ;
				SCT_PinOn := CasePin;
				solve MinImports
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       method     := 'deterministic concurrent',
					       time_limit := 3000;
				SCT_Stat := MinImports.ProgramStatus;
				SCT_Time := MinImports.SolutionTime;
				if SCT_Stat <> 'Optimal' and SCT_Stat <> 'LocallyOptimal' then
					solve MinImports
						where  MIP_Relative_Optimality_Tolerance := 0.01,
						       method              := 'deterministic concurrent',
						       numeric_focus       := 3,
						       barrier_homogeneous := 1,
						       time_limit          := 3000;
					SCT_Stat := MinImports.ProgramStatus;
					SCT_Time := SCT_Time + MinImports.SolutionTime;
				endif;
				SCT_PVCcut := 1000*sum((bat,tGMP), PVC_Cut(bat,tGMP));
				if SCT_Stat = 'Optimal' or SCT_Stat = 'LocallyOptimal' then
					SCT_ImpFut  := 1000*DeltaT*sum((bat,tGMP) | ord(tGMP) > PeriodMaxP, ImportedPnode(BattBus(bat),BattPhase(bat),tGMP));
					SCT_ExpFut  := 1000*DeltaT*sum((bat,tGMP) | ord(tGMP) > PeriodMaxP, ExportedPnode(BattBus(bat),BattPhase(bat),tGMP));
					SCT_OFfut   := sum((bat,tGMP) | ord(tGMP) > PeriodMaxP,
					                   w2(tGMP)*( ImportedPnode(BattBus(bat),BattPhase(bat),tGMP)
					                             + ExpWeight(tGMP)*ExportedPnode(BattBus(bat),BattPhase(bat),tGMP) ));
					SCT_RealP   := P_PCC(PeriodMaxP);
					SCT_RealQ   := Q_PCC(PeriodMaxP);
					SCT_SOC2    := sum(bat, BattSOC(bat,PeriodMaxP)) / max(1, sum(bat, 1));
					SCT_SOCend  := sum(bat, BattSOC(bat,Element(Time,nPeriods))) / max(1, sum(bat, 1));
					SCT_SOCmin  := min((bat,tGMP) | ord(tGMP) >= PeriodMaxP, BattSOC(bat,tGMP));
					SCT_NFloor  := sum(bat | min(tGMP | ord(tGMP) >= PeriodMaxP, BattSOC(bat,tGMP)) <= BattSOCmin(bat) + 1e-3, 1);
					SCT_NFloor2 := sum(bat | BattSOC(bat,PeriodMaxP) <= BattSOCmin(bat) + 1e-3, 1);
					! per prosumer: 'P1 is not compromised' means no prosumer buys more later, in total or in any slot
					SCT_ImpSlot(bat,tGMP) := if ord(tGMP) > PeriodMaxP then 1000*DeltaT*ImportedPnode(BattBus(bat),BattPhase(bat),tGMP) else 0 endif;
					SCT_ImpBat(bat)       := sum(tGMP, SCT_ImpSlot(bat,tGMP));
					if CaseAngle = -1 then
						SCT_ImpBatRef(bat)       := SCT_ImpBat(bat);
						SCT_ImpSlotRef(bat,tGMP) := SCT_ImpSlot(bat,tGMP);
					endif;
					SCT_ImpBatMax  := max(bat, SCT_ImpBat(bat) - SCT_ImpBatRef(bat));
					SCT_NBatReg    := sum(bat | SCT_ImpBat(bat) - SCT_ImpBatRef(bat) > 0.01, 1);
					SCT_ImpSlotMax := max((bat,tGMP) | ord(tGMP) > PeriodMaxP, SCT_ImpSlot(bat,tGMP) - SCT_ImpSlotRef(bat,tGMP));
				else
					SCT_ImpFut := 0;  SCT_ExpFut := 0;  SCT_OFfut := 0;  SCT_RealP := 0;  SCT_RealQ := 0;
					SCT_SOC2   := 0;  SCT_SOCend := 0;  SCT_SOCmin := 0; SCT_NFloor := 0; SCT_NFloor2 := 0;
					SCT_ImpBatMax := 0;  SCT_NBatReg := 0;  SCT_ImpSlotMax := 0;
					if CaseAngle = -1 then SCT_ImpBatRef(bat) := 0; SCT_ImpSlotRef(bat,tGMP) := 0; endif;
				endif;
				! ---- second re-plan, IMPORTS FIRST: same pin, exports weighted by SCT_IPExp only (tie-break). It measures the
				! ---- least the prosumers must still buy later, i.e. whether a plan with no extra purchase still EXISTS -
				! ---- independent of the import-vs-export trade P1's own objective is willing to make.
				SCT_StatIP := "skipped";  SCT_ImpFutIP := 0;  SCT_ImpBatMaxIP := 0;  SCT_NBatRegIP := 0;  SCT_ImpSlotMaxIP := 0;
				if SCT_DualReplan = 1 then
					P1ExpScale := SCT_IPExp;
					SCT_FlatW  := 1;
					solve MinImports
						where  MIP_Relative_Optimality_Tolerance := 0.01,
						       method     := 'deterministic concurrent',
						       time_limit := 3000;
					SCT_StatIP := MinImports.ProgramStatus;
					if SCT_StatIP <> 'Optimal' and SCT_StatIP <> 'LocallyOptimal' then
						solve MinImports
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       method              := 'deterministic concurrent',
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 3000;
						SCT_StatIP := MinImports.ProgramStatus;
					endif;
					P1ExpScale := 1;
					SCT_FlatW  := 0;
					if SCT_StatIP = 'Optimal' or SCT_StatIP = 'LocallyOptimal' then
						SCT_ImpSlot(bat,tGMP) := if ord(tGMP) > PeriodMaxP then 1000*DeltaT*ImportedPnode(BattBus(bat),BattPhase(bat),tGMP) else 0 endif;
						SCT_ImpBat(bat)       := sum(tGMP, SCT_ImpSlot(bat,tGMP));
						SCT_ImpFutIP          := sum(bat, SCT_ImpBat(bat));
						if CaseAngle = -1 then
							SCT_ImpBatRefIP(bat)       := SCT_ImpBat(bat);
							SCT_ImpSlotRefIP(bat,tGMP) := SCT_ImpSlot(bat,tGMP);
						endif;
						SCT_ImpBatMaxIP  := max(bat, SCT_ImpBat(bat) - SCT_ImpBatRefIP(bat));
						SCT_NBatRegIP    := sum(bat | SCT_ImpBat(bat) - SCT_ImpBatRefIP(bat) > 0.01, 1);
						SCT_ImpSlotMaxIP := max((bat,tGMP) | ord(tGMP) > PeriodMaxP, SCT_ImpSlot(bat,tGMP) - SCT_ImpSlotRefIP(bat,tGMP));
					elseif CaseAngle = -1 then
						SCT_ImpBatRefIP(bat) := 0;  SCT_ImpSlotRefIP(bat,tGMP) := 0;
					endif;
				endif;
				SCT_PinOn := 0;
				put SCT_CSV;
				put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_SCWeight:8:4, ",",
				    CaseAngle:6:1, ",", CaseShrink:6:3, ",", CaseP:14:8, ",", CaseQ:14:8, ",",
				    SCT_RealP:14:8, ",", SCT_RealQ:14:8, ",", SCT_Stat, ",", SCT_Time:10:2, ",",
				    SCT_ImpFut:14:6, ",", SCT_ExpFut:14:6, ",", SCT_OFfut:14:8, ",",
				    SCT_SOC2:10:6, ",", SCT_SOCmin:10:6, ",", SCT_NFloor:4:0, ",", SCT_NFloor2:4:0, ",",
				    SCT_SOCend:10:6, ",", SCT_BaseP:14:8, ",", SCT_BaseQ:14:8, ",",
				    SCT_ImpBatMax:12:6, ",", SCT_NBatReg:4:0, ",", SCT_ImpSlotMax:12:6, ",",
				    SCT_StatIP, ",", SCT_ImpFutIP:14:6, ",", SCT_ImpBatMaxIP:12:6, ",", SCT_NBatRegIP:4:0, ",", SCT_ImpSlotMaxIP:12:6, ",", SCT_PVCcut:12:6 / ;
				putclose SCT_CSV;
			}
			Comment: "One regret re-plan: MinImports with slot 1 frozen and, if CasePin = 1, the service-slot PCC point pinned to (CaseP, CaseQ). Appends one row to SCT_regret<suffix>.csv.";
			Parameter CaseAngle {
				Property: Input;
			}
			Parameter CaseShrink {
				Property: Input;
			}
			Parameter CasePin {
				Property: Input;
			}
			Parameter CaseP {
				Property: Input;
			}
			Parameter CaseQ {
				Property: Input;
			}
		}
		Procedure SCT_TypeCheck {
			Body: {
				! Proof, written once per run, that the programs really are QCPs solved by CPLEX, with the exact
				! (non-linearized) fidelity switches in force. Generated on the model state SCT_SolveCase just set up.
				SCT_Info.PageWidth := 32767;
				put SCT_Info;
				SCT_GMP    := GMP::Instance::Generate( MinImports, "SCT_type_MinImports" );
				SCT_MPType := GMP::Instance::GetMathematicalProgrammingType( SCT_GMP );
				SCT_Solver := GMP::Instance::GetSolver( SCT_GMP );
				put "MinImports     (baseline + regret re-plans) : type ", SCT_MPType, "   solver ", SCT_Solver / ;
				GMP::Instance::Delete( SCT_GMP );
				FOR_Lambda := 1;
				SCT_GMP    := GMP::Instance::Generate( FOR_VertexCont, "SCT_type_FORVertexCont" );
				SCT_MPType := GMP::Instance::GetMathematicalProgrammingType( SCT_GMP );
				SCT_Solver := GMP::Instance::GetSolver( SCT_GMP );
				put "FOR_VertexCont (directional sweep)          : type ", SCT_MPType, "   solver ", SCT_Solver / ;
				GMP::Instance::Delete( SCT_GMP );
				put "FOR_PolyS ", FOR_PolyS:2:0, "   FOR_LinearizeVmax ", FOR_LinearizeVmax:2:0, "   RollLinearized ", RollLinearized:2:0,
				    "   IncludeNetworkConstraints ", IncludeNetworkConstraints:2:0, "   IncludeQforMaxP ", IncludeQforMaxP:2:0 / ;
				put "AllowChargeAtPmax ", AllowChargeAtPmax:2:0, "   RollCyclicSOC ", RollCyclicSOC:2:0, "   CyclicSOCBand ", CyclicSOCBand:6:3,
				    "   PeriodMaxP ", PeriodMaxP:3:0, "   nPeriods ", nPeriods:3:0 / ;
				put "BattThroughputPen ", BattThroughputPen:6:3, "   FOR_ThruPenSlot ", FOR_ThruPenSlot:6:3, "   FOR_SCWeight ", FOR_SCWeight:8:4, "   FOR_SCExpWeight ", FOR_SCExpWeight:4:2, "   SCT_Hard ", SCT_Hard:2:0, "   SCT_Regret ", SCT_Regret:2:0, "   SCT_FeasTol ", SCT_FeasTol, "   SCT_BarTol ", SCT_BarTol, "   RollSweepFrom ", RollSweepFrom:3:0, "   SCT_DualReplan ", SCT_DualReplan:2:0, "   SCT_IPExp ", SCT_IPExp:6:3, "   P1ExpScale ", P1ExpScale:4:2, "   RollSvcMode ", RollSvcMode:2:0, "   RollSvcAngle ", RollSvcAngle:5:0, "   RollSvcRho ", RollSvcRho:5:2, "   SCFirst ", SCFirst:2:0, "   SCAlpha ", SCAlpha:6:3,
				    "   FairMode ", FairMode:2:0, "   RollUseGMP ", RollUseGMP:2:0, "   UseBattComp ", UseBattComp:2:0,
					    "   PVC_On ", PVC_On:2:0, "   PVC_Mode ", PVC_Mode:2:0, "   PVC_SweepPen ", PVC_SweepPen:8:4, "   PVC_ReplanPen ", PVC_ReplanPen:8:2 / ;
				put "batteries in the model ", (sum(bat, 1)):5:0, "   DetailTagCSV ", DetailTagCSV, "   DetailLoadPattern ", DetailLoadPattern / ;
				putclose SCT_Info;
				SCT_Checked := 1;
			}
		}
		Procedure SCT_UseCPLEX {
			Body: {
				SCT_Solver := StringToElement( AllSolvers, "CPLEX 22.1" );
				if SCT_Solver = '' then
					halt with "CPLEX 22.1 is not available in this AIMMS - refusing to run the SC-safe test on another solver.";
				endif;
				CurrentSolver('QCP') := SCT_Solver;
				CurrentSolver('QP')  := SCT_Solver;
				CurrentSolver('LP')  := SCT_Solver;
			}
			Comment: "Pin CPLEX 22.1 for the QCP/QP/LP program types before any SC-safe run.";
		}
		Procedure FairLogCorner {
			Body: {
				! one row per non-empty group for the direction just collected. A direction that did not solve gets its status and
				! empty columns: on the async path its solution never reaches the model, so the levels would be another direction's.
				! A criterion column is written only for its own criterion (empty otherwise): with no rows, the factors are 0 and
				! the column would report max |DeltaP| instead of a distance from the criterion. cp_spread is always written.
				put FOR_RollCritCSV;
				for (a | sum( bat | FairGroup(bat) = a, 1 ) > 0) do
					put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",", FairCrit:2:0, ",", FairScope:2:0, ",",
					    FairEps:6:3, ",", FairBox:2:0, ",", FOR_ThruPenSlot:6:3, ",", FOR_StatCur, ",";
					if FairScope = 2 then put "ALL,"; else put a:8, ","; endif;
					if FOR_StatCur <> 'Optimal' and FOR_StatCur <> 'LocallyOptimal' then
						put (sum( bat | FairGroup(bat) = a, 1 )):4:0, ",,,,,,,,,,,,,,," / ;
					else
						put (sum( bat | FairGroup(bat) = a, 1 )):4:0, ",",
						    (1000*sum( bat | FairGroup(bat) = a, BattP_Balance(bat,PeriodMaxP) - FairPsc(bat) )):14:6, ",",
						    (1000*sum( bat | FairGroup(bat) = a, FairUGen(bat) )):14:6, ",",
						    (1000*sum( bat | FairGroup(bat) = a, FairDGen(bat) )):14:6, ",";
						if FairCrit = 1 then put FairZcp(a):12:8, ",,,"; endif;
						if FairCrit = 2 or FairCrit = 3 then put ",", FairZu(a):12:8, ",", FairZd(a):12:8, ","; endif;
						if FairCrit = 0 then put ",,,"; endif;
						put (0.5*( max( bat | FairGroup(bat) = a, (BattP_Balance(bat,PeriodMaxP) - FairPsc(bat))/max(BattMaxP(bat), 1e-9) )
						         - min( bat | FairGroup(bat) = a, (BattP_Balance(bat,PeriodMaxP) - FairPsc(bat))/max(BattMaxP(bat), 1e-9) ) )):12:8, ",";
						if FairCrit = 1 then
							put (max( bat | FairGroup(bat) = a, abs( (BattP_Balance(bat,PeriodMaxP) - FairPsc(bat))/max(BattMaxP(bat), 1e-9) - FairZcp(a) ) )):12:8, ",";
						else
							put ",";
						endif;
						if FairCrit = 2 then
							put (1000*max( bat | FairGroup(bat) = a, abs( BattP_Balance(bat,PeriodMaxP) - FairPsc(bat) - ( FairUGen(bat)*FairZu(a) - FairDGen(bat)*FairZd(a) ) ) )):12:8, ",";
						else
							put ",";
						endif;
						if FairCrit = 3 then
							put (1000*max( bat | FairGroup(bat) = a, max( 0, max( BattP_Balance(bat,PeriodMaxP) - FairPsc(bat) - ( FairUGen(bat)*FairZu(a) - FairDGen(bat)*FairZd(a) ) - FairEps*FairUGen(bat),
							                                           ( FairUGen(bat)*FairZu(a) - FairDGen(bat)*FairZd(a) ) - ( BattP_Balance(bat,PeriodMaxP) - FairPsc(bat) ) - FairEps*FairDGen(bat) ) ) )):12:8, ",";
						else
							put ",";
						endif;
						put (1000*max( bat | FairGroup(bat) = a, max( 0, BattP_Balance(bat,PeriodMaxP) - FairPsc(bat) - FairUGen(bat) ) )):12:8, ",",
						    (1000*max( bat | FairGroup(bat) = a, max( 0, -FairDGen(bat) - ( BattP_Balance(bat,PeriodMaxP) - FairPsc(bat) ) ) )):12:8, ",",
						    (sum( bat | FairGroup(bat) = a and min( BattP_Chg(bat,PeriodMaxP), BattP_Dis(bat,PeriodMaxP) ) > 1e-6, 1 )):4:0, ",",
						    (1000*sum( bat | FairGroup(bat) = a, min( BattP_Chg(bat,PeriodMaxP), BattP_Dis(bat,PeriodMaxP) ) )):12:6, ",",
						    (1000*sum( bat | FairGroup(bat) = a, BattP_Chg(bat,PeriodMaxP) + BattP_Dis(bat,PeriodMaxP) )):12:6 / ;
					endif;
				endfor;
				if RollFlushCSV = 1 then putclose FOR_RollCritCSV; endif;
			}
			Comment: "PAPER-1 FAIRNESS log (FOR_RollCritCSV), called after every collected direction on both sweep paths. Columns: summed contribution and headrooms (kW); the factors of the active criterion (zcp under CP, zu and zd under HP/HB, empty otherwise); cp_spread = half the range of DeltaP/BattMaxP over the group = the smallest max|DeltaP/BattMaxP - zeta| over zeta (0 under CP; for the reference FOR, its distance from CP); cp_dev_max (CP only, 0 expected); rule_res_max_kW (HP only, 0 expected); hb_viol_max_kW (HB only, 0 expected); box violations (0 with FairBox = 1); n_cyc / cyc_kW = batteries charging and discharging at once in slot 2 above 1 W and the cycled power (with kappa = 0.2 a remaining cycle is slot-2 energy disposal that pays: a corner where the region may be optimistic); thr_kW = the group's slot-2 throughput (the kappa term of the objective is FOR_ThruPenSlot times its sum over groups).";
		}
		Procedure FairClipLog {
			Body: {
				! baselines outside the envelope the sweep actually uses (snapshots FairPchGen/FairPdisGen): the [.]^+ of U or D
				! clips there, the only visible sign of a phantom baseline (e.g. a network-forced P1 re-solve that cycles)
				FairClipU   := sum( bat | FairPsc(bat) > FairPchGen(bat) + 1e-6, 1 );
				FairClipD   := sum( bat | -FairPsc(bat) > FairPdisGen(bat) + 1e-6, 1 );
				FairClipMax := 1000*max( bat, max( 0, max( FairPsc(bat) - FairPchGen(bat), -FairPsc(bat) - FairPdisGen(bat) ) ) );
				if FairLogOn = 1 and SCT_On = 1 and FairClipU + FairClipD > 0 then
					put SCT_Info;
					put "FAIRCLIP at step ", RollNow:3:0, ": slot-2 baseline above the charging envelope ", FairClipU:4:0,
					    ", above the discharging envelope ", FairClipD:4:0, ", largest excess ", FairClipMax:10:6, " kW" / ;
					putclose SCT_Info;
				endif;
			}
			Comment: "PAPER-1 FAIRNESS diagnostic, called where FairUGen/FairDGen are snapshotted (before the GMP sweep instance is generated; before the first direction on the sequential path). Threshold 1e-6 p.u. = 1 W: P1 meets the SOC ceiling to solver tolerance (overshoots up to ~0.5 W), which is not a phantom baseline.";
		}
		Procedure SCT_RunBed {
			Arguments: (Tag,Pattern);
			Body: {
				! one TR9 rolling day with the production sweep settings of RunTrafoFOR: Pattern "" = full TR9 (90
				! batteries), "_two" = micro bed (TR9_two, 12 batteries)
				run SCT_UseCPLEX;
				ReduceNetwork     := if SCT_Trafo = "ALL" then 0 else 1 endif;   ! WHOLE FEEDER RUNNER (2026-10-09): "ALL" = full network, every battery
				DetailTagCSV      := if SCT_Trafo = "" then "TR9" elseif SCT_Trafo = "ALL" then "" else SCT_Trafo endif;
				DetailLoadPattern := Pattern;
				UseBattComp       := 0;
				FOR_ThruPenSlot   := if P2SlotPen >= 0 then P2SlotPen else 0.2 endif;   ! kappa = 0.2 stays with the headroom box (see FairnessPaper1); P2SlotPen only for tests
				RollFileSuffix    := Tag;
				SCT_On            := 1;
				SCT_Checked       := 0;
				if FileExists( SCT_CSVName ) then FileDelete( SCT_CSVName ); endif;
				SCT_CSV.PageWidth := 32767;
				put SCT_CSV;
				put "now,target,kappa,angle_deg,shrink,pin_P,pin_Q,real_P,real_Q,status,time,imp_fut_kWh,exp_fut_kWh,of_fut,",
				    "soc2_mean,soc_min,n_floor_window,n_floor_slot2,soc_end_mean,base_P,base_Q,",
				    "imp_bat_max_kWh,n_bat_regret,imp_slot_max_kWh,status_ip,imp_fut_ip_kWh,imp_bat_max_ip_kWh,n_bat_regret_ip,imp_slot_max_ip_kWh,pvc_cut_kW" / ;
				putclose SCT_CSV;
				if SCT_PlanDump = 1 then
					if FileExists( SCT_PlanCSVName ) then FileDelete( SCT_PlanCSVName ); endif;
					SCT_PlanCSV.PageWidth := 32767;
					put SCT_PlanCSV;
					put "now,angle_deg,battery,slot,soc,net_kW,imp_ref_kW" / ;
					putclose SCT_PlanCSV;
				endif;
				if FileExists( SCT_ExecCSVName ) then FileDelete( SCT_ExecCSVName ); endif;
				SCT_ExecCSV.PageWidth := 32767;
				put SCT_ExecCSV;
				put "now,battery,svc,base_status,soc_start,imp1_kWh,exp1_kWh,imp_plan_fut_kWh,batt1_kWh,cut1_kWh,pv1_kWh,zx_cut1_kWh,zx_cap1_kWh" / ;
				putclose SCT_ExecCSV;
				if FileExists( SCT_InfoName ) then FileDelete( SCT_InfoName ); endif;
				SCT_Info.PageWidth := 32767;
				put SCT_Info;
				put "SC-safe test ", Tag, "   started ", CurrentToString("%c%y-%m-%d %H:%M:%S"),
				    "   kappa ", FOR_SCWeight:8:4, "   shrink points ", SCT_nShrink:3:0, "   RollMaxPeriods ", RollMaxPeriods:3:0 / ;
				put "FAIR settings: FairCrit ", FairCrit:2:0, "   FairScope ", FairScope:2:0, "   FairEps ", FairEps:6:3, "   FairBox ", FairBox:2:0, "   FairAllowNoBox ", FairAllowNoBox:2:0, "   kappa_slot (FOR_ThruPenSlot) ", FOR_ThruPenSlot:6:3, "   P2SlotPen ", P2SlotPen:6:3, "   FairMode ", FairMode:2:0 / ;
				putclose SCT_Info;
				run RunFOR_Rolling;
				put SCT_Info;
				put "finished ", CurrentToString("%c%y-%m-%d %H:%M:%S") / ;
				putclose SCT_Info;
				SCT_On            := 0;
				FOR_ThruPenSlot   := 0;
				DetailLoadPattern := "";
				RollFileSuffix    := "";
			}
			StringParameter Tag {
				Property: Input;
			}
			StringParameter Pattern {
				Property: Input;
			}
		}
		Procedure SCT_KappaRun {
			Arguments: (Kappa,ExpShare,Tag,Pattern);
			Body: {
				! regret at the vertices only (s = 0.99) for one kappa
				FOR_SCWeight    := Kappa;
				FOR_SCExpWeight := ExpShare;
				SCT_nShrink     := 1;
				SCT_Shrink('1') := 0.99;
				SCT_RunBed( Tag, Pattern );
				FOR_SCWeight    := 0;
				FOR_SCExpWeight := 1;
			}
			Parameter Kappa {
				Property: Input;
			}
			Parameter ExpShare {
				Property: Input;
			}
			StringParameter Tag {
				Property: Input;
			}
			StringParameter Pattern {
				Property: Input;
			}
		}
		Procedure SCT_Micro_Smoke {
			Body: {
				FOR_SCWeight    := 0;
				SCT_nShrink     := 2;
				SCT_Shrink('1') := 0.99;
				SCT_Shrink('2') := 0.5;
				RollMaxPeriods  := 3;
				SCT_RunBed( "_SCT_micro_smoke", "_two" );
				RollMaxPeriods  := 0;
			}
			Comment: "Machinery check: 3 periods, kappa 0, pins at s = 0.99 and 0.5.";
		}

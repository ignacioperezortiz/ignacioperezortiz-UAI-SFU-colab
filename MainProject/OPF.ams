		Procedure RunMicro_GMP_L2_Smoke {
			Body: {
				! SMOKE TEST del camino de m=2 con GMP. Existe porque la desactivacion de filas de
				! fairness usa el indice de AGREGADORES (a) para m=2/m=4 y el de BATERIAS (bat) para
				! m=1/m=3: son ramas distintas y la de agregadores nunca se ejecuto. ~10 min en el banco
				! micro, contra las ~4 h que costaria descubrir el fallo dentro de la cadena de TR9.
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "_two";
				UseBattComp       := 0;
				FairMode := 2;
				RollUseGMP := 0;  RollGMPBaseline := 0;  RollFileSuffix := "_mL2ref";
				run RunFOR_Rolling;
				RollUseGMP := 1;  RollGMPBaseline := 1;  RollFileSuffix := "_mL2gmp";
				run RunFOR_Rolling;
				FairMode := 0;  RollUseGMP := 0;  RollGMPBaseline := 0;
				RollFileSuffix := "";  DetailLoadPattern := "";
			}
			Comment: "SMOKE TEST del camino m=2 con GMP sobre el banco micro (~10 min). Valida la rama de desactivacion de filas indexada por AGREGADOR, que m=1 no ejercita. Escribe FOR_rolling_mL2ref.csv y FOR_rolling_mL2gmp.csv.";
		}
		Procedure RunTR9_GMP_Chain {
			Body: {
				! CADENA DE VALIDACION: los tres criterios medidos de TR9, uno tras otro, con GMP.
				! Cada uno tiene referencia historica en el repo, asi que las tres dan A/B:
				!   FOR_rolling_TR9_gmp.csv       vs FOR_rolling_TR9.csv
				!   FOR_rolling_TR9_gmpL1.csv     vs FOR_rolling_TR9_fairL1.csv
				!   FOR_rolling_TR9_gmpL2.csv     vs FOR_rolling_TR9_fairL2.csv
				! ~11 h. m=3 y m=4 quedan fuera a proposito: no tienen referencia de TR9 y m=3 es
				! infactible en algunos periodos, lo que mezclaria validar la migracion con explorar
				! un criterio nuevo.
				UseBattComp       := 0;
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;

				FairMode := 0;   RollFileSuffix := "_TR9_gmp";    run RunFOR_Rolling;
				FairMode := 1;   RollFileSuffix := "_TR9_gmpL1";  run RunFOR_Rolling;
				FairMode := 2;   RollFileSuffix := "_TR9_gmpL2";  run RunFOR_Rolling;

				FairMode          := 0;
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
				RollFileSuffix    := "";
			}
			Comment: "CADENA DE VALIDACION de la migracion GMP sobre TR9 produccion: FairMode 0, 1 y 2 uno tras otro, ~11 h. Escribe FOR_rolling_TR9_gmp / _gmpL1 / _gmpL2 (mas sus CSV de SOC y de fairness), sin tocar las referencias. Los tres se comparan con scripts/compare_FOR_runs.py contra FOR_rolling_TR9.csv, _fairL1 y _fairL2.";
		}
		Procedure RunTR9_GMP {
			Body: {
				! A/B PARTNER of RunTR9: the same production run with the sweep matrix generated once per
				! period instead of once per direction. Writes FOR_rolling_TR9_gmp.csv and
				! FOR_rolling_soc_TR9_gmp.csv, so the reference files are left untouched.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR9.csv FOR_rolling_TR9_gmp.csv
				! 48 periods x 12 directions = 576 vertices, against the 36 of the preflight A/B. This is
				! the full-coverage check of the migration, and unlike the preflight it exercises the SOC
				! carry-forward between periods.
				! Cuerpo de RunTrafoFOR replicado a proposito: alli el argumento fija a la vez el tag de
				! reduccion de red y el sufijo de archivo, y aca hacen falta distintos - la red es TR9,
				! la salida no debe pisar FOR_rolling_TR9.csv.
				UseBattComp       := 0;
				RollFileSuffix    := "_TR9_gmp";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "A/B PARTNER of RunTR9: same case with RollUseGMP=1, so the sweep generates one matrix per period and rewrites only the two objective coefficients per direction. 576 vertices -> FOR_rolling_TR9_gmp.csv. Compare against FOR_rolling_TR9.csv with scripts/compare_FOR_runs.py; the invariant is proj, not P/Q. Exercises the SOC carry-forward, which the 3-slot preflight A/B does not.";
		}
		Procedure RunTR1_GMP {
			Body: {
				! A/B PARTNER of RunTR1: the same production run with the sweep matrix generated once per
				! period instead of once per direction. Writes FOR_rolling_TR1_gmp.csv and
				! FOR_rolling_soc_TR1_gmp.csv, so the reference files are left untouched.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR1.csv FOR_rolling_TR1_gmp.csv
				! Clone of RunTR9_GMP with only the tag and the file suffix changed. See that procedure
				! for why the body of RunTrafoFOR is replicated here instead of being called.
				UseBattComp       := 0;
				RollFileSuffix    := "_TR1_gmp";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR1";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "A/B PARTNER of RunTR1: same case with RollUseGMP=1, so the sweep generates one matrix per period and rewrites only the two objective coefficients per direction. 576 vertices -> FOR_rolling_TR1_gmp.csv. Compare against FOR_rolling_TR1.csv with scripts/compare_FOR_runs.py; the invariant is proj, not P/Q. Clone of RunTR9_GMP.";
		}
		Procedure RunTR2_GMP {
			Body: {
				! A/B PARTNER of RunTR2: the same production run with the sweep matrix generated once per
				! period instead of once per direction. Writes FOR_rolling_TR2_gmp.csv and
				! FOR_rolling_soc_TR2_gmp.csv, so the reference files are left untouched.

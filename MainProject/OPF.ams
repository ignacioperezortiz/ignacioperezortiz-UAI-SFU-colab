		Procedure SCT_Micro_SC1_Hard_Tight {
			Body: {
				SCFirst := 1;  SCAlpha := 0;
				SCT_FeasTol := 1e-6;  SCT_BarTol := 1e-6;  RollSweepFrom := 36;
				SCT_KappaRun( 0, 1, "_SCT_micro_sc1hard_tight", "_two" );
				SCT_FeasTol := 0;  SCT_BarTol := 0;  RollSweepFrom := 0;
				SCFirst := 0;
			}
			Comment: "Tolerance test, no hole + P1 as constraint: feasibility and barrier tolerance 1e-6, sweep + regret from period 36 (the evening window where the residuals sit).";
		}
		Procedure SCT_Micro_KI100_Tight {
			Body: {
				SCT_FeasTol := 1e-6;  SCT_BarTol := 1e-6;  RollSweepFrom := 36;
				SCT_KappaRun( 1, 0, "_SCT_micro_ki100_tight", "_two" );
				SCT_FeasTol := 0;  SCT_BarTol := 0;  RollSweepFrom := 0;
			}
			Comment: "Tolerance test, imports-only weights k=1: feasibility and barrier tolerance 1e-6, sweep + regret from period 36 (the evening window where the residuals sit).";
		}
		Procedure SCT_TR4W_Prod {
			Body: {
				SCT_Trafo := "TR4";  RollOfferLog := 1;  SCT_PlanDump := 1;  SCT_PlanSteps := "2,24,38";
				SCT_KappaRun( 0, 1, "_TR4W_prod", "" );
				SCT_Trafo := "";  RollOfferLog := 0;  SCT_PlanDump := 0;
			}
			Comment: "TR4 walk-through, production setup (hole in P1, no protection): regret + per-prosumer offer log + plans at 01:00, 12:00, 19:00.";
		}

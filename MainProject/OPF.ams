				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "A/B PARTNER of RunTR2: same case with RollUseGMP=1, so the sweep generates one matrix per period and rewrites only the two objective coefficients per direction. 576 vertices -> FOR_rolling_TR2_gmp.csv. Compare against FOR_rolling_TR2.csv with scripts/compare_FOR_runs.py; the invariant is proj, not P/Q. Clone of RunTR9_GMP.";
		}
		Procedure RunTR3_GMP {
			Body: {
				! A/B PARTNER of RunTR3: the same production run with the sweep matrix generated once per
				! period instead of once per direction. Writes FOR_rolling_TR3_gmp.csv and
				! FOR_rolling_soc_TR3_gmp.csv, so the reference files are left untouched.

		Procedure RunFOR_Rolling_PerTrafo {
			Body: {
				! PER-TRANSFORMER rolling FOR. For each TRk: keep TRk detailed, lump every other transformer
				! as a passive MV load (its batteries dropped), keep the shared MV feeder, run the 48-step
				! rolling FOR -> FOR_rolling_<tag>.csv / FOR_rolling_soc_<tag>.csv. Combine in post-processing
				! (Minkowski sum about the all-passive baseline).
				showprogresswindow;
				option disable_new_mathprog_generator := 0;   ! NEW generator (exact QCP); RunFOR_Rolling re-pins it anyway
				! capture the transformer universe ONCE on the full feeder, before any reduction
				nPeriods                  := 48;     ! must precede the capture Load_data_dsn (fresh process has no inherited state)
				IncludeNetworkConstraints := 1;
				ReduceNetwork     := 0;
				DetailLoadPattern := "";
				RollFileSuffix    := "";
				empty Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				run Load_data_dsn;
				TrLabel(tr) := FormatString("%e", tr);
				TrTag(tr)   := SubString(TrLabel(tr), 7, StringLength(TrLabel(tr)));
				PerTrafoN   := card(Trafos);
				for (tr) do
					PerTrafoTag(Element(PerTrafoIdx, ord(tr))) := TrTag(tr);
				endfor;
				! one full rolling run per transformer (stable integer loop; Trafos is shrunk inside)
				! RESUME LIST: put already-completed tags in the string below (e.g. ",TR1,TR2,") to skip them
				! when resuming after an interruption. "," = do all.
				for (pti) do
					if FindString(",", "," + PerTrafoTag(pti) + ",") = 0 then
						RollFileSuffix := "_" + PerTrafoTag(pti);
						ReduceNetwork  := 1;
						DetailTagCSV   := PerTrafoTag(pti);
						run RunFOR_Rolling;
					endif;
				endfor;
				! defensive reset to full-feeder defaults
				ReduceNetwork  := 0;
				DetailTagCSV   := "";
				RollFileSuffix := "";
			}
			Comment: "PER-TRANSFORMER PRODUCTION: loops all transformers, each TRk detailed + others lumped passive, writing FOR_rolling_<tag>.csv / FOR_rolling_soc_<tag>.csv. Validate plumbing first with RunTR9.";
		}
		Procedure RunFOR_Rolling_Baseline {
			Body: {
				! ALL-IDLE BASELINE trajectory B(t): full feeder, every battery fixed to zero P and Q.
				! This is the PCC point with no flexibility anywhere; needed to combine the per-transformer
				! FORs (Minkowski sum about B). Cheap: with batteries fixed there is no optimization, just a
				! determined linearized power flow. Writes FOR_rolling_baseline.csv (period,P,Q,status).
				showprogresswindow;
				option disable_new_mathprog_generator := 0;   ! NEW generator for the exact quadratic constraints (see RunFOR_Rolling)
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 0;
				nPeriods                  := 48;
				ReduceNetwork             := 1;     ! reduced net still carries the FULL passive load -> all-idle PCC ~ true B, and is tractable (full feeder is not)
				DetailLoadPattern         := "";
				DetailTagCSV              := "TR9";
				RollFileSuffix            := "";
				FOR_PolyS                 := 0;   ! match production (exact); irrelevant here anyway: batteries fixed to zero, limits relaxed below
				FOR_LinearizeVmax         := 0;
				RollCyclicSOC             := 0;
				CyclicSOCBand             := 0;
				AllowChargeAtPmax         := 1;
				PeriodMaxP                := 25;
				empty allvariables;
				empty Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				run Load_data_dsn;
				! relax network limits so B is the pure all-idle power-flow value (the de-duplication origin
				! for the Minkowski sum). The idle state itself may violate limits at midday; that is fine -
				! B is an arithmetic reference, not a claimed operating point. Feasibility lives in each FOR_k.
				! MODEST relaxation only (validated 2026-06-15): an extreme relax (1e9) puts ~1e18 in the
				! quadratic ampacity rows, destroys conditioning, and returned 48/48 NoSolution.
				MaxV(n)       := 1.5;
				MinV(n)       := 0.5;
				MaxCurrent(l) := 5*MaxCurrent(l);
				MaxAmps(tr)   := 5*MaxAmps(tr);
				! freeze every battery idle (P via Chg=Dis=0; Qinv already 0 since IncludeQforMaxP=0)
				BattP_Chg(bat,t) := 0;
				BattP_Dis(bat,t) := 0;
				BattP_Chg(bat,t).nonvar := 1;
				BattP_Dis(bat,t).nonvar := 1;
				solve MinImports where MIP_Relative_Optimality_Tolerance := 0.01,
					method := 'deterministic concurrent', numeric_focus := 3, barrier_homogeneous := 1, time_limit := 3000;
				FOR_RollBaseCSV.PageWidth := 32767;
				put FOR_RollBaseCSV;
				put "period,P,Q,status" / ;
				for (t) do
					put ord(t):3:0, ",", P_PCC(t):14:6, ",", Q_PCC(t):14:6, ",", MinImports.ProgramStatus / ;
				endfor;
				putclose FOR_RollBaseCSV;
				! release the fixes
				BattP_Chg(bat,t).nonvar := 0;
				BattP_Dis(bat,t).nonvar := 0;
			}
			Comment: "BASELINE for the per-transformer combination: full feeder, all batteries idle -> FOR_rolling_baseline.csv (the all-idle PCC trajectory B). Tractable because batteries are fixed (no optimization). Used by combine_FOR_pertrafo.py to de-duplicate the shared passive load when summing per-TR FORs.";
		}
		Procedure RunFOR_RollingPreflight {
			Body: {
				! ---- FULL-FEEDER PRE-FLIGHT for RunFOR_Rolling. Sweeps the 12 directions at a
				! ----   handful of representative slots (default: t=12, 25, 40) using the SAME
				! ----   solver config as the production rolling run, but with no SOC carry-forward
				! ----   between slots (each preflight slot starts from BattSOCini). Goal is a
				! ----   smoke test that the solver does not break down on the full feeder, plus
				! ----   per-direction timing so the full-day runtime can be extrapolated.
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 0;   ! NEW generator for the exact quadratic constraints (see RunFOR_Rolling)

				! ---- toggles: identical to the full-feeder leg of RunCompareWithPaperT25 ----
				ReduceNetwork             := PreflightReduce;   ! default 0 = FULL feeder; PreflightReduce=1 for a reduced (per-transformer) preflight
				DetailTagCSV              := PreflightDetailTag;   ! default "" = full feeder; e.g. "TR9" when reduced
				DetailLoadPattern         := "";
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 0;        ! exact inverter S-circle -- match RunFOR_Rolling production config
				FOR_LinearizeVmax         := 0;        ! exact quadratic Vmax -- same
				FOR_nAngles               := 12;       ! every 30 deg
				RollCyclicSOC             := 1;
				CyclicSOCBand             := PreflightBand;     ! default 0.05 = production; PreflightBand=1.0 relaxes the cyclic band
				PeriodMaxP                := 2;        ! service slot is window position 2
				EnableRollDiag            := 0;

				! ---- pick the slots to test. Edit these three lines to change coverage. ----
				PreflightSlot(t) := 0;
				PreflightSlot(Element(Time, 12)) := 1;     ! morning ramp
				PreflightSlot(Element(Time, 25)) := 1;     ! midday PV peak (= paper PeriodMaxP)
				PreflightSlot(Element(Time, 40)) := 1;     ! evening

				! ---- freeze the un-rotated day so each preflight slot rotates from a clean copy ----
				empty allvariables;
				run Load_data_dsn;
				P0raw(d,t)        := P0(d,t);
				Q0raw(d,t)        := Q0(d,t);
				GenP0raw(d,t)     := GenP0(d,t);
				Irrraw(t)         := Irradiance(t);
				BattSOCstart(bat) := BattSOCini(bat);   ! each preflight slot starts from the initial SOC

				! ---- CSV header (same columns as FOR_rolling.csv so existing scripts work) ----
				FOR_RollPreflightCSV.PageWidth := 32767;
				put FOR_RollPreflightCSV;
				put "now,target,angle_deg,P,Q,proj,status,time,VminTrue,VmaxTrue,UVviol,OVviol,LinErr" / ;

				Preflight_TotalTime := 0;
				Preflight_nSolves   := 0;
				Preflight_nFail     := 0;

				for (t | PreflightSlot(t) = 1) do
					RollNow     := ord(t);
					RollMap(tt) := Element(Time, mod(ord(tt)-1 + (RollNow-1), nPeriods) + 1);

					! ---- committed self-consumption baseline for this slot (mirrors RunFOR_Rolling) ----
					empty allvariables;
					run Load_data_dsn;
					P0(d,tt)        := P0raw(d, RollMap(tt));
					Q0(d,tt)        := Q0raw(d, RollMap(tt));
					GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
					Irradiance(tt)  := Irrraw(RollMap(tt));
					BattSOCini(bat) := BattSOCstart(bat);
					BattP_Chg(bat,'1').nonvar := 0;
					BattP_Dis(bat,'1').nonvar := 0;
					run MinOFminImports;
					if ConvFlag <> 'Optimal' and ConvFlag <> 'LocallyOptimal' then
						! baseline rescue, mirrors RunFOR_Rolling
						solve MinImports
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       method              := 'deterministic concurrent',
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 3000;
						ConvFlag := MinImports.ProgramStatus;
					endif;
					RollChgExec(bat) := BattP_Chg(bat,'1');
					RollDisExec(bat) := BattP_Dis(bat,'1');

					put FOR_RollPreflightCSV;
					for (ia) do
						FOR_Angle    := FOR_AngleDeg(ia);
						FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;

						empty allvariables;
						run Load_data_dsn;
						P0(d,tt)        := P0raw(d, RollMap(tt));
						Q0(d,tt)        := Q0raw(d, RollMap(tt));
						GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
						Irradiance(tt)  := Irrraw(RollMap(tt));
						BattSOCini(bat) := BattSOCstart(bat);
						BattP_Chg(bat,'1') := RollChgExec(bat);     ! slot 1 fixed to the committed dispatch (mirrors RunFOR_Rolling)
						BattP_Chg(bat,'1').nonvar := 1;
						BattP_Dis(bat,'1') := RollDisExec(bat);
						BattP_Dis(bat,'1').nonvar := 1;
						run MainExecution;

						FOR_Lambda := 1;
						solve FOR_VertexCont
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       method     := 'deterministic concurrent',
							       time_limit := 3000;

						if FOR_VertexCont.ProgramStatus <> 'Optimal' and
						   FOR_VertexCont.ProgramStatus <> 'LocallyOptimal' then
							solve FOR_VertexCont
								where  MIP_Relative_Optimality_Tolerance := 0.01,
								       method              := 'deterministic concurrent',
								       numeric_focus       := 3,
								       barrier_homogeneous := 1,
								       time_limit          := 3000;
						endif;

						FOR_StatCur          := FOR_VertexCont.ProgramStatus;
						Preflight_nSolves    := Preflight_nSolves + 1;
						Preflight_TotalTime  := Preflight_TotalTime + FOR_VertexCont.SolutionTime;

						if FOR_VertexCont.ProgramStatus = 'Optimal' or
						   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
							FOR_Pcur    := P_PCC(PeriodMaxP);
							FOR_Qcur    := Q_PCC(PeriodMaxP);
							FOR_VmaxCur := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
							FOR_LinCur  := max((n,f), abs(Vmag2approx(n,f,PeriodMaxP) - (Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
							put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
							    FOR_Pcur:14:6, ",", FOR_Qcur:14:6, ",",
							    (cos(FOR_AngleRad)*FOR_Pcur + sin(FOR_AngleRad)*FOR_Qcur):14:6, ",",
							    FOR_StatCur, ",", FOR_VertexCont.SolutionTime:12:2, ",",
							    (min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2))):10:5, ",",
							    FOR_VmaxCur:10:5, ",",
							    (max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)))):10:5, ",",
							    (max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)))):10:5, ",",
							    FOR_LinCur:12:6 / ;
						else
							Preflight_nFail := Preflight_nFail + 1;
							put RollNow:3:0, ",", (mod(RollNow,nPeriods)+1):3:0, ",", FOR_Angle:6:1, ",",
							    0:14:6, ",", 0:14:6, ",", 0:14:6, ",",
							    FOR_StatCur, ",", FOR_VertexCont.SolutionTime:12:2, ",",
							    0:10:5, ",", 0:10:5, ",", 0:10:5, ",", 0:10:5, ",", 0:12:6 / ;
						endif;
					endfor;
				endfor;

				putclose FOR_RollPreflightCSV;
				RollCyclicSOC := 0;
				CyclicSOCBand := 0;
				BattP_Chg(bat,t).nonvar := 0;   ! defensive: free the slot-1 fixes so later runs see normal variables
				BattP_Dis(bat,t).nonvar := 0;

				display Preflight_nSolves, Preflight_nFail, Preflight_TotalTime;
			}
			Comment: {
				"FOR - PRE-FLIGHT. Smoke test for the production rolling run on the FULL feeder.
				 Sweeps the 12 directions at 3 representative slots (t=12 morning, t=25 PV peak,
				 t=40 evening) with the same toggles as RunFOR_Rolling (FOR_PolyS=0,
				 FOR_LinearizeVmax=0, RollCyclicSOC=1, NC_Q). Each preflight slot starts from
				 BattSOCini (no SOC carry-forward between preflight slots, to keep this fast),
				 solves the same committed self-consumption baseline (MinImports) as production,
				 and fixes slot 1 to that dispatch during the sweep.
				 Writes FOR_rolling_preflight.csv (same columns as FOR_rolling.csv) and
				 reports Preflight_nFail / Preflight_TotalTime so the full-day runtime
				 (= TotalTime * 48 / 3) can be extrapolated. RUN THIS BEFORE RunFOR_Rolling on
				 the full feeder; if any direction returns non-Optimal, debug before launching."
			}
		}
		Procedure RunTR9_PreflightCyclicTest {
			Body: {
				! EXPERIMENT (one click): does relaxing the cyclic-SOC band inflate the FOR?
				! Runs the 3-slot x 12-direction preflight (t=12/25/40) for TR9 (reduced network)
				! TWICE - once at the production band 0.05, once relaxed (1.0) - both starting from
				! the same BattSOCini (no carry-forward), so the vertices are directly comparable.
				! Writes FOR_rolling_preflight_TR9_cyc05.csv and FOR_rolling_preflight_TR9_cycOff.csv.
				! ~72 vertex solves (~15-25 min). If the relaxed region is materially larger, the
				! cyclic band is doing real work in the FOR (offered flexibility that is not repeatable
				! day to day); if the two regions coincide, the band is inert for the FOR too.
				PreflightReduce    := 1;
				PreflightDetailTag := "TR9";

				PreflightBand   := 0.05;   PreflightSuffix := "_TR9_cyc05";
				run RunFOR_RollingPreflight;

				PreflightBand   := 1.0;    PreflightSuffix := "_TR9_cycOff";
				run RunFOR_RollingPreflight;

				! restore production defaults
				PreflightReduce    := 0;
				PreflightDetailTag := "";
				PreflightBand      := 0.05;
				PreflightSuffix    := "";
			}
			Comment: "EXPERIMENT (one click): FOR sensitivity to the cyclic-SOC band. Runs the TR9 reduced-network preflight (3 slots x 12 directions) at band 0.05 and at band 1.0, writing FOR_rolling_preflight_TR9_cyc05.csv and _cycOff.csv for comparison. ~72 solves (~15-25 min). Production preflight behaviour is unchanged (defaults preserved).";
		}
		Procedure RunReducedTest_RollingMicro {
			Body: {
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "_two";   ! keep only TR9_two* buses (sub-branch with ~12 PV+battery houses)
				run RunFOR_Rolling;
				DetailLoadPattern := "";       ! defensive reset: back to TR9-full behaviour for subsequent runs
			}
			Comment: "MICRO TEST (one click): the smallest controllable test bed - isolate the TR9_two* sub-branch (12 batteries, 21 loads, 21 buses) and run the daily rolling FOR on it. Goal is understanding: small enough to hand-check SOC trajectories, predict the FOR shape, and trace what each constraint does. Back to TR9-full: leave DetailLoadPattern empty. Back to the full feeder: set ReduceNetwork:=0.";
		}
		Procedure RunReducedTest_RollingMicro_LegacyWarm {
			Body: {
				FOR_SweepWarmStart := 1;   ! legacy: run MainExecution before every vertex solve
				run RunReducedTest_RollingMicro;
				FOR_SweepWarmStart := 0;   ! defensive reset: back to the production default
			}
			Comment: {
				"A/B PARTNER of RunReducedTest_RollingMicro (one click): the same micro test with the legacy
				per-direction MainExecution solve switched back ON. Since 2026-07-29 the default is OFF, so this
				is the procedure that reproduces the OLD behaviour - use it to re-run the A/B after any change to
				the sweep or after a solver/AIMMS upgrade. Compare the two FOR_rolling.csv files with
				scripts/compare_FOR_runs.py. Time the RUNS with a clock, not with the CSV 'time' column - that
				column is FOR_VertexCont.SolutionTime only and does not see the solve this toggle adds.
				Acceptance: 'proj' must reproduce within ~2e-6 p.u. and no direction may change solve status;
				P/Q are allowed to slide along a flat face. Measured 2026-07-29 on TR9_two: legacy 41m22s vs
				default 10m12s, outputs bit-identical. See FOR_SweepWarmStart."
			}
		}
		Procedure RunReducedTest_RollingDiag {
			Body: {
				ReduceNetwork  := 1;
				DetailTagCSV   := "TR9";
				EnableRollDiag := 1;
				DiagCyclicBand := 0.10;   ! Pass 1: |SOC_end - SOC_start| <= 10% of capacity (must exceed the 5% production band in RunFOR_Rolling to be a real relaxation)
				DiagPVcutFrac  := 0.50;   ! Pass 2: halve PV (proxy for explicit curtailment)
				run RunFOR_Rolling;
				EnableRollDiag := 0;       ! defensive reset
			}
			Comment: "TEST (one click) + DIAGNOSTIC: same as RunTR9, but for each failed direction inside RunFOR_Rolling, retry with (Pass 1) cyclic-SOC band relaxed to DiagCyclicBand (default 0.05), then (Pass 2) cyclic relaxed + GenP0 scaled by (1 - DiagPVcutFrac) (default 0.50). Attribution is written to FOR_rolling_diag.csv (cols: now,target,angle_deg,pass,status,P,Q,proj,time). Use to tell apart cyclic-SOC-bound vs PV-saturation-bound vs linearization-bound failures.";
		}
		Procedure RunMicro_FairL1 {
			Body: {
				FairMode    := 1;          ! C1 between PROSUMERS
				FairFileTag := "_fairL1";
				run RunReducedTest_RollingMicro;
				FairMode    := 0;          ! defensive reset: back to case A
				FairFileTag := "";
			}
			Comment: "STAGE 0 (one click): micro test bed under C1 fairness between PROSUMERS. Writes FOR_rolling_fairL1.csv (+ _soc_, + the fairness log). ~10 min. Validate case A (RunReducedTest_RollingMicro, FairMode=0) FIRST and confirm it still reproduces the baseline exactly before trusting any fairness number.";
		}
		Procedure RunMicro_FairL2 {
			Body: {
				FairMode    := 2;          ! C1 between AGGREGATORS
				FairFileTag := "_fairL2";
				run RunReducedTest_RollingMicro;
				FairMode    := 0;
				FairFileTag := "";
			}
			Comment: "STAGE 0 (one click): micro test bed under C1 fairness between AGGREGATORS. ~10 min. The micro bed carries all three aggregators with a 1/7/4 battery split (3.6 / 25.2 / 14.4 kW), which is far more unbalanced than TR9\'s 28/32/30 - so this is the SHARPER test of level 2, not a weaker one.";
		}
		Procedure RunTR9_FairL1 {
			Body: {
				FairMode    := 1;
				FairFileTag := "_fairL1";
				run RunTR9;                ! sets RollFileSuffix := '_TR9'; FairFileTag composes -> FOR_rolling_TR9_fairL1.csv
				FairMode    := 0;
				FairFileTag := "";
			}
			Comment: "STAGE 0 PRODUCTION (one click): TR9 rolling FOR under C1 fairness between PROSUMERS. ~3h40. Run only after the micro bed passes.";
		}
		Procedure RunTR9_FairL2 {
			Body: {
				FairMode    := 2;
				FairFileTag := "_fairL2";
				run RunTR9;
				FairMode    := 0;
				FairFileTag := "";
			}
			Comment: "STAGE 0 PRODUCTION (one click): TR9 rolling FOR under C1 fairness between AGGREGATORS. ~3h40. Expect a SMALL contraction: TR9\'s three aggregators hold 28/32/30 prosumers by design, so their capacities are nearly equal and the level-2 constraint has little to bite on. That is a finding of the deliverable, not a defect - the micro bed\'s 1/7/4 split is where level 2 shows its teeth.";
		}
	}
	Section DOE_Dispatch {
		Comment: "Two-level fair dispatch study (thesis chapter): the DSO disaggregates a requested PCC service point into per-aggregator Dynamic Operating Envelopes (level-1 fairness, capacity-proportional across aggregators) and then per-prosumer DOEs (level-2 fairness, capacity-proportional within each aggregator). All constraints are gated by DOE_Stage=0 by default, so this section adds NOTHING to the production solves. Entry points: RunDOE_Dispatch (one target point) and RunDOE_Envelope (per-prosumer DOE bands from the P-extremes of the FOR).";
		DeclarationSection DOE_Declarations {
			Parameter DOE_Stage {
				Default: 0;
				Comment: "0 = section inactive (no rows generated anywhere - production untouched). 1 = level-1 solve (aggregator fairness). 2 = level-2 solve (prosumer fairness, aggregator allocations held by DOE_HoldAgg).";
			}
			Parameter DOE_NAggs {
				Default: 2;
				Comment: "Number of aggregators the prosumers are randomly split into.";
			}
			Set DOE_Aggs {
				SubsetOf: Integers;
				Index: ag;
				Definition: ElementRange(1, DOE_NAggs);
			}
			Parameter DOE_Seed {
				Default: 42;
				Comment: "Random seed for the prosumer->aggregator split (reproducible).";
			}
			ElementParameter DOE_AggOf {
				IndexDomain: bat;
				Range: DOE_Aggs;
				Comment: "Aggregator of each battery/prosumer; set by DOE_AssignAggregators.";
			}
			Parameter DOE_CapAgg {
				IndexDomain: ag;
				Definition: sum(bat | DOE_AggOf(bat) = ag, BattMaxP(bat));
				Comment: "Installed battery power capacity per aggregator (p.u.).";
			}
			Parameter DOE_CapTot {
				Definition: sum(bat, BattMaxP(bat));
			}
			Parameter DOE_Now {
				Default: 25;
				Comment: "Chosen rolling step (1..48). The dispatch happens at that step's service slot (window slot 2 = period now+1), starting from the realised SOC reconstructed by re-committing steps 1..DOE_Now.";
			}
			Parameter DOE_TargetP {
				Default: 0;
				Comment: "Requested PCC active power (p.u.) at the service slot - pick a point inside the FOR of step DOE_Now (see FOR_rolling_<tag>.csv).";
			}
			Parameter DOE_TargetQ {
				Default: 0;
				Comment: "Requested PCC reactive power (p.u.) at the service slot.";
			}
			Parameter DOE_PinTol {
				Default: 0.001;
				Comment: "Half-width of the PCC pin band (p.u.). A hair of slack keeps re-pinned FOR-boundary points numerically feasible; 0.001 p.u. = 1 kW.";
			}
			Parameter DOE_TiePen {
				Default: 0.0001;
				Comment: "Tiny battery-throughput tiebreaker in both fairness objectives: kills charge+discharge degeneracy without measurably distorting fairness (fairness terms are O(1e-4..1e-2) p.u.^2).";
			}
			StringParameter DOE_TrafoTag {
				InitialData: "TR9";
				Comment: "Transformer the dispatch study runs on (per-TR reduced network, like the production FOR).";
			}
			Parameter DOE_AggAlloc {
				IndexDomain: ag;
				Comment: "Level-1 result: committed net injection per aggregator (p.u.), held fixed in level 2 by DOE_HoldAgg.";
			}
			Parameter DOE_ShareB {
				IndexDomain: bat;
				Comment: "Level-2 fair target per prosumer: its aggregator's allocation times BattMaxP share.";
			}
			Parameter DOE_BandLo {
				IndexDomain: bat;
				Comment: "RunDOE_Envelope: prosumer dispatch at the max-export end of the FOR.";
			}
			Parameter DOE_BandMid {
				IndexDomain: bat;
				Comment: "RunDOE_Envelope: prosumer dispatch at the requested target.";
			}
			Parameter DOE_BandHi {
				IndexDomain: bat;
				Comment: "RunDOE_Envelope: prosumer dispatch at the max-import end of the FOR.";
			}
			Variable DOE_NetB {
				IndexDomain: bat | DOE_Stage;
				Range: free;
				Definition: BattP_Dis(bat, PeriodMaxP) - BattP_Chg(bat, PeriodMaxP);
				Comment: "Prosumer net service-slot injection (discharge positive, battery frame).";
			}
			Variable DOE_NetAgg {
				IndexDomain: ag | DOE_Stage;
				Range: free;
				Definition: sum(bat | DOE_AggOf(bat) = ag, DOE_NetB(bat));
				Comment: "Aggregator net service-slot injection.";
			}
			Variable DOE_UtilTot {
				Range: free;
				Definition: sum(bat | DOE_Stage, DOE_NetB(bat)) / max(DOE_CapTot, 1e-9);
				Comment: "Fleet-wide utilisation (net injection / installed capacity). Trivial 0-row when DOE_Stage=0.";
			}
			Variable DOE_OF1 {
				Range: free;
				Definition: sum(ag | DOE_Stage, (DOE_NetAgg(ag) - DOE_UtilTot*DOE_CapAgg(ag))^2) + DOE_TiePen*sum((bat,t) | DOE_Stage, BattP_Chg(bat,t) + BattP_Dis(bat,t));
				Comment: "Level-1 fairness: squared deviation of each aggregator from its capacity-proportional share of the total, + throughput tiebreaker.";
			}
			Variable DOE_OF2 {
				Range: free;
				Definition: sum(bat | DOE_Stage, (DOE_NetB(bat) - DOE_ShareB(bat))^2) + DOE_TiePen*sum((bat,t) | DOE_Stage, BattP_Chg(bat,t) + BattP_Dis(bat,t));
				Comment: "Level-2 fairness: squared deviation of each prosumer from its capacity-proportional share of its aggregator's allocation, + throughput tiebreaker.";
			}
			Constraint DOE_PinP {
				IndexDomain: ag | DOE_Stage and ord(ag) = 1;
				Definition: DOE_TargetP - DOE_PinTol <= P_PCC(PeriodMaxP) <= DOE_TargetP + DOE_PinTol;
				Comment: "Pin the PCC active power to the requested service point (band of +-DOE_PinTol). Indexed over the first aggregator element only = one row when active.";
			}
			Constraint DOE_PinQ {
				IndexDomain: ag | DOE_Stage and ord(ag) = 1;
				Definition: DOE_TargetQ - DOE_PinTol <= Q_PCC(PeriodMaxP) <= DOE_TargetQ + DOE_PinTol;
			}
			Constraint DOE_HoldAgg {
				IndexDomain: ag | DOE_Stage = 2;
				Definition: DOE_NetAgg(ag) = DOE_AggAlloc(ag);
				Comment: "Level 2: hold each aggregator at its level-1 fair allocation (lexicographic two-stage fairness).";
			}
			MathematicalProgram DOE_Level1 {
				Objective: DOE_OF1;
				Direction: minimize;
				Constraints: NotTobeExcluded_constraints;
				Variables: NotTobeExcluded_variables;
				Type: Automatic;
			}
			MathematicalProgram DOE_Level2 {
				Objective: DOE_OF2;
				Direction: minimize;
				Constraints: NotTobeExcluded_constraints;
				Variables: NotTobeExcluded_variables;
				Type: Automatic;
			}
			File DOE_DispatchCSV {
				Name: "DOE_dispatch.csv";
				Device: Disk;
				Mode: replace;
			}
			File DOE_AggCSV {
				Name: "DOE_aggregators.csv";
				Device: Disk;
				Mode: replace;
			}
			File DOE_EnvelopeCSV {
				Name: "DOE_envelopes.csv";
				Device: Disk;
				Mode: replace;
			}
		}
		Procedure DOE_AssignAggregators {
			Body: {
				! random, seeded, reproducible split of the (reduced-network) prosumers
				option seed := DOE_Seed;
				DOE_AggOf(bat) := Element(DOE_Aggs, ceil(Uniform(0, 1) * DOE_NAggs));
				display DOE_CapAgg;
			}
			Comment: "Random prosumer->aggregator split (Bernoulli per battery, seed DOE_Seed). Run after the network is loaded/reduced so only the study transformer's batteries are assigned.";
		}
		Procedure DOE_PrepWindow {
			Body: {
				! rotate the day so slot 1 = DOE_Now, restore realised SOC, freeze slot 1
				! (identical mechanics to the RunFOR_Rolling sweep preamble)
				RollNow     := DOE_Now;
				RollMap(tt) := Element(Time, mod(ord(tt)-1 + (RollNow-1), nPeriods) + 1);
				empty allvariables;
				run Load_data_dsn;
				P0(d,tt)        := P0raw(d, RollMap(tt));
				Q0(d,tt)        := Q0raw(d, RollMap(tt));
				GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
				Irradiance(tt)  := Irrraw(RollMap(tt));
				BattSOCini(bat) := BattSOCstart(bat);
				BattP_Chg(bat,'1') := RollChgExec(bat);
				BattP_Chg(bat,'1').nonvar := 1;
				BattP_Dis(bat,'1') := RollDisExec(bat);
				BattP_Dis(bat,'1').nonvar := 1;
				run MainExecution;
			}
			Comment: "Rotate window to DOE_Now, seed the realised SOC, freeze the committed slot-1 dispatch, generate warm start. Call before every DOE/probe solve (empty allvariables wipes the previous solve).";
		}
		Procedure DOE_RollToStep {
			Body: {
				! reconstruct the realised SOC trajectory by re-committing steps 1..DOE_Now
				! (baseline solves only - no sweeps - so this is fast: ~DOE_Now MinImports solves)
				BattSOCstart(bat) := BattSOCini(bat);
				for (t | ord(t) <= DOE_Now) do
					RollNow     := ord(t);
					RollMap(tt) := Element(Time, mod(ord(tt)-1 + (RollNow-1), nPeriods) + 1);
					empty allvariables;
					run Load_data_dsn;
					P0(d,tt)        := P0raw(d, RollMap(tt));
					Q0(d,tt)        := Q0raw(d, RollMap(tt));
					GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
					Irradiance(tt)  := Irrraw(RollMap(tt));
					BattSOCini(bat) := BattSOCstart(bat);
					BattP_Chg(bat,'1').nonvar := 0;
					BattP_Dis(bat,'1').nonvar := 0;
					run MinOFminImports;
					if ConvFlag <> 'Optimal' and ConvFlag <> 'LocallyOptimal' then
						solve MinImports
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       method              := 'deterministic concurrent',
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 3000;
						ConvFlag := MinImports.ProgramStatus;
					endif;
					RollChgExec(bat) := BattP_Chg(bat,'1');
					RollDisExec(bat) := BattP_Dis(bat,'1');
					if ord(t) < DOE_Now then
						! advance the realised SOC with the executed slot-1 dispatch (not at the final step:
						! the study happens AT step DOE_Now, from the SOC that step starts with)
						BattSOCstart(bat) := BattSOCini(bat)
							+ (BattP_Chg(bat,'1')*etaChg(bat) - BattP_Dis(bat,'1')/etaDis(bat))*DeltaT/BattEcap(bat);
					endif;
				endfor;
			}
			Comment: "Rebuild the rolling state at step DOE_Now: commit the self-consumption baseline step by step (same solves as RunFOR_Rolling, no sweeps), carrying the realised SOC forward. Leaves RollChgExec/RollDisExec = the committed dispatch of step DOE_Now.";
		}
		Procedure DOE_FairSolveAtTarget {
			Arguments: (TgtP,TgtQ);
			Body: {
				DOE_TargetP := TgtP;
				DOE_TargetQ := TgtQ;
				! ---- level 1: fair split between aggregators ----
				run DOE_PrepWindow;
				DOE_Stage := 1;
				solve DOE_Level1
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       method := 'deterministic concurrent', time_limit := 3000;
				DOE_AggAlloc(ag) := DOE_NetAgg(ag);
				DOE_ShareB(bat)  := DOE_AggAlloc(DOE_AggOf(bat)) * BattMaxP(bat) / max(DOE_CapAgg(DOE_AggOf(bat)), 1e-9);
				! ---- level 2: fair split between prosumers, aggregator allocations held ----
				run DOE_PrepWindow;
				DOE_Stage := 2;
				solve DOE_Level2
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       method := 'deterministic concurrent', time_limit := 3000;
				DOE_Stage := 0;
			}
			Parameter TgtP {
				Property: Input;
			}
			Parameter TgtQ {
				Property: Input;
			}
			Comment: "Two-stage lexicographic fair dispatch at one requested PCC point. Leaves the level-2 solution in the model variables (DOE_NetB etc.) and the level-1 allocations in DOE_AggAlloc.";
		}
		Procedure RunDOE_Dispatch {
			Body: {
				! ---- production config, mirrored from RunFOR_Rolling (exact QCP) ----
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 0;
				option Feasibility_Tolerance         := 1.0e-3;
				option Barrier_Convergence_Tolerance := 1.0e-2;
				option Scaling_Flag                  := 2;
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 0;
				FOR_LinearizeVmax         := 0;
				RollCyclicSOC             := 1;
				CyclicSOCBand             := 0.05;
				PeriodMaxP                := 2;
				FOR_TieEps                := 0;
				UseBattComp               := 0;
				ReduceNetwork             := 1;
				DetailTagCSV              := DOE_TrafoTag;
				DetailLoadPattern         := "";
				DOE_Stage                 := 0;
				! load once: freeze raw inputs + day-start SOC, then split the prosumers
				empty allvariables;
				run Load_data_dsn;
				P0raw(d,t)    := P0(d,t);
				Q0raw(d,t)    := Q0(d,t);
				GenP0raw(d,t) := GenP0(d,t);
				Irrraw(t)     := Irradiance(t);
				run DOE_AssignAggregators;
				! realised state at the chosen step, then the two-level fair dispatch
				run DOE_RollToStep;
				DOE_FairSolveAtTarget(DOE_TargetP, DOE_TargetQ);
				! ---- outputs ----
				DOE_AggCSV.PageWidth := 32767;
				put DOE_AggCSV;
				put "aggregator,n_prosumers,cap_pu,alloc_pu,util,targetP_pu,targetQ_pu,now" / ;
				for (ag) do
					put ord(ag):2:0, ",", sum(bat | DOE_AggOf(bat) = ag, 1):4:0, ",", DOE_CapAgg(ag):12:6, ",",
					    DOE_AggAlloc(ag):12:6, ",", (DOE_AggAlloc(ag)/max(DOE_CapAgg(ag),1e-9)):10:6, ",",
					    DOE_TargetP:12:6, ",", DOE_TargetQ:12:6, ",", DOE_Now:3:0 / ;
				endfor;
				putclose DOE_AggCSV;
				DOE_DispatchCSV.PageWidth := 32767;
				put DOE_DispatchCSV;
				put "battery,aggregator,BattMaxP_pu,SOC_start,Chg2_pu,Dis2_pu,net_pu,fair_share_pu,util" / ;
				for (bat) do
					put bat:24, ",", ord(DOE_AggOf(bat)):2:0, ",", BattMaxP(bat):10:6, ",", BattSOCstart(bat):10:6, ",",
					    BattP_Chg(bat,PeriodMaxP):12:6, ",", BattP_Dis(bat,PeriodMaxP):12:6, ",",
					    (BattP_Dis(bat,PeriodMaxP)-BattP_Chg(bat,PeriodMaxP)):12:6, ",", DOE_ShareB(bat):12:6, ",",
					    ((BattP_Dis(bat,PeriodMaxP)-BattP_Chg(bat,PeriodMaxP))/max(BattMaxP(bat),1e-9)):10:6 / ;
				endfor;
				putclose DOE_DispatchCSV;
				! leave the model clean
				BattP_Chg(bat,t).nonvar := 0;
				BattP_Dis(bat,t).nonvar := 0;
				RollCyclicSOC := 0;
				CyclicSOCBand := 0;
			}
			Comment: "ENTRY POINT 1 - single-point fair dispatch. Set DOE_Now + DOE_TargetP/Q (a point inside that step's FOR, from FOR_rolling_<tag>.csv), optionally DOE_Seed/DOE_NAggs/DOE_TrafoTag, then run. Writes DOE_aggregators.csv (level-1 allocations) and DOE_dispatch.csv (per-prosumer dispatch vs fair share).";
		}
		Procedure RunDOE_Envelope {
			Body: {
				! same preparation as RunDOE_Dispatch
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 0;
				option Feasibility_Tolerance         := 1.0e-3;
				option Barrier_Convergence_Tolerance := 1.0e-2;
				option Scaling_Flag                  := 2;
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 0;
				FOR_LinearizeVmax         := 0;
				RollCyclicSOC             := 1;
				CyclicSOCBand             := 0.05;
				PeriodMaxP                := 2;
				FOR_TieEps                := 0;
				UseBattComp               := 0;
				ReduceNetwork             := 1;
				DetailTagCSV              := DOE_TrafoTag;
				DetailLoadPattern         := "";
				DOE_Stage                 := 0;
				empty allvariables;
				run Load_data_dsn;
				P0raw(d,t)    := P0(d,t);
				Q0raw(d,t)    := Q0(d,t);
				GenP0raw(d,t) := GenP0(d,t);
				Irrraw(t)     := Irradiance(t);
				run DOE_AssignAggregators;
				run DOE_RollToStep;
				! ---- probe the P-extremes of this step's FOR (max export / max import) ----
				run DOE_PrepWindow;
				FOR_Angle    := 180;
				FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;
				FOR_Lambda   := 1;
				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       method := 'deterministic concurrent', time_limit := 3000;
				DOE_ProbeLoP := P_PCC(PeriodMaxP);
				DOE_ProbeLoQ := Q_PCC(PeriodMaxP);
				run DOE_PrepWindow;
				FOR_Angle    := 0;
				FOR_AngleRad := 0;
				FOR_Lambda   := 1;
				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       method := 'deterministic concurrent', time_limit := 3000;
				DOE_ProbeHiP := P_PCC(PeriodMaxP);
				DOE_ProbeHiQ := Q_PCC(PeriodMaxP);
				! ---- fair dispatch at lo / mid / hi; collect the per-prosumer bands ----
				DOE_FairSolveAtTarget(DOE_ProbeLoP, DOE_ProbeLoQ);
				DOE_BandLo(bat) := BattP_Dis(bat,PeriodMaxP) - BattP_Chg(bat,PeriodMaxP);
				DOE_FairSolveAtTarget(DOE_TargetP, DOE_TargetQ);
				DOE_BandMid(bat) := BattP_Dis(bat,PeriodMaxP) - BattP_Chg(bat,PeriodMaxP);
				DOE_FairSolveAtTarget(DOE_ProbeHiP, DOE_ProbeHiQ);
				DOE_BandHi(bat) := BattP_Dis(bat,PeriodMaxP) - BattP_Chg(bat,PeriodMaxP);
				! ---- write the per-prosumer DOEs ----
				DOE_EnvelopeCSV.PageWidth := 32767;
				put DOE_EnvelopeCSV;
				put "battery,aggregator,BattMaxP_pu,DOE_lo_pu,DOE_mid_pu,DOE_hi_pu,now,PloFOR,PhiFOR" / ;
				for (bat) do
					put bat:24, ",", ord(DOE_AggOf(bat)):2:0, ",", BattMaxP(bat):10:6, ",",
					    DOE_BandLo(bat):12:6, ",", DOE_BandMid(bat):12:6, ",", DOE_BandHi(bat):12:6, ",",
					    DOE_Now:3:0, ",", DOE_ProbeLoP:12:6, ",", DOE_ProbeHiP:12:6 / ;
				endfor;
				putclose DOE_EnvelopeCSV;
				BattP_Chg(bat,t).nonvar := 0;
				BattP_Dis(bat,t).nonvar := 0;
				RollCyclicSOC := 0;
				CyclicSOCBand := 0;
			}
			Parameter DOE_ProbeLoP;
			Parameter DOE_ProbeLoQ;
			Parameter DOE_ProbeHiP;
			Parameter DOE_ProbeHiQ;
			Comment: "ENTRY POINT 2 - per-prosumer DOE bands. Probes the max-export and max-import ends of step DOE_Now's FOR (two directional solves, slot 1 frozen), fair-dispatches lo/mid/hi, and writes each prosumer's [lo,mid,hi] band to DOE_envelopes.csv: the small DOEs the DSO sends down so every prosumer knows its range.";
		}
	}
	Section Validation {
		Comment: "Everything that VALIDATES the production model, fenced off from it. (1) BattComp: the MIQCP complementarity binary as cross-check of the QCP throughput-penalty formulation. (2) Exact-AC / SLP boundary validation of the linearized FOR (VoltageRefinement, RunFOR_TR9_Exact / RunFOR_TR9_Linearized, RunFOR_Ref). (3) Loss-balance / coverage audits and the raw-number dump. (4) Comparison against the original paper (RunFOR_4Vertices, RunCompareWithPaperT25).";
		DeclarationSection VoltageRefinement {
			Comment: "RunFOR_4Vertices SLP voltage-refinement working set: re-linearization seeds (VreSeed/VimSeed/HaveSeed), the damped trust-region state (Alpha/Stall/VreGood/VimGood, best-so-far OVbest/OVcur) and iteration controls (SLPMaxIter/OVtol/SLPIter).";
			Parameter FOR_VreSeed {
				IndexDomain: (n,f,t);
				Comment: "Vre of the last SOLVED direction. Used to re-linearize a failing direction (attempt 3).";
			}
			Parameter FOR_VimSeed {
				IndexDomain: (n,f,t);
				Comment: "Vim of the last SOLVED direction. Used to re-linearize a failing direction (attempt 3).";
			}
			Parameter FOR_HaveSeed {
				Comment: "1 once at least one direction has solved, so a re-linearization seed is available.";
			}
			Parameter FOR_SLPMaxIter {
				Comment: "Max successive-re-linearization (SLP) passes applied to a solved direction whose TRUE voltage still exceeds the cap.";
			}
			Parameter FOR_OVtol {
				Comment: "Overvoltage tolerance (p.u.). If FOR_OvervoltViol exceeds this after a solve, an SLP refinement pass is triggered.";
			}
			Parameter FOR_SLPIter {
				IndexDomain: ia;
				Comment: {
					"Number of SLP refinement passes actually applied at this direction (0 = none needed; linearization was already accurate)."
				}
			}
			Parameter FOR_OVbest {
				Comment: "Working: smallest FOR_OvervoltViol seen so far across SLP passes for the current direction.";
			}
			Parameter FOR_OVcur {
				Comment: "Working: FOR_OvervoltViol of the latest SLP pass for the current direction.";
			}
			Parameter FOR_Alpha {
				Comment: "Working: current SLP damping/trust-region fraction (reset to FOR_DampAlpha per direction, halved on a regressed or failed pass).";
			}
			Parameter FOR_VreGood {
				IndexDomain: (n,f,t);
				Comment: "Working: Vre of the BEST-so-far SLP solution for the current direction (re-linearization & warm start always restart from here).";
			}
			Parameter FOR_VimGood {
				IndexDomain: (n,f,t);
				Comment: "Working: Vim of the BEST-so-far SLP solution for the current direction.";
			}
			Parameter FOR_Stall {
				Comment: "Working: count of consecutive non-improving SLP passes. When it reaches 2, FOR_Alpha is re-energized to FOR_DampAlpha (break the alpha-collapse plateau) instead of being halved again.";
			}
		}
		DeclarationSection LossBalanceCheck {
			Comment: "DiagnoseLossBalance: independent reconstruction of P_PCC = CustPtot + losses (demand/PV/battery decomposition, coverage, branch loss) -> diag_lossbalance.csv.";
			Parameter FOR_LB_D {
				Comment: "Loss-balance diag: total raw demand sum(d,P0(d,PeriodMaxP)).";
			}
			Parameter FOR_LB_G {
				Comment: "Loss-balance diag: total PV sum(d,GenP0(d,PeriodMaxP)).";
			}
			Parameter FOR_LB_B {
				Comment: "Loss-balance diag: net battery sum(bat,BattP_Balance(bat,PeriodMaxP)) (>0 charge, <0 discharge).";
			}
			Parameter FOR_LB_CustBat {
				Comment: "Loss-balance diag: CustPtot the way the model computes it = sum(bat,TotPcust(BattBus,BattPhase,PeriodMaxP)).";
			}
			Parameter FOR_LB_CustAll {
				Comment: "Loss-balance diag: TotPcust summed over ALL (n,f). Equals FOR_LB_CustBat iff every load node has a battery (coverage proof).";
			}
			Parameter FOR_LB_Ppcc {
				Comment: "Loss-balance diag: P_PCC(PeriodMaxP) at the solved export-extreme vertex.";
			}
			Parameter FOR_LB_PlossRes {
				Comment: "Loss-balance diag: residual loss = P_PCC - CustPtot (the briefing number, true by construction).";
			}
			Parameter FOR_LB_LineLoss {
				Comment: "Loss-balance diag: independent line loss = sum over lines,phases of (Vstart-Vend).I.";
			}
			Parameter FOR_LB_TrLoss {
				Comment: "Loss-balance diag: independent transformer loss = sum over trafos,phases of Vprim.Iprim - Vsec.Isec.";
			}
			Parameter FOR_LB_PlossBr {
				Comment: "Loss-balance diag: independent total branch loss = line + trafo. Should match FOR_LB_PlossRes to ~0.1%.";
			}
			File FOR_LBCSV {
				Name: "diag_lossbalance.csv";
			}
			File FOR_LB_MicroCSV {
				Name: "diag_lossbalance_micro.csv";
			}
		}
		DeclarationSection CoverageCheck {
			Comment: "DiagnoseCoverageGap: per-(bus,phase) battery/load counts and TotPcust to localize the CustPtot coverage gap -> diag_coverage.csv.";
			Parameter FOR_CG_nBat {
				IndexDomain: (n,f);
				Comment: "Coverage diag: number of batteries mapped to (n,f). >1 means TotPcust(n,f) is double-counted in the model CustPtot.";
			}
			Parameter FOR_CG_nLoad {
				IndexDomain: (n,f);
				Comment: "Coverage diag: number of loads/PV at (n,f).";
			}
			Parameter FOR_CG_Tot {
				IndexDomain: (n,f);
				Comment: "Coverage diag: TotPcust(n,f,PeriodMaxP) at the solved 180deg vertex.";
			}
			Parameter FOR_CG_SumAll {
				Comment: "Coverage diag: sum over ALL (n,f) of TotPcust (true network net).";
			}
			Parameter FOR_CG_SumBat {
				Comment: "Coverage diag: sum(bat,TotPcust(BattBus,BattPhase)) (the model CustPtot).";
			}
			Parameter FOR_CG_Dup {
				Comment: "Coverage diag: over-count from nodes with >1 battery = sum (nBat-1)*TotPcust.";
			}
			Parameter FOR_CG_LoadNoBat {
				Comment: "Coverage diag: TotPcust at nodes that have load/PV but ZERO battery (missed by the model CustPtot).";
			}
			File FOR_CGCSV {
				Name: "diag_coverage.csv";
			}
		}
		DeclarationSection NumberDump {
			Comment: "DumpFORNumbers: per-element loss parameters and the dump_*.csv files (loads, batteries, lines, trafos, slack, voltages, currents, scalars) for spreadsheet re-derivation.";
			Parameter FOR_DBG_LineLoss {
				IndexDomain: l;
				Comment: "Audit dump: per-line real loss = Σ_f (Vstart−Vend)·I at PeriodMaxP.";
			}
			Parameter FOR_DBG_TrLoss {
				IndexDomain: tr;
				Comment: "Audit dump: per-transformer real loss = Σ_f Vprim·Iprim − Vsec·Isec at PeriodMaxP.";
			}
			File FOR_DLoads {
				Name: "dump_loads.csv";
			}
			File FOR_DBatt {
				Name: "dump_batteries.csv";
			}
			File FOR_DLines {
				Name: "dump_lines.csv";
			}
			File FOR_DTraf {
				Name: "dump_trafos.csv";
			}
			File FOR_DSlack {
				Name: "dump_slack.csv";
			}
			File FOR_DScal {
				Name: "dump_scalars.csv";
			}
			File FOR_DVolt {
				Name: "dump_voltages.csv";
			}
			File FOR_DLineI {
				Name: "dump_line_currents.csv";
			}
			File FOR_DTrafI {
				Name: "dump_trafo_currents.csv";
			}
			File FOR_DLoadI {
				Name: "dump_loadgen_currents.csv";
			}
		}
		Procedure RunMicro_BattComp {
			Body: {
				UseBattComp       := 1;    ! enforce no simultaneous charge/discharge (complementarity binary)
				run RunReducedTest_RollingMicro;
				UseBattComp       := 0;    ! defensive reset: back to the production QCP
			}
			Comment: "ONE-CLICK VALIDATION (MIQCP): sets UseBattComp=1 (binary BattOn forbids simultaneous battery charge/discharge) and runs the TR9_two micro rolling FOR. Expected: same dispatch and FOR as the production QCP (whose BattThroughputPen=0.2 default already prevents the phantom dump). Resets UseBattComp=0 afterwards.";
		}
		Procedure RunFullTR9_BattComp {
			Body: {
				UseBattComp       := 1;           ! enforce complementarity (no simultaneous charge/discharge)
				RollFileSuffix    := "_TR9_comp"; ! NEW output FOR_rolling_TR9_comp.csv -- does NOT overwrite baseline FOR_rolling_TR9.csv
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR9";
				DetailLoadPattern := "";
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				UseBattComp       := 0;           ! reset toggle so other runs are unaffected
			}
			Comment: "VALIDATION (MIQCP): full TR9 rolling FOR with the complementarity binary (UseBattComp=1) -> FOR_rolling_TR9_comp.csv. Cross-check of the production QCP throughput-penalty formulation (expect the same dispatch/FOR, much slower: 90x48 binaries).";
		}
		Procedure RunFOR_4Vertices {
			Body: {
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator:=1;

				! --- settings: network ON, battery Q at PeriodMaxP, period 25 ---
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";

				! relaxed FOR: batteries may also charge at PeriodMaxP so the feeder can import (0 = article = discharge-only)
				AllowChargeAtPmax := 1;   ! 0 = article ; 1 = relaxed
				! fully-linear model so all 36 directions solve:
				!   FOR_PolyS=1 = 16-gon inverter S-curve (~2% tol); FOR_LinearizeVmax=1 = Vmax linearized like Vmin.
				! set both to 0 for the exact model (then the 4 corners return NoSolution, bounded by neighbours).
				FOR_PolyS         := 1;
				FOR_LinearizeVmax := 1;

				! 1 = also write one workbook per vertex (slow, ~37 .xls); 0 = reference only. FOR_ref_25.xls always written.
				FOR_WriteVertexXls := 1;

				! tiny cost-min tiebreaker: pulls off-period dispatch to the cost-min solution so the vertex .xls are not
				! arbitrary, while keeping the period-25 vertex P/Q optimal. set 0 for previous behaviour.
				FOR_TieEps := 1.0e-5;

				empty allvariables;
				run Load_data_dsn;

				! clear last sweep
				empty FOR_Boundary, FOR_BndStatus, FOR_BndTime, FOR_BndProj;
				empty FOR_FixUsed, FOR_VreSeed, FOR_VimSeed, FOR_SLPIter;
				FOR_HaveSeed := 0;

				! --- sweep + rescue knobs ---
				FOR_nAngles   := 36;   ! number of scan directions (every 10 deg)
				FOR_nSteps    := 8;    ! continuation steps used only by the rescue path
				FOR_DampAlpha := 0.6;  ! re-linearization damping (0..1)

				! --- SLP knobs: linearized Vmax can sit ~0.5-1.5% over the true 1.10 cap. after each solve, if the true
				! overvoltage exceeds FOR_OVtol, re-linearize at the solved voltages and re-solve (1-2 passes). ---
				FOR_SLPMaxIter := 10;       ! damped steps + stall-resets need headroom
				FOR_OVtol      := 0.0005;   ! p.u. (VmaxTrue <= ~1.1005)

				! --- reference solve: force the EXACT model (3 toggles -> 0), solve the same cost-min OPF at p25 and write
				! FOR_ref_25.xls in NC_Q_25 format to check faithfulness, then restore the toggles. fully reversible. ---
				FOR_RefSave_ACAP := AllowChargeAtPmax;
				FOR_RefSave_PolS := FOR_PolyS;
				FOR_RefSave_LVmx := FOR_LinearizeVmax;
				AllowChargeAtPmax := 0;     ! article discharge-only at PeriodMaxP
				FOR_PolyS         := 0;     ! exact battery S-circle
				FOR_LinearizeVmax := 0;     ! exact Vmax quadratic
				empty allvariables;
				run Load_data_dsn;
				run MainExecution;
				run ComputeMetrics;
				ResultsFileRoot := "FOR_ref_";
				run WriteResultstoExcel;
				ResultsFileRoot := "FOR_";
				AllowChargeAtPmax := FOR_RefSave_ACAP;
				FOR_PolyS         := FOR_RefSave_PolS;
				FOR_LinearizeVmax := FOR_RefSave_LVmx;

				! --- directional scan: rotate the objective angle; each solve gives one boundary point of the FOR ---
				for (ia) do
					FOR_Angle    := FOR_AngleDeg(ia);
					FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;

					! attempt 1: clean baseline (Vre0/Vim0 reset to flat, warm-started from the cost-min OPF). FOR_Lambda=1 = pure direction.
					empty allvariables;
					run Load_data_dsn;
					run MainExecution;

					FOR_Lambda := 1;
					solve FOR_VertexCont
						where  MIP_Relative_Optimality_Tolerance := 0.01,
						       time_limit := 3000;

					FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
					FOR_BndTime(ia)   := FOR_VertexCont.SolutionTime;
					FOR_FixUsed(ia)   := "direct";

					! attempt 2: if not optimal, re-solve same model with stronger numerics
					! (Gurobi reported numerical breakdown, NOT infeasibility, on far-from-nominal directions).
					if FOR_VertexCont.ProgramStatus <> 'Optimal' and
					   FOR_VertexCont.ProgramStatus <> 'LocallyOptimal' then

						solve FOR_VertexCont
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 1500;

						FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
						FOR_BndTime(ia)   := FOR_BndTime(ia)
						                    + FOR_VertexCont.SolutionTime;
						if FOR_VertexCont.ProgramStatus = 'Optimal' or
						   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
							FOR_FixUsed(ia) := "numeric";
						endif;
					endif;

					! attempt 3: still stuck -> re-linearize around the last solved direction (a neighbour in scan order) and warm-start from it.
					if (FOR_VertexCont.ProgramStatus <> 'Optimal' and
					    FOR_VertexCont.ProgramStatus <> 'LocallyOptimal') and
					   FOR_HaveSeed = 1 then

						Vre0(n,f,t) := FOR_VreSeed(n,f,t);
						Vim0(n,f,t) := FOR_VimSeed(n,f,t);
						Vre(n,f,t)  := FOR_VreSeed(n,f,t);
						Vim(n,f,t)  := FOR_VimSeed(n,f,t);

						solve FOR_VertexCont
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 1500;

						FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
						FOR_BndTime(ia)   := FOR_BndTime(ia)
						                    + FOR_VertexCont.SolutionTime;
						if FOR_VertexCont.ProgramStatus = 'Optimal' or
						   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
							FOR_FixUsed(ia) := "reseed";
						endif;
					endif;

					! record only if some attempt solved
					if FOR_VertexCont.ProgramStatus = 'Optimal' or
					   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then

						! store P,Q + Tier-2 AC checks + CustPtot/Ploss. re-run inside the SLP loop so the CSV keeps the best point.
						FOR_Boundary(ia, 'P') := P_PCC(PeriodMaxP);
						FOR_Boundary(ia, 'Q') := Q_PCC(PeriodMaxP);
						FOR_BndProj(ia) := cos(FOR_AngleRad)*P_PCC(PeriodMaxP) + sin(FOR_AngleRad)*Q_PCC(PeriodMaxP);
						FOR_VminTrue(ia)     := min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_VmaxTrue(ia)     := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_UndervoltViol(ia):= max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
						FOR_OvervoltViol(ia) := max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)));
						FOR_LinErrMax(ia)    := max((n,f), abs(Vmag2approx(n,f,PeriodMaxP) - (Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
						FOR_CustPtot(ia) := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
						FOR_Ploss(ia)    := P_PCC(PeriodMaxP) - FOR_CustPtot(ia);

						! optional: write this vertex full dispatch as FOR_v<ord(ia)>_25.xls (the converged solve BEFORE the SLP cleanup).
						if FOR_WriteVertexXls = 1 then
							run ComputeMetrics;
							ResultsFileRoot := "FOR_v" + ord(ia) + "_";
							run WriteResultstoExcel;
							ResultsFileRoot := "FOR_";
						endif;

						! SLP refinement: re-linearize toward the solved voltages to pull the true overvoltage onto the cap.
						! damped step (move Vre0/Vim0 a fraction FOR_Alpha toward best); keep best + shrink alpha on a bad pass so it can never degrade.
						FOR_SLPIter(ia)    := 0;
						FOR_OVbest         := FOR_OvervoltViol(ia);
						FOR_Alpha          := FOR_DampAlpha;
						FOR_Stall          := 0;
						FOR_VreGood(n,f,t) := Vre(n,f,t);
						FOR_VimGood(n,f,t) := Vim(n,f,t);
						while ( FOR_OVbest > FOR_OVtol and
						        FOR_SLPIter(ia) < FOR_SLPMaxIter ) do
							! damped move of the linearization point toward best; warm-start from it
							Vre0(n,f,t) := Vre0(n,f,t)
							              + FOR_Alpha*(FOR_VreGood(n,f,t) - Vre0(n,f,t));
							Vim0(n,f,t) := Vim0(n,f,t)
							              + FOR_Alpha*(FOR_VimGood(n,f,t) - Vim0(n,f,t));
							Vre(n,f,t)  := FOR_VreGood(n,f,t);
							Vim(n,f,t)  := FOR_VimGood(n,f,t);

							solve FOR_VertexCont
								where  MIP_Relative_Optimality_Tolerance := 0.01,
								       numeric_focus       := 3,
								       barrier_homogeneous := 1,
								       time_limit          := 1500;

							FOR_BndTime(ia) := FOR_BndTime(ia)
							                  + FOR_VertexCont.SolutionTime;
							FOR_SLPIter(ia) := FOR_SLPIter(ia) + 1;

							if FOR_VertexCont.ProgramStatus = 'Optimal' or
							   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
								FOR_OVcur := max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)));
								if FOR_OVcur <= FOR_OVbest then
									! better pass: accept, re-record, advance best
									FOR_OVbest := FOR_OVcur;
									FOR_Boundary(ia, 'P') := P_PCC(PeriodMaxP);
									FOR_Boundary(ia, 'Q') := Q_PCC(PeriodMaxP);
									FOR_BndProj(ia) := cos(FOR_AngleRad)*P_PCC(PeriodMaxP) + sin(FOR_AngleRad)*Q_PCC(PeriodMaxP);
									FOR_VminTrue(ia)     := min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
									FOR_VmaxTrue(ia)     := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
									FOR_UndervoltViol(ia):= max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
									FOR_OvervoltViol(ia) := FOR_OVcur;
									FOR_LinErrMax(ia)    := max((n,f), abs(Vmag2approx(n,f,PeriodMaxP) - (Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
									FOR_CustPtot(ia) := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
									FOR_Ploss(ia)    := P_PCC(PeriodMaxP) - FOR_CustPtot(ia);
									FOR_VreGood(n,f,t) := Vre(n,f,t);
									FOR_VimGood(n,f,t) := Vim(n,f,t);
									FOR_Stall := 0;              ! progress: reset stall
								else
									! overshoot: shrink alpha, but re-energize after 2 stalls so it does not collapse to ~0 (plateau)
									FOR_Stall := FOR_Stall + 1;
									if FOR_Stall >= 2 then
										FOR_Alpha := FOR_DampAlpha;
										FOR_Stall := 0;
									else
										FOR_Alpha := FOR_Alpha / 2;
									endif;
								endif;
							else
								! numeric fail: same stall-aware shrink
								FOR_Stall := FOR_Stall + 1;
								if FOR_Stall >= 2 then
									FOR_Alpha := FOR_DampAlpha;
									FOR_Stall := 0;
								else
									FOR_Alpha := FOR_Alpha / 2;
								endif;
							endif;
						endwhile;

						! tag if SLP ran
						if FOR_SLPIter(ia) > 0 then
							FOR_FixUsed(ia) := FOR_FixUsed(ia) + "+slp";
						endif;

						! seed the next direction attempt-3 with the best voltages
						FOR_VreSeed(n,f,t) := FOR_VreGood(n,f,t);
						FOR_VimSeed(n,f,t) := FOR_VimGood(n,f,t);
						FOR_HaveSeed       := 1;
					else
						FOR_FixUsed(ia) := "FAILED";
					endif;
				endfor;

				! --- write boundary CSV for the Python plot (widen page so the 14-col rows do not wrap) ---
				FOR_CSV.PageWidth := 32767;
				put FOR_CSV;
				put "angle_deg,P,Q,proj,status,time,VminTrue,VmaxTrue,UVviol,OVviol,LinErr,CustPtot,Ploss,FixUsed,SLPiter" / ;
				for (ia) do
					put FOR_AngleDeg(ia):6:1, ",", FOR_Boundary(ia,'P'):14:6, ",", FOR_Boundary(ia,'Q'):14:6, ",", FOR_BndProj(ia):14:6, ",", FOR_BndStatus(ia), ",", FOR_BndTime(ia):12:2, ",", FOR_VminTrue(ia):10:5, ",", FOR_VmaxTrue(ia):10:5, ",", FOR_UndervoltViol(ia):10:5, ",", FOR_OvervoltViol(ia):10:5, ",", FOR_LinErrMax(ia):12:6, ",", FOR_CustPtot(ia):14:6, ",", FOR_Ploss(ia):14:6, ",", FOR_FixUsed(ia), ",", FOR_SLPIter(ia):4:0 / ;
				endfor;
				putclose FOR_CSV;

				display FOR_Boundary, FOR_BndStatus, FOR_BndTime,
				        FOR_VminTrue, FOR_VmaxTrue, FOR_UndervoltViol,
				        FOR_OvervoltViol, FOR_LinErrMax,
				        FOR_CustPtot, FOR_Ploss, FOR_FixUsed, FOR_SLPIter;
			}
			Comment: {
				"Main FOR deliverable. Full P-Q region at the PCC for PeriodMaxP=25, 36 directions, with SLP voltage refinement; writes FOR_boundary.csv. If a direction struggles, FixUsed/SLPiter in the CSV show which rescue fired and how many SLP passes it took."
			}
		}
		Procedure RunFOR_TR9_Exact {
			Body: {
				! ===========================================================
				! EXPERIMENT (Prof. Luis): keep the EXACT quadratic
				! constraints (inverter S-circle + Vmax circle) and rely on
				! the robust Gurobi barrier + relaxed tolerance, INSTEAD of
				! linearizing. Runs on the TR9-reduced network (fast). Writes
				! FOR_boundary_TR9_exact.csv for side-by-side comparison with
				! the linearized FOR_boundary.csv. Reversible.
				! ===========================================================
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				! the EXACT model is a QCP - use the NEW mathprog generator so the
				! quadratic constraints reach Gurobi (the legacy one is LP-only here)
				option disable_new_mathprog_generator := 0;

				! --- TR9 network reduction (fast): keep TR9 detailed, lump TR1-8 ---
				ReduceNetwork := 1;
				DetailTagCSV  := "TR9";

				! --- base settings (mirror RunFOR_4Vertices) ---
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_WriteVertexXls        := 0;
				FOR_TieEps                := 1.0e-5;

				! --- THE EXPERIMENT: exact quadratic constraints ---
				FOR_PolyS         := 0;   ! exact inverter S-circle: BattP_Balance^2 + Qinv^2 <= BattMaxP^2
				FOR_LinearizeVmax := 0;   ! exact voltage cap:       Vre^2 + Vim^2 <= MaxV^2
				FOR_ScaleInv      := 0;   ! per-unit rescaling tried (did not help) -> isolate the warm-start lever
				FOR_WarmFromLin   := 0;   ! CPLEX solves the exact QCQP directly from cost-min; no linearized predictor needed (set 1 only for the Gurobi warm-start experiment)

				! --- loosen the solver "acceptable error" + scaling (Prof. Luis).
				!     The exact QCP hit Gurobi "unrecoverable numerical difficulties"
				!     (a numeric breakdown, NOT infeasibility). Looser tolerances and
				!     stronger scaling let the barrier complete. Loosen further (e.g.
				!     1.0e-3 / 1.0e-2) if some directions still fail. ---
				option Feasibility_Tolerance         := 1.0e-3;
				option Barrier_Convergence_Tolerance := 1.0e-2;
				option Scaling_Flag                  := 2;

				empty allvariables;
				run Load_data_dsn;

				empty FOR_Boundary, FOR_BndStatus, FOR_BndTime, FOR_BndProj;
				empty FOR_FixUsed, FOR_VreSeed, FOR_VimSeed, FOR_SLPIter;
				FOR_HaveSeed := 0;

				FOR_nAngles := 36;   ! full scan (every 10 deg); drop to 4 for a quick smoke test

				! --- directional scan with the EXACT (QCQP) model + robust barrier ---
				for (ia) do
					FOR_Angle    := FOR_AngleDeg(ia);
					FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;

					! clean warm start from the cost-min OPF
					empty allvariables;
					run Load_data_dsn;
					run MainExecution;

					! --- PREDICTOR: solve the well-conditioned LINEARIZED model for this direction,
					!     then re-linearize the loads AT that boundary point (Vre0/Vim0 := solved Vre/Vim)
					!     and let the exact solve below warm-start from it. Targets conditioning sources
					!     (c) stale flat-nominal linearization and (b) driving onto the boundary. ---
					if FOR_WarmFromLin = 1 then
						FOR_PolyS         := 1;
						FOR_LinearizeVmax := 1;
						FOR_Lambda        := 1;
						solve FOR_VertexCont
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       time_limit := 1500;
						if FOR_VertexCont.ProgramStatus = 'Optimal' or
						   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
							Vre0(n,f,t) := Vre(n,f,t);
							Vim0(n,f,t) := Vim(n,f,t);
						endif;
						FOR_PolyS         := 0;
						FOR_LinearizeVmax := 0;
					endif;

					FOR_Lambda := 1;
					! robust barrier FROM the first attempt (failure mode was numeric, not infeasibility)
					solve FOR_VertexCont
						where  MIP_Relative_Optimality_Tolerance := 0.01,
						       numeric_focus       := 3,
						       barrier_homogeneous := 1,
						       time_limit          := 3000;

					FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
					FOR_BndTime(ia)   := FOR_VertexCont.SolutionTime;
					FOR_FixUsed(ia)   := "exact";

					! retry: reseed from the last solved neighbour
					if (FOR_VertexCont.ProgramStatus <> 'Optimal' and
					    FOR_VertexCont.ProgramStatus <> 'LocallyOptimal') and
					   FOR_HaveSeed = 1 then
						Vre0(n,f,t) := FOR_VreSeed(n,f,t);
						Vim0(n,f,t) := FOR_VimSeed(n,f,t);
						Vre(n,f,t)  := FOR_VreSeed(n,f,t);
						Vim(n,f,t)  := FOR_VimSeed(n,f,t);
						solve FOR_VertexCont
							where  MIP_Relative_Optimality_Tolerance := 0.01,
							       numeric_focus       := 3,
							       barrier_homogeneous := 1,
							       time_limit          := 1500;
						FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
						FOR_BndTime(ia)   := FOR_BndTime(ia) + FOR_VertexCont.SolutionTime;
						if FOR_VertexCont.ProgramStatus = 'Optimal' or
						   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
							FOR_FixUsed(ia) := "exact+reseed";
						endif;
					endif;

					! record if solved. NO SLP: the exact cap has no overshoot to refine.
					if FOR_VertexCont.ProgramStatus = 'Optimal' or
					   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
						FOR_Boundary(ia,'P') := P_PCC(PeriodMaxP);
						FOR_Boundary(ia,'Q') := Q_PCC(PeriodMaxP);
						FOR_BndProj(ia)      := cos(FOR_AngleRad)*P_PCC(PeriodMaxP) + sin(FOR_AngleRad)*Q_PCC(PeriodMaxP);
						FOR_VminTrue(ia)     := min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_VmaxTrue(ia)     := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_UndervoltViol(ia):= max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
						FOR_OvervoltViol(ia) := max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)));
						FOR_LinErrMax(ia)    := 0;
						FOR_CustPtot(ia)     := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
						FOR_Ploss(ia)        := P_PCC(PeriodMaxP) - FOR_CustPtot(ia);
						FOR_SLPIter(ia)      := 0;
						FOR_VreSeed(n,f,t)   := Vre(n,f,t);
						FOR_VimSeed(n,f,t)   := Vim(n,f,t);
						FOR_HaveSeed         := 1;
					else
						FOR_FixUsed(ia) := "FAILED";
					endif;
				endfor;

				! --- write the exact-run boundary to its own csv (same columns as FOR_boundary.csv) ---
				FOR_CSV_Exact.PageWidth := 32767;
				put FOR_CSV_Exact;
				put "angle_deg,P,Q,proj,status,time,VminTrue,VmaxTrue,UVviol,OVviol,LinErr,CustPtot,Ploss,FixUsed,SLPiter" / ;
				for (ia) do
					put FOR_AngleDeg(ia):6:1, ",", FOR_Boundary(ia,'P'):14:6, ",", FOR_Boundary(ia,'Q'):14:6, ",", FOR_BndProj(ia):14:6, ",", FOR_BndStatus(ia), ",", FOR_BndTime(ia):12:2, ",", FOR_VminTrue(ia):10:5, ",", FOR_VmaxTrue(ia):10:5, ",", FOR_UndervoltViol(ia):10:5, ",", FOR_OvervoltViol(ia):10:5, ",", FOR_LinErrMax(ia):12:6, ",", FOR_CustPtot(ia):14:6, ",", FOR_Ploss(ia):14:6, ",", FOR_FixUsed(ia), ",", FOR_SLPIter(ia):4:0 / ;
				endfor;
				putclose FOR_CSV_Exact;

				! --- restore production defaults (exact + full feeder) ---
				FOR_PolyS         := 0;
				FOR_LinearizeVmax := 0;
				FOR_ScaleInv      := 0;
				FOR_WarmFromLin   := 0;
				ReduceNetwork     := 0;

				display FOR_Boundary, FOR_BndStatus, FOR_FixUsed, FOR_VmaxTrue, FOR_OvervoltViol;
			}
			Comment: "EXPERIMENT (Prof. Luis): TR9-reduced FOR scan with EXACT quadratic constraints (FOR_PolyS=0, FOR_LinearizeVmax=0) and robust Gurobi barrier from attempt 1 - no linearization, no SLP. Writes FOR_boundary_TR9_exact.csv to compare with the linearized FOR_boundary.csv. Optional commented tolerance lines loosen the acceptable error. Reversible: restores FOR_PolyS=0, FOR_LinearizeVmax=0 (production exact config), ReduceNetwork=0.";
		}
		Procedure RunFOR_TR9_Linearized {
			Body: {
				! ===========================================================
				! COMPANION to RunFOR_TR9_Exact for the exact-vs-linearized
				! comparison. Same TR9-reduced network + period 25 + 36 dirs,
				! but the LINEARIZED capability model (FOR_PolyS=1 polygon S-cone,
				! FOR_LinearizeVmax=1 tangent Vmax). No SLP -> this is the RAW
				! linearized boundary (the outer approximation that slightly
				! overshoots Vmax on the import side; the production SLP loop is
				! what later pulls it back). Writes FOR_boundary_TR9_lin.csv with
				! the same columns. Records VmaxTrue/OVviol so the overshoot vs the
				! exact run is visible. Well-conditioned -> solves under any solver.
				! Reversible: restores production defaults.
				! ===========================================================
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 0;

				ReduceNetwork := 1;
				DetailTagCSV  := "TR9";
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_WriteVertexXls        := 0;
				FOR_TieEps                := 1.0e-5;

				! --- LINEARIZED capability model (the historical whole-feeder config, minus SLP) ---
				FOR_PolyS         := 1;   ! polygon (16-gon) inverter S-cone
				FOR_LinearizeVmax := 1;   ! tangent-plane voltage cap
				FOR_ScaleInv      := 0;
				FOR_WarmFromLin   := 0;

				empty allvariables;
				run Load_data_dsn;

				empty FOR_Boundary, FOR_BndStatus, FOR_BndTime, FOR_BndProj;
				empty FOR_FixUsed, FOR_SLPIter;

				FOR_nAngles := 36;   ! every 10 deg (match the exact run)

				for (ia) do
					FOR_Angle    := FOR_AngleDeg(ia);
					FOR_AngleRad := FOR_Angle * 4*arctan(1) / 180;

					empty allvariables;
					run Load_data_dsn;
					run MainExecution;

					FOR_Lambda := 1;
					solve FOR_VertexCont
						where  MIP_Relative_Optimality_Tolerance := 0.01,
						       time_limit := 1500;

					FOR_BndStatus(ia) := FOR_VertexCont.ProgramStatus;
					FOR_BndTime(ia)   := FOR_VertexCont.SolutionTime;
					FOR_FixUsed(ia)   := "linearized";

					if FOR_VertexCont.ProgramStatus = 'Optimal' or
					   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then
						FOR_Boundary(ia,'P') := P_PCC(PeriodMaxP);
						FOR_Boundary(ia,'Q') := Q_PCC(PeriodMaxP);
						FOR_BndProj(ia)      := cos(FOR_AngleRad)*P_PCC(PeriodMaxP) + sin(FOR_AngleRad)*Q_PCC(PeriodMaxP);
						FOR_VminTrue(ia)     := min((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_VmaxTrue(ia)     := max((n,f), sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2));
						FOR_UndervoltViol(ia):= max((n,f), max(0, MinV(n) - sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
						FOR_OvervoltViol(ia) := max((n,f), max(0, sqrt(Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2) - MaxV(n)));
						FOR_LinErrMax(ia)    := max((n,f), abs(Vmag2approx(n,f,PeriodMaxP) - (Vre(n,f,PeriodMaxP)^2 + Vim(n,f,PeriodMaxP)^2)));
						FOR_CustPtot(ia)     := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
						FOR_Ploss(ia)        := P_PCC(PeriodMaxP) - FOR_CustPtot(ia);
						FOR_SLPIter(ia)      := 0;
					else
						FOR_FixUsed(ia) := "FAILED";
					endif;
				endfor;

				! --- write the linearized boundary (same columns as the exact run) ---
				FOR_CSV_Lin.PageWidth := 32767;
				put FOR_CSV_Lin;
				put "angle_deg,P,Q,proj,status,time,VminTrue,VmaxTrue,UVviol,OVviol,LinErr,CustPtot,Ploss,FixUsed,SLPiter" / ;
				for (ia) do
					put FOR_AngleDeg(ia):6:1, ",", FOR_Boundary(ia,'P'):14:6, ",", FOR_Boundary(ia,'Q'):14:6, ",", FOR_BndProj(ia):14:6, ",", FOR_BndStatus(ia), ",", FOR_BndTime(ia):12:2, ",", FOR_VminTrue(ia):10:5, ",", FOR_VmaxTrue(ia):10:5, ",", FOR_UndervoltViol(ia):10:5, ",", FOR_OvervoltViol(ia):10:5, ",", FOR_LinErrMax(ia):12:6, ",", FOR_CustPtot(ia):14:6, ",", FOR_Ploss(ia):14:6, ",", FOR_FixUsed(ia), ",", FOR_SLPIter(ia):4:0 / ;
				endfor;
				putclose FOR_CSV_Lin;

				! --- restore production defaults (exact) ---
				FOR_PolyS         := 0;
				FOR_LinearizeVmax := 0;
				FOR_ScaleInv      := 0;
				FOR_WarmFromLin   := 0;
				ReduceNetwork     := 0;

				display FOR_Boundary, FOR_BndStatus, FOR_VmaxTrue, FOR_OvervoltViol;
			}
			Comment: "Linearized companion to RunFOR_TR9_Exact: same TR9-reduced/period-25/36-dir scan with the polygon S-cone + tangent Vmax (FOR_PolyS=1, FOR_LinearizeVmax=1), NO SLP -> the raw linearized (outer) boundary. Writes FOR_boundary_TR9_lin.csv (records VmaxTrue/OVviol so the import-side overshoot vs the exact run is visible). Well-conditioned (solves under Gurobi or CPLEX). For the exact-vs-linearized comparison figure.";
		}
		Procedure RunFOR_Ref {
			Body: {
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator:=1;

				! force the exact article model (clears any toggle state left from a previous run)
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				AllowChargeAtPmax         := 0;
				FOR_PolyS                 := 0;
				FOR_LinearizeVmax         := 0;
				FOR_TieEps                := 0;     ! reference is exact cost-min; no tiebreaker

				empty allvariables;
				run Load_data_dsn;
				run MainExecution;
				run ComputeMetrics;
				ResultsFileRoot := "FOR_ref_";
				run WriteResultstoExcel;
				ResultsFileRoot := "FOR_";
			}
			Comment: "FOR - AUDIT. Quick (one solve, ~2 min) validation export. Solves Prof. Luis\'s EXACT, article-assumption OPF (NC+Q, PeriodMaxP=25, AllowChargeAtPmax=0, FOR_PolyS=0, FOR_LinearizeVmax=0) and writes FOR_ref_25.xls in the identical 11-sheet format as NC_Q_25.xls. Compare with compare_FOR_to_NCQ.py: should PASS within solver tolerance. Run THIS before launching the full RunFOR_4Vertices sweep.";
		}
		Procedure RunCompareWithPaperT25 {
			Body: {
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 1;

				! ---- shared paper-compatible toggles (NC-Q case) -- FULL FEEDER ----
				ReduceNetwork             := 0;        ! FULL feeder for paper reproduction; set 1 + DetailTagCSV:="TR9" (+ DetailLoadPattern:="_two") for fast micro
				DetailTagCSV              := "";
				DetailLoadPattern         := "";
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				AllowChargeAtPmax         := 1;        ! bidirectional flexibility (match rolling default); set 0 to reproduce paper Eq. (8) literally
				RollCyclicSOC             := 0;        ! disable cyclic SOC for fair paper-style comparison
				CyclicSOCBand             := 0;
				FOR_PolyS                 := 1;        ! polygonal S-envelope (~2% outer error vs exact circle) -- needed for numerical robustness at 1216-battery scale with wrapped+saturated SOC
				FOR_LinearizeVmax         := 1;        ! linearized Vmax for the same reason. Applied identically to Stage Paper and Stage Rolling so the equivalence test stays apples-to-apples.
				EnableRollDiag            := 0;
				ResultsFileRoot           := "FOR_";

				! ============ STAGE SC: self-consumption only (no service request) ============
				empty allvariables;
				run Load_data_dsn;
				run MinOFminImports;                                                          ! pure self-consumption baseline

				Cmp_scP := P_PCC('25');                                                       ! evaluate at the same real period for the comparison
				Cmp_scQ := Q_PCC('25');

				! ============ STAGE Paper: paper-style single solve at t=25 ============
				PeriodMaxP := 25;
				empty allvariables;
				run Load_data_dsn;
				run MainExecution;

				Cmp_paperP := P_PCC(PeriodMaxP);
				Cmp_paperQ := Q_PCC(PeriodMaxP);

				! SOC of each battery at end of t=24 (= start of t=25) under Stage Paper's optimal plan
				Cmp_SOC_t24(bat) := BattSOCini(bat)
					+ sum(t | ord(t) <= 24,
					      (BattP_Chg(bat,t)*etaChg(bat)
					       - BattP_Dis(bat,t)/etaDis(bat))
					      * DeltaT / BattEcap(bat));

				! snapshot un-rotated inputs so Stage Rolling can rotate them
				P0raw(d,t)    := P0(d,t);
				Q0raw(d,t)    := Q0(d,t);
				GenP0raw(d,t) := GenP0(d,t);
				Irrraw(t)     := Irradiance(t);

				! ============ STAGE Rolling: rolling step at now=24, target slot 2 = real t=25 ============
				PeriodMaxP  := 2;                                                            ! service slot inside the wrapped window
				RollNow     := 24;
				RollMap(tt) := Element(Time, mod(ord(tt)-1 + (RollNow-1), nPeriods) + 1);

				empty allvariables;
				run Load_data_dsn;
				P0(d,tt)        := P0raw(d, RollMap(tt));
				Q0(d,tt)        := Q0raw(d, RollMap(tt));
				GenP0(d,tt)     := GenP0raw(d, RollMap(tt));
				Irradiance(tt)  := Irrraw(RollMap(tt));
				BattSOCini(bat) := Cmp_SOC_t24(bat);                                          ! same battery state Stage Paper would have at t=24

				! attempt 1: standard solve (succeeds on micro and most full-feeder cases)
				run MainExecution;

				! attempt 2: numeric-focus retry if Gurobi hit unrecoverable difficulties
				! (the wrapped window starting from saturated noon SOC can be ill-conditioned)
				if MinImportsMaxReverseP.ProgramStatus <> 'Optimal' and
				   MinImportsMaxReverseP.ProgramStatus <> 'LocallyOptimal' then
					solve MinImportsMaxReverseP
						where  MIP_Relative_Optimality_Tolerance := 0.01,
						       numeric_focus       := 3,
						       barrier_homogeneous := 1,
						       time_limit          := 3000;
				endif;

				Cmp_rollingP := P_PCC(PeriodMaxP);
				Cmp_rollingQ := Q_PCC(PeriodMaxP);

				! ============ post-process: volumes of services and relative percentages ============
				Cmp_volumeP := Cmp_paperP - Cmp_scP;
				Cmp_volumeQ := Cmp_paperQ - Cmp_scQ;

				Cmp_relP := 0;
				if abs(Cmp_paperP) > 0.000001 then
					Cmp_relP := (Cmp_rollingP - Cmp_paperP) / abs(Cmp_paperP) * 100;
				endif;
				Cmp_relQ := 0;
				if abs(Cmp_paperQ) > 0.000001 then
					Cmp_relQ := (Cmp_rollingQ - Cmp_paperQ) / abs(Cmp_paperQ) * 100;
				endif;

				! ============ write side-by-side comparison CSV ============
				FOR_CompareCSV.PageWidth := 32767;
				put FOR_CompareCSV;
				put "metric,SC_no_service,paper_t25,rolling_now24_slot2,volume_of_services,absolute_diff_rolling_minus_paper,relative_pct" / ;
				put "P_PCC,",
				    Cmp_scP:14:6, ",",
				    Cmp_paperP:14:6, ",",
				    Cmp_rollingP:14:6, ",",
				    Cmp_volumeP:14:6, ",",
				    (Cmp_rollingP - Cmp_paperP):14:6, ",",
				    Cmp_relP:10:3 / ;
				put "Q_PCC,",
				    Cmp_scQ:14:6, ",",
				    Cmp_paperQ:14:6, ",",
				    Cmp_rollingQ:14:6, ",",
				    Cmp_volumeQ:14:6, ",",
				    (Cmp_rollingQ - Cmp_paperQ):14:6, ",",
				    Cmp_relQ:10:3 / ;
				put "" / ;
				put "battery,SOC_at_t24_from_paper_solve" / ;
				for (bat) do
					put bat:24, ",", Cmp_SOC_t24(bat):10:6 / ;
				endfor;
				putclose FOR_CompareCSV;

				display Cmp_scP, Cmp_paperP, Cmp_rollingP, Cmp_volumeP, Cmp_scQ, Cmp_paperQ, Cmp_rollingQ, Cmp_volumeQ;
			}
			Comment: {
				"TEST (one click): three-stage comparison at t=25. (SC) self-consumption only via MinOFminImports -> baseline P at PCC. (Paper) Prof. Luis\'s services case via MainExecution with PeriodMaxP=25 -> paper-style services result. (Rolling) the rolling-horizon equivalent at now=t24 with target slot 2, starting from the SOC Stage Paper would have at t=24. All three use identical paper-compatible toggles (no cyclic, exact S-circle, exact Vmax). The volume of services (paper terminology) is reported as paper - SC; the equivalence of Rolling and Paper is reported as absolute and relative difference. Defaults to the TR9_two micro-test for fast demo; set ReduceNetwork:=0 and clear DetailTagCSV/DetailLoadPattern at the top of the body to compare on the full feeder."
			}
		}
		Procedure DiagnoseLossBalance {
			Body: {
				! independent check that P_PCC = CustPtot + Ploss at the 180deg export extreme:
				!   (a) coverage: CustPtot over battery nodes vs all nodes;  (b) D - G + B rebuilds CustPtot;
				!   (c) branch (V.I) loss, computed independently, must match the P_PCC - CustPtot residual.
				! one clean solve -> diag_lossbalance.csv
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 1;

				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;   ! relaxed (same as 36-angle run)
				FOR_PolyS                 := 1;
				FOR_LinearizeVmax         := 1;

				FOR_Angle    := 180;
				FOR_AngleRad := 180 * 4*arctan(1) / 180;
				FOR_Lambda   := 1;

				empty allvariables;
				run Load_data_dsn;
				run MainExecution;

				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       numeric_focus       := 3,
					       barrier_homogeneous := 1,
					       time_limit          := 1500;

				FOR_StatCur := FOR_VertexCont.ProgramStatus;

				if FOR_VertexCont.ProgramStatus = 'Optimal' or
				   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then

					! ---- (b) component decomposition at PeriodMaxP ----
					FOR_LB_D := sum(d, P0(d,PeriodMaxP));
					FOR_LB_G := sum(d, GenP0(d,PeriodMaxP));
					FOR_LB_B := sum(bat, BattP_Balance(bat,PeriodMaxP));

					! ---- (a) coverage : model sum vs all-node sum ----
					FOR_LB_CustBat := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
					FOR_LB_CustAll := sum((n,f), TotPcust(n,f,PeriodMaxP));

					FOR_LB_Ppcc     := P_PCC(PeriodMaxP);
					FOR_LB_PlossRes := FOR_LB_Ppcc - FOR_LB_CustBat;

					! ---- (c) independent branch loss = sum (Pin - Pout) ----
					FOR_LB_LineLoss := sum((l,f),
					      (Vre(StartBus(l),f,PeriodMaxP) - Vre(EndBus(l),f,PeriodMaxP)) * Ire_Line(l,f,PeriodMaxP)
					    + (Vim(StartBus(l),f,PeriodMaxP) - Vim(EndBus(l),f,PeriodMaxP)) * Iim_Line(l,f,PeriodMaxP) );

					FOR_LB_TrLoss := sum((tr,f),
					      ( Vre(StartBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,StartBusTr(tr),PeriodMaxP)
					      + Vim(StartBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,StartBusTr(tr),PeriodMaxP) )
					    - ( Vre(EndBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,EndBusTr(tr),PeriodMaxP)
					      + Vim(EndBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,EndBusTr(tr),PeriodMaxP) ) );

					FOR_LB_PlossBr := FOR_LB_LineLoss + FOR_LB_TrLoss;

					FOR_LBCSV.PageWidth := 32767;
					put FOR_LBCSV;
					put "quantity,value,note" / ;
					put "status,",            FOR_StatCur, ",solved direction 180deg (export extreme)" / ;
					put "D_demand_total,",    FOR_LB_D:14:6,        ",sum(d) P0  (all loads incl. no-PV houses)" / ;
					put "G_pv_total,",        FOR_LB_G:14:6,        ",sum(d) GenP0  (all PV)" / ;
					put "B_batt_net,",        FOR_LB_B:14:6,        ",sum(bat) BattP_Balance  (>0 charge, <0 discharge)" / ;
					put "Net_reconstruct,",   (FOR_LB_D-FOR_LB_G+FOR_LB_B):14:6, ",D - G + B  (should equal CustPtot_allnodes)" / ;
					put "CustPtot_allnodes,", FOR_LB_CustAll:14:6,  ",sum over ALL (n,f) of TotPcust" / ;
					put "CustPtot_batnodes,", FOR_LB_CustBat:14:6,  ",sum over battery nodes (the models CustPtot)" / ;
					put "Coverage_gap,",      (FOR_LB_CustAll-FOR_LB_CustBat):14:6, ",~0 proves every load node has a battery (no missed load)" / ;
					put "P_PCC,",             FOR_LB_Ppcc:14:6,     ",grid-side import-positive" / ;
					put "Ploss_residual,",    FOR_LB_PlossRes:14:6, ",P_PCC - CustPtot (true by construction)" / ;
					put "Line_loss,",         FOR_LB_LineLoss:14:6, ",independent: sum lines (Vstart-Vend).I" / ;
					put "Trafo_loss,",        FOR_LB_TrLoss:14:6,   ",independent: sum trafos Vprim.Iprim - Vsec.Isec" / ;
					put "Ploss_branch,",      FOR_LB_PlossBr:14:6,  ",independent total (should match Ploss_residual)" / ;
					put "Loss_discrepancy,",  (FOR_LB_PlossBr-FOR_LB_PlossRes):14:6, ",~0 proves the gap is I2R loss not missed demand" / ;
					putclose FOR_LBCSV;

					display FOR_LB_D, FOR_LB_G, FOR_LB_B,
					        FOR_LB_CustAll, FOR_LB_CustBat,
					        FOR_LB_Ppcc, FOR_LB_PlossRes,
					        FOR_LB_LineLoss, FOR_LB_TrLoss, FOR_LB_PlossBr;
				else
					FOR_LBCSV.PageWidth := 32767;
					put FOR_LBCSV;
					put "quantity,value,note" / ;
					put "status,", FOR_StatCur, ",solve did NOT reach optimal - rerun" / ;
					putclose FOR_LBCSV;
				endif;
			}
			Comment: "FOR - AUDIT. One 180deg solve, then checks P_PCC = CustPtot + Ploss independently: D-G+B decomposition, coverage, and branch loss summed line-by-line. Writes diag_lossbalance.csv. This is what proved the reported Ploss is not a clean loss.";
		}
		Procedure DiagnoseLossBalance_Micro {
			Body: {
				! ---- micro-test attribution: same balance check as DiagnoseLossBalance but
				! ---- runs on the TR9_two sub-cluster and writes to diag_lossbalance_micro.csv.
				! ---- Shows how PV is split between local consumers, losses, and TSO export.
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 1;

				! ---- MICRO toggles (TR9_two sub-cluster, 12 batteries + 9 no-battery loads) ----
				ReduceNetwork             := 1;
				DetailTagCSV              := "TR9";
				DetailLoadPattern         := "_two";
				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;        ! midday PV peak
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 1;
				FOR_LinearizeVmax         := 1;

				FOR_Angle    := 180;                    ! direction of max export (most-negative P at PCC)
				FOR_AngleRad := 180 * 4*arctan(1) / 180;
				FOR_Lambda   := 1;

				empty allvariables;
				run Load_data_dsn;
				run MainExecution;

				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       numeric_focus       := 3,
					       barrier_homogeneous := 1,
					       time_limit          := 1500;

				FOR_StatCur := FOR_VertexCont.ProgramStatus;

				if FOR_VertexCont.ProgramStatus = 'Optimal' or
				   FOR_VertexCont.ProgramStatus = 'LocallyOptimal' then

					! ---- component decomposition at PeriodMaxP ----
					FOR_LB_D := sum(d, P0(d,PeriodMaxP));
					FOR_LB_G := sum(d, GenP0(d,PeriodMaxP));
					FOR_LB_B := sum(bat, BattP_Balance(bat,PeriodMaxP));

					! ---- coverage : model sum vs all-node sum ----
					FOR_LB_CustBat := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
					FOR_LB_CustAll := sum((n,f), TotPcust(n,f,PeriodMaxP));

					FOR_LB_Ppcc     := P_PCC(PeriodMaxP);
					FOR_LB_PlossRes := FOR_LB_Ppcc - FOR_LB_CustBat;

					! ---- independent branch loss = sum (Pin - Pout) ----
					FOR_LB_LineLoss := sum((l,f),
					      (Vre(StartBus(l),f,PeriodMaxP) - Vre(EndBus(l),f,PeriodMaxP)) * Ire_Line(l,f,PeriodMaxP)
					    + (Vim(StartBus(l),f,PeriodMaxP) - Vim(EndBus(l),f,PeriodMaxP)) * Iim_Line(l,f,PeriodMaxP) );

					FOR_LB_TrLoss := sum((tr,f),
					      ( Vre(StartBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,StartBusTr(tr),PeriodMaxP)
					      + Vim(StartBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,StartBusTr(tr),PeriodMaxP) )
					    - ( Vre(EndBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,EndBusTr(tr),PeriodMaxP)
					      + Vim(EndBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,EndBusTr(tr),PeriodMaxP) ) );

					FOR_LB_PlossBr := FOR_LB_LineLoss + FOR_LB_TrLoss;

					FOR_LB_MicroCSV.PageWidth := 32767;
					put FOR_LB_MicroCSV;
					put "quantity,value,note" / ;
					put "status,",            FOR_StatCur, ",micro TR9_two, slot t=25, direction 180deg (max export)" / ;
					put "D_demand_total,",    FOR_LB_D:14:6,        ",sum(d) P0  (all loads in micro, incl. no-battery houses)" / ;
					put "G_pv_total,",        FOR_LB_G:14:6,        ",sum(d) GenP0  (all PV in micro)" / ;
					put "B_batt_net,",        FOR_LB_B:14:6,        ",sum(bat) BattP_Balance  (>0 charge, <0 discharge)" / ;
					put "D_minus_G,",         (FOR_LB_D-FOR_LB_G):14:6, ",natural net of all customers (no battery) at this slot" / ;
					put "D_minus_G_plus_B,",  (FOR_LB_D-FOR_LB_G+FOR_LB_B):14:6, ",customer net AFTER battery action  (= CustPtot allnodes)" / ;
					put "CustPtot_allnodes,", FOR_LB_CustAll:14:6,  ",sum over ALL (n,f) of TotPcust (true network net)" / ;
					put "CustPtot_batnodes,", FOR_LB_CustBat:14:6,  ",sum over battery nodes only" / ;
					put "Load_at_NoBatNodes,",(FOR_LB_CustAll-FOR_LB_CustBat):14:6, ",net at the 9 no-battery loads in the micro (= consumer absorption)" / ;
					put "P_PCC,",             FOR_LB_Ppcc:14:6,     ",grid-side at the PCC (negative = export to TSO)" / ;
					put "Ploss_residual,",    FOR_LB_PlossRes:14:6, ",P_PCC - CustPtot  (true losses by construction)" / ;
					put "Line_loss,",         FOR_LB_LineLoss:14:6, ",independent: sum lines (Vstart-Vend).I" / ;
					put "Trafo_loss,",        FOR_LB_TrLoss:14:6,   ",independent: sum trafos Vprim.Iprim - Vsec.Isec" / ;
					put "Ploss_branch,",      FOR_LB_PlossBr:14:6,  ",independent total (should match Ploss_residual)" / ;
					put "Loss_discrepancy,",  (FOR_LB_PlossBr-FOR_LB_PlossRes):14:6, ",~0 proves the gap is true I2R loss" / ;
					putclose FOR_LB_MicroCSV;

					display FOR_LB_D, FOR_LB_G, FOR_LB_B,
					        FOR_LB_CustAll, FOR_LB_CustBat,
					        FOR_LB_Ppcc, FOR_LB_PlossRes,
					        FOR_LB_LineLoss, FOR_LB_TrLoss, FOR_LB_PlossBr;
				else
					FOR_LB_MicroCSV.PageWidth := 32767;
					put FOR_LB_MicroCSV;
					put "quantity,value,note" / ;
					put "status,", FOR_StatCur, ",solve did NOT reach optimal - rerun" / ;
					putclose FOR_LB_MicroCSV;
				endif;

				! ---- defensive reset ----
				DetailLoadPattern := "";
			}
			Comment: "FOR - AUDIT (MICRO). Same balance check as DiagnoseLossBalance but runs on the TR9_two sub-cluster (12 batteries + 9 no-battery loads) and writes diag_lossbalance_micro.csv. The \'Load_at_NoBatNodes\' line directly answers: how much of the local PV is absorbed by neighbouring consumers before anything reaches the TSO.";
		}
		Procedure DiagnoseCoverageGap {
			Body: {
				! localize the CustPtot coverage gap: per (n,f) dump battery count, load count and TotPcust to see
				! if it is double-counting (>1 battery per node) or missing loads at no-battery nodes.
				! one clean 180deg solve (same vertex as DiagnoseLossBalance) -> diag_coverage.csv
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 1;

				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 1;
				FOR_LinearizeVmax         := 1;

				FOR_Angle    := 180;
				FOR_AngleRad := 180 * 4*arctan(1) / 180;
				FOR_Lambda   := 1;

				empty allvariables;
				run Load_data_dsn;
				run MainExecution;

				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       numeric_focus       := 3,
					       barrier_homogeneous := 1,
					       time_limit          := 1500;

				FOR_StatCur := FOR_VertexCont.ProgramStatus;

				FOR_CG_nBat(n,f)  := sum(bat | BattBus(bat)=n and BattPhase(bat)=f, 1);
				FOR_CG_nLoad(n,f) := sum(d   | LoadBus(d)=n  and LoadPhase(d)=f,  1);
				FOR_CG_Tot(n,f)   := TotPcust(n,f,PeriodMaxP);

				FOR_CG_SumAll     := sum((n,f), FOR_CG_Tot(n,f));
				FOR_CG_SumBat     := sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP));
				FOR_CG_Dup        := sum((n,f) | FOR_CG_nBat(n,f) > 1,
				                         (FOR_CG_nBat(n,f) - 1) * FOR_CG_Tot(n,f));
				FOR_CG_LoadNoBat  := sum((n,f) | FOR_CG_nBat(n,f) = 0 and FOR_CG_nLoad(n,f) > 0,
				                         FOR_CG_Tot(n,f));

				FOR_CGCSV.PageWidth := 32767;
				put FOR_CGCSV;
				put "bus,phase,nBat,nLoad,TotPcust,contrib_batsum,contrib_allsum" / ;
				for ( (n,f) | FOR_CG_nBat(n,f) > 0 or FOR_CG_nLoad(n,f) > 0 ) do
					put n, ",", f, ",", FOR_CG_nBat(n,f):4:0, ",", FOR_CG_nLoad(n,f):4:0, ",",
					    FOR_CG_Tot(n,f):14:6, ",",
					    (FOR_CG_nBat(n,f)*FOR_CG_Tot(n,f)):14:6, ",",
					    FOR_CG_Tot(n,f):14:6 / ;
				endfor;
				put "TOTAL_status,",     FOR_StatCur, ",,,," / ;
				put "TOTAL_SumAll,,,,",  FOR_CG_SumAll:14:6,    ",,(true net = sum over ALL nodes)" / ;
				put "TOTAL_SumBat,,,,",  FOR_CG_SumBat:14:6,    ",,(model CustPtot = sum over batteries)" / ;
				put "TOTAL_gap,,,,",     (FOR_CG_SumAll-FOR_CG_SumBat):14:6, ",,(SumAll - SumBat)" / ;
				put "DupTerm,,,,",       FOR_CG_Dup:14:6,       ",,(over-count from nodes with >1 battery)" / ;
				put "LoadNoBatTerm,,,,", FOR_CG_LoadNoBat:14:6, ",,(TotPcust at load nodes with NO battery)" / ;
				putclose FOR_CGCSV;

				display FOR_CG_SumAll, FOR_CG_SumBat, FOR_CG_Dup, FOR_CG_LoadNoBat;
			}
			Comment: "FOR - AUDIT. Per-(bus,phase) dump of battery count, load count and TotPcust. Writes diag_coverage.csv. Proves the CustPtot gap is entirely no-battery consumers (DupTerm=0).";
		}
		Procedure DumpFORNumbers {
			Body: {
				! full audit dump: every per-element number behind D, G, B, CustPtot, P_PCC and the branch losses,
				! so the aggregates can be re-derived in a spreadsheet. one 180deg solve -> dump_*.csv
				empty  Buses, Lines, SlackGens, LoadsAndPV, Trafos, Batteries;
				showprogresswindow;
				option disable_new_mathprog_generator := 1;

				IncludeNetworkConstraints := 1;
				IncludeQforMaxP           := 1;
				nPeriods                  := 48;
				PeriodMaxP                := 25;
				ResultsFileRoot           := "FOR_";
				AllowChargeAtPmax         := 1;
				FOR_PolyS                 := 1;
				FOR_LinearizeVmax         := 1;

				FOR_Angle    := 180;
				FOR_AngleRad := 180 * 4*arctan(1) / 180;
				FOR_Lambda   := 1;

				empty allvariables;
				run Load_data_dsn;
				run MainExecution;

				solve FOR_VertexCont
					where  MIP_Relative_Optimality_Tolerance := 0.01,
					       numeric_focus       := 3,
					       barrier_homogeneous := 1,
					       time_limit          := 1500;

				FOR_StatCur := FOR_VertexCont.ProgramStatus;

				if FOR_VertexCont.ProgramStatus <> 'Optimal' and
				   FOR_VertexCont.ProgramStatus <> 'LocallyOptimal' then
					FOR_DScal.PageWidth := 32767;
					put FOR_DScal;
					put "status,", FOR_StatCur, ",solve did NOT reach optimal - rerun" / ;
					putclose FOR_DScal;
				else
					FOR_DBG_LineLoss(l) := sum(f,
					      (Vre(StartBus(l),f,PeriodMaxP) - Vre(EndBus(l),f,PeriodMaxP)) * Ire_Line(l,f,PeriodMaxP)
					    + (Vim(StartBus(l),f,PeriodMaxP) - Vim(EndBus(l),f,PeriodMaxP)) * Iim_Line(l,f,PeriodMaxP) );
					FOR_DBG_TrLoss(tr) := sum(f,
					      ( Vre(StartBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,StartBusTr(tr),PeriodMaxP)
					      + Vim(StartBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,StartBusTr(tr),PeriodMaxP) )
					    - ( Vre(EndBusTr(tr),f,PeriodMaxP)*Ire_Trafo(tr,f,EndBusTr(tr),PeriodMaxP)
					      + Vim(EndBusTr(tr),f,PeriodMaxP)*Iim_Trafo(tr,f,EndBusTr(tr),PeriodMaxP) ) );

					! ---- per-load ----
					FOR_DLoads.PageWidth := 32767;
					put FOR_DLoads;
					put "load,bus,phase,P0,GenP0,P0_minus_GenP0" / ;
					for (d) do
						put d, ",", LoadBus(d), ",", LoadPhase(d), ",",
						    P0(d,PeriodMaxP):16:8, ",", GenP0(d,PeriodMaxP):16:8, ",",
						    (P0(d,PeriodMaxP)-GenP0(d,PeriodMaxP)):16:8 / ;
					endfor;
					putclose FOR_DLoads;

					! ---- per-battery ----
					FOR_DBatt.PageWidth := 32767;
					put FOR_DBatt;
					put "battery,bus,phase,BattP_Balance" / ;
					for (bat) do
						put bat:24, ",", BattBus(bat):20, ",", BattPhase(bat), ",",
						    BattP_Balance(bat,PeriodMaxP):16:8 / ;
					endfor;
					putclose FOR_DBatt;

					! ---- per-line loss ----
					FOR_DLines.PageWidth := 32767;
					put FOR_DLines;
					put "line,startbus,endbus,line_loss" / ;
					for (l) do
						put l, ",", StartBus(l), ",", EndBus(l), ",",
						    FOR_DBG_LineLoss(l):16:8 / ;
					endfor;
					putclose FOR_DLines;

					! ---- per-transformer loss ----
					FOR_DTraf.PageWidth := 32767;
					put FOR_DTraf;
					put "trafo,startbus,endbus,trafo_loss" / ;
					for (tr) do
						put tr, ",", StartBusTr(tr), ",", EndBusTr(tr), ",",
						    FOR_DBG_TrLoss(tr):16:8 / ;
					endfor;
					putclose FOR_DTraf;

					! ---- per-slack-phase (P_PCC components) ----
					FOR_DSlack.PageWidth := 32767;
					put FOR_DSlack;
					put "slackgen,bus,phase,Vre_PCC,Vim_PCC,Ire_SlackGen,Iim_SlackGen,P_contribution" / ;
					for (sg) do
						put sg, ",", SlackGenBus(sg), ",", SlackGenPhase(sg), ",",
						    Vre_PCC(SlackGenPhase(sg)):16:8, ",",
						    Vim_PCC(SlackGenPhase(sg)):16:8, ",",
						    Ire_SlackGen(sg,PeriodMaxP):16:8, ",",
						    Iim_SlackGen(sg,PeriodMaxP):16:8, ",",
						    ( Vre_PCC(SlackGenPhase(sg))*Ire_SlackGen(sg,PeriodMaxP)
						    + Vim_PCC(SlackGenPhase(sg))*Iim_SlackGen(sg,PeriodMaxP) ):16:8 / ;
					endfor;
					putclose FOR_DSlack;

					! ---- per-bus voltages (Vre, Vim, Vmag2approx) ----
					FOR_DVolt.PageWidth := 32767;
					put FOR_DVolt;
					put "bus,phase,Vre,Vim,Vmag2approx" / ;
					for ((n,f)) do
						put n, ",", f, ",",
						    Vre(n,f,PeriodMaxP):16:8, ",",
						    Vim(n,f,PeriodMaxP):16:8, ",",
						    Vmag2approx(n,f,PeriodMaxP):16:8 / ;
					endfor;
					putclose FOR_DVolt;

					! ---- per-line currents (Ire_Line, Iim_Line) ----
					FOR_DLineI.PageWidth := 32767;
					put FOR_DLineI;
					put "line,phase,startbus,endbus,Ire_Line,Iim_Line" / ;
					for ((l,f)) do
						put l, ",", f, ",", StartBus(l), ",", EndBus(l), ",",
						    Ire_Line(l,f,PeriodMaxP):16:8, ",",
						    Iim_Line(l,f,PeriodMaxP):16:8 / ;
					endfor;
					putclose FOR_DLineI;

					! ---- per-transformer currents (start & end side) ----
					FOR_DTrafI.PageWidth := 32767;
					put FOR_DTrafI;
					put "trafo,phase,Ire_start,Iim_start,Ire_end,Iim_end" / ;
					for ((tr,f)) do
						put tr, ",", f, ",",
						    Ire_Trafo(tr,f,StartBusTr(tr),PeriodMaxP):16:8, ",",
						    Iim_Trafo(tr,f,StartBusTr(tr),PeriodMaxP):16:8, ",",
						    Ire_Trafo(tr,f,EndBusTr(tr),PeriodMaxP):16:8, ",",
						    Iim_Trafo(tr,f,EndBusTr(tr),PeriodMaxP):16:8 / ;
					endfor;
					putclose FOR_DTrafI;

					! ---- per-load/gen currents (Ire/Iim_Load, Ire/Iim_Gen) ----
					FOR_DLoadI.PageWidth := 32767;
					put FOR_DLoadI;
					put "load,bus,phase,Ire_Load,Iim_Load,Ire_Gen,Iim_Gen" / ;
					for (d) do
						put d, ",", LoadBus(d), ",", LoadPhase(d), ",",
						    Ire_Load(d,PeriodMaxP):16:8, ",",
						    Iim_Load(d,PeriodMaxP):16:8, ",",
						    Ire_Gen(d,PeriodMaxP):16:8, ",",
						    Iim_Gen(d,PeriodMaxP):16:8 / ;
					endfor;
					putclose FOR_DLoadI;

					! ---- scalar cross-checks (AIMMS-side, to verify the sheet) ----
					FOR_DScal.PageWidth := 32767;
					put FOR_DScal;
					put "quantity,value" / ;
					put "status,",            FOR_StatCur / ;
					put "D_sum_P0,",          sum(d, P0(d,PeriodMaxP)):16:8 / ;
					put "G_sum_GenP0,",       sum(d, GenP0(d,PeriodMaxP)):16:8 / ;
					put "B_sum_BattP,",       sum(bat, BattP_Balance(bat,PeriodMaxP)):16:8 / ;
					put "CustPtot_allnodes,", sum((n,f), TotPcust(n,f,PeriodMaxP)):16:8 / ;
					put "CustPtot_batnodes,", sum(bat, TotPcust(BattBus(bat),BattPhase(bat),PeriodMaxP)):16:8 / ;
					put "P_PCC,",             P_PCC(PeriodMaxP):16:8 / ;
					put "Line_loss_total,",   sum(l, FOR_DBG_LineLoss(l)):16:8 / ;
					put "Trafo_loss_total,",  sum(tr, FOR_DBG_TrLoss(tr)):16:8 / ;
					putclose FOR_DScal;

					display FOR_StatCur;
				endif;
			}
			Comment: "FOR - AUDIT. Full traceability: every per-element value (each load, battery, line, transformer, slack phase) to dump_*.csv so the aggregates can be re-derived in a spreadsheet.";
		}
	}
	Section ResultsOutput {
		Comment: "Results writers. The rolling FOR writes its CSVs directly from RunFOR_Rolling; WriteResultstoExcel builds the 11-sheet workbook for the paper cases (RunOneCase/RunAllCases/RunBAU).";
		Procedure WriteResultstoExcel {
			Body: {
				axll::CloseAllWorkBooks;

				axll::CreateNewWorkBook(
					WorkbookFilename:ResultsFile,
					FirstSheetName:"BattP_Balance");

				axll::WriteTable(
					IdentifierReference: BattP_Balance(bat,t),	!write BattP_Balance
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1);

				axll::CreateSheet(SheetName:"SOC");	!write SOC
				axll::WriteTable(
					IdentifierReference: BattSOC(bat,t),
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1);

				axll::CreateSheet(SheetName:"BattP_Chg");	!write BattP_Chg
				axll::WriteTable(
					IdentifierReference: BattP_Chg(bat,t),
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1);

				axll::CreateSheet(SheetName:"BattP_Dis");	!write BattP_Dis
				axll::WriteTable(
					IdentifierReference: BattP_Dis(bat,t),
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1);

				axll::CreateSheet(SheetName:"ChgDis");	!write ChgDis
				axll::WriteTable(
					IdentifierReference: ChgDis(bat,t),
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1
					);

				axll::CreateSheet(SheetName:"Qinv");	!write Qinv
				axll::WriteTable(
					IdentifierReference: Qinv(bat,t),
					RowHeaderRange:"A2:A1216",
					ColumnHeaderRange:"B1:AW1",
					DataRange:"B2:AW1216",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1
					);

				!axll::CreateSheet(SheetName:"TotPCust");	!write TotPCust
				!axll::WriteTable(
				!	IdentifierReference:TotPCust(n,f,t),
				!	RowHeaderRange:"A2:B2431",
				!	ColumnHeaderRange:"C1:AX1",
				!	DataRange:"C2:AX2431",
				!	AllowRangeOverflow:1,
				!	WriteZeros:1,
				!	includeEmptyRows:1,
				!	includeEmptyColumns:1
				!	);

				axll::CreateSheet(SheetName:"AllCustWithBatPtot");	!write AllCustWithBatPtot
				axll::WriteTable(
					IdentifierReference:AllCustWithBatPtot(t),
					RowHeaderRange:"",
					ColumnHeaderRange:"A1:AV1",
					DataRange:"A2:AV2",
					AllowRangeOverflow:1,
					WriteZeros:1,
					includeEmptyRows:1,
					includeEmptyColumns:1);

				axll::CreateSheet(SheetName:"AllCustWithBatPtot_AggTr");	!write AllCustWithBatPtot_AggTr
				!axll::WriteTable(
				!	IdentifierReference:AllCustWithBatPtot_AggTr(tr,t),
				!	RowHeaderRange:"A2:B28",
				!	ColumnHeaderRange:"C1:AX1",
				!	DataRange:"C2:AX28",
				!	AllowRangeOverflow:1,
				!	WriteZeros:1,
				!	includeEmptyRows:1,
				!	includeEmptyColumns:1);




				axll::CreateSheet(SheetName:"VmagExPost_PeriodMaxP");	!write VmagExPost_PeriodMaxP
				axll::WriteTable(
					IdentifierReference:VmagExPost_PeriodMaxP(n,f),
					RowHeaderRange:"A1:B13737",
					ColumnHeaderRange:"",
					DataRange:"C1:C13737",
					AllowRangeOverflow:1,
					WriteZeros:1);

				axll::CreateSheet(SheetName:"LineUsage_PeriodMaxP");	!write LineUsage_PeriodMaxP
				axll::WriteTable(
					IdentifierReference:LineUsage_PeriodMaxP(l,f),
					RowHeaderRange:"A1:B13707",
					ColumnHeaderRange:"",
					DataRange:"C1:C13707",
					AllowRangeOverflow:1,
					WriteZeros:1);

				axll::CreateSheet(SheetName:"TrafoUsage_PeriodMaxP");	!write TrafoUsage_PeriodMaxP
				axll::WriteTable(
					IdentifierReference:TrafoUsage_PeriodMaxP(tr,f),
					RowHeaderRange:"A1:B27",
					ColumnHeaderRange:"",
					DataRange:"C1:C27",
					AllowRangeOverflow:1,
					WriteZeros:1);


				axll::CloseAllWorkBooks;
			}
		}
	}
	Section Quantities_and_Units {
		Comment: {
			"This section contains all the units and quantities that are added automatically by AIMMS.
			It is recommended to declare all your quantities here."
		}
		Quantity SI_Time_Duration {
			BaseUnit: s;
			Conversions: minute->s : #-># * 60;
			Comment: {
				"Expresses the value for the duration of periods.

				The unit s has been added automatically because it is a required unit for AimmsWebUI.

				The unit minute has been added automatically because it is a required unit for AimmsWebUI."
			}
		}
	}
}

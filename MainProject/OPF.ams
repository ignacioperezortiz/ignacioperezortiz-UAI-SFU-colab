			Comment: "A/B PARTNER of RunTR3: same case with RollUseGMP=1, so the sweep generates one matrix per period and rewrites only the two objective coefficients per direction. 576 vertices -> FOR_rolling_TR3_gmp.csv. Compare against FOR_rolling_TR3.csv with scripts/compare_FOR_runs.py; the invariant is proj, not P/Q. Clone of RunTR9_GMP.";
		}
		Procedure RunTR4_GMP {
			Body: {
				! A/B PARTNER of RunTR4: the same production run with the sweep matrix generated once per
				! period instead of once per direction. Writes FOR_rolling_TR4_gmp.csv and
				! FOR_rolling_soc_TR4_gmp.csv, so the reference files are left untouched.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR4.csv FOR_rolling_TR4_gmp.csv
				! Clone of RunTR9_GMP with only the tag and the file suffix changed. See that procedure
				! for why the body of RunTrafoFOR is replicated here instead of being called.
				UseBattComp       := 0;
				RollFileSuffix    := "_TR4_gmp";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR4";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				RollUseGMP        := 0;
				RollGMPBaseline   := 0;
			}
			Comment: "A/B PARTNER of RunTR4: same case with RollUseGMP=1, so the sweep generates one matrix per period and rewrites only the two objective coefficients per direction. 576 vertices -> FOR_rolling_TR4_gmp.csv. Compare against FOR_rolling_TR4.csv with scripts/compare_FOR_runs.py; the invariant is proj, not P/Q. Clone of RunTR9_GMP.";
		}
		Procedure RunTR5_GMP {
			Body: {
				! A/B PARTNER of RunTR5: the same production run with the sweep matrix generated once per
				! period instead of once per direction. Writes FOR_rolling_TR5_gmp.csv and
				! FOR_rolling_soc_TR5_gmp.csv, so the reference files are left untouched.
				!   py -3 scripts/compare_FOR_runs.py FOR_rolling_TR5.csv FOR_rolling_TR5_gmp.csv
				! Clone of RunTR9_GMP with only the tag and the file suffix changed. See that procedure
				! for why the body of RunTrafoFOR is replicated here instead of being called.
				UseBattComp       := 0;
				RollFileSuffix    := "_TR5_gmp";
				ReduceNetwork     := 1;
				DetailTagCSV      := "TR5";
				DetailLoadPattern := "";
				RollUseGMP        := 1;
				RollGMPBaseline   := 1;
				run RunFOR_Rolling;
				RollFileSuffix    := "";
				RollUseGMP        := 0;

# ---------------------------------------------------------------------------
# Input data — shared separately via cloud, NOT through GitHub.
# Place these three files in the repository root before running the model.
# ---------------------------------------------------------------------------
Database.mdb
Database.dsn
OpData.xls

# ---------------------------------------------------------------------------
# AIMMS runtime / lock / temp artifacts
# ---------------------------------------------------------------------------
*.aimmslockfile
*.ldb
*.lis
log/
backup/
PROTemp/
.edited/
*.bak
*.tmp
# Local AIMMS snapshots taken before an external edit of OPF.ams. Safety copies for the
# person doing the edit, not deliverables - AIMMS rewrites the whole file on save, so one
# is made before every session that edits the .ams outside the IDE.
MainProject/OPF_pre_*.ams.txt
# Local scratch area: reference copies kept before a run overwrites its own output,
# and notes in progress. Never part of a change.
.refcheck/

# ---------------------------------------------------------------------------
# Model outputs (regenerated on every run)
# ---------------------------------------------------------------------------
FOR_rolling*.csv
# progress marker of RunFOR_RollingPreflight: rewritten every vertex, pure run artefact
FOR_rolling_preflight_progress.txt
# progress marker of RunFOR_Rolling: same reasoning as the preflight one above
FOR_rolling_progress*.txt
# matrix size / memory / objective-row signs, written when PreflightGMPProbe = 1
FOR_gmp_probe*.txt
/*.png
*_analysis_data.xlsx

# Exception to the two patterns above: the whole-feeder run of 2026-08-17 is versioned on
# purpose. It cost 82 h of wall clock, so "regenerate it" is not a real answer to a question
# about what it contains. This is the only run that gets this treatment - see
# results/full_feeder_2026-08/README.md.
!results/full_feeder_2026-08/FOR_rolling*.csv
!results/full_feeder_2026-08/FOR_rolling_progress*.txt

# ---------------------------------------------------------------------------
# Post-processing validation inputs (per-customer load+PV reference tables).
# Shared separately via cloud (like the model input data), NOT through GitHub.
# ---------------------------------------------------------------------------
results/tables/

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
Thumbs.db
.DS_Store

# Intermediate JSON for the FOR viewer (regenerated by scripts/make_viz_data.py)
scripts/for_data*.json
